bump :: fn (value : *u64) void { value[0] = value[0] + 1 }

finish :: fn (value : *u64) i32 {
    defer { value[0] = 42 }
    return value[0] as i32
}

nested :: fn (value : *u64) i32 {
    defer { value[0] = value[0] * 10 + 1 }
    if true {
        defer { value[0] = value[0] * 10 + 2 }
        return value[0] as i32
    }
    0
}

main :: fn () i32 {
    number : u64 = 0
    if finish(&number) != 0 || number != 42 { return 1 }
    number = 0
    if nested(&number) != 0 || number != 21 { return 4 }
    order := 0
    if true {
        defer { order = order * 10 + 1 }
        defer { order = order * 10 + 2 }
    }
    if order != 21 { return 2 }
    count : u64 = 0
    for index in 0..3 {
        defer bump(&count)
        if index == 1 { continue }
        if index == 2 { break }
    }
    if count != 3 { return 3 }
    0
}
