lexer :: @import("../src/lexer.mi")

main :: fn () i32 {
    storage := lexer.expression_arena_init()
    atom := lexer.parse_expression("1", &storage)
    if lexer.expression_is_null(atom) { return 1 }
    if atom.kind != 2 { return atom.kind as i32 }
    if atom.start != 0 { return 12 }
    if atom.end != 1 { return atom.end as i32 }
    expression := lexer.parse_expression("1 + 2 * 3", &storage)
    if lexer.expression_is_null(expression) { return 2 }
    if expression.kind != 43 || expression.start != 0 || expression.end != 9 { return 2 }
    if expression.left.kind != 2 || expression.right.kind != 42 { return 3 }
    if expression.right.left.kind != 2 || expression.right.right.kind != 2 { return 4 }

    grouped := lexer.parse_expression("(1 + 2) * 3", &storage)
    if lexer.expression_is_null(grouped) || grouped.kind != 42 { return 5 }
    if grouped.left.kind != 43 || grouped.left.start != 0 || grouped.left.end != 7 { return 6 }

    associative := lexer.parse_expression("a - b - c", &storage)
    if lexer.expression_is_null(associative) || associative.kind != 45 { return 7 }
    if associative.left.kind != 45 || associative.right.kind != 1 { return 8 }

    logical := lexer.parse_expression("a || b && !c", &storage)
    if lexer.expression_is_null(logical) || logical.kind != 133 { return 13 }
    if logical.right.kind != 132 || logical.right.right.kind != 283 { return 14 }

    members := lexer.parse_expression("pair.0.1", &storage)
    if lexer.expression_is_null(members) || members.kind != 260 { return 17 }
    if members.left.kind != 260 || members.right.kind != 2 { return 18 }
    if members.start != 0 || members.end != 8 { return 19 }

    unary := lexer.parse_expression("-(a + 2)", &storage)
    if lexer.expression_is_null(unary) || unary.kind != 295 { return 9 }
    if unary.left.kind != 43 { return 10 }

    invalid := lexer.parse_expression("1 + )", &storage)
    if !lexer.expression_is_null(invalid) { return 11 }
    unmatched := lexer.parse_expression("(1 + 2", &storage)
    if !lexer.expression_is_null(unmatched) { return 15 }
    adjacent := lexer.parse_expression("a b", &storage)
    if !lexer.expression_is_null(adjacent) { return 16 }
    incomplete_member := lexer.parse_expression("a.", &storage)
    if !lexer.expression_is_null(incomplete_member) { return 20 }
    indexed := lexer.parse_expression("items[1 + 2 * 3].value", &storage)
    if lexer.expression_is_null(indexed) || indexed.kind != 260 { return 21 }
    if indexed.left.kind != 261 || indexed.left.right.kind != 43 { return 22 }
    if indexed.left.right.right.kind != 42 { return 23 }
    if indexed.start != 0 || indexed.end != 21 { return 24 }
    empty_call := lexer.parse_expression("f()", &storage)
    if lexer.expression_is_null(empty_call) || empty_call.kind != 263 || !lexer.expression_is_null(empty_call.right) { return 27 }
    call := lexer.parse_expression("f(a + 1, g(2), c)", &storage)
    if lexer.expression_is_null(call) || call.kind != 263 { return 28 }
    if call.right.kind != 262 || call.right.left.kind != 262 || call.right.right.kind != 1 { return 29 }
    if call.right.left.right.kind != 263 { return 30 }
    three_arguments := lexer.parse_expression("f(a, b, c)", &storage)
    if lexer.expression_is_null(three_arguments) || three_arguments.right.kind != 262 { return 33 }
    if three_arguments.right.left.kind != 262 || three_arguments.right.left.left.kind != 1 || three_arguments.right.right.kind != 1 { return 34 }
    call_precedence := lexer.parse_expression("a + f(b) * c", &storage)
    if lexer.expression_is_null(call_precedence) || call_precedence.kind != 43 || call_precedence.right.kind != 42 { return 35 }
    if call_precedence.right.left.kind != 263 { return 36 }
    method_call := lexer.parse_expression("obj.method(3)", &storage)
    if lexer.expression_is_null(method_call) || method_call.kind != 263 || method_call.left.kind != 260 { return 31 }
    trailing_argument_comma := lexer.parse_expression("f(1,)", &storage)
    if !lexer.expression_is_null(trailing_argument_comma) { return 32 }
    leading_argument_comma := lexer.parse_expression("f(, 1)", &storage)
    if !lexer.expression_is_null(leading_argument_comma) { return 37 }
    repeated_argument_comma := lexer.parse_expression("f(1,,2)", &storage)
    if !lexer.expression_is_null(repeated_argument_comma) { return 38 }
    mismatched_call_delimiter := lexer.parse_expression("f(1]", &storage)
    if !lexer.expression_is_null(mismatched_call_delimiter) { return 39 }
    missing_index := lexer.parse_expression("items[]", &storage)
    if !lexer.expression_is_null(missing_index) { return 25 }
    unclosed_index := lexer.parse_expression("items[1", &storage)
    if !lexer.expression_is_null(unclosed_index) { return 26 }
    lexer.expression_arena_release(&storage)
    0
}
