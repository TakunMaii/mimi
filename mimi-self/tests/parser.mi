lexer :: @import("../src/lexer.mi")

main :: fn () i32 {
    storage := lexer.expression_arena_init()
    scalar_type := lexer.parse_type("i32", &storage)
    if lexer.expression_is_null(scalar_type) || scalar_type.kind != 270 || scalar_type.start != 0 || scalar_type.end != 3 { return 49 }
    pointer_type := lexer.parse_type("**MyType", &storage)
    if lexer.expression_is_null(pointer_type) || pointer_type.kind != 271 || pointer_type.left.kind != 271 || pointer_type.left.left.kind != 270 { return 50 }
    long_pointer_type := lexer.parse_type("**************Item", &storage)
    if lexer.expression_is_null(long_pointer_type) || long_pointer_type.kind != 271 { return 65 }
    slice_type := lexer.parse_type("[][]u8", &storage)
    if lexer.expression_is_null(slice_type) || slice_type.kind != 272 || slice_type.left.kind != 272 || slice_type.left.left.kind != 270 { return 51 }
    array_type := lexer.parse_type("[12]*Item", &storage)
    if lexer.expression_is_null(array_type) || array_type.kind != 273 || array_type.left.kind != 271 || array_type.right.kind != 2 { return 52 }
    if array_type.right.start != 1 || array_type.right.end != 3 { return 97 }
    invalid_type := lexer.parse_type("[]", &storage)
    if !lexer.expression_is_null(invalid_type) { return 53 }
    trailing_type := lexer.parse_type("i32 extra", &storage)
    if !lexer.expression_is_null(trailing_type) { return 54 }
    inferred_header := lexer.parse_binding_header("count := 1 + 2", &storage)
    if lexer.binding_header_is_null(inferred_header) || inferred_header.binding_kind != 0 { return 89 }
    if inferred_header.name_start != 0 || inferred_header.name_end != 5 || inferred_header.value_end != 14 { return 90 }
    typed_header := lexer.parse_binding_header("items : []*u8 = make()", &storage)
    if lexer.binding_header_is_null(typed_header) { return 91 }
    if typed_header.binding_kind != 1 { return 95 }
    if typed_header.type_start != 8 { return 96 }
    if typed_header.type_end != 14 { return typed_header.type_end as i32 }
    if typed_header.value_start != 15 { return typed_header.value_start as i32 }
    constant_header := lexer.parse_binding_header("answer :: 42", &storage)
    if lexer.binding_header_is_null(constant_header) || constant_header.binding_kind != 2 || constant_header.value_start != 9 { return 93 }
    missing_initializer := lexer.parse_binding_header("count :=", &storage)
    if !lexer.binding_header_is_null(missing_initializer) { return 94 }
    function_header := lexer.parse_function_header("work :: fn (x : i32, ptr : *u8) bool {", &storage)
    if lexer.function_header_is_null(function_header) || function_header.name_end != 4 { return 105 }
    if function_header.parameters_start != 12 || function_header.parameters_end != 30 { return 106 }
    if function_header.return_type_start != 32 || function_header.return_type_end != 36 || function_header.body_start != 38 { return 107 }
    parameters := lexer.parse_parameters("work :: fn (x : i32, ptr : *u8) bool {", function_header, &storage)
    if lexer.parameter_list_is_null(parameters) { return 111 }
    if parameters.name_start != 12 || parameters.name_end != 13 { return 115 }
    if parameters.data_type.kind != 270 || parameters.data_type.start != 16 || parameters.data_type.end != 19 { return 112 }
    if lexer.parameter_list_is_null(parameters.next) || parameters.next.name_start != 21 || parameters.next.data_type.kind != 271 { return 113 }
    if parameters.next.data_type.start != 27 { return 116 }
    if parameters.next.data_type.end != 30 { return 114 }
    tuple_node := lexer.parse_tuple_literal("(left, 2, \"x\",)", &storage)
    if lexer.expression_is_null(tuple_node) { return 117 }
    if tuple_node.kind != 268 { return tuple_node.kind as i32 }
    if tuple_node.left.kind != 262 { return tuple_node.left.kind as i32 }
    if tuple_node.left.left.kind != 1 { return tuple_node.left.left.kind as i32 }
    if tuple_node.left.right.kind != 262 { return tuple_node.left.right.kind as i32 }
    if tuple_node.left.right.left.kind != 2 { return tuple_node.left.right.left.kind as i32 }
    if tuple_node.left.right.right.kind != 3 { return tuple_node.left.right.right.kind as i32 }
    if tuple_node.start != 0 || tuple_node.end != 15 { return 119 }
    empty_tuple_node := lexer.parse_tuple_literal("()", &storage)
    if !lexer.expression_is_null(empty_tuple_node) { return 120 }
    non_tuple_group := lexer.parse_tuple_literal("(value)", &storage)
    if !lexer.expression_is_null(non_tuple_group) { return 121 }
    malformed_function := lexer.parse_function_header("work :: fn (x : i32 bool {", &storage)
    if !lexer.function_header_is_null(malformed_function) { return 108 }
    callback_header := lexer.parse_function_header("visit :: fn (callback : fn (i32) bool) []u8 {", &storage)
    if lexer.function_header_is_null(callback_header) || callback_header.parameters_end != 37 { return 109 }
    if callback_header.return_type_start != 39 || callback_header.return_type_end != 43 { return 110 }
    atom := lexer.parse_expression("1", &storage)
    if lexer.expression_is_null(atom) { return 1 }
    if atom.kind != 2 { return atom.kind as i32 }
    if atom.start != 0 { return 12 }
    if atom.end != 1 { return atom.end as i32 }
    string_atom := lexer.parse_expression("\"text\"", &storage)
    if lexer.expression_is_null(string_atom) || string_atom.kind != 3 || string_atom.start != 0 || string_atom.end != 6 { return 86 }
    if string_atom.payload_start != 0 || string_atom.payload_end != 6 { return 98 }
    raw_string := lexer.expression_payload("\"a\\nb\"", lexer.parse_expression("\"a\\nb\"", &storage))
    if raw_string.len != 6 || raw_string[2] != 92 || raw_string[3] != 110 { return 103 }
    true_atom := lexer.parse_expression("true", &storage)
    if lexer.expression_is_null(true_atom) || true_atom.kind != 4 || true_atom.end != 4 { return 87 }
    false_atom := lexer.parse_expression("false", &storage)
    if lexer.expression_is_null(false_atom) || false_atom.kind != 5 || false_atom.end != 5 { return 88 }
    expression := lexer.parse_expression("1 + 2 * 3", &storage)
    if lexer.expression_is_null(expression) { return 2 }
    if lexer.expression_payload("1 + 2 * 3", expression).len != 0 { return 104 }
    if expression.kind != 43 || expression.start != 0 || expression.end != 9 { return 2 }
    if expression.left.kind != 2 || expression.right.kind != 42 { return 3 }
    if expression.right.left.kind != 2 || expression.right.right.kind != 2 { return 4 }

    grouped := lexer.parse_expression("(1 + 2) * 3", &storage)
    if lexer.expression_is_null(grouped) || grouped.kind != 42 { return 5 }
    if grouped.left.kind != 43 || grouped.left.start != 0 || grouped.left.end != 7 { return 6 }

    associative := lexer.parse_expression("a - b - c", &storage)
    if lexer.expression_is_null(associative) || associative.kind != 45 { return 7 }
    if associative.left.kind != 45 || associative.right.kind != 1 { return 8 }

    logical := lexer.parse_expression("a || b && !c", &storage)
    if lexer.expression_is_null(logical) || logical.kind != 133 { return 13 }
    if logical.right.kind != 132 || logical.right.right.kind != 283 { return 14 }

    members := lexer.parse_expression("pair.0.1", &storage)
    if lexer.expression_is_null(members) || members.kind != 260 { return 17 }
    if members.left.kind != 260 || members.right.kind != 2 { return 18 }
    if members.start != 0 || members.end != 8 { return 19 }

    unary := lexer.parse_expression("-(a + 2)", &storage)
    if lexer.expression_is_null(unary) || unary.kind != 295 { return 9 }
    if unary.left.kind != 43 { return 10 }
    pointer_unary := lexer.parse_expression("&*ptr", &storage)
    if lexer.expression_is_null(pointer_unary) || pointer_unary.kind != 288 || pointer_unary.left.kind != 292 { return 66 }
    mixed_pointer := lexer.parse_expression("*ptr + left * right", &storage)
    if lexer.expression_is_null(mixed_pointer) || mixed_pointer.kind != 43 || mixed_pointer.left.kind != 292 || mixed_pointer.right.kind != 42 { return 67 }

    invalid := lexer.parse_expression("1 + )", &storage)
    if !lexer.expression_is_null(invalid) { return 11 }
    unmatched := lexer.parse_expression("(1 + 2", &storage)
    if !lexer.expression_is_null(unmatched) { return 15 }
    adjacent := lexer.parse_expression("a b", &storage)
    if !lexer.expression_is_null(adjacent) { return 16 }
    incomplete_member := lexer.parse_expression("a.", &storage)
    if !lexer.expression_is_null(incomplete_member) { return 20 }
    indexed := lexer.parse_expression("items[1 + 2 * 3].value", &storage)
    if lexer.expression_is_null(indexed) || indexed.kind != 260 { return 21 }
    if indexed.left.kind != 261 || indexed.left.right.kind != 43 { return 22 }
    if indexed.left.right.right.kind != 42 { return 23 }
    if indexed.start != 0 || indexed.end != 21 { return 24 }
    empty_call := lexer.parse_expression("f()", &storage)
    if lexer.expression_is_null(empty_call) || empty_call.kind != 263 || !lexer.expression_is_null(empty_call.right) { return 27 }
    call := lexer.parse_expression("f(a + 1, g(2), c)", &storage)
    if lexer.expression_is_null(call) || call.kind != 263 { return 28 }
    if call.right.kind != 262 || call.right.left.kind != 262 || call.right.right.kind != 1 { return 29 }
    if call.right.left.right.kind != 263 { return 30 }
    three_arguments := lexer.parse_expression("f(a, b, c)", &storage)
    if lexer.expression_is_null(three_arguments) || three_arguments.right.kind != 262 { return 33 }
    if three_arguments.right.left.kind != 262 || three_arguments.right.left.left.kind != 1 || three_arguments.right.right.kind != 1 { return 34 }
    call_precedence := lexer.parse_expression("a + f(b) * c", &storage)
    if lexer.expression_is_null(call_precedence) || call_precedence.kind != 43 || call_precedence.right.kind != 42 { return 35 }
    if call_precedence.right.left.kind != 263 { return 36 }
    method_call := lexer.parse_expression("obj.method(3)", &storage)
    if lexer.expression_is_null(method_call) || method_call.kind != 263 || method_call.left.kind != 260 { return 31 }
    trailing_argument_comma := lexer.parse_expression("f(1,)", &storage)
    if !lexer.expression_is_null(trailing_argument_comma) { return 32 }
    leading_argument_comma := lexer.parse_expression("f(, 1)", &storage)
    if !lexer.expression_is_null(leading_argument_comma) { return 37 }
    repeated_argument_comma := lexer.parse_expression("f(1,,2)", &storage)
    if !lexer.expression_is_null(repeated_argument_comma) { return 38 }
    mismatched_call_delimiter := lexer.parse_expression("f(1]", &storage)
    if !lexer.expression_is_null(mismatched_call_delimiter) { return 39 }
    bounded_slice := lexer.parse_expression("items[1 + 2:limit * 2]", &storage)
    if lexer.expression_is_null(bounded_slice) || bounded_slice.kind != 264 { return 40 }
    if bounded_slice.right.kind != 265 || bounded_slice.right.left.kind != 43 || bounded_slice.right.right.kind != 42 { return 41 }
    range_slice := lexer.parse_expression("items[2..5]", &storage)
    if lexer.expression_is_null(range_slice) || range_slice.kind != 264 || range_slice.right.left.kind != 2 || range_slice.right.right.kind != 2 { return 42 }
    open_slices := lexer.parse_expression("items[..5]", &storage)
    if lexer.expression_is_null(open_slices) || !lexer.expression_is_null(open_slices.right.left) || open_slices.right.right.kind != 2 { return 43 }
    open_slices = lexer.parse_expression("items[2:]", &storage)
    if lexer.expression_is_null(open_slices) || open_slices.right.left.kind != 2 || !lexer.expression_is_null(open_slices.right.right) { return 44 }
    open_slices = lexer.parse_expression("items[..]", &storage)
    if lexer.expression_is_null(open_slices) || !lexer.expression_is_null(open_slices.right.left) || !lexer.expression_is_null(open_slices.right.right) { return 45 }
    chained_slice := lexer.parse_expression("items[1..4][0]", &storage)
    if lexer.expression_is_null(chained_slice) || chained_slice.kind != 261 || chained_slice.left.kind != 264 { return 46 }
    empty_index := lexer.parse_expression("items[]", &storage)
    if !lexer.expression_is_null(empty_index) { return 47 }
    duplicate_slice_separator := lexer.parse_expression("items[1:2:3]", &storage)
    if !lexer.expression_is_null(duplicate_slice_separator) { return 48 }
    missing_index := lexer.parse_expression("items[]", &storage)
    if !lexer.expression_is_null(missing_index) { return 25 }
    unclosed_index := lexer.parse_expression("items[1", &storage)
    if !lexer.expression_is_null(unclosed_index) { return 26 }
    lexer.expression_arena_release(&storage)
    0
}
