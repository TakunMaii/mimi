    if lexer.statement_node_is_null(return_void_statement) || !lexer.expression_is_null(return_void_statement.value) { return 178 }
    break_statement := lexer.parse_transfer_statement("break", &storage)
    if lexer.statement_node_is_null(break_statement) || break_statement.kind != 281 || break_statement.end != 5 { return 179 }
    continue_statement := lexer.parse_transfer_statement("continue", &storage)
    if lexer.statement_node_is_null(continue_statement) || continue_statement.kind != 282 || continue_statement.end != 8 { return 180 }
    invalid_break := lexer.parse_transfer_statement("break 1", &storage)
    if !lexer.statement_node_is_null(invalid_break) { return 181 }
    defer_statement := lexer.parse_defer_statement("defer cleanup()", &storage)
    if lexer.statement_node_is_null(defer_statement) || defer_statement.kind != 283 || defer_statement.value.kind != 263 { return 182 }
    if defer_statement.start != 0 || defer_statement.end != 15 || defer_statement.value.start != 6 { return 183 }
    empty_defer := lexer.parse_defer_statement("defer", &storage)
    if !lexer.statement_node_is_null(empty_defer) { return 184 }
    assignment_statement := lexer.parse_assignment_statement("value = value + 1", &storage)
    if lexer.statement_node_is_null(assignment_statement) || assignment_statement.kind != 284 { return 192 }
    if assignment_statement.value.kind != 284 || assignment_statement.value.left.kind != 1 || assignment_statement.value.right.kind != 43 { return 193 }
    if assignment_statement.start != 0 || assignment_statement.end != 17 || assignment_statement.value.right.start != 8 { return 194 }
    equality_is_not_assignment := lexer.parse_assignment_statement("left == right", &storage)
    if !lexer.statement_node_is_null(equality_is_not_assignment) { return 195 }
    malformed_assignment := lexer.parse_assignment_statement("value =", &storage)
    if !lexer.statement_node_is_null(malformed_assignment) { return 196 }
    tuple_binding := lexer.parse_tuple_binding("first, second := (1, true)", &storage)
    if lexer.tuple_binding_is_null(tuple_binding) || tuple_binding.name_count != 2 || tuple_binding.value.kind != 268 { return 185 }
    if tuple_binding.names.start != 0 || tuple_binding.names.end != 5 { return 186 }
    if tuple_binding.names.next.start != 7 || tuple_binding.names.next.end != 13 { return 187 }
    if tuple_binding.start != 0 || tuple_binding.end != 26 || tuple_binding.value.start != 17 { return 188 }
    one_name_binding := lexer.parse_tuple_binding("first := (1, true)", &storage)
    if !lexer.tuple_binding_is_null(one_name_binding) { return 189 }
    repeated_name_separator := lexer.parse_tuple_binding("first,,second := (1, true)", &storage)
    if !lexer.tuple_binding_is_null(repeated_name_separator) { return 190 }
    non_tuple_binding := lexer.parse_tuple_binding("first, second := value", &storage)
    if !lexer.tuple_binding_is_null(non_tuple_binding) { return 191 }
    lexer.expression_arena_release(&storage)
    0
}
