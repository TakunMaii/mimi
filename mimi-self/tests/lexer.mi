lexer :: @import("../src/lexer.mi")

main :: fn () i32 {
    first := lexer.next_token("abc + 12", 0)
    if first.0 != 1 || first.1 != 0 || first.2 != 3 { return 11 }
    second := lexer.next_token("abc + 12", first.2)
    if second.0 != 43 || second.1 != 4 || second.2 != 5 { return 12 }
    third := lexer.next_token("abc + 12", second.2)
    if third.0 != 2 || third.1 != 6 || third.2 != 8 { return 13 }
    if lexer.next_token("abc + 12", third.2).0 != 0 { return 14 }
    if lexer.next_token("fn true f8 if", 0).0 != 160 { return 15 }
    if lexer.next_token("fn true f8 if", 2).0 != 4 { return 16 }
    if lexer.next_token("fn true f8 if", 7).0 != 5 { return 17 }
    if lexer.next_token("fn true f8 if", 10).0 != 164 { return 18 }
    if lexer.next_token("== != <= >= && || => ..", 0).0 != 128 { return 19 }
    if lexer.next_token("== != <= >= && || => ..", 2).0 != 129 { return 20 }
    if lexer.next_token("== != <= >= && || => ..", 5).0 != 130 { return 21 }
    if lexer.next_token("== != <= >= && || => ..", 8).0 != 131 { return 22 }
    if lexer.next_token("== != <= >= && || => ..", 11).0 != 132 { return 23 }
    if lexer.next_token("== != <= >= && || => ..", 14).0 != 133 { return 24 }
    if lexer.next_token("== != <= >= && || => ..", 17).0 != 134 { return 25 }
    if lexer.next_token("== != <= >= && || => ..", 20).0 != 135 { return 26 }
    if lexer.next_token("struct", 0).0 != 161 { return 27 }
    if lexer.next_token("enum", 0).0 != 162 { return 28 }
    if lexer.next_token("match", 0).0 != 163 { return 29 }
    if lexer.next_token("else", 0).0 != 165 { return 30 }
    if lexer.next_token("pub", 0).0 != 166 { return 31 }
    if lexer.next_token("extern", 0).0 != 167 { return 32 }
    if lexer.next_token("do", 0).0 != 168 { return 33 }
    if lexer.next_token("while", 0).0 != 169 { return 34 }
    if lexer.next_token("for", 0).0 != 170 { return 35 }
    if lexer.next_token("loop", 0).0 != 171 { return 36 }
    if lexer.next_token("defer", 0).0 != 172 { return 37 }
    if lexer.next_token("in", 0).0 != 173 { return 38 }
    if lexer.next_token("as", 0).0 != 174 { return 39 }
    if lexer.next_token("return", 0).0 != 175 { return 40 }
    if lexer.next_token("break", 0).0 != 176 { return 41 }
    if lexer.next_token("continue", 0).0 != 177 { return 42 }
    unicode_name := lexer.next_token("变量", 0)
    if unicode_name.0 != 1 || unicode_name.1 != 0 || unicode_name.2 != 6 { return 43 }
    escaped := lexer.next_token("\"a\\nb\"", 0)
    if escaped.0 != 3 || lexer.decoded_string_len("\"a\\nb\"", escaped.1, escaped.2) != 3 { return 44 }
    if lexer.decoded_string_byte("\"a\\nb\"", escaped.1, escaped.2, 0) != 97 { return 45 }
    if lexer.decoded_string_byte("\"a\\nb\"", escaped.1, escaped.2, 1) != 10 { return 46 }
    if lexer.decoded_string_byte("\"a\\nb\"", escaped.1, escaped.2, 2) != 98 { return 47 }
    if lexer.next_token([240, 128, 128, 128], 0).0 != 255 { return 48 }
    if lexer.token_count("") != 0 { return 1 }
    if lexer.token_count("alpha_2 := 123") != 4 { return 2 }
    if lexer.token_count("f :: fn (x : i32) bool { x >= 1 && x != 2 }") != 19 { return 3 }
    if lexer.token_count("items[1..4] // ignored tokens\n") != 6 { return 4 }
    if lexer.token_count("/* comment */ value = \"a\\\"b\"") != 3 { return 5 }
    if lexer.token_count("unterminated /* comment") != -1 { return 6 }
    if lexer.token_count("\"unterminated") != -1 { return 7 }
    if lexer.token_count("a | b") != -1 { return 8 }
    if lexer.token_count("ratio := 1.") != 4 { return 9 }
    if lexer.token_count("\"bad\\q\"") != -1 { return 10 }
    if lexer.error_code("a | b", 2) != 1 { return 49 }
    if lexer.error_code("/* unfinished", 12) != 2 { return 50 }
    if lexer.error_code("\"unfinished", 11) != 3 { return 51 }
    if lexer.error_code("\"bad\\q\"", 4) != 4 { return 52 }
    if lexer.error_code([240, 128, 128, 128], 0) != 5 { return 53 }
    if lexer.error_message("\"bad\\q\"", 4)[0] != 105 { return 54 }
    0
}
