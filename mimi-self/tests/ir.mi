ir :: @import("../src/lexer.mi")

issue_code :: fn (source : []u8) u64 {
    storage := ir.init()
    lowered := ir.lower_text(source, &storage)
    result := lowered.issue.code
    ir.release(&storage)
    result
}

check_issue :: fn (source : []u8, expected : u64) bool {
    issue_code(source) == expected
}

main :: fn () i32 {
    source := "main :: fn () i32 { value := 6 * 7 return value }"
    storage := ir.init()
    lowered := ir.lower_text(source, &storage)
    if lowered.issue.code != 0 || ir.module_is_null(lowered.module) { return 2 }
    if lowered.module.function_count != 1 { return 3 }
    function := lowered.module.functions
    if function.return_tag != 1 || ir.statement_is_null(function.body) { return 4 }
    if function.owner.id != 0 || function.source.len != source.len { return 36 }
    binding := function.body
    if binding.kind != 285 || binding.value.kind != 42 || binding.value.type_tag != 1 { return 5 }
    if ir.statement_is_null(binding.next) || binding.next.kind != 280 || binding.next.value.kind != 1 { return 6 }
    if binding.next.value.type_tag != 1 || !ir.statement_is_null(binding.next.next) { return 7 }
    output := ir.c_buffer_init()
    if !ir.emit_c(source, lowered.module, &output) || output.len < 60 || output.data[0] != 35 { return 18 }
    ir.c_buffer_release(&output)
    ir.release(&storage)
    if !check_issue("main :: fn () i32 { true + 1 }", 3) { return 8 }
    if !check_issue("main :: fn () i32 { missing }", 2) { return 9 }
    if !check_issue("main :: fn () i32 { if true { return 1 } }", 3) { return 10 }
    if !check_issue("main :: fn (value : i32) i32 { value }", 6) { return 11 }
    if !check_issue("main :: fn () f64 { 1.5 as f64 }", 0) { return 12 }
    if !check_issue("main :: fn () bool { true && false }", 0) { return 13 }
    if !check_issue("first :: fn () i32 { 1 } second :: fn () i32 { 2 }", 0) { return 14 }
    if !check_issue("main :: fn () i32 { true }", 3) { return 15 }
    if !check_issue("main :: fn () i32 { value : bool = 3 value }", 3) { return 16 }
    if !check_issue("main :: fn () i32 { value := 1 }", 3) { return 17 }
    if !check_issue("main :: fn () i32 { true as i32 }", 3) { return 19 }
    if !check_issue("add :: fn (left : i32, right : i32) i32 { left + right } main :: fn () i32 { add(20, 22) }", 0) { return 20 }
    call_source := "add :: fn (left : i32, right : i32) i32 { left + right } main :: fn () i32 { add(20, 22) }"
    call_storage := ir.init()
    call_module := ir.lower_text(call_source, &call_storage)
    if call_module.issue.code != 0 || call_module.module.functions.next.body.value.callee != call_module.module.functions { return 37 }
    ir.release(&call_storage)
    forward := "main :: fn () i32 { add(20, 22) } add :: fn (left : i32, right : i32) i32 { left + right }"
    syntax := ir.expression_arena_init()
    parsed := ir.parse_module(forward, &syntax)
    if ir.module_node_is_null(parsed) { return 60 }
    call := parsed.declarations.function.body.statements.value
    if call.kind != 263 || call.left.kind != 1 { return 61 }
    if forward[call.left.payload_start] != 97 || forward[call.left.payload_end - 1] != 100 { return 62 }
    second := parsed.declarations.next
    if forward[second.name_start] != 97 || forward[second.name_end - 1] != 100 { return 63 }
    if forward[second.function.name_start] != 97 || forward[second.function.name_end - 1] != 100 { return 64 }
    ir.expression_arena_release(&syntax)
    if !check_issue(forward, 0) { return 21 }
    if !check_issue("add :: fn (left : i32, right : i32) i32 { left + right } main :: fn () i32 { add(20) }", 3) { return 22 }
    if !check_issue("add :: fn (left : i32, right : i32) i32 { left + right } main :: fn () i32 { add(true, 22) }", 3) { return 23 }
    if !check_issue("main :: fn () i32 { value := 0 while value < 3 { value = value + 1 } value }", 0) { return 24 }
    if !check_issue("main :: fn () i32 { if true { return 42 } else { return 0 } }", 3) { return 25 }
    if !check_issue("main :: fn () i32 { if true { return 42 } else { return 0 } 0 }", 0) { return 29 }
    if !check_issue("main :: fn () i32 { value := 0 do { value = value + 1 } while value < 3 value }", 0) { return 26 }
    if !check_issue("main :: fn () i32 { break }", 5) { return 27 }
    if !check_issue("main :: fn () i32 { if 1 { return 42 } return 0 }", 3) { return 28 }
    if !check_issue("main :: fn () i32 { total := 0 for index in 2..7 { total = total + index } total }", 0) { return 30 }
    if !check_issue("main :: fn () i32 { for index in true..3 { index } 0 }", 3) { return 31 }
    if !check_issue("main :: fn () i32 { for index in 0..3 { index = 2 } 0 }", 7) { return 32 }
    if !check_issue("main :: fn () i32 { result := if true { 42 } else { 0 } result }", 0) { return 33 }
    if !check_issue("main :: fn () i32 { result := if 1 { 42 } else { 0 } result }", 3) { return 34 }
    if !check_issue("extern labs : fn(value : i64) i64 main :: fn () i32 { labs(-42) as i32 }", 0) { return 35 }
    if !check_issue("math :: @import(\"math.mi\") main :: fn () i32 { 0 }", 6) { return 38 }
    if !check_issue("extern malloc : fn(size : u64) *u8 extern free : fn(pointer : *u8) void main :: fn () i32 { memory := malloc(8) free(memory) 0 }", 0) { return 39 }
    if !check_issue("main :: fn () i32 { pointer := 0 as *u8 0 }", 3) { return 40 }
    if !check_issue("main :: fn () i32 { text : []u8 = \"hello\" text.len as i32 }", 0) { return 41 }
    if !check_issue("main :: fn (argc : i32, argv : **u8) i32 { argc }", 0) { return 42 }
    if !check_issue("main :: fn (argc : i64, argv : **u8) i32 { argc as i32 }", 6) { return 43 }
    if !check_issue("main :: fn (argc : i32, argv : **u8) i32 { argv[1][0] as i32 }", 0) { return 44 }
    if !check_issue("extern mimi_slice_from_raw : fn(data : *u8, length : u64, output : *[]u8) void main :: fn () i32 { text := \"xy\" copied : []u8 = \"\" mimi_slice_from_raw(text.ptr, text.len, &copied) copied[1] as i32 }", 0) { return 45 }
    struct_storage := ir.init()
    struct_source := "Point :: struct { x : i32 } read :: fn (point : *Point) i32 { point.x } main :: fn () i32 { point := Point { x = 42 } read(&point) }"
    struct_lowered := ir.lower_text(struct_source, &struct_storage)
    if struct_lowered.issue.code != 0 || struct_lowered.module.type_count != 1 { return 46 }
    if struct_lowered.module.types.syntax.field_count != 1 || struct_lowered.module.functions.owner.types != struct_lowered.module.types { return 47 }
    if struct_lowered.module.functions.parameters.type_tag != 1000000 { return 48 }
    if struct_lowered.module.functions.next.body.value.type_tag != 1000 { return 49 }
    struct_output := ir.c_buffer_init()
    if !ir.emit_c(struct_source, struct_lowered.module, &struct_output) { return 50 }
    ir.c_buffer_release(&struct_output)
    ir.release(&struct_storage)
    0
}
