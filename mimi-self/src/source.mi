bytes :: @import("bytes.mi")
maps :: @import("map.mi")
arena_api :: @import("arena.mi")
lexer :: @import("lexer.mi")
path_api :: @import("path.mi")
extern mimi_diagnostic_print : fn(code : *u8, code_length : u64, message : *u8, message_length : u64, path : *u8, path_length : u64, source : *u8, source_length : u64, start : u64, end : u64) void
extern mimi_buffer_empty : fn() *void
extern mimi_slice_from_raw : fn(data : *u8, length : u64, output : *[]u8) void

ModulePath :: struct {
    data : *u8,
    length : u64,
    next : *ModulePath,
    cursor : u64,
    record : *ModuleFile,
    alias_start : u64,
    alias_end : u64,
    alias_at : u64,
}

pub SourceFile :: struct {
    path : []u8,
    contents : bytes.ByteBuffer,
}

pub Span :: struct {
    start : u64,
    end : u64,
}

pub Diagnostic :: struct {
    code : []u8,
    message : []u8,
    span : Span,
}

pub ModuleGraph :: struct {
    states : maps.StringMap,
    files : *ModuleFile,
    last_file : *ModuleFile,
    file_count : u64,
    storage : arena_api.Arena,
    ast_storage : lexer.ExpressionArena,
}

pub ModuleFile :: struct {
    path : *u8,
    path_length : u64,
    contents : *u8,
    contents_length : u64,
    next : *ModuleFile,
    imports : *ModuleImport,
    last_import : *ModuleImport,
    import_count : u64,
    module : *lexer.ModuleNode,
}

pub ModuleImport :: struct {
    alias : *u8,
    alias_length : u64,
    path : *u8,
    path_length : u64,
    next : *ModuleImport,
}

pub ModuleFunction :: struct {
    file : *ModuleFile,
    function : *lexer.FunctionNode,
}

pub ModuleSymbol :: struct {
    file : *ModuleFile,
    declaration : *lexer.ModuleDeclarationNode,
}

pub module_graph_init :: fn () ModuleGraph {
    empty := mimi_buffer_empty() as *ModuleFile
    ModuleGraph { states = maps.init(), files = empty, last_file = empty, file_count = 0, storage = arena_api.init(), ast_storage = lexer.expression_arena_init() }
}

pub module_begin :: fn (graph : *ModuleGraph, path : []u8) bool {
    states := graph.states
    value : u64 = 0
    if maps.get(&states, path, &value) { return false }
    if !maps.set(&states, path, 1) { return false }
    graph.states = states
    true
}

pub module_finish :: fn (graph : *ModuleGraph, path : []u8) bool {
    states := graph.states
    value : u64 = 0
    if !maps.get(&states, path, &value) || value != 1 { return false }
    if !maps.set(&states, path, 2) { return false }
    graph.states = states
    true
}

pub module_state :: fn (graph : *ModuleGraph, path : []u8, state : *u64) bool {
    states := graph.states
    maps.get(&states, path, state)
}

pub module_graph_release :: fn (graph : *ModuleGraph) void {
    states := graph.states
    maps.release(&states)
    graph.states = maps.init()
    file_storage := graph.storage
    arena_api.release(&file_storage)
    graph.storage = arena_api.init()
    ast_storage := graph.ast_storage
    lexer.expression_arena_release(&ast_storage)
    graph.ast_storage = lexer.expression_arena_init()
    graph.files = mimi_buffer_empty() as *ModuleFile
    graph.last_file = mimi_buffer_empty() as *ModuleFile
    graph.file_count = 0
}

pub module_file_is_null :: fn (file : *ModuleFile) bool {
    file == (mimi_buffer_empty() as *ModuleFile)
}

pub module_file_lookup :: fn (graph : *ModuleGraph, path : *u8, path_length : u64) *ModuleFile {
    file := graph.files
    while !module_file_is_null(file) {
        if file.path_length == path_length {
            same := true
            index : u64 = 0
            while index < path_length && same {
                if file.path[index] != path[index] { same = false }
                index = index + 1
            }
            if same { return file }
        }
        file = file.next
    }
    mimi_buffer_empty() as *ModuleFile
}

raw_name_equals :: fn (left : *u8, left_length : u64, right : *u8, right_length : u64) bool {
    if left_length != right_length { return false }
    index : u64 = 0
    while index < left_length {
        if left[index] != right[index] { return false }
        index = index + 1
    }
    true
}

pub module_public_lookup :: fn (graph : *ModuleGraph, importer : *ModuleFile, alias : []u8, name : []u8) ModuleSymbol {
    missing := ModuleSymbol { file = mimi_buffer_empty() as *ModuleFile, declaration = mimi_buffer_empty() as *lexer.ModuleDeclarationNode }
    if module_file_is_null(importer) { return missing }
    edge := importer.imports
    while edge != (mimi_buffer_empty() as *ModuleImport) {
        if raw_name_equals(edge.alias, edge.alias_length, alias.ptr, alias.len) {
            file := module_file_lookup(graph, edge.path, edge.path_length)
            if module_file_is_null(file) { return missing }
            if lexer.module_node_is_null(file.module) {
                text : []u8 = ""
                mimi_slice_from_raw(file.contents, file.contents_length, &text)
                ast_storage := graph.ast_storage
                file.module = lexer.parse_module(text, &ast_storage)
                graph.ast_storage = ast_storage
                if lexer.module_node_is_null(file.module) { return missing }
            }
            declaration := file.module.declarations
            while declaration != (mimi_buffer_empty() as *lexer.ModuleDeclarationNode) {
                if declaration.is_public {
                    start := declaration.name_start
                    ending := declaration.name_end
                    if source_range_equals(file.contents, start, ending, name) {
                        return ModuleSymbol { file = file, declaration = declaration }
                    }
                }
                declaration = declaration.next
            }
            return missing
        }
        edge = edge.next
    }
    missing
}

pub module_symbol_is_null :: fn (value : ModuleSymbol) bool {
    module_file_is_null(value.file) || value.declaration == (mimi_buffer_empty() as *lexer.ModuleDeclarationNode)
}

pub module_function_lookup :: fn (graph : *ModuleGraph, importer : *ModuleFile, alias : []u8, name : []u8) ModuleFunction {
    symbol := module_public_lookup(graph, importer, alias, name)
    if !module_symbol_is_null(symbol) && (symbol.declaration.kind == 1 || symbol.declaration.kind == 7) {
        return ModuleFunction { file = symbol.file, function = symbol.declaration.function }
    }
    ModuleFunction { file = mimi_buffer_empty() as *ModuleFile, function = mimi_buffer_empty() as *lexer.FunctionNode }
}

pub module_type_lookup :: fn (graph : *ModuleGraph, importer : *ModuleFile, alias : []u8, name : []u8) ModuleSymbol {
    symbol := module_public_lookup(graph, importer, alias, name)
    if !module_symbol_is_null(symbol) && (symbol.declaration.kind == 2 || symbol.declaration.kind == 3) { return symbol }
    ModuleSymbol { file = mimi_buffer_empty() as *ModuleFile, declaration = mimi_buffer_empty() as *lexer.ModuleDeclarationNode }
}

pub module_function_is_null :: fn (value : ModuleFunction) bool {
    module_file_is_null(value.file) || lexer.function_node_is_null(value.function)
}

store_module_file :: fn (storage : *arena_api.Arena, path : *u8, path_length : u64, contents : *u8, contents_length : u64) *ModuleFile {
    empty := mimi_buffer_empty() as *ModuleFile
    if !arena_api.allocate(storage, 72, 8) { return empty }
    record := arena_api.last_byte(storage) as *ModuleFile
    record.next = empty
    record.imports = mimi_buffer_empty() as *ModuleImport
    record.last_import = mimi_buffer_empty() as *ModuleImport
    record.import_count = 0
    record.module = mimi_buffer_empty() as *lexer.ModuleNode
    record.path_length = path_length
    record.contents_length = contents_length
    if !arena_api.allocate(storage, path_length, 1) { return empty }
    record.path = arena_api.last_byte(storage)
    index : u64 = 0
    while index < path_length {
        record.path[index] = path[index]
        index = index + 1
    }
    record.contents = mimi_buffer_empty() as *u8
    if contents_length != 0 {
        if !arena_api.allocate(storage, contents_length, 1) { return empty }
        record.contents = arena_api.last_byte(storage)
        index = 0
        while index < contents_length {
            record.contents[index] = contents[index]
            index = index + 1
        }
    }
    record
}

store_module_import :: fn (storage : *arena_api.Arena, source : *u8, alias_start : u64, alias_end : u64, path : *u8, path_length : u64) *ModuleImport {
    empty := mimi_buffer_empty() as *ModuleImport
    if alias_end <= alias_start || path_length == 0 || !arena_api.allocate(storage, 40, 8) { return empty }
    item := arena_api.last_byte(storage) as *ModuleImport
    item.alias_length = alias_end - alias_start
    item.path_length = path_length
    item.next = empty
    if !arena_api.allocate(storage, item.alias_length, 1) { return empty }
    item.alias = arena_api.last_byte(storage)
    index : u64 = 0
    while index < item.alias_length {
        item.alias[index] = source[alias_start + index]
        index = index + 1
    }
    if !arena_api.allocate(storage, path_length, 1) { return empty }
    item.path = arena_api.last_byte(storage)
    index = 0
    while index < path_length {
        item.path[index] = path[index]
        index = index + 1
    }
    item
}

pub load_graph :: fn (root : []u8, graph : *ModuleGraph) bool {
    storage := arena_api.init()
    canonical_root := bytes.init()
    if !path_api.canonicalize(root, &canonical_root) {
        bytes.release(&canonical_root)
        arena_api.release(&storage)
        return false
    }
    first := store_module_path(&storage, canonical_root.data, canonical_root.len)
    bytes.release(&canonical_root)
    if first == (mimi_buffer_empty() as *ModulePath) || !module_begin_raw(graph, first.data, first.length) {
        arena_api.release(&storage)
        return false
    }
    current := first
    valid := true
    while current != (mimi_buffer_empty() as *ModulePath) && valid {
        contents := bytes.init()
        if !bytes.read_file_raw(current.data, current.length, &contents) { valid = false } else {
            if current.cursor == 0 {
                file_storage := graph.storage
                record := store_module_file(&file_storage, current.data, current.length, contents.data, contents.len)
                graph.storage = file_storage
                if record == (mimi_buffer_empty() as *ModuleFile) { valid = false } else {
                    current.record = record
                    if graph.file_count == 0 { graph.files = record } else { graph.last_file.next = record }
                    graph.last_file = record
                    graph.file_count = graph.file_count + 1
                }
            }
            found_dependency := false
            while current.cursor < contents.len && valid && !found_dependency {
                token := lexer.next_token_raw(contents.data, contents.len, current.cursor)
                if token.0 == 255 { valid = false } else {
                    current.cursor = token.2
                    if token.0 == 1 {
                        colon1 := lexer.next_token_raw(contents.data, contents.len, token.2)
                        colon2 := lexer.next_token_raw(contents.data, contents.len, colon1.2)
                        at := lexer.next_token_raw(contents.data, contents.len, colon2.2)
                        if colon1.0 == 58 && colon2.0 == 58 && at.0 == 64 {
                            current.alias_start = token.1
                            current.alias_end = token.2
                            current.alias_at = at.1
                        }
                    }
                    if token.0 == 64 {
                        name := lexer.next_token_raw(contents.data, contents.len, current.cursor)
                        if name.0 == 1 && source_range_equals(contents.data, name.1, name.2, "import") {
                            if current.alias_at != token.1 { valid = false }
                            open := lexer.next_token_raw(contents.data, contents.len, name.2)
                            literal := lexer.next_token_raw(contents.data, contents.len, open.2)
                            close := lexer.next_token_raw(contents.data, contents.len, literal.2)
                            if open.0 != 40 || literal.0 != 3 || close.0 != 41 {
                                valid = false
                            } else {
                                current.cursor = close.2
                                import_path := bytes.init()
                                decoded_length := lexer.decoded_string_len_raw(contents.data, literal.1, literal.2)
                                decoded_index : u64 = 0
                                while decoded_index < decoded_length && valid {
                                    if !bytes.push(&import_path, lexer.decoded_string_byte_raw(contents.data, literal.1, literal.2, decoded_index)) { valid = false }
                                    decoded_index = decoded_index + 1
                                }
                                resolved_path := bytes.init()
                                if valid && import_path.len != 0 && import_path.data[0] != 47 {
                                    directory_length := module_directory_length(current.data, current.length)
                                    if !path_api.join_raw(current.data, directory_length, import_path.data, import_path.len, &resolved_path) { valid = false }
                                } else {
                                    resolved_path = import_path
                                    import_path = bytes.init()
                                }
                                canonical_path := bytes.init()
                                if valid && !path_api.canonicalize_raw(resolved_path.data, resolved_path.len, &canonical_path) { valid = false }
                                if valid {
                                    file_storage := graph.storage
                                    edge := store_module_import(&file_storage, contents.data, current.alias_start, current.alias_end, canonical_path.data, canonical_path.len)
                                    graph.storage = file_storage
                                    if edge == (mimi_buffer_empty() as *ModuleImport) { valid = false } else {
                                        if current.record.imports == (mimi_buffer_empty() as *ModuleImport) { current.record.imports = edge } else { current.record.last_import.next = edge }
                                        current.record.last_import = edge
                                        current.record.import_count = current.record.import_count + 1
                                    }
                                }
                                if valid {
                                    state : u64 = 0
                                    if module_state_raw(graph, canonical_path.data, canonical_path.len, &state) {
                                        if state == 1 { valid = false }
                                    } else {
                                        dependency := store_module_path(&storage, canonical_path.data, canonical_path.len)
                                        if dependency == (mimi_buffer_empty() as *ModulePath) || !module_begin_raw(graph, dependency.data, dependency.length) { valid = false } else {
                                            dependency.next = current
                                            current = dependency
                                            found_dependency = true
                                        }
                                    }
                                }
                                bytes.release(&canonical_path)
                                bytes.release(&resolved_path)
                                bytes.release(&import_path)
                            }
                        }
                    }
                }
            }
            bytes.release(&contents)
            if valid && !found_dependency {
                if !module_finish_raw(graph, current.data, current.length) { valid = false } else {
                    current = current.next
                }
            }
        }
    }
    arena_api.release(&storage)
    valid
}

pub module_directory_length :: fn (path : *u8, path_length : u64) u64 {
    directory_length : u64 = 0
    index : u64 = 0
    while index < path_length {
        if path[index] == 47 { directory_length = index }
        index = index + 1
    }
    if directory_length == 0 && path_length != 0 && path[0] == 47 { return 1 }
    directory_length
}

store_module_path :: fn (storage : *arena_api.Arena, path : *u8, path_length : u64) *ModulePath {
    if !arena_api.allocate(storage, 64, 8) { return mimi_buffer_empty() as *ModulePath }
    module_path := arena_api.last_byte(storage) as *ModulePath
    module_path.next = mimi_buffer_empty() as *ModulePath
    module_path.cursor = 0
    module_path.record = mimi_buffer_empty() as *ModuleFile
    module_path.alias_start = 0
    module_path.alias_end = 0
    module_path.alias_at = 0
    if !arena_api.allocate(storage, path_length, 1) { return mimi_buffer_empty() as *ModulePath }
    path_copy := arena_api.last_byte(storage)
    index : u64 = 0
    while index < path_length {
        path_copy[index] = path[index]
        index = index + 1
    }
    module_path.data = path_copy
    module_path.length = path_length
    module_path
}

module_begin_raw :: fn (graph : *ModuleGraph, path : *u8, path_length : u64) bool {
    states := graph.states
    value : u64 = 0
    if maps.get_raw(&states, path, path_length, &value) { return false }
    if !maps.set_raw(&states, path, path_length, 1) { return false }
    graph.states = states
    true
}

module_state_raw :: fn (graph : *ModuleGraph, path : *u8, path_length : u64, state : *u64) bool {
    states := graph.states
    maps.get_raw(&states, path, path_length, state)
}

module_finish_raw :: fn (graph : *ModuleGraph, path : *u8, path_length : u64) bool {
    states := graph.states
    value : u64 = 0
    if !maps.get_raw(&states, path, path_length, &value) || value != 1 { return false }
    if !maps.set_raw(&states, path, path_length, 2) { return false }
    graph.states = states
    true
}

source_range_equals :: fn (source : *u8, start : u64, end : u64, expected : []u8) bool {
    if end - start != expected.len { return false }
    index : u64 = 0
    while index < expected.len {
        if source[start + index] != expected[index] { return false }
        index = index + 1
    }
    true
}


pub init :: fn () SourceFile {
    SourceFile { path = "", contents = bytes.init() }
}

pub load :: fn (path : []u8, source : *SourceFile) bool {
    source.path = path
    contents := bytes.init()
    if !bytes.read_file(path, &contents) {
        bytes.release(&contents)
        return false
    }
    source.contents = contents
    true
}

pub release :: fn (source : *SourceFile) void {
    contents := source.contents
    bytes.release(&contents)
    source.contents = contents
}

pub render :: fn (diagnostic : Diagnostic, source : *SourceFile) void {
    mimi_diagnostic_print(
        diagnostic.code.ptr,
        diagnostic.code.len,
        diagnostic.message.ptr,
        diagnostic.message.len,
        source.path.ptr,
        source.path.len,
        source.contents.data,
        source.contents.len,
        diagnostic.span.start,
        diagnostic.span.end
    )
}

pub analyze_text :: fn (text : []u8) Diagnostic {
    cursor : u64 = 0
    while cursor < text.len {
        token := lexer.lex_next(text, cursor)
        if token.kind == 255 {
            return Diagnostic {
                code = "E_LEX",
                message = lexer.error_message(text, token.start),
                span = Span { start = token.start, end = token.end },
            }
        }
        if token.kind == 0 { break }
        cursor = token.end
    }
    storage := lexer.expression_arena_init()
    parse_issue := lexer.ModuleParseIssue { start = 0, end = 0 }
    module := lexer.parse_module_with_issue(text, &storage, &parse_issue)
    if lexer.module_node_is_null(module) {
        lexer.expression_arena_release(&storage)
        return Diagnostic {
            code = "E_PARSE",
            message = "could not parse module",
            span = Span { start = parse_issue.start, end = parse_issue.end },
        }
    }
    issue := lexer.resolve_module_names(text, module, &storage)
    if issue.code == 0 { issue = lexer.check_module_tuple_types(text, module, &storage) }
    lexer.expression_arena_release(&storage)
    if issue.code == 0 {
        return Diagnostic { code = "", message = "", span = Span { start = 0, end = 0 } }
    }
    code : []u8 = "E_INTERNAL"
    if issue.code == 1 || issue.code == 2 { code = "E_NAME" }
    if issue.code >= 4 && issue.code <= 6 { code = "E_TYPE" }
    Diagnostic {
        code = code,
        message = lexer.name_issue_message(issue.code),
        span = Span { start = issue.start, end = issue.end },
    }
}
