    parameters_start : u64,
    parameters_end : u64,
    return_type_start : u64,
    return_type_end : u64,
    body_start : u64,
}

pub ParameterNode :: struct {
    name_start : u64,
    name_end : u64,
    data_type : *ExprNode,
    next : *ParameterNode,
}

ExprOperator :: struct {
    kind : u64,
    start : u64,
    base_count : u64,
    argument_count : u64,
}

ExpressionStacks :: struct {
    storage : *ExpressionArena,
    nodes : **ExprNode,
    operators : *ExprOperator,
    node_count : u64,
    operator_count : u64,
}

pub expression_arena_init :: fn () ExpressionArena {
    empty := mimi_arena_empty()
    ExpressionArena { head = empty, last = empty }
}

pub expression_arena_release :: fn (storage : *ExpressionArena) void {
    mimi_arena_release(storage)
}

pub expression_is_null :: fn (node : *ExprNode) bool {
    node == (mimi_buffer_empty() as *ExprNode)
}

pub expression_payload :: fn (source : []u8, node : *ExprNode) []u8 {
    if expression_is_null(node) || (node.kind != 1 && node.kind != 2 && node.kind != 3) { return "" }
    source[node.payload_start:node.payload_end]
}

pub binding_header_is_null :: fn (header : *BindingHeader) bool {
    header == (mimi_buffer_empty() as *BindingHeader)
}

pub parse_binding_header :: fn (source : []u8, storage : *ExpressionArena) *BindingHeader {
    name := next_token(source, 0)
    if name.0 != 1 { return mimi_buffer_empty() as *BindingHeader }
    colon := next_token(source, name.2)
    if colon.0 != 58 { return mimi_buffer_empty() as *BindingHeader }
    marker := next_token(source, colon.2)
    binding_kind : u64 = 0
    type_start : u64 = 0
    type_end : u64 = 0
    value_start : u64 = marker.2
    if marker.0 == 58 {
        binding_kind = 2
    } else {
        if marker.0 == 61 {
            binding_kind = 0
        } else {
            binding_kind = 1
            type_start = marker.1
            cursor := marker.1
            nesting : u64 = 0
            found_equal := false
            while cursor < source.len && !found_equal {
                token := next_token(source, cursor)
                if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *BindingHeader }
                cursor = token.2
                if token.0 == 91 { nesting = nesting + 1 } else {
                    if token.0 == 93 && nesting > 0 { nesting = nesting - 1 } else {
                        if token.0 == 61 && nesting == 0 {
                            type_end = token.1
                            value_start = token.2
                            found_equal = true
                        }
                    }
                }
            }
            if !found_equal || nesting != 0 { return mimi_buffer_empty() as *BindingHeader }
            parsed_type := parse_type(source[type_start:type_end], storage)
            if expression_is_null(parsed_type) { return mimi_buffer_empty() as *BindingHeader }
        }
    }
    if next_token(source, value_start).0 == 0 || next_token(source, value_start).0 == 255 {
        return mimi_buffer_empty() as *BindingHeader
    }
    if mimi_arena_allocate(storage, 72, 8) == 0 { return mimi_buffer_empty() as *BindingHeader }
    header := storage.last as *BindingHeader
    header.start = name.1
    header.end = source.len
    header.name_start = name.1
    header.name_end = name.2
    header.binding_kind = binding_kind
    header.type_start = type_start
    header.type_end = type_end
    header.value_start = value_start
    header.value_end = source.len
    header
}

pub binding_node_is_null :: fn (binding : *BindingNode) bool {
    binding == (mimi_buffer_empty() as *BindingNode)
}

pub parse_binding_declaration :: fn (source : []u8, storage : *ExpressionArena) *BindingNode {
    header := parse_binding_header(source, storage)
    if binding_header_is_null(header) { return mimi_buffer_empty() as *BindingNode }
    initializer := parse_expression(source[header.value_start:header.value_end], storage)
    if expression_is_null(initializer) { return mimi_buffer_empty() as *BindingNode }
    shift_expression_tree(initializer, header.value_start)
    data_type : *ExprNode = mimi_buffer_empty() as *ExprNode
    if header.binding_kind == 1 {
        data_type = parse_type(source[header.type_start:header.type_end], storage)
        if expression_is_null(data_type) { return mimi_buffer_empty() as *BindingNode }
        shift_expression_tree(data_type, header.type_start)
    }
    if mimi_arena_allocate(storage, 56, 8) == 0 { return mimi_buffer_empty() as *BindingNode }
    binding := storage.last as *BindingNode
    binding.start = header.start
    binding.end = initializer.end
    binding.name_start = header.name_start
    binding.name_end = header.name_end
    binding.binding_kind = header.binding_kind
    binding.data_type = data_type
    binding.initializer = initializer
    binding
}

pub statement_node_is_null :: fn (statement : *StatementNode) bool {
    statement == (mimi_buffer_empty() as *StatementNode)
}

pub parse_transfer_statement :: fn (source : []u8, storage : *ExpressionArena) *StatementNode {
    keyword := next_token(source, 0)
    kind : u64 = 0
    value : *ExprNode = mimi_buffer_empty() as *ExprNode
    if keyword.0 == 175 {
        kind = 280
        next := next_token(source, keyword.2)
        if next.0 != 0 {
            value = parse_expression(source[keyword.2:source.len], storage)
            if expression_is_null(value) { return mimi_buffer_empty() as *StatementNode }
            shift_expression_tree(value, keyword.2)
        }
    } else {
        if keyword.0 == 176 { kind = 281 } else {
            if keyword.0 == 177 { kind = 282 } else { return mimi_buffer_empty() as *StatementNode }
        }
        if next_token(source, keyword.2).0 != 0 { return mimi_buffer_empty() as *StatementNode }
    }
    if mimi_arena_allocate(storage, 104, 8) == 0 { return mimi_buffer_empty() as *StatementNode }
    statement := storage.last as *StatementNode
    statement.kind = kind
    statement.start = keyword.1
    statement.end = keyword.2
    if !expression_is_null(value) { statement.end = value.end }
    statement.value = value
    statement.next = mimi_buffer_empty() as *StatementNode
    statement.body = mimi_buffer_empty() as *BlockNode
    statement.binding = mimi_buffer_empty() as *BindingNode
    statement.if_statement = mimi_buffer_empty() as *IfNode
    statement.if_let = mimi_buffer_empty() as *IfLetNode
    statement.loop_statement = mimi_buffer_empty() as *LoopNode
    statement.for_loop = mimi_buffer_empty() as *ForNode
    statement.match_statement = mimi_buffer_empty() as *MatchNode
    statement.tuple_binding = mimi_buffer_empty() as *TupleBindingNode
    statement
}

pub parse_defer_statement :: fn (source : []u8, storage : *ExpressionArena) *StatementNode {
    keyword := next_token(source, 0)
    if keyword.0 != 172 { return mimi_buffer_empty() as *StatementNode }
    next := next_token(source, keyword.2)
    if next.0 == 0 { return mimi_buffer_empty() as *StatementNode }
    if next.0 == 123 {
        body := parse_block_span(source[next.1:source.len], next.1, storage)
        if block_node_is_null(body) || next_token(source, body.end).0 != 0 { return mimi_buffer_empty() as *StatementNode }
        if mimi_arena_allocate(storage, 104, 8) == 0 { return mimi_buffer_empty() as *StatementNode }
        statement := storage.last as *StatementNode
        statement.kind = 290
        statement.start = keyword.1
        statement.end = body.end
        statement.value = mimi_buffer_empty() as *ExprNode
        statement.next = mimi_buffer_empty() as *StatementNode
        statement.body = body
        statement.binding = mimi_buffer_empty() as *BindingNode
        statement.if_statement = mimi_buffer_empty() as *IfNode
        statement.if_let = mimi_buffer_empty() as *IfLetNode
        statement.loop_statement = mimi_buffer_empty() as *LoopNode
        statement.for_loop = mimi_buffer_empty() as *ForNode
        statement.match_statement = mimi_buffer_empty() as *MatchNode
        statement.tuple_binding = mimi_buffer_empty() as *TupleBindingNode
        return statement
    }
    value := parse_expression(source[keyword.2:source.len], storage)
    if expression_is_null(value) { return mimi_buffer_empty() as *StatementNode }
    shift_expression_tree(value, keyword.2)
    if mimi_arena_allocate(storage, 104, 8) == 0 { return mimi_buffer_empty() as *StatementNode }
    statement := storage.last as *StatementNode
    statement.kind = 283
    statement.start = keyword.1
    statement.end = source.len
    statement.value = value
    statement.next = mimi_buffer_empty() as *StatementNode
    statement.body = mimi_buffer_empty() as *BlockNode
    statement.binding = mimi_buffer_empty() as *BindingNode
    statement.if_statement = mimi_buffer_empty() as *IfNode
    statement.if_let = mimi_buffer_empty() as *IfLetNode
    statement.loop_statement = mimi_buffer_empty() as *LoopNode
    statement.for_loop = mimi_buffer_empty() as *ForNode
    statement.match_statement = mimi_buffer_empty() as *MatchNode
    statement.tuple_binding = mimi_buffer_empty() as *TupleBindingNode
    statement
}

pub parse_assignment_statement :: fn (source : []u8, storage : *ExpressionArena) *StatementNode {
    cursor : u64 = 0
    paren_depth : u64 = 0
    bracket_depth : u64 = 0
    equal_start : u64 = source.len
    equal_end : u64 = source.len
    while cursor < source.len {
        token := next_token(source, cursor)
        if token.0 == 0 { break }
        if token.0 == 255 { return mimi_buffer_empty() as *StatementNode }
        cursor = token.2
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 {
                if paren_depth == 0 { return mimi_buffer_empty() as *StatementNode }
                paren_depth = paren_depth - 1
            } else {
                if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                    if token.0 == 93 {
                        if bracket_depth == 0 { return mimi_buffer_empty() as *StatementNode }
                        bracket_depth = bracket_depth - 1
                    } else {
                        if token.0 == 61 && paren_depth == 0 && bracket_depth == 0 {
                            if equal_start != source.len { return mimi_buffer_empty() as *StatementNode }
                            equal_start = token.1
                            equal_end = token.2
                        }
                    }
                }
            }
        }
    }
    if equal_start == source.len || paren_depth != 0 || bracket_depth != 0 { return mimi_buffer_empty() as *StatementNode }
    target := parse_expression(source[0:equal_start], storage)
    if expression_is_null(target) { return mimi_buffer_empty() as *StatementNode }
    value := parse_expression(source[equal_end:source.len], storage)
    if expression_is_null(value) { return mimi_buffer_empty() as *StatementNode }
    shift_expression_tree(value, equal_end)
    assignment := allocate_expr(storage, 284, target.start, value.end, target, value)
    if expression_is_null(assignment) { return mimi_buffer_empty() as *StatementNode }
    if mimi_arena_allocate(storage, 104, 8) == 0 { return mimi_buffer_empty() as *StatementNode }
    statement := storage.last as *StatementNode
    statement.kind = 284
    statement.start = target.start
    statement.end = value.end
    statement.value = assignment
    statement.next = mimi_buffer_empty() as *StatementNode
    statement.body = mimi_buffer_empty() as *BlockNode
    statement.binding = mimi_buffer_empty() as *BindingNode
    statement.if_statement = mimi_buffer_empty() as *IfNode
    statement.if_let = mimi_buffer_empty() as *IfLetNode
    statement.loop_statement = mimi_buffer_empty() as *LoopNode
    statement.for_loop = mimi_buffer_empty() as *ForNode
    statement.match_statement = mimi_buffer_empty() as *MatchNode
    statement.tuple_binding = mimi_buffer_empty() as *TupleBindingNode
    statement
}

pub tuple_binding_is_null :: fn (binding : *TupleBindingNode) bool {
    binding == (mimi_buffer_empty() as *TupleBindingNode)
}

tuple_expression_item_count :: fn (items : *ExprNode) u64 {
    if expression_is_null(items) { return 0 }
    if items.kind == 262 { return tuple_expression_item_count(items.left) + 1 }
    1
}

pub parse_tuple_binding :: fn (source : []u8, storage : *ExpressionArena) *TupleBindingNode {
    cursor : u64 = 0
    names : *DestructureNameNode = mimi_buffer_empty() as *DestructureNameNode
    last : *DestructureNameNode = mimi_buffer_empty() as *DestructureNameNode
    count : u64 = 0
    value_start : u64 = 0
    while true {
        name := next_token(source, cursor)
        if name.0 != 1 { return mimi_buffer_empty() as *TupleBindingNode }
        previous := names
        duplicate := false
        while previous != (mimi_buffer_empty() as *DestructureNameNode) && !duplicate {
            if previous.end - previous.start == name.2 - name.1 {
                equal := true
                index : u64 = 0
                while index < name.2 - name.1 && equal {
                    if source[previous.start + index] != source[name.1 + index] { equal = false }
                    index = index + 1
                }
                if equal { duplicate = true }
            }
            previous = previous.next
        }
        if duplicate { return mimi_buffer_empty() as *TupleBindingNode }
        if mimi_arena_allocate(storage, 24, 8) == 0 { return mimi_buffer_empty() as *TupleBindingNode }
        item := storage.last as *DestructureNameNode
        item.start = name.1
        item.end = name.2
        item.next = mimi_buffer_empty() as *DestructureNameNode
        if last == (mimi_buffer_empty() as *DestructureNameNode) { names = item } else { last.next = item }
        last = item
        count = count + 1
        separator := next_token(source, name.2)
        if separator.0 == 44 {
            cursor = separator.2
        } else {
            if separator.0 != 58 { return mimi_buffer_empty() as *TupleBindingNode }
            equal := next_token(source, separator.2)
            if equal.0 != 61 { return mimi_buffer_empty() as *TupleBindingNode }
            value_start = equal.2
            break
        }
    }
    if count < 2 { return mimi_buffer_empty() as *TupleBindingNode }
    value := parse_tuple_literal(source[value_start:source.len], storage)
    if expression_is_null(value) { return mimi_buffer_empty() as *TupleBindingNode }
    if tuple_expression_item_count(value.left) != count { return mimi_buffer_empty() as *TupleBindingNode }
    shift_expression_tree(value, value_start)
    if mimi_arena_allocate(storage, 40, 8) == 0 { return mimi_buffer_empty() as *TupleBindingNode }
    binding := storage.last as *TupleBindingNode
    binding.start = names.start
    binding.end = value.end
    binding.name_count = count
    binding.names = names
    binding.value = value
    binding
}

pub function_header_is_null :: fn (header : *FunctionHeader) bool {
    header == (mimi_buffer_empty() as *FunctionHeader)
}

pub parse_function_header :: fn (source : []u8, storage : *ExpressionArena) *FunctionHeader {
    name := next_token(source, 0)
    if name.0 != 1 { return mimi_buffer_empty() as *FunctionHeader }
    colon1 := next_token(source, name.2)
    colon2 := next_token(source, colon1.2)
    function_keyword := next_token(source, colon2.2)
    open := next_token(source, function_keyword.2)
    if colon1.0 != 58 || colon2.0 != 58 || function_keyword.0 != 160 || open.0 != 40 {
        return mimi_buffer_empty() as *FunctionHeader
    }
    parameters_start := open.2
    cursor := open.2
    nesting : u64 = 1
    while cursor < source.len && nesting != 0 {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *FunctionHeader }
        cursor = token.2
        if token.0 == 40 { nesting = nesting + 1 } else {
            if token.0 == 41 { nesting = nesting - 1 }
        }
    }
    if nesting != 0 { return mimi_buffer_empty() as *FunctionHeader }
    parameters_end := cursor - 1
    return_type := next_token(source, cursor)
    return_type_start : u64 = return_type.1
    return_type_end : u64 = return_type.2
    body_open := return_type
    if return_type.0 != 123 {
        if return_type.0 == 0 || return_type.0 == 255 { return mimi_buffer_empty() as *FunctionHeader }
        type_end := return_type.2
        type_cursor := return_type.2
        while type_cursor < source.len {
            token := next_token(source, type_cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *FunctionHeader }
            if token.0 == 123 {
                body_open = token
                break
            }
            type_end = token.2
            type_cursor = token.2
        }
        if body_open.0 != 123 { return mimi_buffer_empty() as *FunctionHeader }
        return_type_end = type_end
        parsed_return_type := parse_type(source[return_type_start:return_type_end], storage)
        if expression_is_null(parsed_return_type) { return mimi_buffer_empty() as *FunctionHeader }
    } else {
        return_type_start = return_type.1
        return_type_end = return_type.1
    }
    if mimi_arena_allocate(storage, 72, 8) == 0 { return mimi_buffer_empty() as *FunctionHeader }
    header := storage.last as *FunctionHeader
    header.start = name.1
    header.end = body_open.2
    header.name_start = name.1
    header.name_end = name.2
    header.parameters_start = parameters_start
    header.parameters_end = parameters_end
    header.return_type_start = return_type_start
    header.return_type_end = return_type_end
    header.body_start = body_open.2
    header
}

pub block_node_is_null :: fn (block : *BlockNode) bool {
    block == (mimi_buffer_empty() as *BlockNode)
}

pub parse_block_span :: fn (source : []u8, offset : u64, storage : *ExpressionArena) *BlockNode {
    opening := next_token(source, 0)
    if opening.0 != 123 { return mimi_buffer_empty() as *BlockNode }
    cursor := opening.2
    depth : u64 = 1
    close_start : u64 = 0
    close_end : u64 = 0
    while depth > 0 {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *BlockNode }
        cursor = token.2
        if token.0 == 123 { depth = depth + 1 } else {
            if token.0 == 125 {
                depth = depth - 1
                if depth == 0 {
                    close_start = token.1
                    close_end = token.2
                }
            }
        }
    }
    if mimi_arena_allocate(storage, 40, 8) == 0 { return mimi_buffer_empty() as *BlockNode }
    block := storage.last as *BlockNode
    block.start = opening.1 + offset
    block.end = close_end + offset
    block.content_start = opening.2 + offset
    block.content_end = close_start + offset
    block.statements = mimi_buffer_empty() as *StatementNode
    block
}

pub parse_statement_block :: fn (source : []u8, offset : u64, storage : *ExpressionArena) *BlockNode {
    block := parse_block_span(source, offset, storage)
    if block_node_is_null(block) { return block }
    if next_token(source, block.end - offset).0 != 0 { return mimi_buffer_empty() as *BlockNode }
    opening := next_token(source, 0)
    closing := block.content_end - offset
    cursor := opening.2
    segment_start := cursor
    paren_depth : u64 = 0
    bracket_depth : u64 = 0
    brace_depth : u64 = 0
    previous_kind : u8 = 0
    seen_equal := false
    first : *StatementNode = mimi_buffer_empty() as *StatementNode
    last : *StatementNode = mimi_buffer_empty() as *StatementNode
    while cursor < closing {
        token := next_token(source, cursor)
        if token.0 == 125 && token.1 == closing { break }
        if token.0 == 0 || token.0 == 255 || token.2 > closing { return mimi_buffer_empty() as *BlockNode }
        at_top_level := paren_depth == 0 && bracket_depth == 0 && brace_depth == 0
        first_token := next_token(source, segment_start)
        starts_new := false
        if (previous_kind == 0 || can_end_expression(previous_kind)) && statement_starts_here(source, token) { starts_new = true }
        if previous_kind == 125 && expression_starts_statement(token.0) { starts_new = true }
        if can_end_expression(previous_kind) && starts_expression_atom(token.0) { starts_new = true }
        if previous_kind == 93 && token.0 == 1 && !seen_equal {
            name := next_token(source, segment_start)
            colon := next_token(source, name.2)
            marker := next_token(source, colon.2)
            if name.0 == 1 && colon.0 == 58 && marker.0 == 91 { starts_new = false }
        }
        if previous_kind == 125 && token.0 == 169 && first_token.0 == 168 { starts_new = false }
        if at_top_level && token.1 > segment_start && first_token.1 < token.1 && starts_new {
            previous := parse_statement_piece(source[segment_start:token.1], segment_start + offset, storage)
            if statement_node_is_null(previous) { return mimi_buffer_empty() as *BlockNode }
            if first == (mimi_buffer_empty() as *StatementNode) { first = previous } else { last.next = previous }
            last = previous
            while last.next != (mimi_buffer_empty() as *StatementNode) { last = last.next }
            segment_start = token.1
            seen_equal = false
        }
        cursor = token.2
        previous_kind = token.0
        if at_top_level && token.0 == 61 { seen_equal = true }
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 {
                if paren_depth == 0 { return mimi_buffer_empty() as *BlockNode }
                paren_depth = paren_depth - 1
            } else {
                if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                    if token.0 == 93 {
                        if bracket_depth == 0 { return mimi_buffer_empty() as *BlockNode }
                        bracket_depth = bracket_depth - 1
                    } else {
                        if token.0 == 123 { brace_depth = brace_depth + 1 } else {
                            if token.0 == 125 {
                                if brace_depth == 0 { return mimi_buffer_empty() as *BlockNode }
                                brace_depth = brace_depth - 1
                            }
                        }
                    }
                }
            }
        }
    }
    if paren_depth != 0 || bracket_depth != 0 || brace_depth != 0 { return mimi_buffer_empty() as *BlockNode }
    trailing := next_token(source, segment_start)
    if trailing.0 != 0 && trailing.1 < closing {
        current := parse_statement_piece(source[segment_start:closing], segment_start + offset, storage)
        if statement_node_is_null(current) { return mimi_buffer_empty() as *BlockNode }
        if first == (mimi_buffer_empty() as *StatementNode) { first = current } else { last.next = current }
        last = current
        while last.next != (mimi_buffer_empty() as *StatementNode) { last = last.next }
    }
    block.statements = first
    block
}

expression_starts_statement :: fn (kind : u8) bool {
    kind == 1 || kind == 2 || kind == 3 || kind == 4 || kind == 5 || kind == 40 || kind == 42 || kind == 38 || kind == 45 || kind == 33
}

can_end_expression :: fn (kind : u8) bool {
    kind == 1 || kind == 2 || kind == 3 || kind == 4 || kind == 5 || kind == 41 || kind == 93 || kind == 125
}

starts_expression_atom :: fn (kind : u8) bool {
    kind == 1 || kind == 2 || kind == 3 || kind == 4 || kind == 5 || kind == 33 || kind == 38
}

statement_starts_here :: fn (source : []u8, token : (u8, u64, u64)) bool {
    if token.0 == 163 || token.0 == 164 || token.0 == 168 || token.0 == 169 || token.0 == 170 || token.0 == 171 || token.0 == 172 || token.0 == 175 || token.0 == 176 || token.0 == 177 { return true }
    if token.0 != 1 { return false }
    separator := next_token(source, token.2)
    if separator.0 == 58 {
        return true
    }
    separator.0 == 61 || separator.0 == 44
}

parse_statement_piece :: fn (source : []u8, offset : u64, storage : *ExpressionArena) *StatementNode {
    first := next_token(source, 0)
    statement : *StatementNode = mimi_buffer_empty() as *StatementNode
    if first.0 == 163 {
        match_node := parse_match_expression(source, storage)
        if match_node_is_null(match_node) { return mimi_buffer_empty() as *StatementNode }
        statement = allocate_control_statement(storage, 308, match_node.start, match_node.end)
        statement.match_statement = match_node
    } else {
    if first.0 == 164 {
        if_let := parse_if_let_statement(source, storage)
        if !if_let_node_is_null(if_let) {
            statement = allocate_control_statement(storage, 305, if_let.start, if_let.end)
            statement.if_let = if_let
        } else {
            if_node := parse_if_statement(source, storage)
            if if_node_is_null(if_node) { return mimi_buffer_empty() as *StatementNode }
            statement = allocate_control_statement(storage, 304, if_node.start, if_node.end)
            statement.if_statement = if_node
        }
    } else {
    if first.0 == 168 || first.0 == 169 || first.0 == 171 {
        loop_node := parse_loop_statement(source, storage)
        if loop_node_is_null(loop_node) { return mimi_buffer_empty() as *StatementNode }
        statement = allocate_control_statement(storage, 306, loop_node.start, loop_node.end)
        statement.loop_statement = loop_node
    } else {
    if first.0 == 170 {
        for_node := parse_for_statement(source, storage)
        if for_node_is_null(for_node) { return mimi_buffer_empty() as *StatementNode }
        statement = allocate_control_statement(storage, 307, for_node.start, for_node.end)
        statement.for_loop = for_node
    } else {
    if first.0 == 175 || first.0 == 176 || first.0 == 177 {
        statement = parse_transfer_statement(source, storage)
    } else {
        if first.0 == 172 {
            statement = parse_defer_statement(source, storage)
        } else {
            tuple_value : *TupleBindingNode = mimi_buffer_empty() as *TupleBindingNode
            if next_token(source, first.2).0 == 44 { tuple_value = parse_tuple_binding(source, storage) }
            if !tuple_binding_is_null(tuple_value) {
                statement = allocate_control_statement(storage, 309, tuple_value.start, tuple_value.end)
                statement.tuple_binding = tuple_value
            } else {
            binding := parse_binding_declaration(source, storage)
            if !binding_node_is_null(binding) {
                if mimi_arena_allocate(storage, 104, 8) == 0 { return mimi_buffer_empty() as *StatementNode }
                statement = storage.last as *StatementNode
                statement.kind = 285
                statement.start = binding.start
                statement.end = binding.end
                statement.value = binding.initializer
                statement.next = mimi_buffer_empty() as *StatementNode
                statement.body = mimi_buffer_empty() as *BlockNode
                statement.binding = binding
                statement.if_statement = mimi_buffer_empty() as *IfNode
                statement.if_let = mimi_buffer_empty() as *IfLetNode
                statement.loop_statement = mimi_buffer_empty() as *LoopNode
                statement.for_loop = mimi_buffer_empty() as *ForNode
                statement.match_statement = mimi_buffer_empty() as *MatchNode
                statement.tuple_binding = mimi_buffer_empty() as *TupleBindingNode
            } else {
                statement = parse_assignment_statement(source, storage)
                if statement_node_is_null(statement) {
                    value := parse_expression(source, storage)
                    if expression_is_null(value) { return mimi_buffer_empty() as *StatementNode }
                    if mimi_arena_allocate(storage, 104, 8) == 0 { return mimi_buffer_empty() as *StatementNode }
                    statement = storage.last as *StatementNode
                    statement.kind = 303
                    statement.start = value.start
                    statement.end = value.end
                    statement.value = value
                    statement.next = mimi_buffer_empty() as *StatementNode
                    statement.body = mimi_buffer_empty() as *BlockNode
                    statement.binding = mimi_buffer_empty() as *BindingNode
                    statement.if_statement = mimi_buffer_empty() as *IfNode
                    statement.if_let = mimi_buffer_empty() as *IfLetNode
                    statement.loop_statement = mimi_buffer_empty() as *LoopNode
                    statement.for_loop = mimi_buffer_empty() as *ForNode
                    statement.match_statement = mimi_buffer_empty() as *MatchNode
                    statement.tuple_binding = mimi_buffer_empty() as *TupleBindingNode
                }
            }
            }
        }
    }
    }
    }
    }
    }
    if statement_node_is_null(statement) { return statement }
    compose_statement_blocks(source, statement, storage)
    shift_statement_spans(statement, offset)
    shift_control_statement(statement, offset)
    statement
}

compose_statement_blocks :: fn (source : []u8, statement : *StatementNode, storage : *ExpressionArena) void {
    if statement.if_statement != (mimi_buffer_empty() as *IfNode) { compose_if_blocks(source, statement.if_statement, storage) }
    if statement.if_let != (mimi_buffer_empty() as *IfLetNode) {
        node := statement.if_let
        node.then_branch = compose_block_contents(source, node.then_branch, storage)
        node.else_branch = compose_block_contents(source, node.else_branch, storage)
    }
    if statement.loop_statement != (mimi_buffer_empty() as *LoopNode) {
        node := statement.loop_statement
        node.body = compose_block_contents(source, node.body, storage)
    }
    if statement.for_loop != (mimi_buffer_empty() as *ForNode) {
        node := statement.for_loop
        node.body = compose_block_contents(source, node.body, storage)
    }
    if statement.kind == 290 && !block_node_is_null(statement.body) {
        statement.body = compose_block_contents(source, statement.body, storage)
    }
}

compose_if_blocks :: fn (source : []u8, node : *IfNode, storage : *ExpressionArena) void {
    node.then_branch = compose_block_contents(source, node.then_branch, storage)
    node.else_branch = compose_block_contents(source, node.else_branch, storage)
    if node.else_if != (mimi_buffer_empty() as *IfNode) { compose_if_blocks(source, node.else_if, storage) }
}

compose_block_contents :: fn (source : []u8, block : *BlockNode, storage : *ExpressionArena) *BlockNode {
    if block_node_is_null(block) { return block }
    parse_statement_block(source[block.start:block.end], block.start, storage)
}

allocate_control_statement :: fn (storage : *ExpressionArena, kind : u64, start : u64, end : u64) *StatementNode {
    if mimi_arena_allocate(storage, 104, 8) == 0 { return mimi_buffer_empty() as *StatementNode }
    statement := storage.last as *StatementNode
    statement.kind = kind
    statement.start = start
    statement.end = end
    statement.value = mimi_buffer_empty() as *ExprNode
    statement.next = mimi_buffer_empty() as *StatementNode
    statement.body = mimi_buffer_empty() as *BlockNode
    statement.binding = mimi_buffer_empty() as *BindingNode
    statement.if_statement = mimi_buffer_empty() as *IfNode
    statement.if_let = mimi_buffer_empty() as *IfLetNode
    statement.loop_statement = mimi_buffer_empty() as *LoopNode
    statement.for_loop = mimi_buffer_empty() as *ForNode
    statement.match_statement = mimi_buffer_empty() as *MatchNode
    statement.tuple_binding = mimi_buffer_empty() as *TupleBindingNode
    statement
}

shift_control_statement :: fn (statement : *StatementNode, offset : u64) void {
    if statement.if_statement != (mimi_buffer_empty() as *IfNode) { shift_if_node(statement.if_statement, offset) }
    if statement.if_let != (mimi_buffer_empty() as *IfLetNode) {
        node := statement.if_let
        node.start = node.start + offset
        node.end = node.end + offset
        node.variant_start = node.variant_start + offset
        node.variant_end = node.variant_end + offset
        if node.binding_start != 0 || node.binding_end != 0 {
            node.binding_start = node.binding_start + offset
            node.binding_end = node.binding_end + offset
        }
        shift_expression_tree(node.value, offset)
        shift_block_span(node.then_branch, offset)
        shift_block_span(node.else_branch, offset)
    }
    if statement.loop_statement != (mimi_buffer_empty() as *LoopNode) {
        node := statement.loop_statement
        node.start = node.start + offset
        node.end = node.end + offset
        if !expression_is_null(node.condition) {
            shift_expression_tree(node.condition, offset)
        }
        shift_block_span(node.body, offset)
    }
    if statement.for_loop != (mimi_buffer_empty() as *ForNode) {
        node := statement.for_loop
        node.start = node.start + offset
        node.end = node.end + offset
        node.variable_start = node.variable_start + offset
        node.variable_end = node.variable_end + offset
        if !expression_is_null(node.iterable) { shift_expression_tree(node.iterable, offset) }
        if !expression_is_null(node.range_start) { shift_expression_tree(node.range_start, offset) }
        if !expression_is_null(node.range_end) { shift_expression_tree(node.range_end, offset) }
        shift_block_span(node.body, offset)
    }
    if statement.match_statement != (mimi_buffer_empty() as *MatchNode) {
        node := statement.match_statement
        node.start = node.start + offset
        node.end = node.end + offset
        shift_expression_tree(node.value, offset)
        arm := node.arms
        while arm != (mimi_buffer_empty() as *MatchArmNode) {
            arm.start = arm.start + offset
            arm.end = arm.end + offset
            arm.variant_start = arm.variant_start + offset
            arm.variant_end = arm.variant_end + offset
            if arm.binding_start != 0 || arm.binding_end != 0 {
                arm.binding_start = arm.binding_start + offset
                arm.binding_end = arm.binding_end + offset
            }
            shift_expression_tree(arm.value, offset)
            arm = arm.next
        }
    }
    if statement.tuple_binding != (mimi_buffer_empty() as *TupleBindingNode) {
        node := statement.tuple_binding
        node.start = node.start + offset
        node.end = node.end + offset
        name := node.names
        while name != (mimi_buffer_empty() as *DestructureNameNode) {
            name.start = name.start + offset
            name.end = name.end + offset
            name = name.next
        }
        shift_expression_tree(node.value, offset)
    }
}

shift_if_node :: fn (node : *IfNode, offset : u64) void {
    node.start = node.start + offset
    node.end = node.end + offset
    shift_expression_tree(node.condition, offset)
    shift_block_span(node.then_branch, offset)
    shift_block_span(node.else_branch, offset)
    if node.else_if != (mimi_buffer_empty() as *IfNode) { shift_if_node(node.else_if, offset) }
}

shift_block_span :: fn (block : *BlockNode, offset : u64) void {
    if block_node_is_null(block) { return }
    block.start = block.start + offset
    block.end = block.end + offset
    block.content_start = block.content_start + offset
    block.content_end = block.content_end + offset
    current := block.statements
    while !statement_node_is_null(current) {
        shift_statement_spans(current, offset)
        shift_control_statement(current, offset)
        current = current.next
    }
}

shift_expression_tree :: fn (expression : *ExprNode, offset : u64) void {
    if expression_is_null(expression) { return }
    expression.start = expression.start + offset
    expression.end = expression.end + offset
    expression.payload_start = expression.payload_start + offset
    expression.payload_end = expression.payload_end + offset
    shift_expression_children(expression, offset)
}

shift_statement_spans :: fn (statement : *StatementNode, offset : u64) void {
    statement.start = statement.start + offset
    statement.end = statement.end + offset
    if !expression_is_null(statement.value) && (binding_node_is_null(statement.binding) || statement.value != statement.binding.initializer) {
        shift_expression_tree(statement.value, offset)
    }
    if !block_node_is_null(statement.body) {
        shift_block_span(statement.body, offset)
    }
    if !binding_node_is_null(statement.binding) {
        statement.binding.start = statement.binding.start + offset
        statement.binding.end = statement.binding.end + offset
        statement.binding.name_start = statement.binding.name_start + offset
        statement.binding.name_end = statement.binding.name_end + offset
        if !expression_is_null(statement.binding.data_type) {
            shift_expression_tree(statement.binding.data_type, offset)
        }
        if !expression_is_null(statement.binding.initializer) {
            shift_expression_tree(statement.binding.initializer, offset)
        }
    }
}

shift_expression_children :: fn (expression : *ExprNode, offset : u64) void {
    if expression_is_null(expression) { return }
    if !expression_is_null(expression.left) {
        shift_expression_tree(expression.left, offset)
    }
    if !expression_is_null(expression.right) {
        shift_expression_tree(expression.right, offset)
    }
}

pub if_node_is_null :: fn (node : *IfNode) bool {
    node == (mimi_buffer_empty() as *IfNode)
}

pub parse_if_statement :: fn (source : []u8, storage : *ExpressionArena) *IfNode {
    parse_if_statement_at(source, 0, storage)
}

parse_if_statement_at :: fn (source : []u8, offset : u64, storage : *ExpressionArena) *IfNode {
    keyword := next_token(source, 0)
    if keyword.0 != 164 { return mimi_buffer_empty() as *IfNode }
    cursor := keyword.2
    paren_depth : u64 = 0
    condition_end := source.len
    block_start := source.len
    found_block := false
    while cursor < source.len && !found_block {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *IfNode }
        cursor = token.2
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 {
                if paren_depth == 0 { return mimi_buffer_empty() as *IfNode }
                paren_depth = paren_depth - 1
            } else {
                if token.0 == 123 && paren_depth == 0 {
                    condition_end = token.1
                    block_start = token.1
                    found_block = true
                }
            }
        }
    }
    if !found_block || condition_end <= keyword.2 { return mimi_buffer_empty() as *IfNode }
    condition := parse_expression(source[keyword.2:condition_end], storage)
    if expression_is_null(condition) { return mimi_buffer_empty() as *IfNode }
    shift_expression_tree(condition, keyword.2)
    then_branch := parse_block_span(source[block_start:source.len], offset + block_start, storage)
    if block_node_is_null(then_branch) { return mimi_buffer_empty() as *IfNode }
    end := then_branch.end - offset
    remainder := next_token(source, end)
    else_branch : *BlockNode = mimi_buffer_empty() as *BlockNode
    else_if : *IfNode = mimi_buffer_empty() as *IfNode
    if remainder.0 != 0 {
        if remainder.0 != 165 { return mimi_buffer_empty() as *IfNode }
        else_start := next_token(source, remainder.2)
        if else_start.0 == 123 {
            else_branch = parse_block_span(source[else_start.1:source.len], offset + else_start.1, storage)
            if block_node_is_null(else_branch) { return mimi_buffer_empty() as *IfNode }
            end = else_branch.end - offset
            if next_token(source, end).0 != 0 { return mimi_buffer_empty() as *IfNode }
        } else {
            if else_start.0 != 164 { return mimi_buffer_empty() as *IfNode }
            else_if = parse_if_statement_at(source[else_start.1:source.len], offset + else_start.1, storage)
            if if_node_is_null(else_if) { return mimi_buffer_empty() as *IfNode }
            end = else_if.end - offset
        }
    }
    if mimi_arena_allocate(storage, 48, 8) == 0 { return mimi_buffer_empty() as *IfNode }
    node := storage.last as *IfNode
    node.start = keyword.1 + offset
    node.end = end + offset
    node.condition = condition
    shift_expression_tree(node.condition, offset)
    node.then_branch = then_branch
    node.else_branch = else_branch
    node.else_if = else_if
    node
}

pub parse_if_expression :: fn (source : []u8, storage : *ExpressionArena) *ExprNode {
    statement := parse_if_statement(source, storage)
    if if_node_is_null(statement) { return mimi_buffer_empty() as *ExprNode }
    parse_if_expression_node(source, statement, storage)
}

pub if_let_node_is_null :: fn (node : *IfLetNode) bool {
    node == (mimi_buffer_empty() as *IfLetNode)
}

pub parse_if_let_statement :: fn (source : []u8, storage : *ExpressionArena) *IfLetNode {
    keyword := next_token(source, 0)
    if keyword.0 != 164 { return mimi_buffer_empty() as *IfLetNode }
    variant := next_token(source, keyword.2)
    if variant.0 != 1 { return mimi_buffer_empty() as *IfLetNode }
    cursor := variant.2
    binding_start : u64 = 0
    binding_end : u64 = 0
    next := next_token(source, cursor)
    if next.0 == 40 {
        binding := next_token(source, next.2)
        close := next_token(source, binding.2)
        if binding.0 != 1 || close.0 != 41 { return mimi_buffer_empty() as *IfLetNode }
        binding_start = binding.1
        binding_end = binding.2
        cursor = close.2
    }
    colon := next_token(source, cursor)
    equal := next_token(source, colon.2)
    if colon.0 != 58 || equal.0 != 61 { return mimi_buffer_empty() as *IfLetNode }
    cursor = equal.2
    paren_depth : u64 = 0
    bracket_depth : u64 = 0
    block_start := source.len
    found_block := false
    while cursor < source.len && !found_block {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *IfLetNode }
        cursor = token.2
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 {
                if paren_depth == 0 { return mimi_buffer_empty() as *IfLetNode }
                paren_depth = paren_depth - 1
            } else {
                if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                    if token.0 == 93 {
                        if bracket_depth == 0 { return mimi_buffer_empty() as *IfLetNode }
                        bracket_depth = bracket_depth - 1
                    } else {
                        if token.0 == 123 && paren_depth == 0 && bracket_depth == 0 {
                            block_start = token.1
                            found_block = true
                        }
                    }
                }
            }
        }
    }
    if !found_block || block_start <= equal.2 { return mimi_buffer_empty() as *IfLetNode }
    value := parse_expression(source[equal.2:block_start], storage)
    if expression_is_null(value) { return mimi_buffer_empty() as *IfLetNode }
    shift_expression_tree(value, equal.2)
    then_branch := parse_block_span(source[block_start:source.len], block_start, storage)
    if block_node_is_null(then_branch) { return mimi_buffer_empty() as *IfLetNode }
    end := then_branch.end
    else_branch : *BlockNode = mimi_buffer_empty() as *BlockNode
    remainder := next_token(source, end)
    if remainder.0 != 0 {
        if remainder.0 != 165 { return mimi_buffer_empty() as *IfLetNode }
        opening := next_token(source, remainder.2)
        if opening.0 != 123 { return mimi_buffer_empty() as *IfLetNode }
        else_branch = parse_block_span(source[opening.1:source.len], opening.1, storage)
        if block_node_is_null(else_branch) || next_token(source, else_branch.end).0 != 0 { return mimi_buffer_empty() as *IfLetNode }
        end = else_branch.end
    }
    if mimi_arena_allocate(storage, 72, 8) == 0 { return mimi_buffer_empty() as *IfLetNode }
    node := storage.last as *IfLetNode
    node.start = keyword.1
    node.end = end
    node.variant_start = variant.1
    node.variant_end = variant.2
    node.binding_start = binding_start
    node.binding_end = binding_end
    node.value = value
    node.then_branch = then_branch
    node.else_branch = else_branch
    node
}

parse_if_expression_node :: fn (source : []u8, statement : *IfNode, storage : *ExpressionArena) *ExprNode {
    if if_node_is_null(statement) || (block_node_is_null(statement.else_branch) && if_node_is_null(statement.else_if)) { return mimi_buffer_empty() as *ExprNode }
    then_value := parse_expression(source[statement.then_branch.content_start:statement.then_branch.content_end], storage)
    if expression_is_null(then_value) { return then_value }
    shift_expression_tree(then_value, statement.then_branch.content_start)
    then_node := allocate_expr(storage, 289, statement.then_branch.start, statement.then_branch.end, then_value, mimi_buffer_empty() as *ExprNode)
    if expression_is_null(then_node) { return then_node }
    else_node : *ExprNode = mimi_buffer_empty() as *ExprNode
    if if_node_is_null(statement.else_if) {
        else_value := parse_expression(source[statement.else_branch.content_start:statement.else_branch.content_end], storage)
        if expression_is_null(else_value) { return else_value }
        shift_expression_tree(else_value, statement.else_branch.content_start)
        else_node = allocate_expr(storage, 289, statement.else_branch.start, statement.else_branch.end, else_value, mimi_buffer_empty() as *ExprNode)
    } else {
        else_node = parse_if_expression_node(source, statement.else_if, storage)
    }
    if expression_is_null(else_node) { return else_node }
    branches := allocate_expr(storage, 276, then_node.start, else_node.end, then_node, else_node)
    if expression_is_null(branches) { return branches }
    allocate_expr(storage, 288, statement.start, statement.end, statement.condition, branches)
}

pub loop_node_is_null :: fn (node : *LoopNode) bool {
    node == (mimi_buffer_empty() as *LoopNode)
}

pub parse_loop_statement :: fn (source : []u8, storage : *ExpressionArena) *LoopNode {
    keyword := next_token(source, 0)
    kind : u64 = 0
    condition : *ExprNode = mimi_buffer_empty() as *ExprNode
    block_start := source.len
    if keyword.0 == 171 {
        kind = 285
        opening := next_token(source, keyword.2)
        if opening.0 != 123 { return mimi_buffer_empty() as *LoopNode }
        block_start = opening.1
    } else {
        if keyword.0 == 169 { kind = 286 } else {
            if keyword.0 == 168 { kind = 287 } else { return mimi_buffer_empty() as *LoopNode }
        }
        if kind == 287 {
            opening := next_token(source, keyword.2)
            if opening.0 != 123 { return mimi_buffer_empty() as *LoopNode }
            block_start = opening.1
        } else {
        cursor := keyword.2
        paren_depth : u64 = 0
        found_block := false
        condition_end := source.len
        while cursor < source.len && !found_block {
            token := next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *LoopNode }
            cursor = token.2
            if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                if token.0 == 41 {
                    if paren_depth == 0 { return mimi_buffer_empty() as *LoopNode }
                    paren_depth = paren_depth - 1
                } else {
                    if token.0 == 123 && paren_depth == 0 {
                        condition_end = token.1
                        block_start = token.1
                        found_block = true
                    }
                }
            }
        }
        if !found_block || condition_end <= keyword.2 { return mimi_buffer_empty() as *LoopNode }
        condition = parse_expression(source[keyword.2:condition_end], storage)
        if expression_is_null(condition) { return mimi_buffer_empty() as *LoopNode }
        shift_expression_tree(condition, keyword.2)
        }
    }
    body := parse_block_span(source[block_start:source.len], block_start, storage)
    if block_node_is_null(body) { return mimi_buffer_empty() as *LoopNode }
    if kind == 287 {
        while_token := next_token(source, body.end)
        if while_token.0 != 169 { return mimi_buffer_empty() as *LoopNode }
        condition_start := while_token.2
        condition = parse_expression(source[condition_start:source.len], storage)
        if expression_is_null(condition) { return mimi_buffer_empty() as *LoopNode }
        shift_expression_tree(condition, condition_start)
    } else {
        if next_token(source, body.end).0 != 0 { return mimi_buffer_empty() as *LoopNode }
    }
    if mimi_arena_allocate(storage, 40, 8) == 0 { return mimi_buffer_empty() as *LoopNode }
    node := storage.last as *LoopNode
    node.kind = kind
    node.start = keyword.1
    node.end = source.len
    node.condition = condition
    node.body = body
    node
}

pub for_node_is_null :: fn (node : *ForNode) bool {
    node == (mimi_buffer_empty() as *ForNode)
}

pub parse_for_statement :: fn (source : []u8, storage : *ExpressionArena) *ForNode {
    keyword := next_token(source, 0)
    if keyword.0 != 170 { return mimi_buffer_empty() as *ForNode }
    variable := next_token(source, keyword.2)
    in_token := next_token(source, variable.2)
    if variable.0 != 1 || in_token.0 != 173 { return mimi_buffer_empty() as *ForNode }
    cursor := in_token.2
    paren_depth : u64 = 0
    bracket_depth : u64 = 0
    header_end := source.len
    block_start := source.len
    found_block := false
    while cursor < source.len && !found_block {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *ForNode }
        cursor = token.2
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 {
                if paren_depth == 0 { return mimi_buffer_empty() as *ForNode }
                paren_depth = paren_depth - 1
            } else {
                if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                    if token.0 == 93 {
                        if bracket_depth == 0 { return mimi_buffer_empty() as *ForNode }
                        bracket_depth = bracket_depth - 1
                    } else {
                        if token.0 == 123 && paren_depth == 0 && bracket_depth == 0 {
                            header_end = token.1
                            block_start = token.1
                            found_block = true
                        }
                    }
                }
            }
        }
    }
    if !found_block || header_end <= in_token.2 { return mimi_buffer_empty() as *ForNode }
    iterable : *ExprNode = mimi_buffer_empty() as *ExprNode
    range_start : *ExprNode = mimi_buffer_empty() as *ExprNode
    range_end : *ExprNode = mimi_buffer_empty() as *ExprNode
    is_range := false
    range_cursor := in_token.2
    while range_cursor < header_end && !is_range {
        token := next_token(source, range_cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *ForNode }
        if token.0 == 135 { is_range = true } else { range_cursor = token.2 }
    }
    if is_range {
        range_start = parse_expression(source[in_token.2:range_cursor], storage)
        range_end = parse_expression(source[range_cursor + 2:header_end], storage)
        if expression_is_null(range_start) || expression_is_null(range_end) { return mimi_buffer_empty() as *ForNode }
        shift_expression_tree(range_start, in_token.2)
        shift_expression_tree(range_end, range_cursor + 2)
    } else {
        iterable = parse_expression(source[in_token.2:header_end], storage)
        if expression_is_null(iterable) { return mimi_buffer_empty() as *ForNode }
        shift_expression_tree(iterable, in_token.2)
    }
    body := parse_block_span(source[block_start:source.len], block_start, storage)
    if block_node_is_null(body) || next_token(source, body.end).0 != 0 { return mimi_buffer_empty() as *ForNode }
    if mimi_arena_allocate(storage, 72, 8) == 0 { return mimi_buffer_empty() as *ForNode }
    node := storage.last as *ForNode
    node.start = keyword.1
    node.end = body.end
    node.variable_start = variable.1
    node.variable_end = variable.2
    node.is_range = is_range
    node.iterable = iterable
    node.range_start = range_start
    node.range_end = range_end
    node.body = body
    node
}

pub match_node_is_null :: fn (node : *MatchNode) bool {
    node == (mimi_buffer_empty() as *MatchNode)
}

pub parse_match_expression :: fn (source : []u8, storage : *ExpressionArena) *MatchNode {
    keyword := next_token(source, 0)
    if keyword.0 != 163 { return mimi_buffer_empty() as *MatchNode }
    cursor := keyword.2
    paren_depth : u64 = 0
    bracket_depth : u64 = 0
    opening_start := source.len
    opening_end := source.len
    found_open := false
    while cursor < source.len && !found_open {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *MatchNode }
        cursor = token.2
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 {
                if paren_depth == 0 { return mimi_buffer_empty() as *MatchNode }
                paren_depth = paren_depth - 1
            } else {
                if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                    if token.0 == 93 {
                        if bracket_depth == 0 { return mimi_buffer_empty() as *MatchNode }
                        bracket_depth = bracket_depth - 1
                    } else {
                        if token.0 == 123 && paren_depth == 0 && bracket_depth == 0 {
                            opening_start = token.1
                            opening_end = token.2
                            found_open = true
                        }
                    }
                }
            }
        }
    }
    if !found_open || opening_start <= keyword.2 { return mimi_buffer_empty() as *MatchNode }
    match_value := parse_expression(source[keyword.2:opening_start], storage)
    if expression_is_null(match_value) { return mimi_buffer_empty() as *MatchNode }
    shift_expression_tree(match_value, keyword.2)
    cursor = opening_end
    arm_count : u64 = 0
    first : *MatchArmNode = mimi_buffer_empty() as *MatchArmNode
    last : *MatchArmNode = mimi_buffer_empty() as *MatchArmNode
    close_end : u64 = 0
    while cursor < source.len {
        if next_token(source, cursor).0 == 125 {
            close := next_token(source, cursor)
            if arm_count == 0 || next_token(source, close.2).0 != 0 { return mimi_buffer_empty() as *MatchNode }
            close_end = close.2
            break
        }
        arm_start := cursor
        segment_end := source.len
        local_paren : u64 = 0
        local_bracket : u64 = 0
        local_brace : u64 = 0
        found_separator := false
        while cursor < source.len && !found_separator {
            token := next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *MatchNode }
            cursor = token.2
            if token.0 == 40 { local_paren = local_paren + 1 } else {
                if token.0 == 41 {
                    if local_paren == 0 { return mimi_buffer_empty() as *MatchNode }
                    local_paren = local_paren - 1
                } else {
                    if token.0 == 91 { local_bracket = local_bracket + 1 } else {
                        if token.0 == 93 {
                            if local_bracket == 0 { return mimi_buffer_empty() as *MatchNode }
                            local_bracket = local_bracket - 1
                        } else {
                            if token.0 == 123 { local_brace = local_brace + 1 } else {
                                if token.0 == 125 {
                                    if local_brace > 0 { local_brace = local_brace - 1 } else {
                                        if local_paren == 0 && local_bracket == 0 {
                                            segment_end = token.1
                                            close_end = token.2
                                            found_separator = true
                                        }
                                    }
                                } else {
                                    if token.0 == 44 && local_paren == 0 && local_bracket == 0 && local_brace == 0 {
                                        segment_end = token.1
                                        found_separator = true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if !found_separator || local_paren != 0 || local_bracket != 0 || local_brace != 0 { return mimi_buffer_empty() as *MatchNode }
        arrow_start := segment_end
        scan := arm_start
        while scan < segment_end && arrow_start == segment_end {
            token := next_token(source, scan)
            if token.0 == 134 {
                arrow_start = token.1
                scan = token.2
            } else { scan = token.2 }
        }
        if arrow_start == segment_end { return mimi_buffer_empty() as *MatchNode }
        pattern := source[arm_start:arrow_start]
        variant := next_token(pattern, 0)
        if variant.0 != 1 { return mimi_buffer_empty() as *MatchNode }
        existing_arm := first
        while existing_arm != (mimi_buffer_empty() as *MatchArmNode) {
            if source_names_equal(source, existing_arm.variant_start, existing_arm.variant_end, variant.1 + arm_start, variant.2 + arm_start) { return mimi_buffer_empty() as *MatchNode }
            existing_arm = existing_arm.next
        }
        after_variant := next_token(pattern, variant.2)
        binding_start : u64 = 0
        binding_end : u64 = 0
        if after_variant.0 == 40 {
            binding := next_token(pattern, after_variant.2)
            binding_close := next_token(pattern, binding.2)
            if binding.0 != 1 || binding_close.0 != 41 || next_token(pattern, binding_close.2).0 != 0 { return mimi_buffer_empty() as *MatchNode }
            binding_start = binding.1 + arm_start
            binding_end = binding.2 + arm_start
        } else {
            if after_variant.0 != 0 { return mimi_buffer_empty() as *MatchNode }
        }
        value_start := scan
        arm_value := parse_expression(source[value_start:segment_end], storage)
        if expression_is_null(arm_value) { return mimi_buffer_empty() as *MatchNode }
        shift_expression_tree(arm_value, value_start)
        if mimi_arena_allocate(storage, 64, 8) == 0 { return mimi_buffer_empty() as *MatchNode }
        arm := storage.last as *MatchArmNode
        arm.start = arm_start
        arm.end = segment_end
        arm.variant_start = variant.1 + arm_start
        arm.variant_end = variant.2 + arm_start
        arm.binding_start = binding_start
        arm.binding_end = binding_end
        arm.value = arm_value
        arm.next = mimi_buffer_empty() as *MatchArmNode
        if last == (mimi_buffer_empty() as *MatchArmNode) { first = arm } else { last.next = arm }
        last = arm
        arm_count = arm_count + 1
        separator := next_token(source, segment_end)
        if separator.0 == 125 {
            close_end = separator.2
            break
        }
        if separator.0 != 44 { return mimi_buffer_empty() as *MatchNode }
        cursor = separator.2
    }
    if close_end == 0 || next_token(source, close_end).0 != 0 { return mimi_buffer_empty() as *MatchNode }
    if mimi_arena_allocate(storage, 40, 8) == 0 { return mimi_buffer_empty() as *MatchNode }
    node := storage.last as *MatchNode
    node.start = keyword.1
    node.end = close_end
    node.value = match_value
    node.arm_count = arm_count
    node.arms = first
    node
}

pub generic_parameter_list_is_null :: fn (parameters : *GenericParameterList) bool {
    parameters == (mimi_buffer_empty() as *GenericParameterList)
}

pub parse_generic_parameters :: fn (source : []u8, storage : *ExpressionArena) *GenericParameterList {
    opening := next_token(source, 0)
    if opening.0 != 60 { return mimi_buffer_empty() as *GenericParameterList }
    cursor := opening.2
    first : *GenericParameterNode = mimi_buffer_empty() as *GenericParameterNode
    last : *GenericParameterNode = mimi_buffer_empty() as *GenericParameterNode
    count : u64 = 0
    while true {
        name := next_token(source, cursor)
        if name.0 != 1 { return mimi_buffer_empty() as *GenericParameterList }
        current := first
        while current != (mimi_buffer_empty() as *GenericParameterNode) {
            if current.end - current.start == name.2 - name.1 {
                duplicate := true
                index : u64 = 0
                while index < name.2 - name.1 && duplicate {
                    if source[current.start + index] != source[name.1 + index] { duplicate = false }
                    index = index + 1
                }
                if duplicate { return mimi_buffer_empty() as *GenericParameterList }
            }
            current = current.next
        }
        if mimi_arena_allocate(storage, 24, 8) == 0 { return mimi_buffer_empty() as *GenericParameterList }
        item := storage.last as *GenericParameterNode
        item.start = name.1
        item.end = name.2
        item.next = mimi_buffer_empty() as *GenericParameterNode
        if last == (mimi_buffer_empty() as *GenericParameterNode) { first = item } else { last.next = item }
        last = item
        count = count + 1
        separator := next_token(source, name.2)
        if separator.0 == 62 {
            if next_token(source, separator.2).0 != 0 { return mimi_buffer_empty() as *GenericParameterList }
            if mimi_arena_allocate(storage, 32, 8) == 0 { return mimi_buffer_empty() as *GenericParameterList }
            result := storage.last as *GenericParameterList
            result.start = opening.1
            result.end = separator.2
            result.count = count
            result.first = first
            return result
        }
        if separator.0 != 44 { return mimi_buffer_empty() as *GenericParameterList }
        cursor = separator.2
    }
    mimi_buffer_empty() as *GenericParameterList
}

pub enum_node_is_null :: fn (node : *EnumNode) bool {
    node == (mimi_buffer_empty() as *EnumNode)
}

source_names_equal :: fn (source : []u8, left_start : u64, left_end : u64, right_start : u64, right_end : u64) bool {
    if left_end - left_start != right_end - right_start { return false }
    index : u64 = 0
    while index < left_end - left_start {
        if source[left_start + index] != source[right_start + index] { return false }
        index = index + 1
    }
    true
}

pub parse_enum_declaration :: fn (source : []u8, storage : *ExpressionArena) *EnumNode {
    keyword := next_token(source, 0)
    if keyword.0 != 162 { return mimi_buffer_empty() as *EnumNode }
    cursor := keyword.2
    parameters : *GenericParameterList = mimi_buffer_empty() as *GenericParameterList
    next := next_token(source, cursor)
    if next.0 == 60 {
        close_cursor := next.2
        found_close := false
        while close_cursor < source.len && !found_close {
            token := next_token(source, close_cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *EnumNode }
            close_cursor = token.2
            if token.0 == 62 { found_close = true }
        }
        if !found_close { return mimi_buffer_empty() as *EnumNode }
        parameters = parse_generic_parameters(source[next.1:close_cursor], storage)
        if generic_parameter_list_is_null(parameters) { return mimi_buffer_empty() as *EnumNode }
        parameters.start = parameters.start + next.1
        parameters.end = parameters.end + next.1
        cursor = close_cursor
    }
    opening := next_token(source, cursor)
    if opening.0 != 123 { return mimi_buffer_empty() as *EnumNode }
    cursor = opening.2
    first : *EnumVariantNode = mimi_buffer_empty() as *EnumVariantNode
    last : *EnumVariantNode = mimi_buffer_empty() as *EnumVariantNode
    count : u64 = 0
    close_end : u64 = 0
    while cursor < source.len {
        if next_token(source, cursor).0 == 125 {
            close := next_token(source, cursor)
            close_end = close.2
            break
        }
        segment_start := cursor
        segment_end := source.len
        paren_depth : u64 = 0
        bracket_depth : u64 = 0
        found_separator := false
        while cursor < source.len && !found_separator {
            token := next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *EnumNode }
            cursor = token.2
            if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                if token.0 == 41 {
                    if paren_depth == 0 { return mimi_buffer_empty() as *EnumNode }
                    paren_depth = paren_depth - 1
                } else {
                    if token.0 == 123 { bracket_depth = bracket_depth + 1 } else {
                        if token.0 == 125 {
                            if bracket_depth > 0 { bracket_depth = bracket_depth - 1 } else {
                                if paren_depth == 0 {
                                    segment_end = token.1
                                    close_end = token.2
                                    found_separator = true
                                }
                            }
                        } else {
                            if token.0 == 44 && paren_depth == 0 && bracket_depth == 0 {
                                segment_end = token.1
                                found_separator = true
                            }
                        }
                    }
                }
            }
        }
        if !found_separator || paren_depth != 0 || bracket_depth != 0 { return mimi_buffer_empty() as *EnumNode }
        variant_source := source[segment_start:segment_end]
        name := next_token(variant_source, 0)
        if name.0 != 1 { return mimi_buffer_empty() as *EnumNode }
        existing := first
        while existing != (mimi_buffer_empty() as *EnumVariantNode) {
            if source_names_equal(source, existing.name_start, existing.name_end, name.1 + segment_start, name.2 + segment_start) { return mimi_buffer_empty() as *EnumNode }
            existing = existing.next
        }
        payload : *ExprNode = mimi_buffer_empty() as *ExprNode
        after_name := next_token(variant_source, name.2)
        if after_name.0 == 40 {
            payload_start := after_name.2
            payload_end := variant_source.len
            close := next_token(variant_source, payload_start)
            depth : u64 = 0
            scan := payload_start
            found_payload_close := false
            while scan < variant_source.len && !found_payload_close {
                close = next_token(variant_source, scan)
                if close.0 == 40 { depth = depth + 1 } else {
                    if close.0 == 41 {
                        if depth == 0 {
                            payload_end = close.1
                            found_payload_close = true
                        } else { depth = depth - 1 }
                    }
                }
                scan = close.2
            }
            if !found_payload_close || next_token(variant_source, close.2).0 != 0 { return mimi_buffer_empty() as *EnumNode }
            payload = parse_type(variant_source[payload_start:payload_end], storage)
            if expression_is_null(payload) { return mimi_buffer_empty() as *EnumNode }
            shift_expression_tree(payload, segment_start + payload_start)
        } else {
            if after_name.0 != 0 { return mimi_buffer_empty() as *EnumNode }
        }
        if mimi_arena_allocate(storage, 48, 8) == 0 { return mimi_buffer_empty() as *EnumNode }
        variant := storage.last as *EnumVariantNode
        variant.start = segment_start
        variant.end = segment_end
        variant.name_start = name.1 + segment_start
        variant.name_end = name.2 + segment_start
        variant.payload_type = payload
        variant.next = mimi_buffer_empty() as *EnumVariantNode
        if last == (mimi_buffer_empty() as *EnumVariantNode) { first = variant } else { last.next = variant }
        last = variant
        count = count + 1
        separator := next_token(source, segment_end)
        if separator.0 == 125 {
            close_end = separator.2
            break
        }
        if separator.0 != 44 { return mimi_buffer_empty() as *EnumNode }
        cursor = separator.2
    }
    if close_end == 0 || next_token(source, close_end).0 != 0 { return mimi_buffer_empty() as *EnumNode }
    if mimi_arena_allocate(storage, 40, 8) == 0 { return mimi_buffer_empty() as *EnumNode }
    node := storage.last as *EnumNode
    node.start = keyword.1
    node.end = close_end
    node.parameters = parameters
    node.variant_count = count
    node.variants = first
    node
}

pub struct_node_is_null :: fn (node : *StructNode) bool {
    node == (mimi_buffer_empty() as *StructNode)
}

pub parse_struct_declaration :: fn (source : []u8, storage : *ExpressionArena) *StructNode {
    keyword := next_token(source, 0)
    if keyword.0 != 161 { return mimi_buffer_empty() as *StructNode }
    cursor := keyword.2
    parameters : *GenericParameterList = mimi_buffer_empty() as *GenericParameterList
    next := next_token(source, cursor)
    if next.0 == 60 {
        close_cursor := next.2
        found_close := false
        while close_cursor < source.len && !found_close {
            token := next_token(source, close_cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *StructNode }
            close_cursor = token.2
            if token.0 == 62 { found_close = true }
        }
        if !found_close { return mimi_buffer_empty() as *StructNode }
        parameters = parse_generic_parameters(source[next.1:close_cursor], storage)
        if generic_parameter_list_is_null(parameters) { return mimi_buffer_empty() as *StructNode }
        parameters.start = parameters.start + next.1
        parameters.end = parameters.end + next.1
        cursor = close_cursor
    }
    opening := next_token(source, cursor)
    if opening.0 != 123 { return mimi_buffer_empty() as *StructNode }
    cursor = opening.2
    first : *StructFieldNode = mimi_buffer_empty() as *StructFieldNode
    last : *StructFieldNode = mimi_buffer_empty() as *StructFieldNode
    first_method : *StructMethodNode = mimi_buffer_empty() as *StructMethodNode
    last_method : *StructMethodNode = mimi_buffer_empty() as *StructMethodNode
    count : u64 = 0
    method_count : u64 = 0
    close_end : u64 = 0
    while cursor < source.len {
        if next_token(source, cursor).0 == 125 {
            close := next_token(source, cursor)
            close_end = close.2
            break
        }
        if struct_method_starts(source, cursor) {
            method := parse_struct_method(source, cursor, storage)
            if method == (mimi_buffer_empty() as *StructMethodNode) { return mimi_buffer_empty() as *StructNode }
            previous_method := first_method
            while previous_method != (mimi_buffer_empty() as *StructMethodNode) {
                if source_names_equal(source, previous_method.name_start, previous_method.name_end, method.name_start, method.name_end) { return mimi_buffer_empty() as *StructNode }
                previous_method = previous_method.next
            }
            if last_method == (mimi_buffer_empty() as *StructMethodNode) { first_method = method } else { last_method.next = method }
            last_method = method
            method_count = method_count + 1
            cursor = method.end
            separator := next_token(source, cursor)
            if separator.0 == 44 { cursor = separator.2 } else {
                if separator.0 != 125 { return mimi_buffer_empty() as *StructNode }
            }
        } else {
        segment_start := cursor
        segment_end := source.len
        paren_depth : u64 = 0
        bracket_depth : u64 = 0
        angle_depth : u64 = 0
        found_separator := false
        while cursor < source.len && !found_separator {
            token := next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *StructNode }
            cursor = token.2
            if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                if token.0 == 41 {
                    if paren_depth == 0 { return mimi_buffer_empty() as *StructNode }
                    paren_depth = paren_depth - 1
                } else {
                    if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                        if token.0 == 93 {
                            if bracket_depth == 0 { return mimi_buffer_empty() as *StructNode }
                            bracket_depth = bracket_depth - 1
                        } else {
                            if token.0 == 60 { angle_depth = angle_depth + 1 } else {
                                if token.0 == 62 && angle_depth > 0 { angle_depth = angle_depth - 1 } else {
                                    if token.0 == 123 { return mimi_buffer_empty() as *StructNode } else {
                                        if token.0 == 125 && paren_depth == 0 && bracket_depth == 0 && angle_depth == 0 {
                                            segment_end = token.1
                                            close_end = token.2
                                            found_separator = true
                                        } else {
                                            if token.0 == 44 && paren_depth == 0 && bracket_depth == 0 && angle_depth == 0 {
                                                segment_end = token.1
                                                found_separator = true
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if !found_separator || paren_depth != 0 || bracket_depth != 0 || angle_depth != 0 { return mimi_buffer_empty() as *StructNode }
        field_source := source[segment_start:segment_end]
        name := next_token(field_source, 0)
        colon := next_token(field_source, name.2)
        if name.0 != 1 || colon.0 != 58 { return mimi_buffer_empty() as *StructNode }
        existing := first
        while existing != (mimi_buffer_empty() as *StructFieldNode) {
            if source_names_equal(source, existing.name_start, existing.name_end, name.1 + segment_start, name.2 + segment_start) { return mimi_buffer_empty() as *StructNode }
            existing = existing.next
        }
        scan := colon.2
        local_paren : u64 = 0
        local_bracket : u64 = 0
        local_angle : u64 = 0
        marker_kind : u8 = 0
        marker_start : u64 = 0
        marker_end : u64 = 0
        while scan < field_source.len && marker_kind == 0 {
            token := next_token(field_source, scan)
            if token.0 == 40 { local_paren = local_paren + 1 } else {
                if token.0 == 41 && local_paren > 0 { local_paren = local_paren - 1 } else {
                    if token.0 == 91 { local_bracket = local_bracket + 1 } else {
                        if token.0 == 93 && local_bracket > 0 { local_bracket = local_bracket - 1 } else {
                            if token.0 == 60 { local_angle = local_angle + 1 } else {
                                if token.0 == 62 && local_angle > 0 { local_angle = local_angle - 1 } else {
                                    if local_paren == 0 && local_bracket == 0 && local_angle == 0 && (token.0 == 58 || token.0 == 61) {
                                        marker_kind = token.0
                                        marker_start = token.1
                                        marker_end = token.2
                                    }
                                }
                            }
                        }
                    }
                }
            }
            scan = token.2
        }
        type_end := field_source.len
        mutable := true
        default_value : *ExprNode = mimi_buffer_empty() as *ExprNode
        if marker_kind != 0 {
            type_end = marker_start
            default_value = parse_expression(field_source[marker_end:field_source.len], storage)
            if expression_is_null(default_value) { return mimi_buffer_empty() as *StructNode }
            shift_expression_tree(default_value, marker_end + segment_start)
            mutable = marker_kind == 61
        }
        data_type := parse_type(field_source[colon.2:type_end], storage)
        if expression_is_null(data_type) { return mimi_buffer_empty() as *StructNode }
        shift_expression_tree(data_type, colon.2 + segment_start)
        if mimi_arena_allocate(storage, 64, 8) == 0 { return mimi_buffer_empty() as *StructNode }
        field := storage.last as *StructFieldNode
        field.start = name.1 + segment_start
        field.end = segment_end
        field.name_start = name.1 + segment_start
        field.name_end = name.2 + segment_start
        field.mutable = mutable
        field.data_type = data_type
        field.default_value = default_value
        field.next = mimi_buffer_empty() as *StructFieldNode
        if last == (mimi_buffer_empty() as *StructFieldNode) { first = field } else { last.next = field }
        last = field
        count = count + 1
        separator := next_token(source, segment_end)
        if separator.0 == 125 {
            close_end = separator.2
            break
        }
        if separator.0 != 44 { return mimi_buffer_empty() as *StructNode }
        cursor = separator.2
        }
    }
    if close_end == 0 || next_token(source, close_end).0 != 0 { return mimi_buffer_empty() as *StructNode }
    if mimi_arena_allocate(storage, 56, 8) == 0 { return mimi_buffer_empty() as *StructNode }
    node := storage.last as *StructNode
    node.start = keyword.1
    node.end = close_end
    node.parameters = parameters
    node.field_count = count
    node.fields = first
    node.method_count = method_count
    node.methods = first_method
    node
}

struct_method_starts :: fn (source : []u8, start : u64) bool {
    name := next_token(source, start)
    open := next_token(source, name.2)
    close := next_token(source, open.2)
    colon1 := next_token(source, close.2)
    colon2 := next_token(source, colon1.2)
    function := next_token(source, colon2.2)
    name.0 == 1 && open.0 == 40 && close.0 == 41 && colon1.0 == 58 && colon2.0 == 58 && function.0 == 160
}

parse_struct_method :: fn (source : []u8, start : u64, storage : *ExpressionArena) *StructMethodNode {
    name := next_token(source, start)
    open_empty := next_token(source, name.2)
    close_empty := next_token(source, open_empty.2)
    colon1 := next_token(source, close_empty.2)
    colon2 := next_token(source, colon1.2)
    function_keyword := next_token(source, colon2.2)
    parameters_open := next_token(source, function_keyword.2)
    if !struct_method_starts(source, start) || parameters_open.0 != 40 { return mimi_buffer_empty() as *StructMethodNode }
    cursor := parameters_open.2
    depth : u64 = 1
    parameters_end := source.len
    parameters_close := source.len
    while cursor < source.len && depth > 0 {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *StructMethodNode }
        cursor = token.2
        if token.0 == 40 { depth = depth + 1 } else {
            if token.0 == 41 {
                depth = depth - 1
                if depth == 0 {
                    parameters_end = token.1
                    parameters_close = token.2
                }
            }
        }
    }
    if depth != 0 { return mimi_buffer_empty() as *StructMethodNode }
    body_open := next_token(source, parameters_close)
    return_end := source.len
    scan := parameters_close
    while scan < source.len && body_open.0 != 123 {
        token := next_token(source, scan)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *StructMethodNode }
        if token.0 == 123 {
            body_open = token
            return_end = token.1
        } else { scan = token.2 }
    }
    if body_open.0 != 123 { return mimi_buffer_empty() as *StructMethodNode }
    return_type := parse_type(source[parameters_close:return_end], storage)
    if expression_is_null(return_type) { return mimi_buffer_empty() as *StructMethodNode }
    shift_expression_tree(return_type, parameters_close)
    body_span := parse_block_span(source[body_open.1:source.len], body_open.1, storage)
    if block_node_is_null(body_span) { return mimi_buffer_empty() as *StructMethodNode }
    body := parse_statement_block(source[body_open.1:body_span.end], body_open.1, storage)
    if block_node_is_null(body) { return mimi_buffer_empty() as *StructMethodNode }
    header := FunctionHeader { start = start, end = body_open.2, name_start = name.1, name_end = name.2, parameters_start = parameters_open.2, parameters_end = parameters_end, return_type_start = parameters_close, return_type_end = return_end, body_start = body_open.2 }
    parameters := parse_parameters(source, &header, storage)
    if parameters_end != parameters_open.2 && parameter_list_is_null(parameters) { return mimi_buffer_empty() as *StructMethodNode }
    if mimi_arena_allocate(storage, 56, 8) == 0 { return mimi_buffer_empty() as *StructMethodNode }
    function_node := storage.last as *FunctionNode
    function_node.start = start
    function_node.end = body.end
    function_node.name_start = name.1
    function_node.name_end = name.2
    function_node.parameters = parameters
    function_node.return_type = return_type
    function_node.body = body
    if mimi_arena_allocate(storage, 48, 8) == 0 { return mimi_buffer_empty() as *StructMethodNode }
    method := storage.last as *StructMethodNode
    method.start = start
    method.end = body.end
    method.name_start = name.1
    method.name_end = name.2
    method.function = function_node
    method.next = mimi_buffer_empty() as *StructMethodNode
    method
}

pub struct_literal_is_null :: fn (literal : *StructLiteralNode) bool {
    literal == (mimi_buffer_empty() as *StructLiteralNode)
}

pub parse_struct_literal :: fn (source : []u8, storage : *ExpressionArena) *StructLiteralNode {
    type_name := next_token(source, 0)
    if type_name.0 != 1 { return mimi_buffer_empty() as *StructLiteralNode }
    cursor := type_name.2
    type_end := type_name.2
    suffix := next_token(source, cursor)
    while suffix.0 == 46 {
        member := next_token(source, suffix.2)
        if member.0 != 1 { return mimi_buffer_empty() as *StructLiteralNode }
        cursor = member.2
        type_end = member.2
        suffix = next_token(source, cursor)
    }
    if suffix.0 == 60 {
        cursor = suffix.2
        angle_depth : u64 = 1
        found_generic_end := false
        while cursor < source.len && !found_generic_end {
            token := next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *StructLiteralNode }
            cursor = token.2
            if token.0 == 60 { angle_depth = angle_depth + 1 } else {
                if token.0 == 62 {
                    angle_depth = angle_depth - 1
                    if angle_depth == 0 {
                        type_end = token.2
                        found_generic_end = true
                    }
                }
            }
        }
        if !found_generic_end { return mimi_buffer_empty() as *StructLiteralNode }
    }
    opening := next_token(source, cursor)
    if opening.0 != 123 { return mimi_buffer_empty() as *StructLiteralNode }
    cursor = opening.2
    first : *StructLiteralFieldNode = mimi_buffer_empty() as *StructLiteralFieldNode
    last : *StructLiteralFieldNode = mimi_buffer_empty() as *StructLiteralFieldNode
    count : u64 = 0
    close_end : u64 = 0
    while cursor < source.len {
        if next_token(source, cursor).0 == 125 {
            close := next_token(source, cursor)
            close_end = close.2
            break
        }
        segment_start := cursor
        segment_end := source.len
        paren_depth : u64 = 0
        bracket_depth : u64 = 0
        brace_depth : u64 = 0
        found_separator := false
        while cursor < source.len && !found_separator {
            token := next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *StructLiteralNode }
            cursor = token.2
            if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                if token.0 == 41 {
                    if paren_depth == 0 { return mimi_buffer_empty() as *StructLiteralNode }
                    paren_depth = paren_depth - 1
                } else {
                    if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                        if token.0 == 93 {
                            if bracket_depth == 0 { return mimi_buffer_empty() as *StructLiteralNode }
                            bracket_depth = bracket_depth - 1
                        } else {
                            if token.0 == 123 { brace_depth = brace_depth + 1 } else {
                                if token.0 == 125 {
                                    if brace_depth > 0 { brace_depth = brace_depth - 1 } else {
                                        if paren_depth == 0 && bracket_depth == 0 {
                                            segment_end = token.1
                                            close_end = token.2
                                            found_separator = true
                                        }
                                    }
                                } else {
                                    if token.0 == 44 && paren_depth == 0 && bracket_depth == 0 && brace_depth == 0 {
                                        segment_end = token.1
                                        found_separator = true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if !found_separator || paren_depth != 0 || bracket_depth != 0 || brace_depth != 0 { return mimi_buffer_empty() as *StructLiteralNode }
        field_source := source[segment_start:segment_end]
        name := next_token(field_source, 0)
        equal := next_token(field_source, name.2)
        if name.0 != 1 || equal.0 != 61 { return mimi_buffer_empty() as *StructLiteralNode }
        existing := first
        while existing != (mimi_buffer_empty() as *StructLiteralFieldNode) {
            if source_names_equal(source, existing.name_start, existing.name_end, name.1 + segment_start, name.2 + segment_start) { return mimi_buffer_empty() as *StructLiteralNode }
            existing = existing.next
        }
        value := parse_expression(field_source[equal.2:field_source.len], storage)
        if expression_is_null(value) { return mimi_buffer_empty() as *StructLiteralNode }
        shift_expression_tree(value, equal.2 + segment_start)
        if mimi_arena_allocate(storage, 48, 8) == 0 { return mimi_buffer_empty() as *StructLiteralNode }
        field := storage.last as *StructLiteralFieldNode
        field.start = name.1 + segment_start
        field.end = segment_end
        field.name_start = name.1 + segment_start
        field.name_end = name.2 + segment_start
        field.value = value
        field.next = mimi_buffer_empty() as *StructLiteralFieldNode
        if last == (mimi_buffer_empty() as *StructLiteralFieldNode) { first = field } else { last.next = field }
        last = field
        count = count + 1
        separator := next_token(source, segment_end)
        if separator.0 == 125 {
            close_end = separator.2
            break
        }
        if separator.0 != 44 { return mimi_buffer_empty() as *StructLiteralNode }
        cursor = separator.2
    }
    if close_end == 0 || next_token(source, close_end).0 != 0 { return mimi_buffer_empty() as *StructLiteralNode }
    if mimi_arena_allocate(storage, 48, 8) == 0 { return mimi_buffer_empty() as *StructLiteralNode }
    literal := storage.last as *StructLiteralNode
    literal.start = type_name.1
    literal.end = close_end
    literal.type_start = type_name.1
    literal.type_end = type_end
    literal.field_count = count
    literal.fields = first
    literal
}

parse_cast_expression :: fn (source : []u8, storage : *ExpressionArena) *ExprNode {
    cursor : u64 = 0
    paren_depth : u64 = 0
    bracket_depth : u64 = 0
    cast_start := source.len
    cast_end := source.len
    while cursor < source.len {
        token := next_token(source, cursor)
        if token.0 == 255 { return mimi_buffer_empty() as *ModuleNode }
        if token.0 == 0 { break }
        cursor = token.2
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 && paren_depth > 0 { paren_depth = paren_depth - 1 } else {
                if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                    if token.0 == 93 && bracket_depth > 0 { bracket_depth = bracket_depth - 1 } else {
                        if token.0 == 174 && paren_depth == 0 && bracket_depth == 0 {
                            if cast_start != source.len { return mimi_buffer_empty() as *ExprNode }
                            cast_start = token.1
                            cast_end = token.2
                        }
                    }
                }
            }
        }
    }
    if cast_start == source.len { return mimi_buffer_empty() as *ExprNode }
    left_source := source[0:cast_start]
    first := next_token(left_source, 0)
    left := parse_expression(left_source, storage)
    if expression_is_null(left) { return left }
    if expression_precedence(left.kind as u8) != 0 && first.0 != 40 { return mimi_buffer_empty() as *ExprNode }
    data_type := parse_type(source[cast_end:source.len], storage)
    if expression_is_null(data_type) { return data_type }
    shift_expression_tree(data_type, cast_end)
    allocate_expr(storage, 293, left.start, data_type.end, left, data_type)
}

pub function_node_is_null :: fn (function : *FunctionNode) bool {
    function == (mimi_buffer_empty() as *FunctionNode)
}

pub module_node_is_null :: fn (module : *ModuleNode) bool {
    module == (mimi_buffer_empty() as *ModuleNode)
}

pub parse_module :: fn (source : []u8, storage : *ExpressionArena) *ModuleNode {
    issue := ModuleParseIssue { start = 0, end = 0 }
    parse_module_with_issue(source, storage, &issue)
}

pub ModuleParseIssue :: struct {
    start : u64,
    end : u64,
}

pub parse_module_with_issue :: fn (source : []u8, storage : *ExpressionArena, issue : *ModuleParseIssue) *ModuleNode {
    first : *ModuleDeclarationNode = mimi_buffer_empty() as *ModuleDeclarationNode
    last : *ModuleDeclarationNode = mimi_buffer_empty() as *ModuleDeclarationNode
    count : u64 = 0
    segment_start := next_token(source, 0).1
    cursor : u64 = 0
    brace_depth : u64 = 0
    paren_depth : u64 = 0
    bracket_depth : u64 = 0
    previous_kind : u8 = 0
    while cursor < source.len {
        token := next_token(source, cursor)
        if token.0 == 255 {
            issue.start = token.1
            issue.end = token.2
            return mimi_buffer_empty() as *ModuleNode
        }
        if token.0 == 0 { break }
        at_top := brace_depth == 0 && paren_depth == 0 && bracket_depth == 0
        if at_top && token.1 > segment_start && previous_kind != 166 && previous_kind != 167 && module_declaration_starts(source, token) {
            declaration := parse_module_declaration(source[segment_start:token.1], segment_start, storage)
            if declaration == (mimi_buffer_empty() as *ModuleDeclarationNode) {
                first_token := next_token(source, segment_start)
                issue.start = first_token.1
                issue.end = first_token.2
                return mimi_buffer_empty() as *ModuleNode
            }
            previous := first
            while previous != (mimi_buffer_empty() as *ModuleDeclarationNode) {
                if source_names_equal(source, previous.name_start, previous.name_end, declaration.name_start, declaration.name_end) {
                    issue.start = declaration.name_start
                    issue.end = declaration.name_end
                    return mimi_buffer_empty() as *ModuleNode
                }
                previous = previous.next
            }
            if first == (mimi_buffer_empty() as *ModuleDeclarationNode) { first = declaration } else { last.next = declaration }
            last = declaration
            count = count + 1
            segment_start = token.1
        }
        cursor = token.2
        previous_kind = token.0
        if token.0 == 123 { brace_depth = brace_depth + 1 } else {
            if token.0 == 125 {
                if brace_depth == 0 {
                    issue.start = token.1
                    issue.end = token.2
                    return mimi_buffer_empty() as *ModuleNode
                }
                brace_depth = brace_depth - 1
            } else {
                if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                    if token.0 == 41 && paren_depth > 0 { paren_depth = paren_depth - 1 } else {
                        if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                            if token.0 == 93 && bracket_depth > 0 { bracket_depth = bracket_depth - 1 }
                        }
                    }
                }
            }
        }
    }
    if brace_depth != 0 || paren_depth != 0 || bracket_depth != 0 {
        issue.start = if cursor > 0 { cursor - 1 } else { 0 }
        issue.end = cursor
        return mimi_buffer_empty() as *ModuleNode
    }
    trailing := next_token(source, segment_start)
    if trailing.0 != 0 {
        declaration := parse_module_declaration(source[segment_start:source.len], segment_start, storage)
        if declaration == (mimi_buffer_empty() as *ModuleDeclarationNode) {
            issue.start = trailing.1
            issue.end = trailing.2
            return mimi_buffer_empty() as *ModuleNode
        }
        previous := first
        while previous != (mimi_buffer_empty() as *ModuleDeclarationNode) {
            if source_names_equal(source, previous.name_start, previous.name_end, declaration.name_start, declaration.name_end) {
                issue.start = declaration.name_start
                issue.end = declaration.name_end
                return mimi_buffer_empty() as *ModuleNode
            }
            previous = previous.next
        }
        if first == (mimi_buffer_empty() as *ModuleDeclarationNode) { first = declaration } else { last.next = declaration }
        last = declaration
        count = count + 1
    }
    if mimi_arena_allocate(storage, 32, 8) == 0 { return mimi_buffer_empty() as *ModuleNode }
    module := storage.last as *ModuleNode
    module.start = 0
    module.end = source.len
    module.declaration_count = count
    module.declarations = first
    module
}

module_declaration_starts :: fn (source : []u8, token : (u8, u64, u64)) bool {
    if token.0 == 167 { return true }
    if token.0 == 166 {
        name := next_token(source, token.2)
        colon1 := next_token(source, name.2)
        colon2 := next_token(source, colon1.2)
        return name.0 == 1 && colon1.0 == 58 && colon2.0 == 58
    }
    if token.0 != 1 { return false }
    colon1 := next_token(source, token.2)
    colon2 := next_token(source, colon1.2)
    if colon1.0 != 58 { return false }
    if colon2.0 == 58 || colon2.0 == 61 { return true }
    scan := colon2.2
    parens : u64 = 0
    brackets : u64 = 0
    angles : u64 = 0
    while scan < source.len {
        part := next_token(source, scan)
        if part.0 == 0 || part.0 == 255 { return false }
        if part.0 == 123 || part.0 == 125 { return false }
        if part.0 == 40 { parens = parens + 1 } else {
            if part.0 == 41 && parens > 0 { parens = parens - 1 } else {
                if part.0 == 91 { brackets = brackets + 1 } else {
                    if part.0 == 93 && brackets > 0 { brackets = brackets - 1 } else {
                        if part.0 == 60 { angles = angles + 1 } else {
                            if part.0 == 62 && angles > 0 { angles = angles - 1 }
                        }
                    }
                }
            }
        }
        if part.0 == 61 && parens == 0 && brackets == 0 && angles == 0 { return true }
        scan = part.2
    }
    false
}

parse_module_declaration :: fn (source : []u8, offset : u64, storage : *ExpressionArena) *ModuleDeclarationNode {
    first := next_token(source, 0)
    is_public := first.0 == 166
    is_external := first.0 == 167
    name := first
    if is_public { name = next_token(source, first.2) }
    if is_external { name = next_token(source, first.2) }
    colon1 := next_token(source, name.2)
    colon2 := next_token(source, colon1.2)
    if name.0 != 1 || colon1.0 != 58 { return mimi_buffer_empty() as *ModuleDeclarationNode }
    declaration := next_token(source, if is_external { colon1.2 } else { colon2.2 })
    kind : u64 = 0
    binding : *BindingNode = mimi_buffer_empty() as *BindingNode
    function : *FunctionNode = mimi_buffer_empty() as *FunctionNode
    struct_node : *StructNode = mimi_buffer_empty() as *StructNode
    enum_node : *EnumNode = mimi_buffer_empty() as *EnumNode
    path_start : u64 = 0
    path_end : u64 = 0
    value_start : u64 = 0
    value_end : u64 = 0
    end := source.len
    if is_external {
        if declaration.0 != 160 { return mimi_buffer_empty() as *ModuleDeclarationNode }
        function = parse_external_function_node(source, name, declaration, offset, storage)
        if function_node_is_null(function) { return mimi_buffer_empty() as *ModuleDeclarationNode }
        kind = 7
    } else {
    if declaration.0 == 160 {
        function = parse_function_definition(source[(if is_public { name.1 } else { 0 }):source.len], storage)
        if function_node_is_null(function) { return mimi_buffer_empty() as *ModuleDeclarationNode }
        function.start = function.start + offset + (if is_public { name.1 } else { 0 })
        function.end = function.end + offset + (if is_public { name.1 } else { 0 })
        function.name_start = function.name_start + offset + (if is_public { name.1 } else { 0 })
        function.name_end = function.name_end + offset + (if is_public { name.1 } else { 0 })
        shift_function_contents(function, offset + (if is_public { name.1 } else { 0 }))
        kind = 1
        end = function.end - offset
    } else {
        if declaration.0 == 161 {
            struct_node = parse_struct_declaration(source[declaration.1:source.len], storage)
            if struct_node_is_null(struct_node) { return mimi_buffer_empty() as *ModuleDeclarationNode }
            kind = 2
            end = declaration.1 + struct_node.end
            shift_struct_declaration(struct_node, offset + declaration.1)
        } else {
            if declaration.0 == 162 {
                enum_node = parse_enum_declaration(source[declaration.1:source.len], storage)
                if enum_node_is_null(enum_node) { return mimi_buffer_empty() as *ModuleDeclarationNode }
                kind = 3
                end = declaration.1 + enum_node.end
                shift_enum_declaration(enum_node, offset + declaration.1)
            } else {
                if declaration.0 == 64 {
                    at := declaration
                    import_name := next_token(source, at.2)
                    open := next_token(source, import_name.2)
                    path := next_token(source, open.2)
                    close := next_token(source, path.2)
                    if at.0 != 64 || import_name.0 != 1 || open.0 != 40 { return mimi_buffer_empty() as *ModuleDeclarationNode }
                    is_import := source_name_equals(source, import_name.1, import_name.2, "import")
                    is_cimport := source_name_equals(source, import_name.1, import_name.2, "cimport")
                    is_define := source_name_equals(source, import_name.1, import_name.2, "cDefine")
                    if path.0 != 3 { return mimi_buffer_empty() as *ModuleDeclarationNode }
                    if is_define {
                        comma := next_token(source, path.2)
                        value := next_token(source, comma.2)
                        close := next_token(source, value.2)
                        if comma.0 != 44 || (value.0 != 3 && value.0 != 2) || close.0 != 41 || next_token(source, close.2).0 != 0 { return mimi_buffer_empty() as *ModuleDeclarationNode }
                        kind = 8
                        path_start = path.1 + offset
                        path_end = path.2 + offset
                        value_start = value.1 + offset
                        value_end = value.2 + offset
                    } else {
                        close := next_token(source, path.2)
                        if (!is_import && !is_cimport) || close.0 != 41 || next_token(source, close.2).0 != 0 { return mimi_buffer_empty() as *ModuleDeclarationNode }
                        kind = 4
                        if is_cimport { kind = 6 }
                        path_start = path.1 + offset
                        path_end = path.2 + offset
                    }
                } else {
                    binding = parse_binding_declaration(source[name.1:source.len], storage)
                    if binding_node_is_null(binding) { return mimi_buffer_empty() as *ModuleDeclarationNode }
                    kind = 5
                    shift_binding_node(binding, offset + name.1)
                    end = name.1 + binding.end - offset - name.1
                }
            }
        }
    }
    }
    if mimi_arena_allocate(storage, 128, 8) == 0 { return mimi_buffer_empty() as *ModuleDeclarationNode }
    node := storage.last as *ModuleDeclarationNode
    node.kind = kind
    node.is_public = is_public
    node.start = first.1 + offset
    node.end = end + offset
    node.name_start = name.1 + offset
    node.name_end = name.2 + offset
    node.path_start = path_start
    node.path_end = path_end
    node.value_start = value_start
    node.value_end = value_end
    node.binding = binding
    node.function = function
    node.struct_node = struct_node
    node.enum_node = enum_node
    node.is_external = is_external
    node.next = mimi_buffer_empty() as *ModuleDeclarationNode
    node
}

parse_external_function_node :: fn (source : []u8, name : (u8, u64, u64), keyword : (u8, u64, u64), offset : u64, storage : *ExpressionArena) *FunctionNode {
    opening := next_token(source, keyword.2)
    if opening.0 != 40 { return mimi_buffer_empty() as *FunctionNode }
    cursor := opening.2
    depth : u64 = 1
    parameters_end := cursor
    parameters_close := cursor
    while cursor < source.len && depth > 0 {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *FunctionNode }
        cursor = token.2
        if token.0 == 40 { depth = depth + 1 } else {
            if token.0 == 41 {
                depth = depth - 1
                if depth == 0 {
                    parameters_end = token.1
                    parameters_close = token.2
                }
            }
        }
    }
    if depth != 0 { return mimi_buffer_empty() as *FunctionNode }
    return_type := parse_type(source[parameters_close:source.len], storage)
    if expression_is_null(return_type) { return mimi_buffer_empty() as *FunctionNode }
    header := FunctionHeader { start = name.1, end = source.len, name_start = name.1, name_end = name.2, parameters_start = opening.2, parameters_end = parameters_end, return_type_start = parameters_close, return_type_end = source.len, body_start = source.len }
    parameters := parse_parameters(source, &header, storage)
    if parameters_end != opening.2 && parameter_list_is_null(parameters) { return mimi_buffer_empty() as *FunctionNode }
    if mimi_arena_allocate(storage, 56, 8) == 0 { return mimi_buffer_empty() as *FunctionNode }
    function := storage.last as *FunctionNode
    function.start = name.1 + offset
    function.end = source.len + offset
    function.name_start = name.1 + offset
    function.name_end = name.2 + offset
    function.parameters = parameters
    function.return_type = return_type
    function.body = mimi_buffer_empty() as *BlockNode
    current := parameters
    while !parameter_list_is_null(current) {
        current.name_start = current.name_start + offset
        current.name_end = current.name_end + offset
        shift_expression_tree(current.data_type, offset)
        current = current.next
    }
    shift_expression_tree(return_type, parameters_close + offset)
    function
}

source_name_equals :: fn (source : []u8, start : u64, end : u64, expected : []u8) bool {
    if end - start != expected.len { return false }
    index : u64 = 0
    while index < expected.len {
        if source[start + index] != expected[index] { return false }
        index = index + 1
    }
    true
}

shift_function_contents :: fn (function : *FunctionNode, offset : u64) void {
    parameter := function.parameters
    while !parameter_list_is_null(parameter) {
        parameter.name_start = parameter.name_start + offset
        parameter.name_end = parameter.name_end + offset
        shift_expression_tree(parameter.data_type, offset)
        parameter = parameter.next
    }
    shift_expression_tree(function.return_type, offset)
    shift_block_span(function.body, offset)
}

shift_binding_node :: fn (binding : *BindingNode, offset : u64) void {
    binding.start = binding.start + offset
    binding.end = binding.end + offset
    binding.name_start = binding.name_start + offset
    binding.name_end = binding.name_end + offset
    if !expression_is_null(binding.data_type) { shift_expression_tree(binding.data_type, offset) }
    shift_expression_tree(binding.initializer, offset)
}

shift_generic_parameters :: fn (parameters : *GenericParameterList, offset : u64) void {
    if generic_parameter_list_is_null(parameters) { return }
    parameters.start = parameters.start + offset
    parameters.end = parameters.end + offset
    current := parameters.first
    while current != (mimi_buffer_empty() as *GenericParameterNode) {
        current.start = current.start + offset
        current.end = current.end + offset
        current = current.next
    }
}

shift_struct_declaration :: fn (node : *StructNode, offset : u64) void {
    node.start = node.start + offset
    node.end = node.end + offset
    shift_generic_parameters(node.parameters, offset)
    field := node.fields
    while field != (mimi_buffer_empty() as *StructFieldNode) {
        field.start = field.start + offset
        field.end = field.end + offset
        field.name_start = field.name_start + offset
        field.name_end = field.name_end + offset
        shift_expression_tree(field.data_type, offset)
        if !expression_is_null(field.default_value) { shift_expression_tree(field.default_value, offset) }
        field = field.next
    }
    method := node.methods
    while method != (mimi_buffer_empty() as *StructMethodNode) {
        method.start = method.start + offset
        method.end = method.end + offset
        method.name_start = method.name_start + offset
        method.name_end = method.name_end + offset
        method.function.start = method.function.start + offset
        method.function.end = method.function.end + offset
        method.function.name_start = method.function.name_start + offset
        method.function.name_end = method.function.name_end + offset
        shift_function_contents(method.function, offset)
        method = method.next
    }
}

shift_enum_declaration :: fn (node : *EnumNode, offset : u64) void {
    node.start = node.start + offset
    node.end = node.end + offset
    shift_generic_parameters(node.parameters, offset)
    variant := node.variants
    while variant != (mimi_buffer_empty() as *EnumVariantNode) {
        variant.start = variant.start + offset
        variant.end = variant.end + offset
        variant.name_start = variant.name_start + offset
        variant.name_end = variant.name_end + offset
        if !expression_is_null(variant.payload_type) { shift_expression_tree(variant.payload_type, offset) }
        variant = variant.next
    }
}

pub parse_function_definition :: fn (source : []u8, storage : *ExpressionArena) *FunctionNode {
    header := parse_function_header(source, storage)
    if function_header_is_null(header) { return mimi_buffer_empty() as *FunctionNode }
    if header.body_start >= source.len { return mimi_buffer_empty() as *FunctionNode }
    body := parse_statement_block(source[header.body_start - 1:source.len], header.body_start - 1, storage)
    if block_node_is_null(body) { return mimi_buffer_empty() as *FunctionNode }
    parameters := parse_parameters(source, header, storage)
    if header.parameters_start != header.parameters_end && parameter_list_is_null(parameters) {
        return mimi_buffer_empty() as *FunctionNode
    }
    return_type := parse_type(source[header.return_type_start:header.return_type_end], storage)
    if expression_is_null(return_type) { return mimi_buffer_empty() as *FunctionNode }
    shift_expression_tree(return_type, header.return_type_start)
    if mimi_arena_allocate(storage, 56, 8) == 0 { return mimi_buffer_empty() as *FunctionNode }
    function := storage.last as *FunctionNode
    function.start = header.start
    function.end = body.end
    function.name_start = header.name_start
    function.name_end = header.name_end
    function.parameters = parameters
    function.return_type = return_type
    function.body = body
    function
}

pub parameter_list_is_null :: fn (parameter : *ParameterNode) bool {
    parameter == (mimi_buffer_empty() as *ParameterNode)
}

pub parse_parameters :: fn (source : []u8, header : *FunctionHeader, storage : *ExpressionArena) *ParameterNode {
    if function_header_is_null(header) { return mimi_buffer_empty() as *ParameterNode }
    if header.parameters_start == header.parameters_end { return mimi_buffer_empty() as *ParameterNode }
    first : *ParameterNode = mimi_buffer_empty() as *ParameterNode
    last : *ParameterNode = mimi_buffer_empty() as *ParameterNode
    segment_start := header.parameters_start
    cursor := segment_start
    bracket_depth : u64 = 0
    paren_depth : u64 = 0
    angle_depth : u64 = 0
    while cursor <= header.parameters_end {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *ParameterNode }
        cursor = token.2
        if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
            if token.0 == 93 && bracket_depth > 0 { bracket_depth = bracket_depth - 1 }
        }
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 && paren_depth > 0 { paren_depth = paren_depth - 1 }
        }
        if token.0 == 60 { angle_depth = angle_depth + 1 } else {
            if token.0 == 62 && angle_depth > 0 { angle_depth = angle_depth - 1 }
        }
        if (token.0 == 44 && bracket_depth == 0 && paren_depth == 0 && angle_depth == 0) || token.2 > header.parameters_end {
            segment_end := token.1
            if token.2 > header.parameters_end { segment_end = header.parameters_end }
            parameter := parse_parameter(source[segment_start:segment_end], segment_start, storage)
            if parameter == (mimi_buffer_empty() as *ParameterNode) { return parameter }
            previous := first
            duplicate := false
            while previous != (mimi_buffer_empty() as *ParameterNode) && !duplicate {
                if previous.name_end - previous.name_start == parameter.name_end - parameter.name_start {
                    equal := true
                    index : u64 = 0
                    while index < parameter.name_end - parameter.name_start && equal {
                        if source[previous.name_start + index] != source[parameter.name_start + index] { equal = false }
                        index = index + 1
                    }
                    if equal { duplicate = true }
                }
                previous = previous.next
            }
            if duplicate { return mimi_buffer_empty() as *ParameterNode }
            if parameter_list_is_null(first) { first = parameter } else { last.next = parameter }
            last = parameter
            segment_start = token.2
        }
    }
    if cursor <= header.parameters_end { return mimi_buffer_empty() as *ParameterNode }
    first
}

pub parse_tuple_literal :: fn (source : []u8, storage : *ExpressionArena) *ExprNode {
    opening := next_token(source, 0)
    if opening.0 != 40 { return mimi_buffer_empty() as *ExprNode }
    cursor := opening.2
    items : *ExprNode = mimi_buffer_empty() as *ExprNode
    count : u64 = 0
    while true {
        if next_token(source, cursor).0 == 41 { return mimi_buffer_empty() as *ExprNode }
        segment_start := cursor
        segment_end := source.len
        paren_depth : u64 = 0
        bracket_depth : u64 = 0
        found_separator := false
        while cursor < source.len && !found_separator {
            token := next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *ExprNode }
            cursor = token.2
            if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                if token.0 == 41 {
                    if paren_depth > 0 { paren_depth = paren_depth - 1 } else {
                        if bracket_depth == 0 {
                            segment_end = token.1
                            found_separator = true
                        }
                    }
                } else {
                    if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                        if token.0 == 93 {
                            if bracket_depth == 0 { return mimi_buffer_empty() as *ExprNode }
                            bracket_depth = bracket_depth - 1
                        } else {
                            if token.0 == 44 && paren_depth == 0 && bracket_depth == 0 {
                                segment_end = token.1
                                found_separator = true
                            }
                        }
                    }
                }
            }
        }
        if !found_separator || paren_depth != 0 || bracket_depth != 0 { return mimi_buffer_empty() as *ExprNode }
        item := parse_expression(source[segment_start:segment_end], storage)
        if expression_is_null(item) { return item }
        shift_expression_tree(item, segment_start)
        if count == 0 { items = item } else {
            items = allocate_expr(storage, 262, items.start, item.end, items, item)
            if expression_is_null(items) { return items }
        }
        count = count + 1
        separator := next_token(source, segment_end)
        if separator.0 == 41 {
            if count < 2 || next_token(source, separator.2).0 != 0 { return mimi_buffer_empty() as *ExprNode }
            return allocate_expr(storage, 268, opening.1, separator.2, items, mimi_buffer_empty() as *ExprNode)
        }
        if separator.0 != 44 { return mimi_buffer_empty() as *ExprNode }
        cursor = separator.2
        trailing_close := next_token(source, cursor)
        if trailing_close.0 == 41 {
            if next_token(source, trailing_close.2).0 != 0 { return mimi_buffer_empty() as *ExprNode }
            return allocate_expr(storage, 268, opening.1, trailing_close.2, items, mimi_buffer_empty() as *ExprNode)
        }
    }
    mimi_buffer_empty() as *ExprNode
}

parse_parameter :: fn (source : []u8, offset : u64, storage : *ExpressionArena) *ParameterNode {
    name := next_token(source, 0)
    colon := next_token(source, name.2)
    if name.0 != 1 || colon.0 != 58 { return mimi_buffer_empty() as *ParameterNode }
    type_start := colon.2
    data_type := parse_type(source[type_start:source.len], storage)
    if expression_is_null(data_type) { return mimi_buffer_empty() as *ParameterNode }
    shift_expression_tree(data_type, offset + type_start)
    if mimi_arena_allocate(storage, 32, 8) == 0 { return mimi_buffer_empty() as *ParameterNode }
    parameter := storage.last as *ParameterNode
    parameter.name_start = name.1 + offset
    parameter.name_end = name.2 + offset
    parameter.data_type = data_type
    parameter.next = mimi_buffer_empty() as *ParameterNode
    parameter
}

pub parse_type :: fn (source : []u8, storage : *ExpressionArena) *ExprNode {
    if source.len > 500000000000000000 { return mimi_buffer_empty() as *ExprNode }
    first := next_token(source, 0)
    if first.0 == 40 { return parse_tuple_type(source, storage) }
    if first.0 == 160 { return parse_function_type(source, storage) }
    if mimi_arena_allocate(storage, source.len * 32 + 32, 8) == 0 { return mimi_buffer_empty() as *ExprNode }
    prefixes := storage.last as *ExprOperator
    prefix_count : u64 = 0
    cursor : u64 = 0
    token := next_token(source, cursor)
    if token.0 == 42 {
        prefixes[prefix_count] = ExprOperator { kind = 271, start = token.1, base_count = 0, argument_count = 0 }
        prefix_count = prefix_count + 1
        cursor = token.2
    } else {
        if token.0 == 91 {
            next := next_token(source, token.2)
            if next.0 == 93 {
                prefixes[prefix_count] = ExprOperator { kind = 272, start = token.1, base_count = 0, argument_count = 0 }
                prefix_count = prefix_count + 1
                cursor = next.2
            } else {
                if next.0 != 2 { return mimi_buffer_empty() as *ExprNode }
                close := next_token(source, next.2)
                if close.0 != 93 { return mimi_buffer_empty() as *ExprNode }
                count_node := allocate_expr(storage, 2, next.1, next.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
                if expression_is_null(count_node) { return count_node }
                prefixes[prefix_count] = ExprOperator { kind = 273, start = token.1, base_count = count_node.start, argument_count = count_node.end }
                prefix_count = prefix_count + 1
                cursor = close.2
            }
        }
    }
    while true {
        token = next_token(source, cursor)
        if token.0 == 42 {
            prefixes[prefix_count] = ExprOperator { kind = 271, start = token.1, base_count = 0, argument_count = 0 }
            prefix_count = prefix_count + 1
            cursor = token.2
        } else {
            if token.0 == 91 {
                next := next_token(source, token.2)
                if next.0 == 93 {
                    prefixes[prefix_count] = ExprOperator { kind = 272, start = token.1, base_count = 0, argument_count = 0 }
                    prefix_count = prefix_count + 1
                    cursor = next.2
                } else {
                    if next.0 != 2 { return mimi_buffer_empty() as *ExprNode }
                    close := next_token(source, next.2)
                    if close.0 != 93 { return mimi_buffer_empty() as *ExprNode }
                    prefixes[prefix_count] = ExprOperator { kind = 273, start = token.1, base_count = next.1, argument_count = next.2 }
                    prefix_count = prefix_count + 1
                    cursor = close.2
                }
            } else { break }
        }
    }
    name := next_token(source, cursor)
    if name.0 != 1 && name.0 != 4 && name.0 != 5 { return mimi_buffer_empty() as *ExprNode }
    node := allocate_expr(storage, 270, name.1, name.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
    if expression_is_null(node) { return node }
    suffix := next_token(source, name.2)
    while suffix.0 == 46 {
        member := next_token(source, suffix.2)
        if member.0 != 1 { return mimi_buffer_empty() as *ExprNode }
        member_node := allocate_expr(storage, 270, member.1, member.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
        if expression_is_null(member_node) { return member_node }
        node = allocate_expr(storage, 260, node.start, member.2, node, member_node)
        if expression_is_null(node) { return node }
        suffix = next_token(source, member.2)
    }
    if suffix.0 == 60 {
        if node.kind != 270 { return mimi_buffer_empty() as *ExprNode }
        node = parse_generic_type(source, name, suffix, storage)
    } else {
        if suffix.0 != 0 { return mimi_buffer_empty() as *ExprNode }
    }
    if expression_is_null(node) { return node }
    while prefix_count > 0 {
        prefix_count = prefix_count - 1
        prefix := prefixes[prefix_count]
        if prefix.kind == 273 {
            count := allocate_expr(storage, 2, prefix.base_count, prefix.argument_count, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
            if expression_is_null(count) { return count }
            node = allocate_expr(storage, prefix.kind, prefix.start, node.end, node, count)
        } else {
            node = allocate_expr(storage, prefix.kind, prefix.start, node.end, node, mimi_buffer_empty() as *ExprNode)
        }
        if expression_is_null(node) { return node }
    }
    node
}

parse_generic_type :: fn (source : []u8, name : (u8, u64, u64), opening : (u8, u64, u64), storage : *ExpressionArena) *ExprNode {
    cursor := opening.2
    arguments : *ExprNode = mimi_buffer_empty() as *ExprNode
    count : u64 = 0
    while true {
        if next_token(source, cursor).0 == 62 { return mimi_buffer_empty() as *ExprNode }
        segment_start := cursor
        segment_end := source.len
        angle_depth : u64 = 0
        paren_depth : u64 = 0
        bracket_depth : u64 = 0
        found_separator := false
        while cursor < source.len && !found_separator {
            token := next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *ExprNode }
            cursor = token.2
            if token.0 == 60 { angle_depth = angle_depth + 1 } else {
                if token.0 == 62 {
                    if angle_depth > 0 { angle_depth = angle_depth - 1 } else {
                        if paren_depth == 0 && bracket_depth == 0 {
                            segment_end = token.1
                            found_separator = true
                        }
                    }
                } else {
                    if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                        if token.0 == 41 {
                            if paren_depth == 0 { return mimi_buffer_empty() as *ExprNode }
                            paren_depth = paren_depth - 1
                        } else {
                            if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                                if token.0 == 93 {
                                    if bracket_depth == 0 { return mimi_buffer_empty() as *ExprNode }
                                    bracket_depth = bracket_depth - 1
                                } else {
                                    if token.0 == 44 && angle_depth == 0 && paren_depth == 0 && bracket_depth == 0 {
                                        segment_end = token.1
                                        found_separator = true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if !found_separator || angle_depth != 0 || paren_depth != 0 || bracket_depth != 0 { return mimi_buffer_empty() as *ExprNode }
        argument := parse_type(source[segment_start:segment_end], storage)
        if expression_is_null(argument) { argument = parse_expression(source[segment_start:segment_end], storage) }
        if expression_is_null(argument) { return argument }
        shift_expression_tree(argument, segment_start)
        if count == 0 { arguments = argument } else {
            arguments = allocate_expr(storage, 276, arguments.start, argument.end, arguments, argument)
            if expression_is_null(arguments) { return arguments }
        }
        count = count + 1
        separator := next_token(source, segment_end)
        if separator.0 == 62 {
            if next_token(source, separator.2).0 != 0 { return mimi_buffer_empty() as *ExprNode }
            base := allocate_expr(storage, 270, name.1, name.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
            if expression_is_null(base) { return base }
            return allocate_expr(storage, 278, name.1, separator.2, base, arguments)
        }
        if separator.0 != 44 { return mimi_buffer_empty() as *ExprNode }
        cursor = separator.2
        if next_token(source, cursor).0 == 62 { return mimi_buffer_empty() as *ExprNode }
    }
    mimi_buffer_empty() as *ExprNode
}

pub parse_tuple_type :: fn (source : []u8, storage : *ExpressionArena) *ExprNode {
    opening := next_token(source, 0)
    if opening.0 != 40 { return mimi_buffer_empty() as *ExprNode }
    cursor := opening.2
    elements : *ExprNode = mimi_buffer_empty() as *ExprNode
    count : u64 = 0
    while true {
        token := next_token(source, cursor)
        if token.0 == 41 || token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *ExprNode }
        segment_start := cursor
        bracket_depth : u64 = 0
        paren_depth : u64 = 0
        segment_end := source.len
        found_separator := false
        while cursor < source.len && !found_separator {
            token = next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *ExprNode }
            cursor = token.2
            if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                if token.0 == 93 {
                    if bracket_depth == 0 { return mimi_buffer_empty() as *ExprNode }
                    bracket_depth = bracket_depth - 1
                } else {
                    if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                        if token.0 == 41 {
                            if paren_depth > 0 { paren_depth = paren_depth - 1 } else {
                                if bracket_depth == 0 {
                                    segment_end = token.1
                                    found_separator = true
                                }
                            }
                        } else {
                            if bracket_depth == 0 && paren_depth == 0 && token.0 == 44 {
                                segment_end = token.1
                                found_separator = true
                            }
                        }
                    }
                }
            }
        }
        if !found_separator || bracket_depth != 0 || paren_depth != 0 { return mimi_buffer_empty() as *ExprNode }
        element := parse_type(source[segment_start:segment_end], storage)
        if expression_is_null(element) { return element }
        shift_expression_tree(element, segment_start)
        if count == 0 { elements = element } else {
            elements = allocate_expr(storage, 276, elements.start, element.end, elements, element)
            if expression_is_null(elements) { return elements }
        }
        count = count + 1
        separator := next_token(source, segment_end)
        if separator.0 == 41 {
            if next_token(source, separator.2).0 != 0 || count < 2 { return mimi_buffer_empty() as *ExprNode }
            return allocate_expr(storage, 275, opening.1, separator.2, elements, mimi_buffer_empty() as *ExprNode)
        }
        if separator.0 != 44 { return mimi_buffer_empty() as *ExprNode }
        cursor = separator.2
        trailing_close := next_token(source, cursor)
        if trailing_close.0 == 41 {
            if count == 0 || next_token(source, trailing_close.2).0 != 0 { return mimi_buffer_empty() as *ExprNode }
            return allocate_expr(storage, 275, opening.1, trailing_close.2, elements, mimi_buffer_empty() as *ExprNode)
        }
    }
    mimi_buffer_empty() as *ExprNode
}

pub parse_function_type :: fn (source : []u8, storage : *ExpressionArena) *ExprNode {
    keyword := next_token(source, 0)
    opening := next_token(source, keyword.2)
    if keyword.0 != 160 || opening.0 != 40 { return mimi_buffer_empty() as *ExprNode }
    cursor := opening.2
    parameters : *ExprNode = mimi_buffer_empty() as *ExprNode
    count : u64 = 0
    close_start : u64 = 0
    close_end : u64 = 0
    if next_token(source, cursor).0 == 41 {
        close := next_token(source, cursor)
        close_start = close.1
        close_end = close.2
    } else {
        while true {
            segment_start := cursor
            segment_end := source.len
            paren_depth : u64 = 0
            bracket_depth : u64 = 0
            found_separator := false
            while cursor < source.len && !found_separator {
                token := next_token(source, cursor)
                if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *ExprNode }
                cursor = token.2
                if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                    if token.0 == 41 {
                        if paren_depth > 0 { paren_depth = paren_depth - 1 } else {
                            if bracket_depth == 0 {
                                segment_end = token.1
                                close_start = token.1
                                close_end = token.2
                                found_separator = true
                            }
                        }
                    } else {
                        if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                            if token.0 == 93 {
                                if bracket_depth == 0 { return mimi_buffer_empty() as *ExprNode }
                                bracket_depth = bracket_depth - 1
                            } else {
                                if token.0 == 44 && paren_depth == 0 && bracket_depth == 0 {
                                    segment_end = token.1
                                    found_separator = true
                                }
                            }
                        }
                    }
                }
            }
            if !found_separator || paren_depth != 0 || bracket_depth != 0 { return mimi_buffer_empty() as *ExprNode }
            parameter := parse_type(source[segment_start:segment_end], storage)
            if expression_is_null(parameter) { return parameter }
            shift_expression_tree(parameter, segment_start)
            if count == 0 { parameters = parameter } else {
                parameters = allocate_expr(storage, 276, parameters.start, parameter.end, parameters, parameter)
                if expression_is_null(parameters) { return parameters }
            }
            count = count + 1
            separator := next_token(source, segment_end)
            if separator.0 == 41 { break }
            if separator.0 != 44 { return mimi_buffer_empty() as *ExprNode }
            cursor = separator.2
            if next_token(source, cursor).0 == 41 { return mimi_buffer_empty() as *ExprNode }
        }
    }
    if close_end == 0 { return mimi_buffer_empty() as *ExprNode }
    return_type := parse_type(source[close_end:source.len], storage)
    if expression_is_null(return_type) { return return_type }
    shift_expression_tree(return_type, close_end)
    allocate_expr(storage, 277, keyword.1, return_type.end, parameters, return_type)
}

if_expression_end :: fn (source : []u8, start : u64) u64 {
    cursor := start
    depth : u64 = 0
    saw_block := false
    while cursor < source.len {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return start }
        cursor = token.2
        if token.0 == 123 {
            depth = depth + 1
            saw_block = true
        } else {
            if token.0 == 125 {
                if depth == 0 { return start }
                depth = depth - 1
                if saw_block && depth == 0 {
                    next := next_token(source, cursor)
                    if next.0 != 165 { return cursor }
                }
            }
        }
    }
    start
}

pub parse_expression :: fn (source : []u8, storage : *ExpressionArena) *ExprNode {
    // Bound the stack-size calculations below before multiplying source.len.
    if source.len > 500000000000000000 { return mimi_buffer_empty() as *ExprNode }
    first_cast := next_token(source, 0)
    if first_cast.0 == 1 || first_cast.0 == 2 || first_cast.0 == 3 || first_cast.0 == 40 || first_cast.0 == 42 || first_cast.0 == 91 || first_cast.0 == 38 || first_cast.0 == 45 || first_cast.0 == 33 {
        cast := parse_cast_expression(source, storage)
        if !expression_is_null(cast) { return cast }
    }
    if first_cast.0 == 40 {
        tuple := parse_tuple_literal(source, storage)
        if !expression_is_null(tuple) { return tuple }
    }
    first := next_token(source, 0)
    if first.0 == 1 && (next_token(source, first.2).0 == 123 || next_token(source, first.2).0 == 60 || next_token(source, first.2).0 == 46) {
        literal := parse_struct_literal(source, storage)
        if struct_literal_is_null(literal) { } else {
        type_node := parse_type(source[literal.type_start:literal.type_end], storage)
        if expression_is_null(type_node) { return type_node }
        shift_expression_tree(type_node, literal.type_start)
        if expression_is_null(type_node) { return type_node }
        fields : *ExprNode = mimi_buffer_empty() as *ExprNode
        current := literal.fields
        while current != (mimi_buffer_empty() as *StructLiteralFieldNode) {
            name_node := allocate_expr(storage, 1, current.name_start, current.name_end, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
            if expression_is_null(name_node) { return name_node }
            entry := allocate_expr(storage, 292, current.start, current.end, name_node, current.value)
            if expression_is_null(entry) { return entry }
            if expression_is_null(fields) { fields = entry } else {
                fields = allocate_expr(storage, 262, fields.start, entry.end, fields, entry)
                if expression_is_null(fields) { return fields }
            }
            current = current.next
        }
        return allocate_expr(storage, 291, literal.start, literal.end, type_node, fields)
        }
    }
    if first.0 == 1 || first.0 == 2 || first.0 == 3 || first.0 == 4 || first.0 == 5 {
        if next_token(source, first.2).0 == 0 {
            return allocate_expr(storage, first.0 as u64, first.1, first.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
        }
    }
    if mimi_arena_allocate(storage, source.len * 8 + 8, 8) == 0 { return mimi_buffer_empty() as *ExprNode }
    node_stack := storage.last as **ExprNode
    if mimi_arena_allocate(storage, source.len * 32 + 32, 8) == 0 { return mimi_buffer_empty() as *ExprNode }
    operator_stack := storage.last as *ExprOperator
    stacks := ExpressionStacks { storage = storage, nodes = node_stack, operators = operator_stack, node_count = 0, operator_count = 0 }
    cursor : u64 = 0
    expecting_operand := true
    while true {
        token := next_token(source, cursor)
        if token.0 == 0 { break }
        if token.0 == 255 { return mimi_buffer_empty() as *ExprNode }
        cursor = token.2

        if token.0 == 164 {
            if !expecting_operand { return mimi_buffer_empty() as *ExprNode }
            ending := if_expression_end(source, token.1)
            if ending == token.1 { return mimi_buffer_empty() as *ExprNode }
            value := parse_if_expression(source[token.1:ending], storage)
            if expression_is_null(value) { return value }
            shift_expression_tree(value, token.1)
            stacks.nodes[stacks.node_count] = value
            stacks.node_count = stacks.node_count + 1
            cursor = ending
            expecting_operand = false
            while stacks.operator_count > 0 && is_prefix_operator(stacks.operators[stacks.operator_count - 1].kind) {
                if !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
            }
            continue
        }

        if token.0 == 1 || token.0 == 2 || token.0 == 3 || token.0 == 4 || token.0 == 5 {
            if !expecting_operand { return mimi_buffer_empty() as *ExprNode }
            node := allocate_expr(storage, token.0 as u64, token.1, token.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
            if expression_is_null(node) { return node }
            if token.0 == 1 || token.0 == 2 || token.0 == 3 {
                node.payload_start = token.1
                node.payload_end = token.2
            }
            stacks.nodes[stacks.node_count] = node
            stacks.node_count = stacks.node_count + 1
            expecting_operand = false
            while stacks.operator_count > 0 && is_prefix_operator(stacks.operators[stacks.operator_count - 1].kind) {
                if !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
            }
        } else {
            if token.0 == 46 && !expecting_operand {
                if stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
                member := next_token(source, cursor)
                if member.0 != 1 && member.0 != 2 { return mimi_buffer_empty() as *ExprNode }
                cursor = member.2
                member_node := allocate_expr(storage, member.0 as u64, member.1, member.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
                if expression_is_null(member_node) { return member_node }
                receiver := stacks.nodes[stacks.node_count - 1]
                access := allocate_expr(storage, 260, receiver.start, member.2, receiver, member_node)
                if expression_is_null(access) { return access }
                stacks.nodes[stacks.node_count - 1] = access
            } else {
                if token.0 == 40 && expecting_operand {
                    stacks.operators[stacks.operator_count] = ExprOperator { kind = 40, start = token.1, base_count = 0, argument_count = 0 }
                    stacks.operator_count = stacks.operator_count + 1
                } else {
                    if token.0 == 40 && !expecting_operand {
                        if stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
                        stacks.operators[stacks.operator_count] = ExprOperator { kind = 300, start = token.1, base_count = stacks.node_count, argument_count = 0 }
                        stacks.operator_count = stacks.operator_count + 1
                        expecting_operand = true
                    } else {
                    if token.0 == 91 && !expecting_operand {
                        if stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
                        stacks.operators[stacks.operator_count] = ExprOperator { kind = 91, start = token.1, base_count = stacks.node_count, argument_count = 0 }
                        stacks.operator_count = stacks.operator_count + 1
                        expecting_operand = true
                    } else {
                        if token.0 == 58 || token.0 == 135 {
                            found_index := false
                            while stacks.operator_count > 0 && !found_index {
                                top := stacks.operators[stacks.operator_count - 1]
                                if top.kind == 91 {
                                    found_index = true
                                } else {
                                    if top.kind == 40 || top.kind == 300 || !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                                }
                            }
                            if !found_index || stacks.operators[stacks.operator_count - 1].argument_count != 0 { return mimi_buffer_empty() as *ExprNode }
                            marker := stacks.operators[stacks.operator_count - 1]
                            if expecting_operand {
                                if stacks.node_count != marker.base_count { return mimi_buffer_empty() as *ExprNode }
                                marker.argument_count = 1
                            } else {
                                if stacks.node_count != marker.base_count + 1 { return mimi_buffer_empty() as *ExprNode }
                                marker.argument_count = 3
                            }
                            stacks.operators[stacks.operator_count - 1] = marker
                            expecting_operand = true
                        } else {
                        if token.0 == 44 {
                            if expecting_operand || stacks.operator_count == 0 { return mimi_buffer_empty() as *ExprNode }
                            while stacks.operator_count > 0 && stacks.operators[stacks.operator_count - 1].kind != 300 {
                                top := stacks.operators[stacks.operator_count - 1]
                                if top.kind == 40 || top.kind == 91 || !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                            }
                            if stacks.operator_count == 0 { return mimi_buffer_empty() as *ExprNode }
                            marker := stacks.operators[stacks.operator_count - 1]
                            expected_count := marker.base_count + 1
                            if marker.argument_count != 0 { expected_count = expected_count + 1 }
                            if stacks.node_count != expected_count { return mimi_buffer_empty() as *ExprNode }
                            argument := stacks.nodes[stacks.node_count - 1]
                            if marker.argument_count == 0 {
                                stacks.nodes[marker.base_count] = argument
                            } else {
                                previous := stacks.nodes[marker.base_count]
                                argument_list := allocate_expr(storage, 262, previous.start, argument.end, previous, argument)
                                if expression_is_null(argument_list) { return argument_list }
                                stacks.nodes[marker.base_count] = argument_list
                                stacks.node_count = stacks.node_count - 1
                            }
                            marker.argument_count = marker.argument_count + 1
                            stacks.operators[stacks.operator_count - 1] = marker
                            expecting_operand = true
                        } else {
                        if token.0 == 93 {
                            found_index := false
                            marker := ExprOperator { kind = 0, start = 0, base_count = 0, argument_count = 0 }
                            while stacks.operator_count > 0 && !found_index {
                                top := stacks.operators[stacks.operator_count - 1]
                                if top.kind == 91 {
                                    marker = top
                                    stacks.operator_count = stacks.operator_count - 1
                                    found_index = true
                                } else {
                                    if top.kind == 40 || top.kind == 300 || !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                                }
                            }
                            if !found_index || marker.base_count == 0 { return mimi_buffer_empty() as *ExprNode }
                            if marker.argument_count == 0 {
                                if expecting_operand || stacks.node_count != marker.base_count + 1 { return mimi_buffer_empty() as *ExprNode }
                                index_node := stacks.nodes[marker.base_count]
                                receiver := stacks.nodes[marker.base_count - 1]
                                access := allocate_expr(storage, 261, receiver.start, token.2, receiver, index_node)
                                if expression_is_null(access) { return access }
                                stacks.node_count = marker.base_count
                                stacks.nodes[stacks.node_count - 1] = access
                            } else {
                                has_start := marker.argument_count == 3
                                has_end := !expecting_operand
                                expected_count := marker.base_count
                                if has_start { expected_count = expected_count + 1 }
                                if has_end { expected_count = expected_count + 1 }
                                if stacks.node_count != expected_count { return mimi_buffer_empty() as *ExprNode }
                                start_node : *ExprNode = mimi_buffer_empty() as *ExprNode
                                end_node : *ExprNode = mimi_buffer_empty() as *ExprNode
                                if has_start { start_node = stacks.nodes[marker.base_count] }
                                if has_end {
                                    end_index := marker.base_count
                                    if has_start { end_index = end_index + 1 }
                                    end_node = stacks.nodes[end_index]
                                }
                                receiver := stacks.nodes[marker.base_count - 1]
                                bounds := allocate_expr(storage, 265, token.1, token.1, start_node, end_node)
                                if expression_is_null(bounds) { return bounds }
                                slice := allocate_expr(storage, 264, receiver.start, token.2, receiver, bounds)
                                if expression_is_null(slice) { return slice }
                                stacks.node_count = marker.base_count - 1
                                stacks.nodes[stacks.node_count] = slice
                                stacks.node_count = stacks.node_count + 1
                            }
                            expecting_operand = false
                        } else {
                            if token.0 == 41 {
                                while stacks.operator_count > 0 {
                                    top := stacks.operators[stacks.operator_count - 1]
                                    if top.kind == 40 || top.kind == 300 { break }
                                    if top.kind == 91 || !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                                }
                            }
                            if token.0 == 41 && stacks.operator_count > 0 && stacks.operators[stacks.operator_count - 1].kind == 300 {
                                marker := stacks.operators[stacks.operator_count - 1]
                                if marker.argument_count == 0 {
                                    if stacks.node_count != marker.base_count && stacks.node_count != marker.base_count + 1 { return mimi_buffer_empty() as *ExprNode }
                                } else {
                                    if expecting_operand { return mimi_buffer_empty() as *ExprNode }
                                    while stacks.operator_count > 0 && stacks.operators[stacks.operator_count - 1].kind != 300 {
                                        if !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                                    }
                                    if stacks.node_count != marker.base_count + 2 { return mimi_buffer_empty() as *ExprNode }
                                    previous := stacks.nodes[marker.base_count]
                                    argument := stacks.nodes[marker.base_count + 1]
                                    argument_list := allocate_expr(storage, 262, previous.start, argument.end, previous, argument)
                                    if expression_is_null(argument_list) { return argument_list }
                                    stacks.nodes[marker.base_count] = argument_list
                                    stacks.node_count = stacks.node_count - 1
                                }
                                stacks.operator_count = stacks.operator_count - 1
                                callee := stacks.nodes[marker.base_count - 1]
                                arguments : *ExprNode = mimi_buffer_empty() as *ExprNode
                                if marker.argument_count != 0 || stacks.node_count == marker.base_count + 1 { arguments = stacks.nodes[marker.base_count] }
                                call := allocate_expr(storage, 263, callee.start, token.2, callee, arguments)
                                if expression_is_null(call) { return call }
                                stacks.node_count = marker.base_count - 1
                                stacks.nodes[stacks.node_count] = call
                                stacks.node_count = stacks.node_count + 1
                                expecting_operand = false
                            } else {
                            if token.0 == 41 {
                                if expecting_operand { return mimi_buffer_empty() as *ExprNode }
                                found_open := false
                                while stacks.operator_count > 0 && !found_open {
                                    top := stacks.operators[stacks.operator_count - 1]
                                    if top.kind == 40 {
                                        stacks.operator_count = stacks.operator_count - 1
                                        found_open = true
                                    } else {
                                        if top.kind == 91 || top.kind == 300 || !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                                    }
                                }
                                if !found_open { return mimi_buffer_empty() as *ExprNode }
                                if stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
                                stacks.nodes[stacks.node_count - 1].start = stacks.operators[stacks.operator_count].start
                                stacks.nodes[stacks.node_count - 1].end = token.2
                                expecting_operand = false
                            } else {
                                if token.0 == 174 && !expecting_operand {
                                    if stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
                                    type_end := cast_type_end(source, cursor)
                                    if type_end == cursor { return mimi_buffer_empty() as *ExprNode }
                                    data_type := parse_type(source[cursor:type_end], storage)
                                    if expression_is_null(data_type) { return data_type }
                                    shift_expression_tree(data_type, cursor)
                                    value := stacks.nodes[stacks.node_count - 1]
                                    cast := allocate_expr(storage, 293, value.start, data_type.end, value, data_type)
                                    if expression_is_null(cast) { return cast }
                                    stacks.nodes[stacks.node_count - 1] = cast
                                    cursor = type_end
                                } else {
                                if expecting_operand {
                                    if token.0 != 45 && token.0 != 33 && token.0 != 38 && token.0 != 42 { return mimi_buffer_empty() as *ExprNode }
                                    prefix_kind : u64 = 250 + token.0 as u64
                                    if token.0 == 38 { prefix_kind = 296 }
                                    if token.0 == 42 { prefix_kind = 297 }
                                    stacks.operators[stacks.operator_count] = ExprOperator { kind = prefix_kind, start = token.1, base_count = 0, argument_count = 0 }
                                    stacks.operator_count = stacks.operator_count + 1
                                } else {
                                    precedence := expression_precedence(token.0)
                                    if precedence == 0 { return mimi_buffer_empty() as *ExprNode }
                                    while stacks.operator_count > 0 {
                                        top := stacks.operators[stacks.operator_count - 1]
                                        if top.kind == 40 || top.kind == 91 || top.kind == 300 { break }
                                        top_precedence := expression_operator_precedence(top.kind)
                                        if top_precedence < precedence { break }
                                        if !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                                    }
                                    stacks.operators[stacks.operator_count] = ExprOperator { kind = token.0 as u64, start = token.1, base_count = 0, argument_count = 0 }
                                    stacks.operator_count = stacks.operator_count + 1
                                    expecting_operand = true
                                    }
                                }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
    }

    }
    if expecting_operand || stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
    while stacks.operator_count > 0 {
        if stacks.operators[stacks.operator_count - 1].kind == 40 || stacks.operators[stacks.operator_count - 1].kind == 91 || stacks.operators[stacks.operator_count - 1].kind == 300 { return mimi_buffer_empty() as *ExprNode }
        if !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
    }
    if stacks.node_count != 1 { return mimi_buffer_empty() as *ExprNode }
    stacks.nodes[0]
}

cast_type_end :: fn (source : []u8, start : u64) u64 {
    cursor := start
    paren_depth : u64 = 0
    bracket_depth : u64 = 0
    angle_depth : u64 = 0
    saw_name := false
    while cursor < source.len {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { break }
        if paren_depth == 0 && bracket_depth == 0 && angle_depth == 0 {
            if token.0 == 174 || token.0 == 43 || token.0 == 45 || token.0 == 47 || token.0 == 37 || token.0 == 128 || token.0 == 129 || token.0 == 130 || token.0 == 131 || token.0 == 132 || token.0 == 133 || token.0 == 44 || token.0 == 41 || token.0 == 93 { break }
            if token.0 == 42 && saw_name { break }
        }
        cursor = token.2
        if token.0 == 1 || token.0 == 4 || token.0 == 5 { saw_name = true }
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 {
                if paren_depth == 0 { return start }
                paren_depth = paren_depth - 1
            } else {
                if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                    if token.0 == 93 {
                        if bracket_depth == 0 { return start }
                        bracket_depth = bracket_depth - 1
                    } else {
                        if token.0 == 60 { angle_depth = angle_depth + 1 } else {
                            if token.0 == 62 && angle_depth > 0 { angle_depth = angle_depth - 1 }
                        }
                    }
                }
            }
        }
    }
    if paren_depth != 0 || bracket_depth != 0 || angle_depth != 0 { return start }
    cursor
}

allocate_expr :: fn (storage : *ExpressionArena, kind : u64, start : u64, end : u64, left : *ExprNode, right : *ExprNode) *ExprNode {
    if mimi_arena_allocate(storage, 56, 8) == 0 { return mimi_buffer_empty() as *ExprNode }
    node := storage.last as *ExprNode
    node.kind = kind
    node.start = start
    node.end = end
    node.left = left
    node.right = right
    node.payload_start = start
    node.payload_end = end
    node
}

reduce_expression :: fn (stacks : *ExpressionStacks) bool {
    if stacks.operator_count == 0 { return false }
    operator := stacks.operators[stacks.operator_count - 1]
    stacks.operator_count = stacks.operator_count - 1
    if is_prefix_operator(operator.kind) {
        if stacks.node_count < 1 { return false }
        operand := stacks.nodes[stacks.node_count - 1]
        node := allocate_expr(stacks.storage, operator.kind, operator.start, operand.end, operand, mimi_buffer_empty() as *ExprNode)
        if expression_is_null(node) { return false }
        stacks.nodes[stacks.node_count - 1] = node
        return true
    }
    if stacks.node_count < 2 { return false }
    right := stacks.nodes[stacks.node_count - 1]
    left := stacks.nodes[stacks.node_count - 2]
    stacks.node_count = stacks.node_count - 2
    node := allocate_expr(stacks.storage, operator.kind, left.start, right.end, left, right)
    if expression_is_null(node) { return false }
    stacks.nodes[stacks.node_count] = node
    stacks.node_count = stacks.node_count + 1
    true
}

is_prefix_operator :: fn (kind : u64) bool {
    kind == 295 || kind == 283 || kind == 296 || kind == 297
}

expression_operator_precedence :: fn (kind : u64) u8 {
    if is_prefix_operator(kind) { return 7 }
    expression_precedence(kind as u8)
}

expression_precedence :: fn (kind : u8) u8 {
    if kind == 133 { return 1 }
    if kind == 132 { return 2 }
    if kind == 128 || kind == 129 { return 3 }
    if kind == 60 || kind == 62 || kind == 130 || kind == 131 { return 4 }
    if kind == 43 || kind == 45 { return 5 }
    if kind == 42 || kind == 47 || kind == 37 { return 6 }
    0
}

pub NameIssue :: struct {
    code : u64,
    start : u64,
    end : u64,
}

NameSymbol :: struct {
    start : u64,
    end : u64,
    next : *NameSymbol,
}

name_symbol_push :: fn (storage : *ExpressionArena, head : *NameSymbol, start : u64, end : u64) *NameSymbol {
    if mimi_arena_allocate(storage, 24, 8) == 0 { return mimi_buffer_empty() as *NameSymbol }
    symbol := storage.last as *NameSymbol
    symbol.start = start
    symbol.end = end
    symbol.next = head
    symbol
}

name_in_scope :: fn (source : []u8, start : u64, end : u64, head : *NameSymbol) bool {
    symbol := head
    while symbol != (mimi_buffer_empty() as *NameSymbol) {
        if source_names_equal(source, start, end, symbol.start, symbol.end) { return true }
        symbol = symbol.next
    }
    false
}

name_in_current_block :: fn (source : []u8, start : u64, end : u64, head : *NameSymbol, incoming : *NameSymbol) bool {
    symbol := head
    while symbol != incoming {
        if source_names_equal(source, start, end, symbol.start, symbol.end) { return true }
        symbol = symbol.next
    }
    false
}

name_is_global :: fn (source : []u8, start : u64, end : u64, module : *ModuleNode) bool {
    declaration := module.declarations
    while declaration != (mimi_buffer_empty() as *ModuleDeclarationNode) {
        if source_names_equal(source, start, end, declaration.name_start, declaration.name_end) { return true }
        declaration = declaration.next
    }
    false
}

name_resolve_expression :: fn (source : []u8, module : *ModuleNode, expression : *ExprNode, locals : *NameSymbol, issue : *NameIssue) bool {
    if expression_is_null(expression) { return true }
    if expression.kind == 1 {
        if expression.end > source.len { issue.code = 3 issue.start = expression.start issue.end = expression.end return false }
        token := next_token(source, expression.start)
        while token.0 != 1 && token.0 != 0 && token.2 < expression.end { token = next_token(source, token.2) }
        if token.0 != 1 || token.1 >= expression.end { issue.code = 3 issue.start = expression.start issue.end = expression.end return false }
        if source_name_equals(source, token.1, token.2, "null") || name_in_scope(source, token.1, token.2, locals) || name_is_global(source, token.1, token.2, module) { return true }
        issue.code = 1
        issue.start = token.1
        issue.end = token.2
        return false
    }
    if expression.kind == 260 || expression.kind == 293 { return name_resolve_expression(source, module, expression.left, locals, issue) }
    if expression.kind == 292 { return name_resolve_expression(source, module, expression.right, locals, issue) }
    if expression.kind == 291 { return name_resolve_expression(source, module, expression.right, locals, issue) }
    if expression.kind == 289 || (expression.kind >= 270 && expression.kind <= 278) { return true }
    if !name_resolve_expression(source, module, expression.left, locals, issue) { return false }
    name_resolve_expression(source, module, expression.right, locals, issue)
}

name_resolve_if :: fn (source : []u8, module : *ModuleNode, node : *IfNode, locals : *NameSymbol, storage : *ExpressionArena, issue : *NameIssue) bool {
    if if_node_is_null(node) { return true }
    if !name_resolve_expression(source, module, node.condition, locals, issue) { return false }
    if !name_resolve_block(source, module, node.then_branch, locals, storage, issue) { return false }
    if !name_resolve_block(source, module, node.else_branch, locals, storage, issue) { return false }
    name_resolve_if(source, module, node.else_if, locals, storage, issue)
}

name_resolve_block :: fn (source : []u8, module : *ModuleNode, block : *BlockNode, incoming : *NameSymbol, storage : *ExpressionArena, issue : *NameIssue) bool {
    if block_node_is_null(block) { return true }
    locals := incoming
    statement := block.statements
    while !statement_node_is_null(statement) {
        if statement.kind == 285 {
            if !name_resolve_expression(source, module, statement.binding.initializer, locals, issue) { return false }
            start := statement.binding.name_start
            end := statement.binding.name_end
            if name_in_current_block(source, start, end, locals, incoming) { issue.code = 2 issue.start = start issue.end = end return false }
            locals = name_symbol_push(storage, locals, start, end)
            if locals == (mimi_buffer_empty() as *NameSymbol) { issue.code = 3 return false }
        } else {
            if statement.kind == 309 {
                if !name_resolve_expression(source, module, statement.tuple_binding.value, locals, issue) { return false }
                name := statement.tuple_binding.names
                while name != (mimi_buffer_empty() as *DestructureNameNode) {
                    if name_in_current_block(source, name.start, name.end, locals, incoming) { issue.code = 2 issue.start = name.start issue.end = name.end return false }
                    locals = name_symbol_push(storage, locals, name.start, name.end)
                    if locals == (mimi_buffer_empty() as *NameSymbol) { issue.code = 3 return false }
                    name = name.next
                }
            } else {
                if statement.kind == 304 {
                    if !name_resolve_if(source, module, statement.if_statement, locals, storage, issue) { return false }
                } else {
                    if statement.kind == 305 {
                        node := statement.if_let
                        if !name_resolve_expression(source, module, node.value, locals, issue) { return false }
                        then_locals := locals
                        if node.binding_end > node.binding_start {
                            then_locals = name_symbol_push(storage, locals, node.binding_start, node.binding_end)
                        }
                        if !name_resolve_block(source, module, node.then_branch, then_locals, storage, issue) { return false }
                        if !name_resolve_block(source, module, node.else_branch, locals, storage, issue) { return false }
                    } else {
                        if statement.kind == 306 {
                            if !name_resolve_expression(source, module, statement.loop_statement.condition, locals, issue) { return false }
                            if !name_resolve_block(source, module, statement.loop_statement.body, locals, storage, issue) { return false }
                        } else {
                            if statement.kind == 307 {
                                loop_node := statement.for_loop
                                if !name_resolve_expression(source, module, loop_node.iterable, locals, issue) { return false }
                                if !name_resolve_expression(source, module, loop_node.range_start, locals, issue) { return false }
                                if !name_resolve_expression(source, module, loop_node.range_end, locals, issue) { return false }
                                loop_locals := name_symbol_push(storage, locals, loop_node.variable_start, loop_node.variable_end)
                                if !name_resolve_block(source, module, loop_node.body, loop_locals, storage, issue) { return false }
                            } else {
                                if statement.kind == 308 {
                                    match_node := statement.match_statement
                                    if !name_resolve_expression(source, module, match_node.value, locals, issue) { return false }
                                    arm := match_node.arms
                                    while arm != (mimi_buffer_empty() as *MatchArmNode) {
                                        arm_locals := locals
                                        if arm.binding_end > arm.binding_start { arm_locals = name_symbol_push(storage, locals, arm.binding_start, arm.binding_end) }
                                        if !name_resolve_expression(source, module, arm.value, arm_locals, issue) { return false }
                                        arm = arm.next
                                    }
                                } else {
                                    if !name_resolve_expression(source, module, statement.value, locals, issue) { return false }
                                    if !name_resolve_block(source, module, statement.body, locals, storage, issue) { return false }
                                }
                            }
                        }
                    }
                }
            }
        }
        statement = statement.next
    }
    true
}

name_resolve_function :: fn (source : []u8, module : *ModuleNode, function : *FunctionNode, storage : *ExpressionArena, issue : *NameIssue) bool {
    locals : *NameSymbol = mimi_buffer_empty() as *NameSymbol
    parameter := function.parameters
    while !parameter_list_is_null(parameter) {
        locals = name_symbol_push(storage, locals, parameter.name_start, parameter.name_end)
        if locals == (mimi_buffer_empty() as *NameSymbol) { issue.code = 3 return false }
        parameter = parameter.next
    }
    name_resolve_block(source, module, function.body, locals, storage, issue)
}

pub resolve_module_names :: fn (source : []u8, module : *ModuleNode, storage : *ExpressionArena) NameIssue {
    issue := NameIssue { code = 0, start = 0, end = 0 }
    if module_node_is_null(module) { issue.code = 3 return issue }
    empty : *NameSymbol = mimi_buffer_empty() as *NameSymbol
    declaration := module.declarations
    while declaration != (mimi_buffer_empty() as *ModuleDeclarationNode) {
        if !binding_node_is_null(declaration.binding) {
            if !name_resolve_expression(source, module, declaration.binding.initializer, empty, &issue) { return issue }
        }
        if !function_node_is_null(declaration.function) {
            if !name_resolve_function(source, module, declaration.function, storage, &issue) { return issue }
        }
        if declaration.struct_node != (mimi_buffer_empty() as *StructNode) {
            method := declaration.struct_node.methods
            while method != (mimi_buffer_empty() as *StructMethodNode) {
                if !name_resolve_function(source, module, method.function, storage, &issue) { return issue }
                method = method.next
            }
        }
        declaration = declaration.next
    }
    issue
}

pub name_issue_message :: fn (code : u64) []u8 {
    if code == 1 { return "undefined identifier" }
    if code == 2 { return "name is already defined in this scope" }
    if code == 3 { return "invalid syntax tree or out of memory" }
    if code == 4 { return "expression uses an incompatible operand type" }
    if code == 5 { return "assigned value is incompatible with its declared type" }
    if code == 6 { return "tuple destructuring requires matching tuple elements" }
    ""
}

TypeSymbol :: struct {
    start : u64,
    end : u64,
    type_tag : u64,
    next : *TypeSymbol,
}

type_symbol_push :: fn (storage : *ExpressionArena, head : *TypeSymbol, start : u64, end : u64, type_tag : u64) *TypeSymbol {
    if mimi_arena_allocate(storage, 32, 8) == 0 { return mimi_buffer_empty() as *TypeSymbol }
    symbol := storage.last as *TypeSymbol
    symbol.start = start
    symbol.end = end
    symbol.type_tag = type_tag
    symbol.next = head
    symbol
}

type_symbol_lookup :: fn (source : []u8, start : u64, end : u64, head : *TypeSymbol) u64 {
    symbol := head
    while symbol != (mimi_buffer_empty() as *TypeSymbol) {
        if source_names_equal(source, start, end, symbol.start, symbol.end) { return symbol.type_tag }
        symbol = symbol.next
    }
    0
}

type_annotation_tag :: fn (source : []u8, data_type : *ExprNode) u64 {
    if expression_is_null(data_type) { return 0 }
    if data_type.kind == 272 || data_type.kind == 273 { return 4 }
    if data_type.kind == 275 { return 5 }
    if data_type.kind != 270 { return 0 }
    token := next_token(source, data_type.start)
    if token.0 != 1 { return 0 }
    if source_name_equals(source, token.1, token.2, "bool") { return 2 }
    if source_name_equals(source, token.1, token.2, "void") { return 6 }
    if source_name_equals(source, token.1, token.2, "f32") || source_name_equals(source, token.1, token.2, "f64") { return 3 }
    if source_name_equals(source, token.1, token.2, "i8") || source_name_equals(source, token.1, token.2, "i16") || source_name_equals(source, token.1, token.2, "i32") || source_name_equals(source, token.1, token.2, "i64") || source_name_equals(source, token.1, token.2, "u8") || source_name_equals(source, token.1, token.2, "u16") || source_name_equals(source, token.1, token.2, "u32") || source_name_equals(source, token.1, token.2, "u64") { return 1 }
    0
}

type_compatible :: fn (left : u64, right : u64) bool {
    left == 0 || right == 0 || left == right || ((left == 1 || left == 3) && (right == 1 || right == 3))
}

type_assignable :: fn (expected : u64, actual : u64) bool {
    expected == 0 || actual == 0 || expected == actual || (expected == 3 && actual == 1)
}

type_fail :: fn (issue : *NameIssue, code : u64, expression : *ExprNode) u64 {
    issue.code = code
    issue.start = expression.start
    issue.end = expression.end
    0
}

infer_expression_tag :: fn (source : []u8, expression : *ExprNode, locals : *TypeSymbol, issue : *NameIssue) u64 {
    if expression_is_null(expression) || issue.code != 0 { return 0 }
    if expression.kind == 1 {
        token := next_token(source, expression.start)
        while token.0 != 1 && token.0 != 0 && token.2 < expression.end { token = next_token(source, token.2) }
        if token.0 != 1 { return 0 }
        return type_symbol_lookup(source, token.1, token.2, locals)
    }
    if expression.kind == 2 {
        cursor := expression.start
        while cursor < expression.end {
            if source[cursor] == 46 { return 3 }
            cursor = cursor + 1
        }
        return 1
    }
    if expression.kind == 3 { return 4 }
    if expression.kind == 4 || expression.kind == 5 { return 2 }
    if expression.kind == 293 {
        original := infer_expression_tag(source, expression.left, locals, issue)
        target := type_annotation_tag(source, expression.right)
        if original == 2 || target == 2 { return type_fail(issue, 4, expression) }
        return target
    }
    if expression.kind == 260 { infer_expression_tag(source, expression.left, locals, issue) return 0 }
    if expression.kind == 291 || expression.kind == 292 {
        infer_expression_tag(source, expression.right, locals, issue)
        return 0
    }
    if expression.kind == 268 { infer_expression_tag(source, expression.left, locals, issue) return 5 }
    if expression.kind == 283 {
        operand := infer_expression_tag(source, expression.left, locals, issue)
        if operand != 0 && operand != 2 { return type_fail(issue, 4, expression) }
        return 2
    }
    if expression.kind == 295 {
        operand := infer_expression_tag(source, expression.left, locals, issue)
        if operand != 0 && operand != 1 && operand != 3 { return type_fail(issue, 4, expression) }
        return operand
    }
    left := infer_expression_tag(source, expression.left, locals, issue)
    right := infer_expression_tag(source, expression.right, locals, issue)
    if issue.code != 0 { return 0 }
    if expression.kind == 43 || expression.kind == 45 || expression.kind == 42 || expression.kind == 47 || expression.kind == 37 {
        if (left != 0 && left != 1 && left != 3) || (right != 0 && right != 1 && right != 3) { return type_fail(issue, 4, expression) }
        if left == 3 || right == 3 { return 3 }
        if left == 1 || right == 1 { return 1 }
        return 0
    }
    if expression.kind == 132 || expression.kind == 133 {
        if (left != 0 && left != 2) || (right != 0 && right != 2) { return type_fail(issue, 4, expression) }
        return 2
    }
    if expression.kind == 128 || expression.kind == 129 || expression.kind == 130 || expression.kind == 131 || expression.kind == 60 || expression.kind == 62 {
        if !type_compatible(left, right) { return type_fail(issue, 4, expression) }
        return 2
    }
    if expression.kind == 284 && !type_assignable(left, right) { return type_fail(issue, 5, expression) }
    0
}

fill_tuple_tags :: fn (source : []u8, items : *ExprNode, locals : *TypeSymbol, tags : *u64, cursor : *u64, issue : *NameIssue) bool {
    if expression_is_null(items) { return false }
    if items.kind == 262 {
        if !fill_tuple_tags(source, items.left, locals, tags, cursor, issue) { return false }
        tags[cursor[0]] = infer_expression_tag(source, items.right, locals, issue)
    } else {
        tags[cursor[0]] = infer_expression_tag(source, items, locals, issue)
    }
    cursor[0] = cursor[0] + 1
    issue.code == 0
}

type_check_condition :: fn (source : []u8, condition : *ExprNode, locals : *TypeSymbol, issue : *NameIssue) bool {
    if expression_is_null(condition) { return true }
    tag := infer_expression_tag(source, condition, locals, issue)
    if issue.code != 0 { return false }
    if tag != 0 && tag != 2 { type_fail(issue, 4, condition) return false }
    true
}

type_check_if :: fn (source : []u8, node : *IfNode, locals : *TypeSymbol, storage : *ExpressionArena, expected_return : u64, issue : *NameIssue) bool {
    if if_node_is_null(node) { return true }
    if !type_check_condition(source, node.condition, locals, issue) { return false }
    if !type_check_block(source, node.then_branch, locals, storage, expected_return, false, issue) { return false }
    if !type_check_block(source, node.else_branch, locals, storage, expected_return, false, issue) { return false }
    type_check_if(source, node.else_if, locals, storage, expected_return, issue)
}

type_check_block :: fn (source : []u8, block : *BlockNode, incoming : *TypeSymbol, storage : *ExpressionArena, expected_return : u64, check_tail : bool, issue : *NameIssue) bool {
    if block_node_is_null(block) { return true }
    locals := incoming
    statement := block.statements
    while !statement_node_is_null(statement) {
        if statement.kind == 285 {
            inferred := infer_expression_tag(source, statement.binding.initializer, locals, issue)
            annotated := type_annotation_tag(source, statement.binding.data_type)
            if issue.code != 0 { return false }
            if !type_assignable(annotated, inferred) { type_fail(issue, 5, statement.binding.initializer) return false }
            if annotated != 0 { inferred = annotated }
            locals = type_symbol_push(storage, locals, statement.binding.name_start, statement.binding.name_end, inferred)
        } else {
            if statement.kind == 309 {
                tuple := statement.tuple_binding
                if tuple.value.kind != 268 { type_fail(issue, 6, tuple.value) return false }
                if mimi_arena_allocate(storage, tuple.name_count * 8, 8) == 0 { issue.code = 3 return false }
                tags := storage.last as *u64
                cursor : u64 = 0
                if !fill_tuple_tags(source, tuple.value.left, locals, tags, &cursor, issue) { return false }
                if cursor != tuple.name_count { type_fail(issue, 6, tuple.value) return false }
                name := tuple.names
                index : u64 = 0
                while name != (mimi_buffer_empty() as *DestructureNameNode) {
                    locals = type_symbol_push(storage, locals, name.start, name.end, tags[index])
                    index = index + 1
                    name = name.next
                }
            } else {
                if statement.kind == 304 {
                    if !type_check_if(source, statement.if_statement, locals, storage, expected_return, issue) { return false }
                } else {
                    if statement.kind == 305 {
                        node := statement.if_let
                        infer_expression_tag(source, node.value, locals, issue)
                        then_locals := locals
                        if node.binding_end > node.binding_start { then_locals = type_symbol_push(storage, locals, node.binding_start, node.binding_end, 0) }
                        if issue.code != 0 || !type_check_block(source, node.then_branch, then_locals, storage, expected_return, false, issue) { return false }
                        if !type_check_block(source, node.else_branch, locals, storage, expected_return, false, issue) { return false }
                    } else {
                        if statement.kind == 306 {
                            node := statement.loop_statement
                            if !type_check_condition(source, node.condition, locals, issue) { return false }
                            if !type_check_block(source, node.body, locals, storage, expected_return, false, issue) { return false }
                        } else {
                            if statement.kind == 307 {
                                node := statement.for_loop
                                infer_expression_tag(source, node.iterable, locals, issue)
                                infer_expression_tag(source, node.range_start, locals, issue)
                                infer_expression_tag(source, node.range_end, locals, issue)
                                loop_locals := type_symbol_push(storage, locals, node.variable_start, node.variable_end, 0)
                                if issue.code != 0 || loop_locals == (mimi_buffer_empty() as *TypeSymbol) || !type_check_block(source, node.body, loop_locals, storage, expected_return, false, issue) { return false }
                            } else {
                                if statement.kind == 308 {
                                    node := statement.match_statement
                                    infer_expression_tag(source, node.value, locals, issue)
                                    arm := node.arms
                                    while arm != (mimi_buffer_empty() as *MatchArmNode) {
                                        arm_locals := locals
                                        if arm.binding_end > arm.binding_start { arm_locals = type_symbol_push(storage, locals, arm.binding_start, arm.binding_end, 0) }
                                        infer_expression_tag(source, arm.value, arm_locals, issue)
                                        if issue.code != 0 { return false }
                                        arm = arm.next
                                    }
                                } else {
                                    inferred := infer_expression_tag(source, statement.value, locals, issue)
                                    if issue.code != 0 { return false }
                                    if statement.kind == 280 && expected_return != 0 {
                                        if expression_is_null(statement.value) { inferred = 6 }
                                        if !type_assignable(expected_return, inferred) {
                                            issue.code = 5
                                            issue.start = statement.start
                                            issue.end = statement.end
                                            return false
                                        }
                                    }
                                    if check_tail && statement.kind == 303 && statement_node_is_null(statement.next) && expected_return != 0 && !type_assignable(expected_return, inferred) {
                                        type_fail(issue, 5, statement.value)
                                        return false
                                    }
                                    if !type_check_block(source, statement.body, locals, storage, expected_return, false, issue) { return false }
                                }
                            }
                        }
                    }
                }
            }
        }
        if locals == (mimi_buffer_empty() as *TypeSymbol) && (statement.kind == 285 || statement.kind == 309) { issue.code = 3 return false }
        statement = statement.next
    }
    true
}

type_check_function :: fn (source : []u8, function : *FunctionNode, storage : *ExpressionArena, issue : *NameIssue) bool {
    if function_node_is_null(function) || block_node_is_null(function.body) { return true }
    locals : *TypeSymbol = mimi_buffer_empty() as *TypeSymbol
    parameter := function.parameters
    while !parameter_list_is_null(parameter) {
        tag := type_annotation_tag(source, parameter.data_type)
        locals = type_symbol_push(storage, locals, parameter.name_start, parameter.name_end, tag)
        if locals == (mimi_buffer_empty() as *TypeSymbol) { issue.code = 3 return false }
        parameter = parameter.next
    }
    type_check_block(source, function.body, locals, storage, type_annotation_tag(source, function.return_type), true, issue)
}

pub check_module_tuple_types :: fn (source : []u8, module : *ModuleNode, storage : *ExpressionArena) NameIssue {
    issue := NameIssue { code = 0, start = 0, end = 0 }
    if module_node_is_null(module) { issue.code = 3 return issue }
    declaration := module.declarations
    while declaration != (mimi_buffer_empty() as *ModuleDeclarationNode) {
        if !type_check_function(source, declaration.function, storage, &issue) { return issue }
        if declaration.struct_node != (mimi_buffer_empty() as *StructNode) {
            method := declaration.struct_node.methods
            while method != (mimi_buffer_empty() as *StructMethodNode) {
                if !type_check_function(source, method.function, storage, &issue) { return issue }
                method = method.next
            }
        }
        declaration = declaration.next
    }
    issue
}

pub Storage :: struct {
    head : *void,
    last : *void,
}

pub init :: fn () Storage {
    empty := mimi_arena_empty()
    Storage { head = empty, last = empty }
}

pub release :: fn (storage : *Storage) void { mimi_arena_release(storage as *ExpressionArena) }

allocate :: fn (storage : *Storage, size : u64) bool {
    mimi_arena_allocate(storage as *ExpressionArena, size, 8) != 0
}

pub Expr :: struct {
    kind : u64,
    type_tag : u64,
    start : u64,
    end : u64,
    payload_start : u64,
    payload_end : u64,
    left : *Expr,
    right : *Expr,
    otherwise : *Expr,
    is_external : bool,
    callee : *Function,
}

pub Statement :: struct {
    kind : u64,
    type_tag : u64,
    start : u64,
    end : u64,
    name_start : u64,
    name_end : u64,
    value : *Expr,
    next : *Statement,
    then_body : *Statement,
    else_body : *Statement,
    loop_kind : u64,
    range_end : *Expr,
}

pub Parameter :: struct {
    name_start : u64,
    name_end : u64,
    type_tag : u64,
    next : *Parameter,
}

pub Function :: struct {
    name_start : u64,
    name_end : u64,
    return_tag : u64,
    parameters : *Parameter,
    body : *Statement,
    next : *Function,
    is_external : bool,
    source : []u8,
    owner : *ModuleInput,
    syntax : *FunctionNode,
    is_public : bool,
}

pub ModuleInput :: struct {
    id : u64,
    path : []u8,
    source : []u8,
    parsed : *ModuleNode,
    imports : *ImportInput,
    next : *ModuleInput,
}

pub ImportInput :: struct {
    alias : []u8,
    target : *ModuleInput,
    next : *ImportInput,
}

pub Module :: struct {
    functions : *Function,
    function_count : u64,
}

pub LowerIssue :: struct {
    code : u64,
    start : u64,
    end : u64,
    owner : *ModuleInput,
}

pub LowerResult :: struct {
    module : *Module,
    issue : LowerIssue,
}

pub lower_issue_message :: fn (code : u64) []u8 {
    if code == 1 { return "expression is not supported by the C backend" }
    if code == 2 { return "identifier has no supported scalar type" }
    if code == 3 { return "scalar expression or return has an incompatible type" }
    if code == 4 { return "out of memory while lowering" }
    if code == 5 { return "statement is not supported by the C backend" }
    if code == 6 { return "declaration is not supported by the C backend" }
    if code == 7 { return "cannot assign to an immutable binding" }
    "unknown lowering failure"
}

Symbol :: struct {
    start : u64,
    end : u64,
    type_tag : u64,
    next : *Symbol,
    mutable : bool,
}

pub expr_is_null :: fn (value : *Expr) bool { value == (mimi_buffer_empty() as *Expr) }
pub statement_is_null :: fn (value : *Statement) bool { value == (mimi_buffer_empty() as *Statement) }
pub module_is_null :: fn (value : *Module) bool { value == (mimi_buffer_empty() as *Module) }

fail :: fn (issue : *LowerIssue, code : u64, start : u64, end : u64) void {
    if issue.code != 0 { return }
    issue.code = code
    issue.start = start
    issue.end = end
}

same_name :: fn (source : []u8, first_start : u64, first_end : u64, second_start : u64, second_end : u64) bool {
    if first_end - first_start != second_end - second_start { return false }
    index : u64 = 0
    while index < first_end - first_start {
        if source[first_start + index] != source[second_start + index] { return false }
        index = index + 1
    }
    true
}

name_is :: fn (source : []u8, start : u64, end : u64, expected : []u8) bool {
    if end - start != expected.len { return false }
    index : u64 = 0
    while index < expected.len {
        if source[start + index] != expected[index] { return false }
        index = index + 1
    }
    true
}

type_tag :: fn (source : []u8, node : *ExprNode) u64 {
    if expression_is_null(node) { return 0 }
    if node.kind == 271 { return 7 }
    if node.kind == 272 && !expression_is_null(node.left) && node.left.kind == 270 && name_is(source, node.left.start, node.left.end, "u8") { return 8 }
    if node.kind != 270 { return 0 }
    token := next_token(source, node.start)
    if token.0 != 1 { return 0 }
    if name_is(source, token.1, token.2, "bool") { return 2 }
    if name_is(source, token.1, token.2, "void") { return 6 }
    if name_is(source, token.1, token.2, "f32") || name_is(source, token.1, token.2, "f64") { return 3 }
    if name_is(source, token.1, token.2, "i8") || name_is(source, token.1, token.2, "i16") || name_is(source, token.1, token.2, "i32") || name_is(source, token.1, token.2, "i64") || name_is(source, token.1, token.2, "u8") || name_is(source, token.1, token.2, "u16") || name_is(source, token.1, token.2, "u32") || name_is(source, token.1, token.2, "u64") { return 1 }
    0
}

symbol_find :: fn (source : []u8, start : u64, end : u64, head : *Symbol) *Symbol {
    symbol := head
    while symbol != (mimi_buffer_empty() as *Symbol) {
        if same_name(source, start, end, symbol.start, symbol.end) { return symbol }
        symbol = symbol.next
    }
    mimi_buffer_empty() as *Symbol
}

symbol_type :: fn (source : []u8, start : u64, end : u64, head : *Symbol) u64 {
    symbol := symbol_find(source, start, end, head)
    if symbol == (mimi_buffer_empty() as *Symbol) { return 0 }
    symbol.type_tag
}

symbol_push :: fn (storage : *Storage, head : *Symbol, start : u64, end : u64, tag : u64, mutable : bool) *Symbol {
    if !allocate(storage, 40) { return mimi_buffer_empty() as *Symbol }
    item := storage.last as *Symbol
    item.start = start
    item.end = end
    item.type_tag = tag
    item.next = head
    item.mutable = mutable
    item
}

allocate_ir_expr :: fn (storage : *Storage, source_node : *ExprNode, tag : u64, left : *Expr, right : *Expr) *Expr {
    if !allocate(storage, 88) { return mimi_buffer_empty() as *Expr }
    item := storage.last as *Expr
    item.kind = source_node.kind
    item.type_tag = tag
    item.start = source_node.start
    item.end = source_node.end
    item.payload_start = source_node.payload_start
    item.payload_end = source_node.payload_end
    item.left = left
    item.right = right
    item.otherwise = mimi_buffer_empty() as *Expr
    item.is_external = false
    item.callee = mimi_buffer_empty() as *Function
    item
}

numeric :: fn (tag : u64) bool { tag == 1 || tag == 3 }

names_match :: fn (source : []u8, start : u64, end : u64, other : []u8, other_start : u64, other_end : u64) bool {
    if end < start || other_end < other_start || end - start != other_end - other_start { return false }
    index : u64 = 0
    while index < end - start {
        if source[start + index] != other[other_start + index] { return false }
        index = index + 1
    }
    true
}

find_import :: fn (source : []u8, start : u64, end : u64, owner : *ModuleInput) *ModuleInput {
    edge := owner.imports
    while edge != (mimi_buffer_empty() as *ImportInput) {
        if names_match(source, start, end, edge.alias, 0, edge.alias.len) { return edge.target }
        edge = edge.next
    }
    mimi_buffer_empty() as *ModuleInput
}

find_function :: fn (source : []u8, start : u64, end : u64, owner : *ModuleInput, functions : *Function) *Function {
    current := functions
    while current != (mimi_buffer_empty() as *Function) {
        if current.owner == owner && names_match(source, start, end, current.source, current.name_start, current.name_end) { return current }
        current = current.next
    }
    mimi_buffer_empty() as *Function
}

parameter_at :: fn (first : *Parameter, index : u64) *Parameter {
    current := first
    position : u64 = 0
    while current != (mimi_buffer_empty() as *Parameter) && position < index {
        current = current.next
        position = position + 1
    }
    current
}

parameter_count :: fn (first : *Parameter) u64 {
    count : u64 = 0
    current := first
    while current != (mimi_buffer_empty() as *Parameter) {
        count = count + 1
        current = current.next
    }
    count
}

main_parameters_valid :: fn (source : []u8, first : *ParameterNode) bool {
    if parameter_list_is_null(first) { return true }
    second := first.next
    if parameter_list_is_null(second) || !parameter_list_is_null(second.next) { return false }
    first_type := first.data_type
    second_type := second.data_type
    if expression_is_null(first_type) || first_type.kind != 270 || !name_is(source, first_type.start, first_type.end, "i32") { return false }
    if expression_is_null(second_type) || second_type.kind != 271 || expression_is_null(second_type.left) || second_type.left.kind != 271 { return false }
    inner := second_type.left.left
    !expression_is_null(inner) && inner.kind == 270 && name_is(source, inner.start, inner.end, "u8")
}

lower_arguments :: fn (source : []u8, owner : *ModuleInput, node : *ExprNode, locals : *Symbol, functions : *Function, storage : *Storage, parameters : *Parameter, cursor : *u64, issue : *LowerIssue) *Expr {
    empty : *Expr = mimi_buffer_empty() as *Expr
    if node.kind == 262 {
        left := lower_arguments(source, owner, node.left, locals, functions, storage, parameters, cursor, issue)
        if expr_is_null(left) { return empty }
        right := lower_arguments(source, owner, node.right, locals, functions, storage, parameters, cursor, issue)
        if expr_is_null(right) { return empty }
        result := allocate_ir_expr(storage, node, 0, left, right)
        if expr_is_null(result) { fail(issue, 4, node.start, node.end) }
        return result
    }
    parameter := parameter_at(parameters, cursor[0])
    if parameter == (mimi_buffer_empty() as *Parameter) { fail(issue, 3, node.start, node.end) return empty }
    value := lower_expr(source, owner, node, locals, functions, storage, issue)
    if expr_is_null(value) { return empty }
    if !type_assignable(parameter.type_tag, value.type_tag) { fail(issue, 3, node.start, node.end) return empty }
    cursor[0] = cursor[0] + 1
    value
}

lower_expr :: fn (source : []u8, owner : *ModuleInput, node : *ExprNode, locals : *Symbol, functions : *Function, storage : *Storage, issue : *LowerIssue) *Expr {
    empty : *Expr = mimi_buffer_empty() as *Expr
    if expression_is_null(node) { fail(issue, 1, 0, 0) return empty }
    if node.kind == 288 {
        if expression_is_null(node.right) || node.right.kind != 276 { fail(issue, 1, node.start, node.end) return empty }
        condition := lower_expr(source, owner, node.left, locals, functions, storage, issue)
        if expr_is_null(condition) { return empty }
        if condition.type_tag != 2 { fail(issue, 3, node.left.start, node.left.end) return empty }
        then_value := lower_expr(source, owner, node.right.left, locals, functions, storage, issue)
        else_value := lower_expr(source, owner, node.right.right, locals, functions, storage, issue)
        if expr_is_null(then_value) || expr_is_null(else_value) { return empty }
        tag := then_value.type_tag
        if tag != else_value.type_tag {
            if !numeric(tag) || !numeric(else_value.type_tag) { fail(issue, 3, node.start, node.end) return empty }
            tag = 3
        }
        result := allocate_ir_expr(storage, node, tag, condition, then_value)
        if expr_is_null(result) { fail(issue, 4, node.start, node.end) return empty }
        result.otherwise = else_value
        return result
    }
    if node.kind == 289 { return lower_expr(source, owner, node.left, locals, functions, storage, issue) }
    if node.kind == 263 {
        if expression_is_null(node.left) { fail(issue, 1, node.start, node.end) return empty }
        callee_owner := owner
        callee_name := node.left
        if node.left.kind == 260 {
            if expression_is_null(node.left.left) || node.left.left.kind != 1 || expression_is_null(node.left.right) || node.left.right.kind != 1 { fail(issue, 1, node.start, node.end) return empty }
            callee_owner = find_import(source, node.left.left.payload_start, node.left.left.payload_end, owner)
            callee_name = node.left.right
        } else {
            if node.left.kind != 1 { fail(issue, 1, node.start, node.end) return empty }
        }
        if callee_owner == (mimi_buffer_empty() as *ModuleInput) { fail(issue, 2, node.left.start, node.left.end) return empty }
        callee := find_function(source, callee_name.payload_start, callee_name.payload_end, callee_owner, functions)
        if callee_owner != owner && callee != (mimi_buffer_empty() as *Function) && !callee.is_public { fail(issue, 2, node.left.start, node.left.end) return empty }
        if callee == (mimi_buffer_empty() as *Function) { fail(issue, 2, node.left.start, node.left.end) return empty }
        cursor : u64 = 0
        arguments : *Expr = empty
        if !expression_is_null(node.right) {
            arguments = lower_arguments(source, owner, node.right, locals, functions, storage, callee.parameters, &cursor, issue)
            if expr_is_null(arguments) { return empty }
        }
        if cursor != parameter_count(callee.parameters) { fail(issue, 3, node.start, node.end) return empty }
        result := allocate_ir_expr(storage, node, callee.return_tag, empty, arguments)
        if expr_is_null(result) { fail(issue, 4, node.start, node.end) return empty }
        result.payload_start = callee_name.payload_start
        result.payload_end = callee_name.payload_end
        result.is_external = callee.is_external
        result.callee = callee
        return result
    }
    if node.kind == 1 {
        if name_is(source, node.payload_start, node.payload_end, "null") { return allocate_ir_expr(storage, node, 7, empty, empty) }
        tag := symbol_type(source, node.payload_start, node.payload_end, locals)
        if tag == 0 { fail(issue, 2, node.start, node.end) return empty }
        return allocate_ir_expr(storage, node, tag, empty, empty)
    }
    if node.kind == 3 { return allocate_ir_expr(storage, node, 8, empty, empty) }
    if node.kind == 260 {
        receiver := lower_expr(source, owner, node.left, locals, functions, storage, issue)
        if expr_is_null(receiver) { return empty }
        if receiver.type_tag != 8 || expression_is_null(node.right) || node.right.kind != 1 { fail(issue, 1, node.start, node.end) return empty }
        tag : u64 = 0
        if name_is(source, node.right.start, node.right.end, "ptr") { tag = 7 }
        if name_is(source, node.right.start, node.right.end, "len") { tag = 1 }
        if tag == 0 { fail(issue, 1, node.right.start, node.right.end) return empty }
        return allocate_ir_expr(storage, node, tag, receiver, empty)
    }
    if node.kind == 2 {
        tag : u64 = 1
        index := node.payload_start
        while index < node.payload_end {
            if source[index] == 46 { tag = 3 }
            index = index + 1
        }
        return allocate_ir_expr(storage, node, tag, empty, empty)
    }
    if node.kind == 4 || node.kind == 5 { return allocate_ir_expr(storage, node, 2, empty, empty) }
    if node.kind == 293 {
        value := lower_expr(source, owner, node.left, locals, functions, storage, issue)
        tag := type_tag(source, node.right)
        if expr_is_null(value) || tag == 0 { fail(issue, 1, node.start, node.end) return empty }
        if !(numeric(value.type_tag) && numeric(tag)) && !(tag == 7 && value.type_tag == 7) {
            fail(issue, 3, node.start, node.end)
            return empty
        }
        return allocate_ir_expr(storage, node, tag, value, empty)
    }
    if node.kind == 295 || node.kind == 283 {
        value := lower_expr(source, owner, node.left, locals, functions, storage, issue)
        if expr_is_null(value) { return empty }
        if (node.kind == 295 && !numeric(value.type_tag)) || (node.kind == 283 && value.type_tag != 2) {
            fail(issue, 3, node.start, node.end)
            return empty
        }
        tag : u64 = if node.kind == 283 { 2 } else { value.type_tag }
        return allocate_ir_expr(storage, node, tag, value, empty)
    }
    if node.kind == 43 || node.kind == 45 || node.kind == 42 || node.kind == 47 || node.kind == 37 || node.kind == 128 || node.kind == 129 || node.kind == 130 || node.kind == 131 || node.kind == 60 || node.kind == 62 || node.kind == 132 || node.kind == 133 {
        left := lower_expr(source, owner, node.left, locals, functions, storage, issue)
        right := lower_expr(source, owner, node.right, locals, functions, storage, issue)
        if expr_is_null(left) || expr_is_null(right) { return empty }
        tag : u64 = 2
        if node.kind == 132 || node.kind == 133 {
            if left.type_tag != 2 || right.type_tag != 2 { fail(issue, 3, node.start, node.end) return empty }
        } else {
            if node.kind == 128 || node.kind == 129 {
                if left.type_tag != right.type_tag && !(numeric(left.type_tag) && numeric(right.type_tag)) { fail(issue, 3, node.start, node.end) return empty }
            } else {
                if !numeric(left.type_tag) || !numeric(right.type_tag) { fail(issue, 3, node.start, node.end) return empty }
            }
            if node.kind == 43 || node.kind == 45 || node.kind == 42 || node.kind == 47 || node.kind == 37 {
                tag = if left.type_tag == 3 || right.type_tag == 3 { 3 } else { 1 }
            }
        }
        return allocate_ir_expr(storage, node, tag, left, right)
    }
    fail(issue, 1, node.start, node.end)
    empty
}

allocate_statement :: fn (storage : *Storage, node : *StatementNode, value : *Expr) *Statement {
    if !allocate(storage, 96) { return mimi_buffer_empty() as *Statement }
    item := storage.last as *Statement
    item.kind = node.kind
    item.type_tag = 0
    item.start = node.start
    item.end = node.end
    item.name_start = 0
    item.name_end = 0
    item.value = value
    item.next = mimi_buffer_empty() as *Statement
    item.then_body = mimi_buffer_empty() as *Statement
    item.else_body = mimi_buffer_empty() as *Statement
    item.loop_kind = 0
    item.range_end = mimi_buffer_empty() as *Expr
    item
}

lower_if_node :: fn (source : []u8, owner : *ModuleInput, node : *IfNode, locals : *Symbol, functions : *Function, storage : *Storage, expected_return : u64, in_loop : bool, issue : *LowerIssue) *Statement {
    empty : *Statement = mimi_buffer_empty() as *Statement
    condition := lower_expr(source, owner, node.condition, locals, functions, storage, issue)
    if expr_is_null(condition) { return empty }
    if condition.type_tag != 2 { fail(issue, 3, node.condition.start, node.condition.end) return empty }
    if !allocate(storage, 96) { fail(issue, 4, node.start, node.end) return empty }
    item := storage.last as *Statement
    item.kind = 304
    item.type_tag = 0
    item.start = node.start
    item.end = node.end
    item.name_start = 0
    item.name_end = 0
    item.value = condition
    item.next = empty
    item.then_body = lower_body(source, owner, node.then_branch, locals, functions, storage, expected_return, false, in_loop, issue)
    item.else_body = empty
    item.loop_kind = 0
    item.range_end = mimi_buffer_empty() as *Expr
    if issue.code != 0 { return empty }
    if !block_node_is_null(node.else_branch) {
        item.else_body = lower_body(source, owner, node.else_branch, locals, functions, storage, expected_return, false, in_loop, issue)
    }
    if !if_node_is_null(node.else_if) {
        item.else_body = lower_if_node(source, owner, node.else_if, locals, functions, storage, expected_return, in_loop, issue)
    }
    if issue.code != 0 { return empty }
    item
}

lower_body :: fn (source : []u8, owner : *ModuleInput, body : *BlockNode, incoming : *Symbol, functions : *Function, storage : *Storage, expected_return : u64, check_tail : bool, in_loop : bool, issue : *LowerIssue) *Statement {
    empty : *Statement = mimi_buffer_empty() as *Statement
    first : *Statement = empty
    last : *Statement = empty
    locals := incoming
    node := body.statements
    while !statement_node_is_null(node) {
        item : *Statement = empty
        if node.kind == 307 {
            range := node.for_loop
            if !range.is_range { fail(issue, 5, range.start, range.end) return empty }
            start := lower_expr(source, owner, range.range_start, locals, functions, storage, issue)
            ending := lower_expr(source, owner, range.range_end, locals, functions, storage, issue)
            if issue.code != 0 { return empty }
            if expr_is_null(start) || expr_is_null(ending) || start.type_tag != 1 || ending.type_tag != 1 {
                fail(issue, 3, range.start, range.end)
                return empty
            }
            item = allocate_statement(storage, node, start)
            if !statement_is_null(item) {
                item.name_start = range.variable_start
                item.name_end = range.variable_end
                item.type_tag = 1
                item.range_end = ending
                loop_locals := symbol_push(storage, locals, range.variable_start, range.variable_end, 1, false)
                if loop_locals == (mimi_buffer_empty() as *Symbol) { fail(issue, 4, range.start, range.end) return empty }
                item.then_body = lower_body(source, owner, range.body, loop_locals, functions, storage, expected_return, false, true, issue)
            }
        } else {
        if node.kind == 304 {
            item = lower_if_node(source, owner, node.if_statement, locals, functions, storage, expected_return, in_loop, issue)
        } else {
            if node.kind == 306 {
                loop_node := node.loop_statement
                condition : *Expr = mimi_buffer_empty() as *Expr
                if !expression_is_null(loop_node.condition) {
                    condition = lower_expr(source, owner, loop_node.condition, locals, functions, storage, issue)
                    if !expr_is_null(condition) && condition.type_tag != 2 { fail(issue, 3, loop_node.condition.start, loop_node.condition.end) }
                }
                if issue.code != 0 { return empty }
                item = allocate_statement(storage, node, condition)
                if !statement_is_null(item) {
                    item.loop_kind = loop_node.kind
                    item.then_body = lower_body(source, owner, loop_node.body, locals, functions, storage, expected_return, false, true, issue)
                }
            } else {
                if node.kind == 281 || node.kind == 282 {
                    if !in_loop { fail(issue, 5, node.start, node.end) return empty }
                    item = allocate_statement(storage, node, mimi_buffer_empty() as *Expr)
                } else {
                    if node.kind == 284 {
                        target := node.value.left
                        if expression_is_null(target) || target.kind != 1 { fail(issue, 5, node.start, node.end) return empty }
                        target_symbol := symbol_find(source, target.payload_start, target.payload_end, locals)
                        target_tag : u64 = if target_symbol == (mimi_buffer_empty() as *Symbol) { 0 } else { target_symbol.type_tag }
                        value := lower_expr(source, owner, node.value.right, locals, functions, storage, issue)
                        if target_tag == 0 { fail(issue, 2, target.start, target.end) return empty }
                        if !target_symbol.mutable { fail(issue, 7, target.start, target.end) return empty }
                        if expr_is_null(value) || !type_assignable(target_tag, value.type_tag) { fail(issue, 3, node.start, node.end) return empty }
                        item = allocate_statement(storage, node, value)
                        if !statement_is_null(item) {
                            item.name_start = target.payload_start
                            item.name_end = target.payload_end
                            item.type_tag = target_tag
                        }
                    } else {
                        if node.kind != 285 && node.kind != 280 && node.kind != 303 { fail(issue, 5, node.start, node.end) return empty }
                        value : *Expr = mimi_buffer_empty() as *Expr
                        if node.kind == 285 {
                            value = lower_expr(source, owner, node.binding.initializer, locals, functions, storage, issue)
                        } else {
                            if !expression_is_null(node.value) { value = lower_expr(source, owner, node.value, locals, functions, storage, issue) }
                        }
                        if issue.code != 0 { return empty }
                        if node.kind != 280 && expr_is_null(value) { fail(issue, 4, node.start, node.end) return empty }
                        if node.kind == 280 {
                            actual : u64 = if expr_is_null(value) { 6 } else { value.type_tag }
                            if !type_assignable(expected_return, actual) { fail(issue, 3, node.start, node.end) return empty }
                        }
                        if check_tail && node.kind == 303 && statement_node_is_null(node.next) && !type_assignable(expected_return, value.type_tag) {
                            fail(issue, 3, node.start, node.end)
                            return empty
                        }
                        item = allocate_statement(storage, node, value)
                        if !statement_is_null(item) && node.kind == 285 {
                            item.name_start = node.binding.name_start
                            item.name_end = node.binding.name_end
                            tag := value.type_tag
                            annotated := type_tag(source, node.binding.data_type)
                            if annotated != 0 {
                                if !type_assignable(annotated, tag) { fail(issue, 3, node.start, node.end) return empty }
                                tag = annotated
                            }
                            if tag == 6 { fail(issue, 3, node.start, node.end) return empty }
                            item.type_tag = tag
                            locals = symbol_push(storage, locals, item.name_start, item.name_end, tag, node.binding.binding_kind != 2)
                            if locals == (mimi_buffer_empty() as *Symbol) { fail(issue, 4, node.start, node.end) return empty }
                        }
                    }
                }
            }
        }
        }
        if issue.code != 0 { return empty }
        if statement_is_null(item) { fail(issue, 4, node.start, node.end) return empty }
        if statement_is_null(first) { first = item } else { last.next = item }
        last = item
        node = node.next
    }
    if check_tail && expected_return != 6 && (statement_is_null(last) || (last.kind != 280 && last.kind != 303)) {
        fail(issue, 3, body.start, body.end)
        return empty
    }
    first
}

pub lower_inputs :: fn (first : *ModuleInput, storage : *Storage) LowerResult {
    issue := LowerIssue { code = 0, start = 0, end = 0, owner = first }
    empty : *Module = mimi_buffer_empty() as *Module
    if first == (mimi_buffer_empty() as *ModuleInput) { fail(&issue, 6, 0, 0) return LowerResult { module = empty, issue = issue } }
    if !allocate(storage, 16) { fail(&issue, 4, 0, 0) return LowerResult { module = empty, issue = issue } }
    result := storage.last as *Module
    result.functions = mimi_buffer_empty() as *Function
    result.function_count = 0
    last : *Function = mimi_buffer_empty() as *Function
    owner := first
    while owner != (mimi_buffer_empty() as *ModuleInput) {
    issue.owner = owner
    source := owner.source
    parsed := owner.parsed
    if module_node_is_null(parsed) { fail(&issue, 6, 0, 0) return LowerResult { module = empty, issue = issue } }
    declaration := parsed.declarations
    while declaration != (mimi_buffer_empty() as *ModuleDeclarationNode) {
        if declaration.kind == 4 {
            if find_import(source, declaration.name_start, declaration.name_end, owner) == (mimi_buffer_empty() as *ModuleInput) {
                fail(&issue, 6, declaration.start, declaration.end)
                return LowerResult { module = empty, issue = issue }
            }
            declaration = declaration.next
            continue
        }
        if (declaration.kind != 1 && declaration.kind != 7) || function_node_is_null(declaration.function) {
            fail(&issue, 6, declaration.start, declaration.end)
            return LowerResult { module = empty, issue = issue }
        }
        function := declaration.function
        tag := type_tag(source, function.return_type)
        if tag == 0 { fail(&issue, 6, function.start, function.end) return LowerResult { module = empty, issue = issue } }
        if !allocate(storage, 96) { fail(&issue, 4, function.start, function.end) return LowerResult { module = empty, issue = issue } }
        item := storage.last as *Function
        item.name_start = function.name_start
        item.name_end = function.name_end
        item.return_tag = tag
        item.parameters = mimi_buffer_empty() as *Parameter
        item.body = mimi_buffer_empty() as *Statement
        item.next = mimi_buffer_empty() as *Function
        item.is_external = declaration.kind == 7
        item.source = source
        item.owner = owner
        item.syntax = function
        item.is_public = declaration.is_public
        last_parameter : *Parameter = mimi_buffer_empty() as *Parameter
        source_parameter := function.parameters
        while !parameter_list_is_null(source_parameter) {
            parameter_tag := type_tag(source, source_parameter.data_type)
            if parameter_tag == 0 || parameter_tag == 6 { fail(&issue, 6, source_parameter.name_start, source_parameter.name_end) return LowerResult { module = empty, issue = issue } }
            if !allocate(storage, 32) { fail(&issue, 4, source_parameter.name_start, source_parameter.name_end) return LowerResult { module = empty, issue = issue } }
            parameter := storage.last as *Parameter
            parameter.name_start = source_parameter.name_start
            parameter.name_end = source_parameter.name_end
            parameter.type_tag = parameter_tag
            parameter.next = mimi_buffer_empty() as *Parameter
            if item.parameters == (mimi_buffer_empty() as *Parameter) { item.parameters = parameter } else { last_parameter.next = parameter }
            last_parameter = parameter
            source_parameter = source_parameter.next
        }
        if owner.id == 0 && name_is(source, item.name_start, item.name_end, "main") && (item.is_external || !main_parameters_valid(source, function.parameters)) {
            fail(&issue, 6, item.name_start, item.name_end)
            return LowerResult { module = empty, issue = issue }
        }
        if result.function_count == 0 { result.functions = item } else { last.next = item }
        last = item
        result.function_count = result.function_count + 1
        declaration = declaration.next
    }
    owner = owner.next
    }
    current := result.functions
    while current != (mimi_buffer_empty() as *Function) {
        owner = current.owner
        issue.owner = owner
        source := current.source
        if !current.is_external {
            locals : *Symbol = mimi_buffer_empty() as *Symbol
            parameter := current.parameters
            while parameter != (mimi_buffer_empty() as *Parameter) {
                locals = symbol_push(storage, locals, parameter.name_start, parameter.name_end, parameter.type_tag, true)
                if locals == (mimi_buffer_empty() as *Symbol) { fail(&issue, 4, parameter.name_start, parameter.name_end) return LowerResult { module = empty, issue = issue } }
                parameter = parameter.next
            }
            current.body = lower_body(source, owner, current.syntax.body, locals, result.functions, storage, current.return_tag, true, false, &issue)
            if issue.code != 0 { return LowerResult { module = empty, issue = issue } }
        }
        current.syntax = mimi_buffer_empty() as *FunctionNode
        current = current.next
    }
    LowerResult { module = result, issue = issue }
}

pub lower_text :: fn (source : []u8, storage : *Storage) LowerResult {
    syntax := expression_arena_init()
    parsed := parse_module(source, &syntax)
    if !allocate(storage, 64) {
        lexer_issue := LowerIssue { code = 4, start = 0, end = 0, owner = mimi_buffer_empty() as *ModuleInput }
        expression_arena_release(&syntax)
        return LowerResult { module = mimi_buffer_empty() as *Module, issue = lexer_issue }
    }
    owner := storage.last as *ModuleInput
    owner.id = 0
    owner.path = ""
    owner.source = source
    owner.parsed = parsed
    owner.imports = mimi_buffer_empty() as *ImportInput
    owner.next = mimi_buffer_empty() as *ModuleInput
    result := lower_inputs(owner, storage)
    expression_arena_release(&syntax)
    result
}

extern mimi_buffer_resize : fn(buffer : *CBuffer, size : u64) i32
extern mimi_buffer_release : fn(buffer : *CBuffer) void
extern mimi_write_file : fn(path : *u8, path_length : u64, data : *u8, length : u64) i32

pub CBuffer :: struct {
    data : *u8,
    len : u64,
    capacity : u64,
    released : bool,
}

pub c_buffer_init :: fn () CBuffer {
    CBuffer { data = mimi_buffer_empty() as *u8, len = 0, capacity = 0, released = false }
}

pub c_buffer_release :: fn (buffer : *CBuffer) void {
    if buffer.released { return }
    mimi_buffer_release(buffer)
    buffer.len = 0
    buffer.capacity = 0
    buffer.released = true
}

c_push :: fn (output : *CBuffer, value : u8) bool {
    if output.released { return false }
    if output.len == output.capacity {
        capacity : u64 = if output.capacity == 0 { 256 } else { output.capacity * 2 }
        if mimi_buffer_resize(output, capacity) == 0 { return false }
        output.capacity = capacity
    }
    output.data[output.len] = value
    output.len = output.len + 1
    true
}

c_text :: fn (output : *CBuffer, value : []u8) bool {
    index : u64 = 0
    while index < value.len {
        if !c_push(output, value[index]) { return false }
        index = index + 1
    }
    true
}

c_span :: fn (output : *CBuffer, source : []u8, start : u64, end : u64) bool {
    if end < start || end > source.len { return false }
    index := start
    while index < end {
        if !c_push(output, source[index]) { return false }
        index = index + 1
    }
    true
}

c_name :: fn (output : *CBuffer, source : []u8, start : u64, end : u64, prefix : []u8) bool {
    if end <= start || end > source.len || !c_text(output, prefix) { return false }
    digits := "0123456789abcdef"
    index := start
    while index < end {
        byte := source[index]
        if !c_push(output, digits[(byte / 16) as u64]) || !c_push(output, digits[(byte % 16) as u64]) { return false }
        index = index + 1
    }
    true
}

c_uint :: fn (output : *CBuffer, value : u64) bool {
    if value >= 10 && !c_uint(output, value / 10) { return false }
    c_push(output, (48 + value % 10) as u8)
}

c_function_name :: fn (output : *CBuffer, function : *Function) bool {
    if !c_text(output, "m_") || !c_uint(output, function.owner.id) || !c_push(output, 95) { return false }
    c_name(output, function.source, function.name_start, function.name_end, "")
}

c_type :: fn (output : *CBuffer, tag : u64) bool {
    if tag == 1 { return c_text(output, "int64_t") }
    if tag == 2 { return c_text(output, "_Bool") }
    if tag == 3 { return c_text(output, "double") }
    if tag == 6 { return c_text(output, "void") }
    if tag == 7 { return c_text(output, "void*") }
    if tag == 8 { return c_text(output, "m_slice") }
    false
}

c_operator :: fn (output : *CBuffer, kind : u64) bool {
    if kind == 128 { return c_text(output, "==") }
    if kind == 129 { return c_text(output, "!=") }
    if kind == 130 { return c_text(output, "<=") }
    if kind == 131 { return c_text(output, ">=") }
    if kind == 132 { return c_text(output, "&&") }
    if kind == 133 { return c_text(output, "||") }
    if kind == 43 || kind == 45 || kind == 42 || kind == 47 || kind == 37 || kind == 60 || kind == 62 {
        return c_push(output, kind as u8)
    }
    false
}

c_parameters :: fn (output : *CBuffer, source : []u8, first : *Parameter) bool {
    if first == (mimi_buffer_empty() as *Parameter) { return c_text(output, "void") }
    current := first
    while current != (mimi_buffer_empty() as *Parameter) {
        if !c_type(output, current.type_tag) || !c_push(output, 32) { return false }
        if !c_name(output, source, current.name_start, current.name_end, "v_") { return false }
        current = current.next
        if current != (mimi_buffer_empty() as *Parameter) && !c_text(output, ", ") { return false }
    }
    true
}

c_main_parameters :: fn (output : *CBuffer, source : []u8, first : *Parameter) bool {
    if first == (mimi_buffer_empty() as *Parameter) { return c_text(output, "void") }
    second := first.next
    if second == (mimi_buffer_empty() as *Parameter) || second.next != (mimi_buffer_empty() as *Parameter) { return false }
    if !c_text(output, "int ") || !c_name(output, source, first.name_start, first.name_end, "v_") || !c_text(output, ", char **") { return false }
    c_name(output, source, second.name_start, second.name_end, "v_")
}

c_arguments :: fn (output : *CBuffer, source : []u8, value : *Expr) bool {
    if expr_is_null(value) { return true }
    if value.kind == 262 {
        if !c_arguments(output, source, value.left) || !c_text(output, ", ") { return false }
        return c_arguments(output, source, value.right)
    }
    c_expr(output, source, value)
}

c_expr :: fn (output : *CBuffer, source : []u8, value : *Expr) bool {
    if expr_is_null(value) { return false }
    if value.kind == 288 {
        if !c_push(output, 40) || !c_expr(output, source, value.left) || !c_text(output, " ? ") || !c_expr(output, source, value.right) || !c_text(output, " : ") { return false }
        if !c_expr(output, source, value.otherwise) { return false }
        return c_push(output, 41)
    }
    if value.kind == 263 {
        if value.callee == (mimi_buffer_empty() as *Function) { return false }
        if value.is_external {
            if !c_span(output, value.callee.source, value.callee.name_start, value.callee.name_end) { return false }
        } else {
            if value.callee.owner.id == 0 && name_is(value.callee.source, value.callee.name_start, value.callee.name_end, "main") {
                if !c_text(output, "main") { return false }
            } else {
                if !c_function_name(output, value.callee) { return false }
            }
        }
        if !c_push(output, 40) { return false }
        if !c_arguments(output, source, value.right) { return false }
        return c_push(output, 41)
    }
    if value.kind == 1 {
        if name_is(source, value.payload_start, value.payload_end, "null") { return c_text(output, "((void*)0)") }
        return c_name(output, source, value.payload_start, value.payload_end, "v_")
    }
    if value.kind == 3 {
        if !c_text(output, "((m_slice){(uint8_t*)") || !c_span(output, source, value.payload_start, value.payload_end) || !c_push(output, 44) { return false }
        if !c_uint(output, decoded_string_len(source, value.payload_start, value.payload_end)) { return false }
        return c_text(output, "})")
    }
    if value.kind == 260 {
        if !c_push(output, 40) || !c_expr(output, source, value.left) || !c_text(output, ").") { return false }
        if value.type_tag == 7 { return c_text(output, "ptr") }
        if value.type_tag == 1 { return c_text(output, "len") }
        return false
    }
    if value.kind == 2 { return c_span(output, source, value.payload_start, value.payload_end) }
    if value.kind == 4 { return c_text(output, "1") }
    if value.kind == 5 { return c_text(output, "0") }
    if value.kind == 293 {
        if !c_text(output, "((") || !c_type(output, value.type_tag) || !c_text(output, ")") { return false }
        if !c_expr(output, source, value.left) { return false }
        return c_text(output, ")")
    }
    if value.kind == 295 || value.kind == 283 {
        if !c_push(output, 40) { return false }
        if !c_push(output, if value.kind == 295 { 45 as u8 } else { 33 as u8 }) { return false }
        if !c_expr(output, source, value.left) { return false }
        return c_push(output, 41)
    }
    if !c_push(output, 40) || !c_expr(output, source, value.left) || !c_operator(output, value.kind) || !c_expr(output, source, value.right) {
        return false
    }
    c_push(output, 41)
}

c_indent :: fn (output : *CBuffer, depth : u64) bool {
    index : u64 = 0
    while index < depth * 2 {
        if !c_push(output, 32) { return false }
        index = index + 1
    }
    true
}

c_block :: fn (output : *CBuffer, source : []u8, first : *Statement, return_tag : u64, depth : u64, tail_returns : bool) bool {
    current := first
    while !statement_is_null(current) {
        if !c_statement(output, source, current, return_tag, depth, tail_returns) { return false }
        current = current.next
    }
    true
}

c_statement :: fn (output : *CBuffer, source : []u8, item : *Statement, return_tag : u64, depth : u64, tail_returns : bool) bool {
    if !c_indent(output, depth) { return false }
    if item.kind == 285 {
        if !c_type(output, item.type_tag) || !c_push(output, 32) { return false }
        if !c_name(output, source, item.name_start, item.name_end, "v_") || !c_text(output, " = ") { return false }
        if !c_expr(output, source, item.value) { return false }
        return c_text(output, ";\n")
    }
    if item.kind == 284 {
        if !c_name(output, source, item.name_start, item.name_end, "v_") || !c_text(output, " = ") { return false }
        if !c_expr(output, source, item.value) { return false }
        return c_text(output, ";\n")
    }
    if item.kind == 304 {
        if !c_text(output, "if (") || !c_expr(output, source, item.value) || !c_text(output, ") {\n") { return false }
        if !c_block(output, source, item.then_body, return_tag, depth + 1, false) || !c_indent(output, depth) || !c_push(output, 125) { return false }
        if !statement_is_null(item.else_body) {
            if !c_text(output, " else {\n") { return false }
            if !c_block(output, source, item.else_body, return_tag, depth + 1, false) || !c_indent(output, depth) || !c_push(output, 125) { return false }
        }
        return c_push(output, 10)
    }
    if item.kind == 306 {
        if item.loop_kind == 285 {
            if !c_text(output, "for (;;) {\n") { return false }
        } else {
            if item.loop_kind == 286 {
                if !c_text(output, "while (") || !c_expr(output, source, item.value) || !c_text(output, ") {\n") { return false }
            } else {
                if item.loop_kind != 287 || !c_text(output, "do {\n") { return false }
            }
        }
        if !c_block(output, source, item.then_body, return_tag, depth + 1, false) || !c_indent(output, depth) || !c_push(output, 125) { return false }
        if item.loop_kind == 287 {
            if !c_text(output, " while (") || !c_expr(output, source, item.value) || !c_push(output, 41) || !c_push(output, 59) { return false }
        }
        return c_push(output, 10)
    }
    if item.kind == 307 {
        if !c_text(output, "for (int64_t ") || !c_name(output, source, item.name_start, item.name_end, "v_") || !c_text(output, " = ") { return false }
        if !c_expr(output, source, item.value) || !c_text(output, ", ") || !c_name(output, source, item.name_start, item.name_end, "e_") || !c_text(output, " = ") { return false }
        if !c_expr(output, source, item.range_end) || !c_text(output, "; ") || !c_name(output, source, item.name_start, item.name_end, "v_") || !c_text(output, " < ") { return false }
        if !c_name(output, source, item.name_start, item.name_end, "e_") || !c_text(output, "; ++") || !c_name(output, source, item.name_start, item.name_end, "v_") || !c_text(output, ") {\n") { return false }
        if !c_block(output, source, item.then_body, return_tag, depth + 1, false) || !c_indent(output, depth) || !c_text(output, "}\n") { return false }
        return true
    }
    if item.kind == 281 { return c_text(output, "break;\n") }
    if item.kind == 282 { return c_text(output, "continue;\n") }
    if item.kind == 280 || (item.kind == 303 && tail_returns && statement_is_null(item.next) && return_tag != 6) {
        if !c_text(output, "return") { return false }
        if !expr_is_null(item.value) {
            if !c_push(output, 32) || !c_expr(output, source, item.value) { return false }
        }
        return c_text(output, ";\n")
    }
    if item.kind == 303 {
        if !c_expr(output, source, item.value) { return false }
        return c_text(output, ";\n")
    }
    false
}

pub emit_c :: fn (source : []u8, module : *Module, output : *CBuffer) bool {
    if module_is_null(module) || !c_text(output, "#include <stdint.h>\n#include <stdbool.h>\ntypedef struct { uint8_t *ptr; uint64_t len; } m_slice;\n\n") { return false }
    prototype := module.functions
    while prototype != (mimi_buffer_empty() as *Function) {
        is_main := prototype.owner.id == 0 && name_is(prototype.source, prototype.name_start, prototype.name_end, "main")
        if is_main {
            if prototype.return_tag != 1 || !c_text(output, "int main(") || !c_main_parameters(output, prototype.source, prototype.parameters) || !c_text(output, ");\n") { return false }
        } else {
            if !c_text(output, if prototype.is_external { "extern " } else { "static " }) || !c_type(output, prototype.return_tag) || !c_push(output, 32) { return false }
            if prototype.is_external {
                if !c_span(output, prototype.source, prototype.name_start, prototype.name_end) { return false }
            } else {
                if !c_function_name(output, prototype) { return false }
            }
            if !c_push(output, 40) { return false }
            if !c_parameters(output, prototype.source, prototype.parameters) || !c_text(output, ");\n") { return false }
        }
        prototype = prototype.next
    }
    if !c_push(output, 10) { return false }
    has_main := false
    function := module.functions
    while function != (mimi_buffer_empty() as *Function) {
        if function.is_external {
            function = function.next
            continue
        }
        is_main := function.owner.id == 0 && name_is(function.source, function.name_start, function.name_end, "main")
        if is_main {
            if has_main || function.return_tag != 1 { return false }
            has_main = true
            if !c_text(output, "int main(") || !c_main_parameters(output, function.source, function.parameters) || !c_text(output, ") {\n") { return false }
        } else {
            if !c_text(output, "static ") || !c_type(output, function.return_tag) || !c_push(output, 32) { return false }
            if !c_function_name(output, function) || !c_push(output, 40) { return false }
            if !c_parameters(output, function.source, function.parameters) || !c_text(output, ") {\n") { return false }
        }
        if !c_block(output, function.source, function.body, function.return_tag, 1, true) { return false }
        if !c_text(output, "}\n\n") { return false }
        function = function.next
    }
    has_main
}

pub emit_c_to_file :: fn (source : []u8, module : *Module, path : []u8) bool {
    output := c_buffer_init()
    valid := emit_c(source, module, &output)
    if valid { valid = mimi_write_file(path.ptr, path.len, output.data, output.len) != 0 }
    c_buffer_release(&output)
    valid
}
