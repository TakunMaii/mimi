}

pub expression_arena_init :: fn () ExpressionArena {
    empty := mimi_arena_empty()
    ExpressionArena { head = empty, last = empty }
}

pub expression_arena_release :: fn (storage : *ExpressionArena) void {
    mimi_arena_release(storage)
}

pub expression_is_null :: fn (node : *ExprNode) bool {
    node == (mimi_buffer_empty() as *ExprNode)
}

pub expression_payload :: fn (source : []u8, node : *ExprNode) []u8 {
    if expression_is_null(node) || (node.kind != 1 && node.kind != 2 && node.kind != 3) { return "" }
    source[node.payload_start:node.payload_end]
}

pub binding_header_is_null :: fn (header : *BindingHeader) bool {
    header == (mimi_buffer_empty() as *BindingHeader)
}

pub parse_binding_header :: fn (source : []u8, storage : *ExpressionArena) *BindingHeader {
    name := next_token(source, 0)
    if name.0 != 1 { return mimi_buffer_empty() as *BindingHeader }
    colon := next_token(source, name.2)
    if colon.0 != 58 { return mimi_buffer_empty() as *BindingHeader }
    marker := next_token(source, colon.2)
    binding_kind : u64 = 0
    type_start : u64 = 0
    type_end : u64 = 0
    value_start : u64 = marker.2
    if marker.0 == 58 {
        binding_kind = 2
    } else {
        if marker.0 == 61 {
            binding_kind = 0
        } else {
            binding_kind = 1
            type_start = marker.1
            cursor := marker.1
            nesting : u64 = 0
            found_equal := false
            while cursor < source.len && !found_equal {
                token := next_token(source, cursor)
                if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *BindingHeader }
                cursor = token.2
                if token.0 == 91 { nesting = nesting + 1 } else {
                    if token.0 == 93 && nesting > 0 { nesting = nesting - 1 } else {
                        if token.0 == 61 && nesting == 0 {
                            type_end = token.1
                            value_start = token.2
                            found_equal = true
                        }
                    }
                }
            }
            if !found_equal || nesting != 0 { return mimi_buffer_empty() as *BindingHeader }
            parsed_type := parse_type(source[type_start:type_end], storage)
            if expression_is_null(parsed_type) { return mimi_buffer_empty() as *BindingHeader }
        }
    }
    if next_token(source, value_start).0 == 0 || next_token(source, value_start).0 == 255 {
        return mimi_buffer_empty() as *BindingHeader
    }
    if mimi_arena_allocate(storage, 72, 8) == 0 { return mimi_buffer_empty() as *BindingHeader }
    header := storage.last as *BindingHeader
    header.start = name.1
    header.end = source.len
    header.name_start = name.1
    header.name_end = name.2
    header.binding_kind = binding_kind
    header.type_start = type_start
    header.type_end = type_end
    header.value_start = value_start
    header.value_end = source.len
    header
}

pub binding_node_is_null :: fn (binding : *BindingNode) bool {
    binding == (mimi_buffer_empty() as *BindingNode)
}

pub parse_binding_declaration :: fn (source : []u8, storage : *ExpressionArena) *BindingNode {
    header := parse_binding_header(source, storage)
    if binding_header_is_null(header) { return mimi_buffer_empty() as *BindingNode }
    initializer := parse_expression(source[header.value_start:header.value_end], storage)
    if expression_is_null(initializer) { return mimi_buffer_empty() as *BindingNode }
    initializer.start = initializer.start + header.value_start
    initializer.end = initializer.end + header.value_start
    data_type : *ExprNode = mimi_buffer_empty() as *ExprNode
    if header.binding_kind == 1 {
        data_type = parse_type(source[header.type_start:header.type_end], storage)
        if expression_is_null(data_type) { return mimi_buffer_empty() as *BindingNode }
        data_type.start = data_type.start + header.type_start
        data_type.end = data_type.end + header.type_start
    }
    if mimi_arena_allocate(storage, 56, 8) == 0 { return mimi_buffer_empty() as *BindingNode }
    binding := storage.last as *BindingNode
    binding.start = header.start
    binding.end = initializer.end
    binding.name_start = header.name_start
    binding.name_end = header.name_end
    binding.binding_kind = header.binding_kind
    binding.data_type = data_type
    binding.initializer = initializer
    binding
}

pub statement_node_is_null :: fn (statement : *StatementNode) bool {
    statement == (mimi_buffer_empty() as *StatementNode)
}

pub parse_transfer_statement :: fn (source : []u8, storage : *ExpressionArena) *StatementNode {
    keyword := next_token(source, 0)
    kind : u64 = 0
    value : *ExprNode = mimi_buffer_empty() as *ExprNode
    if keyword.0 == 175 {
        kind = 280
        next := next_token(source, keyword.2)
        if next.0 != 0 {
            value = parse_expression(source[keyword.2:source.len], storage)
            if expression_is_null(value) { return mimi_buffer_empty() as *StatementNode }
            value.start = value.start + keyword.2
            value.end = value.end + keyword.2
        }
    } else {
        if keyword.0 == 176 { kind = 281 } else {
            if keyword.0 == 177 { kind = 282 } else { return mimi_buffer_empty() as *StatementNode }
        }
        if next_token(source, keyword.2).0 != 0 { return mimi_buffer_empty() as *StatementNode }
    }
    if mimi_arena_allocate(storage, 104, 8) == 0 { return mimi_buffer_empty() as *StatementNode }
    statement := storage.last as *StatementNode
    statement.kind = kind
    statement.start = keyword.1
    statement.end = source.len
    statement.value = value
    statement.next = mimi_buffer_empty() as *StatementNode
    statement.body = mimi_buffer_empty() as *BlockNode
    statement.binding = mimi_buffer_empty() as *BindingNode
    statement.if_statement = mimi_buffer_empty() as *IfNode
    statement.if_let = mimi_buffer_empty() as *IfLetNode
    statement.loop_statement = mimi_buffer_empty() as *LoopNode
    statement.for_loop = mimi_buffer_empty() as *ForNode
    statement.match_statement = mimi_buffer_empty() as *MatchNode
    statement.tuple_binding = mimi_buffer_empty() as *TupleBindingNode
    statement
}

pub parse_defer_statement :: fn (source : []u8, storage : *ExpressionArena) *StatementNode {
    keyword := next_token(source, 0)
    if keyword.0 != 172 { return mimi_buffer_empty() as *StatementNode }
    next := next_token(source, keyword.2)
    if next.0 == 0 { return mimi_buffer_empty() as *StatementNode }
    if next.0 == 123 {
        body := parse_block_span(source[next.1:source.len], next.1, storage)
        if block_node_is_null(body) { return mimi_buffer_empty() as *StatementNode }
        if mimi_arena_allocate(storage, 104, 8) == 0 { return mimi_buffer_empty() as *StatementNode }
        statement := storage.last as *StatementNode
        statement.kind = 290
        statement.start = keyword.1
        statement.end = body.end
        statement.value = mimi_buffer_empty() as *ExprNode
        statement.next = mimi_buffer_empty() as *StatementNode
        statement.body = body
        statement.binding = mimi_buffer_empty() as *BindingNode
        statement.if_statement = mimi_buffer_empty() as *IfNode
        statement.if_let = mimi_buffer_empty() as *IfLetNode
        statement.loop_statement = mimi_buffer_empty() as *LoopNode
        statement.for_loop = mimi_buffer_empty() as *ForNode
        statement.match_statement = mimi_buffer_empty() as *MatchNode
        statement.tuple_binding = mimi_buffer_empty() as *TupleBindingNode
        return statement
    }
    value := parse_expression(source[keyword.2:source.len], storage)
    if expression_is_null(value) { return mimi_buffer_empty() as *StatementNode }
    value.start = value.start + keyword.2
    value.end = value.end + keyword.2
    if mimi_arena_allocate(storage, 104, 8) == 0 { return mimi_buffer_empty() as *StatementNode }
    statement := storage.last as *StatementNode
    statement.kind = 283
    statement.start = keyword.1
    statement.end = source.len
    statement.value = value
    statement.next = mimi_buffer_empty() as *StatementNode
    statement.body = mimi_buffer_empty() as *BlockNode
    statement.binding = mimi_buffer_empty() as *BindingNode
    statement.if_statement = mimi_buffer_empty() as *IfNode
    statement.if_let = mimi_buffer_empty() as *IfLetNode
    statement.loop_statement = mimi_buffer_empty() as *LoopNode
    statement.for_loop = mimi_buffer_empty() as *ForNode
    statement.match_statement = mimi_buffer_empty() as *MatchNode
    statement.tuple_binding = mimi_buffer_empty() as *TupleBindingNode
    statement
}

pub parse_assignment_statement :: fn (source : []u8, storage : *ExpressionArena) *StatementNode {
    cursor : u64 = 0
    paren_depth : u64 = 0
    bracket_depth : u64 = 0
    equal_start : u64 = source.len
    equal_end : u64 = source.len
    while cursor < source.len {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *StatementNode }
        cursor = token.2
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 {
                if paren_depth == 0 { return mimi_buffer_empty() as *StatementNode }
                paren_depth = paren_depth - 1
            } else {
                if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                    if token.0 == 93 {
                        if bracket_depth == 0 { return mimi_buffer_empty() as *StatementNode }
                        bracket_depth = bracket_depth - 1
                    } else {
                        if token.0 == 61 && paren_depth == 0 && bracket_depth == 0 {
                            if equal_start != source.len { return mimi_buffer_empty() as *StatementNode }
                            equal_start = token.1
                            equal_end = token.2
                        }
                    }
                }
            }
        }
    }
    if equal_start == source.len || paren_depth != 0 || bracket_depth != 0 { return mimi_buffer_empty() as *StatementNode }
    target := parse_expression(source[0:equal_start], storage)
    if expression_is_null(target) { return mimi_buffer_empty() as *StatementNode }
    value := parse_expression(source[equal_end:source.len], storage)
    if expression_is_null(value) { return mimi_buffer_empty() as *StatementNode }
    value.start = value.start + equal_end
    value.end = value.end + equal_end
    assignment := allocate_expr(storage, 284, target.start, value.end, target, value)
    if expression_is_null(assignment) { return mimi_buffer_empty() as *StatementNode }
    if mimi_arena_allocate(storage, 104, 8) == 0 { return mimi_buffer_empty() as *StatementNode }
    statement := storage.last as *StatementNode
    statement.kind = 284
    statement.start = target.start
    statement.end = value.end
    statement.value = assignment
    statement.next = mimi_buffer_empty() as *StatementNode
    statement.body = mimi_buffer_empty() as *BlockNode
    statement.binding = mimi_buffer_empty() as *BindingNode
    statement.if_statement = mimi_buffer_empty() as *IfNode
    statement.if_let = mimi_buffer_empty() as *IfLetNode
    statement.loop_statement = mimi_buffer_empty() as *LoopNode
    statement.for_loop = mimi_buffer_empty() as *ForNode
    statement.match_statement = mimi_buffer_empty() as *MatchNode
    statement.tuple_binding = mimi_buffer_empty() as *TupleBindingNode
    statement
}

pub tuple_binding_is_null :: fn (binding : *TupleBindingNode) bool {
    binding == (mimi_buffer_empty() as *TupleBindingNode)
}

tuple_expression_item_count :: fn (items : *ExprNode) u64 {
    if expression_is_null(items) { return 0 }
    if items.kind == 262 { return tuple_expression_item_count(items.left) + 1 }
    1
}

pub parse_tuple_binding :: fn (source : []u8, storage : *ExpressionArena) *TupleBindingNode {
    cursor : u64 = 0
    names : *DestructureNameNode = mimi_buffer_empty() as *DestructureNameNode
    last : *DestructureNameNode = mimi_buffer_empty() as *DestructureNameNode
    count : u64 = 0
    value_start : u64 = 0
    while true {
        name := next_token(source, cursor)
        if name.0 != 1 { return mimi_buffer_empty() as *TupleBindingNode }
        previous := names
        duplicate := false
        while previous != (mimi_buffer_empty() as *DestructureNameNode) && !duplicate {
            if previous.end - previous.start == name.2 - name.1 {
                equal := true
                index : u64 = 0
                while index < name.2 - name.1 && equal {
                    if source[previous.start + index] != source[name.1 + index] { equal = false }
                    index = index + 1
                }
                if equal { duplicate = true }
            }
            previous = previous.next
        }
        if duplicate { return mimi_buffer_empty() as *TupleBindingNode }
        if mimi_arena_allocate(storage, 24, 8) == 0 { return mimi_buffer_empty() as *TupleBindingNode }
        item := storage.last as *DestructureNameNode
        item.start = name.1
        item.end = name.2
        item.next = mimi_buffer_empty() as *DestructureNameNode
        if last == (mimi_buffer_empty() as *DestructureNameNode) { names = item } else { last.next = item }
        last = item
        count = count + 1
        separator := next_token(source, name.2)
        if separator.0 == 44 {
            cursor = separator.2
        } else {
            if separator.0 != 58 { return mimi_buffer_empty() as *TupleBindingNode }
            equal := next_token(source, separator.2)
            if equal.0 != 61 { return mimi_buffer_empty() as *TupleBindingNode }
            value_start = equal.2
            break
        }
    }
    if count < 2 { return mimi_buffer_empty() as *TupleBindingNode }
    value := parse_tuple_literal(source[value_start:source.len], storage)
    if expression_is_null(value) { return mimi_buffer_empty() as *TupleBindingNode }
    if tuple_expression_item_count(value.left) != count { return mimi_buffer_empty() as *TupleBindingNode }
    value.start = value.start + value_start
    value.end = value.end + value_start
    if mimi_arena_allocate(storage, 40, 8) == 0 { return mimi_buffer_empty() as *TupleBindingNode }
    binding := storage.last as *TupleBindingNode
    binding.start = names.start
    binding.end = value.end
    binding.name_count = count
    binding.names = names
    binding.value = value
    binding
}

pub function_header_is_null :: fn (header : *FunctionHeader) bool {
    header == (mimi_buffer_empty() as *FunctionHeader)
}

pub parse_function_header :: fn (source : []u8, storage : *ExpressionArena) *FunctionHeader {
    name := next_token(source, 0)
    if name.0 != 1 { return mimi_buffer_empty() as *FunctionHeader }
    colon1 := next_token(source, name.2)
    colon2 := next_token(source, colon1.2)
    function_keyword := next_token(source, colon2.2)
    open := next_token(source, function_keyword.2)
    if colon1.0 != 58 || colon2.0 != 58 || function_keyword.0 != 160 || open.0 != 40 {
        return mimi_buffer_empty() as *FunctionHeader
    }
    parameters_start := open.2
    cursor := open.2
    nesting : u64 = 1
    while cursor < source.len && nesting != 0 {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *FunctionHeader }
        cursor = token.2
        if token.0 == 40 { nesting = nesting + 1 } else {
            if token.0 == 41 { nesting = nesting - 1 }
        }
    }
    if nesting != 0 { return mimi_buffer_empty() as *FunctionHeader }
    parameters_end := cursor - 1
    return_type := next_token(source, cursor)
    return_type_start : u64 = return_type.1
    return_type_end : u64 = return_type.2
    body_open := return_type
    if return_type.0 != 123 {
        if return_type.0 == 0 || return_type.0 == 255 { return mimi_buffer_empty() as *FunctionHeader }
        type_end := return_type.2
        type_cursor := return_type.2
        while type_cursor < source.len {
            token := next_token(source, type_cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *FunctionHeader }
            if token.0 == 123 {
                body_open = token
                break
            }
            type_end = token.2
            type_cursor = token.2
        }
        if body_open.0 != 123 { return mimi_buffer_empty() as *FunctionHeader }
        return_type_end = type_end
        parsed_return_type := parse_type(source[return_type_start:return_type_end], storage)
        if expression_is_null(parsed_return_type) { return mimi_buffer_empty() as *FunctionHeader }
    } else {
        return_type_start = return_type.1
        return_type_end = return_type.1
    }
    if mimi_arena_allocate(storage, 72, 8) == 0 { return mimi_buffer_empty() as *FunctionHeader }
    header := storage.last as *FunctionHeader
    header.start = name.1
    header.end = body_open.2
    header.name_start = name.1
    header.name_end = name.2
    header.parameters_start = parameters_start
    header.parameters_end = parameters_end
    header.return_type_start = return_type_start
    header.return_type_end = return_type_end
    header.body_start = body_open.2
    header
}

pub block_node_is_null :: fn (block : *BlockNode) bool {
    block == (mimi_buffer_empty() as *BlockNode)
}

pub parse_block_span :: fn (source : []u8, offset : u64, storage : *ExpressionArena) *BlockNode {
    opening := next_token(source, 0)
    if opening.0 != 123 { return mimi_buffer_empty() as *BlockNode }
    cursor := opening.2
    depth : u64 = 1
    close_start : u64 = 0
    close_end : u64 = 0
    while depth > 0 {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *BlockNode }
        cursor = token.2
        if token.0 == 123 { depth = depth + 1 } else {
            if token.0 == 125 {
                depth = depth - 1
                if depth == 0 {
                    close_start = token.1
                    close_end = token.2
                }
            }
        }
    }
    if next_token(source, close_end).0 != 0 { return mimi_buffer_empty() as *BlockNode }
    if mimi_arena_allocate(storage, 40, 8) == 0 { return mimi_buffer_empty() as *BlockNode }
    block := storage.last as *BlockNode
    block.start = opening.1 + offset
    block.end = close_end + offset
    block.content_start = opening.2 + offset
    block.content_end = close_start + offset
    block.statements = mimi_buffer_empty() as *StatementNode
    block
}

pub parse_statement_block :: fn (source : []u8, offset : u64, storage : *ExpressionArena) *BlockNode {
    block := parse_block_span(source, offset, storage)
    if block_node_is_null(block) { return block }
    opening := next_token(source, 0)
    closing := block.content_end - offset
    cursor := opening.2
    segment_start := cursor
    paren_depth : u64 = 0
    bracket_depth : u64 = 0
    brace_depth : u64 = 0
    previous_kind : u8 = 0
    first : *StatementNode = mimi_buffer_empty() as *StatementNode
    last : *StatementNode = mimi_buffer_empty() as *StatementNode
    while cursor < closing {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 || token.2 > closing { return mimi_buffer_empty() as *BlockNode }
        at_top_level := paren_depth == 0 && bracket_depth == 0 && brace_depth == 0
        if at_top_level && token.1 > segment_start && (statement_starts_here(source, token) || (previous_kind == 125 && expression_starts_statement(token.0))) {
            previous := parse_statement_piece(source[segment_start:token.1], segment_start + offset, storage)
            if statement_node_is_null(previous) { return mimi_buffer_empty() as *BlockNode }
            if first == (mimi_buffer_empty() as *StatementNode) { first = previous } else { last.next = previous }
            last = previous
            while last.next != (mimi_buffer_empty() as *StatementNode) { last = last.next }
            segment_start = token.1
        }
        cursor = token.2
        previous_kind = token.0
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 {
                if paren_depth == 0 { return mimi_buffer_empty() as *BlockNode }
                paren_depth = paren_depth - 1
            } else {
                if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                    if token.0 == 93 {
                        if bracket_depth == 0 { return mimi_buffer_empty() as *BlockNode }
                        bracket_depth = bracket_depth - 1
                    } else {
                        if token.0 == 123 { brace_depth = brace_depth + 1 } else {
                            if token.0 == 125 {
                                if brace_depth == 0 { return mimi_buffer_empty() as *BlockNode }
                                brace_depth = brace_depth - 1
                            }
                        }
                    }
                }
            }
        }
    }
    if paren_depth != 0 || bracket_depth != 0 || brace_depth != 0 { return mimi_buffer_empty() as *BlockNode }
    trailing := next_token(source, segment_start)
    if trailing.0 != 0 && trailing.1 < closing {
        current := parse_statement_piece(source[segment_start:closing], segment_start + offset, storage)
        if statement_node_is_null(current) { return mimi_buffer_empty() as *BlockNode }
        if first == (mimi_buffer_empty() as *StatementNode) { first = current } else { last.next = current }
        last = current
        while last.next != (mimi_buffer_empty() as *StatementNode) { last = last.next }
    }
    block.statements = first
    block
}

expression_starts_statement :: fn (kind : u8) bool {
    kind == 1 || kind == 2 || kind == 3 || kind == 4 || kind == 5 || kind == 40 || kind == 42 || kind == 38 || kind == 45 || kind == 33
}

statement_starts_here :: fn (source : []u8, token : (u8, u64, u64)) bool {
    if token.0 == 163 || token.0 == 164 || token.0 == 168 || token.0 == 169 || token.0 == 170 || token.0 == 171 || token.0 == 172 || token.0 == 175 || token.0 == 176 || token.0 == 177 { return true }
    if token.0 != 1 { return false }
    separator := next_token(source, token.2)
    if separator.0 == 58 {
        after_colon := next_token(source, separator.2)
        return after_colon.0 == 58 || after_colon.0 == 61
    }
    separator.0 == 61 || separator.0 == 44
}

parse_statement_piece :: fn (source : []u8, offset : u64, storage : *ExpressionArena) *StatementNode {
    first := next_token(source, 0)
    statement : *StatementNode = mimi_buffer_empty() as *StatementNode
    if first.0 == 163 {
        match_node := parse_match_expression(source, storage)
        if match_node_is_null(match_node) { return mimi_buffer_empty() as *StatementNode }
        statement = allocate_control_statement(storage, 308, match_node.start, match_node.end)
        statement.match_statement = match_node
    } else {
    if first.0 == 164 {
        if_let := parse_if_let_statement(source, storage)
        if !if_let_node_is_null(if_let) {
            statement = allocate_control_statement(storage, 305, if_let.start, if_let.end)
            statement.if_let = if_let
        } else {
            if_node := parse_if_statement(source, storage)
            if if_node_is_null(if_node) { return mimi_buffer_empty() as *StatementNode }
            statement = allocate_control_statement(storage, 304, if_node.start, if_node.end)
            statement.if_statement = if_node
        }
    } else {
    if first.0 == 168 || first.0 == 169 || first.0 == 171 {
        loop_node := parse_loop_statement(source, storage)
        if loop_node_is_null(loop_node) { return mimi_buffer_empty() as *StatementNode }
        statement = allocate_control_statement(storage, 306, loop_node.start, loop_node.end)
        statement.loop_statement = loop_node
    } else {
    if first.0 == 170 {
        for_node := parse_for_statement(source, storage)
        if for_node_is_null(for_node) { return mimi_buffer_empty() as *StatementNode }
        statement = allocate_control_statement(storage, 307, for_node.start, for_node.end)
        statement.for_loop = for_node
    } else {
    if first.0 == 175 || first.0 == 176 || first.0 == 177 {
        statement = parse_transfer_statement(source, storage)
    } else {
        if first.0 == 172 {
            statement = parse_defer_statement(source, storage)
        } else {
            tuple_value : *TupleBindingNode = mimi_buffer_empty() as *TupleBindingNode
            if next_token(source, first.2).0 == 44 { tuple_value = parse_tuple_binding(source, storage) }
            if !tuple_binding_is_null(tuple_value) {
                statement = allocate_control_statement(storage, 309, tuple_value.start, tuple_value.end)
                statement.tuple_binding = tuple_value
            } else {
            binding := parse_binding_declaration(source, storage)
            if !binding_node_is_null(binding) {
                if mimi_arena_allocate(storage, 104, 8) == 0 { return mimi_buffer_empty() as *StatementNode }
                statement = storage.last as *StatementNode
                statement.kind = 285
                statement.start = binding.start
                statement.end = binding.end
                statement.value = binding.initializer
                statement.next = mimi_buffer_empty() as *StatementNode
                statement.body = mimi_buffer_empty() as *BlockNode
                statement.binding = binding
                statement.if_statement = mimi_buffer_empty() as *IfNode
                statement.if_let = mimi_buffer_empty() as *IfLetNode
                statement.loop_statement = mimi_buffer_empty() as *LoopNode
                statement.for_loop = mimi_buffer_empty() as *ForNode
                statement.match_statement = mimi_buffer_empty() as *MatchNode
                statement.tuple_binding = mimi_buffer_empty() as *TupleBindingNode
            } else {
                statement = parse_assignment_statement(source, storage)
                if statement_node_is_null(statement) {
                    value := parse_expression(source, storage)
                    if expression_is_null(value) { return mimi_buffer_empty() as *StatementNode }
                    if mimi_arena_allocate(storage, 104, 8) == 0 { return mimi_buffer_empty() as *StatementNode }
                    statement = storage.last as *StatementNode
                    statement.kind = 303
                    statement.start = value.start
                    statement.end = value.end
                    statement.value = value
                    statement.next = mimi_buffer_empty() as *StatementNode
                    statement.body = mimi_buffer_empty() as *BlockNode
                    statement.binding = mimi_buffer_empty() as *BindingNode
                    statement.if_statement = mimi_buffer_empty() as *IfNode
                    statement.if_let = mimi_buffer_empty() as *IfLetNode
                    statement.loop_statement = mimi_buffer_empty() as *LoopNode
                    statement.for_loop = mimi_buffer_empty() as *ForNode
                    statement.match_statement = mimi_buffer_empty() as *MatchNode
                    statement.tuple_binding = mimi_buffer_empty() as *TupleBindingNode
                }
            }
            }
        }
    }
    }
    }
    }
    }
    if statement_node_is_null(statement) { return statement }
    compose_statement_blocks(source, statement, storage)
    shift_statement_spans(statement, offset)
    shift_control_statement(statement, offset)
    statement
}

compose_statement_blocks :: fn (source : []u8, statement : *StatementNode, storage : *ExpressionArena) void {
    if statement.if_statement != (mimi_buffer_empty() as *IfNode) { compose_if_blocks(source, statement.if_statement, storage) }
    if statement.if_let != (mimi_buffer_empty() as *IfLetNode) {
        node := statement.if_let
        node.then_branch = compose_block_contents(source, node.then_branch, storage)
        node.else_branch = compose_block_contents(source, node.else_branch, storage)
    }
    if statement.loop_statement != (mimi_buffer_empty() as *LoopNode) {
        node := statement.loop_statement
        node.body = compose_block_contents(source, node.body, storage)
    }
    if statement.for_loop != (mimi_buffer_empty() as *ForNode) {
        node := statement.for_loop
        node.body = compose_block_contents(source, node.body, storage)
    }
    if statement.kind == 290 && !block_node_is_null(statement.body) {
        statement.body = compose_block_contents(source, statement.body, storage)
    }
}

compose_if_blocks :: fn (source : []u8, node : *IfNode, storage : *ExpressionArena) void {
    node.then_branch = compose_block_contents(source, node.then_branch, storage)
    node.else_branch = compose_block_contents(source, node.else_branch, storage)
    if node.else_if != (mimi_buffer_empty() as *IfNode) { compose_if_blocks(source, node.else_if, storage) }
}

compose_block_contents :: fn (source : []u8, block : *BlockNode, storage : *ExpressionArena) *BlockNode {
    if block_node_is_null(block) { return block }
    parse_statement_block(source[block.start:block.end], block.start, storage)
}

allocate_control_statement :: fn (storage : *ExpressionArena, kind : u64, start : u64, end : u64) *StatementNode {
    if mimi_arena_allocate(storage, 104, 8) == 0 { return mimi_buffer_empty() as *StatementNode }
    statement := storage.last as *StatementNode
    statement.kind = kind
    statement.start = start
    statement.end = end
    statement.value = mimi_buffer_empty() as *ExprNode
    statement.next = mimi_buffer_empty() as *StatementNode
    statement.body = mimi_buffer_empty() as *BlockNode
    statement.binding = mimi_buffer_empty() as *BindingNode
    statement.if_statement = mimi_buffer_empty() as *IfNode
    statement.if_let = mimi_buffer_empty() as *IfLetNode
    statement.loop_statement = mimi_buffer_empty() as *LoopNode
    statement.for_loop = mimi_buffer_empty() as *ForNode
    statement.match_statement = mimi_buffer_empty() as *MatchNode
    statement.tuple_binding = mimi_buffer_empty() as *TupleBindingNode
    statement
}

shift_control_statement :: fn (statement : *StatementNode, offset : u64) void {
    if statement.if_statement != (mimi_buffer_empty() as *IfNode) { shift_if_node(statement.if_statement, offset) }
    if statement.if_let != (mimi_buffer_empty() as *IfLetNode) {
        node := statement.if_let
        node.start = node.start + offset
        node.end = node.end + offset
        node.value.start = node.value.start + offset
        node.value.end = node.value.end + offset
        shift_expression_children(node.value, offset)
        shift_block_span(node.then_branch, offset)
        shift_block_span(node.else_branch, offset)
    }
    if statement.loop_statement != (mimi_buffer_empty() as *LoopNode) {
        node := statement.loop_statement
        node.start = node.start + offset
        node.end = node.end + offset
        if !expression_is_null(node.condition) {
            node.condition.start = node.condition.start + offset
            node.condition.end = node.condition.end + offset
            shift_expression_children(node.condition, offset)
        }
        shift_block_span(node.body, offset)
    }
    if statement.for_loop != (mimi_buffer_empty() as *ForNode) {
        node := statement.for_loop
        node.start = node.start + offset
        node.end = node.end + offset
        node.variable_start = node.variable_start + offset
        node.variable_end = node.variable_end + offset
        if !expression_is_null(node.iterable) { shift_expression_tree(node.iterable, offset) }
        if !expression_is_null(node.range_start) { shift_expression_tree(node.range_start, offset) }
        if !expression_is_null(node.range_end) { shift_expression_tree(node.range_end, offset) }
        shift_block_span(node.body, offset)
    }
    if statement.match_statement != (mimi_buffer_empty() as *MatchNode) {
        node := statement.match_statement
        node.start = node.start + offset
        node.end = node.end + offset
        shift_expression_tree(node.value, offset)
        arm := node.arms
        while arm != (mimi_buffer_empty() as *MatchArmNode) {
            arm.start = arm.start + offset
            arm.end = arm.end + offset
            arm.variant_start = arm.variant_start + offset
            arm.variant_end = arm.variant_end + offset
            if arm.binding_start != 0 || arm.binding_end != 0 {
                arm.binding_start = arm.binding_start + offset
                arm.binding_end = arm.binding_end + offset
            }
            shift_expression_tree(arm.value, offset)
            arm = arm.next
        }
    }
    if statement.tuple_binding != (mimi_buffer_empty() as *TupleBindingNode) {
        node := statement.tuple_binding
        node.start = node.start + offset
        node.end = node.end + offset
        name := node.names
        while name != (mimi_buffer_empty() as *DestructureNameNode) {
            name.start = name.start + offset
            name.end = name.end + offset
            name = name.next
        }
        shift_expression_tree(node.value, offset)
    }
}

shift_if_node :: fn (node : *IfNode, offset : u64) void {
    node.start = node.start + offset
    node.end = node.end + offset
    shift_expression_tree(node.condition, offset)
    shift_block_span(node.then_branch, offset)
    shift_block_span(node.else_branch, offset)
    if node.else_if != (mimi_buffer_empty() as *IfNode) { shift_if_node(node.else_if, offset) }
}

shift_block_span :: fn (block : *BlockNode, offset : u64) void {
    if block_node_is_null(block) { return }
    block.start = block.start + offset
    block.end = block.end + offset
    block.content_start = block.content_start + offset
    block.content_end = block.content_end + offset
    current := block.statements
    while !statement_node_is_null(current) {
        shift_statement_spans(current, offset)
        shift_control_statement(current, offset)
        current = current.next
    }
}

shift_expression_tree :: fn (expression : *ExprNode, offset : u64) void {
    if expression_is_null(expression) { return }
    expression.start = expression.start + offset
    expression.end = expression.end + offset
    shift_expression_children(expression, offset)
}

shift_statement_spans :: fn (statement : *StatementNode, offset : u64) void {
    statement.start = statement.start + offset
    statement.end = statement.end + offset
    if !expression_is_null(statement.value) {
        statement.value.start = statement.value.start + offset
        statement.value.end = statement.value.end + offset
        shift_expression_children(statement.value, offset)
    }
    if !block_node_is_null(statement.body) {
        shift_block_span(statement.body, offset)
    }
    if !binding_node_is_null(statement.binding) {
        statement.binding.start = statement.binding.start + offset
        statement.binding.end = statement.binding.end + offset
        statement.binding.name_start = statement.binding.name_start + offset
        statement.binding.name_end = statement.binding.name_end + offset
        if !expression_is_null(statement.binding.data_type) {
            statement.binding.data_type.start = statement.binding.data_type.start + offset
            statement.binding.data_type.end = statement.binding.data_type.end + offset
        }
        if !expression_is_null(statement.binding.initializer) {
            statement.binding.initializer.start = statement.binding.initializer.start + offset
            statement.binding.initializer.end = statement.binding.initializer.end + offset
        }
    }
}

shift_expression_children :: fn (expression : *ExprNode, offset : u64) void {
    if expression_is_null(expression) { return }
    if !expression_is_null(expression.left) {
        expression.left.start = expression.left.start + offset
        expression.left.end = expression.left.end + offset
        shift_expression_children(expression.left, offset)
    }
    if !expression_is_null(expression.right) {
        expression.right.start = expression.right.start + offset
        expression.right.end = expression.right.end + offset
        shift_expression_children(expression.right, offset)
    }
}

pub if_node_is_null :: fn (node : *IfNode) bool {
    node == (mimi_buffer_empty() as *IfNode)
}

pub parse_if_statement :: fn (source : []u8, storage : *ExpressionArena) *IfNode {
    parse_if_statement_at(source, 0, storage)
}

parse_if_statement_at :: fn (source : []u8, offset : u64, storage : *ExpressionArena) *IfNode {
    keyword := next_token(source, 0)
    if keyword.0 != 164 { return mimi_buffer_empty() as *IfNode }
    cursor := keyword.2
    paren_depth : u64 = 0
    condition_end := source.len
    block_start := source.len
    found_block := false
    while cursor < source.len && !found_block {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *IfNode }
        cursor = token.2
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 {
                if paren_depth == 0 { return mimi_buffer_empty() as *IfNode }
                paren_depth = paren_depth - 1
            } else {
                if token.0 == 123 && paren_depth == 0 {
                    condition_end = token.1
                    block_start = token.1
                    found_block = true
                }
            }
        }
    }
    if !found_block || condition_end <= keyword.2 { return mimi_buffer_empty() as *IfNode }
    condition := parse_expression(source[keyword.2:condition_end], storage)
    if expression_is_null(condition) { return mimi_buffer_empty() as *IfNode }
    condition.start = condition.start + keyword.2
    condition.end = condition.end + keyword.2
    then_branch := parse_block_span(source[block_start:source.len], offset + block_start, storage)
    if block_node_is_null(then_branch) { return mimi_buffer_empty() as *IfNode }
    end := then_branch.end - offset
    remainder := next_token(source, end)
    else_branch : *BlockNode = mimi_buffer_empty() as *BlockNode
    else_if : *IfNode = mimi_buffer_empty() as *IfNode
    if remainder.0 != 0 {
        if remainder.0 != 165 { return mimi_buffer_empty() as *IfNode }
        else_start := next_token(source, remainder.2)
        if else_start.0 == 123 {
            else_branch = parse_block_span(source[else_start.1:source.len], offset + else_start.1, storage)
            if block_node_is_null(else_branch) { return mimi_buffer_empty() as *IfNode }
            end = else_branch.end - offset
            if next_token(source, end).0 != 0 { return mimi_buffer_empty() as *IfNode }
        } else {
            if else_start.0 != 164 { return mimi_buffer_empty() as *IfNode }
            else_if = parse_if_statement_at(source[else_start.1:source.len], offset + else_start.1, storage)
            if if_node_is_null(else_if) { return mimi_buffer_empty() as *IfNode }
            end = else_if.end - offset
        }
    }
    if mimi_arena_allocate(storage, 40, 8) == 0 { return mimi_buffer_empty() as *IfNode }
    node := storage.last as *IfNode
    node.start = keyword.1 + offset
    node.end = end + offset
    node.condition = condition
    node.condition.start = node.condition.start + offset
    node.condition.end = node.condition.end + offset
    node.then_branch = then_branch
    node.else_branch = else_branch
    node.else_if = else_if
    node
}

pub parse_if_expression :: fn (source : []u8, storage : *ExpressionArena) *ExprNode {
    statement := parse_if_statement(source, storage)
    if if_node_is_null(statement) { return mimi_buffer_empty() as *ExprNode }
    parse_if_expression_node(statement, storage)
}

pub if_let_node_is_null :: fn (node : *IfLetNode) bool {
    node == (mimi_buffer_empty() as *IfLetNode)
}

pub parse_if_let_statement :: fn (source : []u8, storage : *ExpressionArena) *IfLetNode {
    keyword := next_token(source, 0)
    if keyword.0 != 164 { return mimi_buffer_empty() as *IfLetNode }
    variant := next_token(source, keyword.2)
    if variant.0 != 1 { return mimi_buffer_empty() as *IfLetNode }
    cursor := variant.2
    binding_start : u64 = 0
    binding_end : u64 = 0
    next := next_token(source, cursor)
    if next.0 == 40 {
        binding := next_token(source, next.2)
        close := next_token(source, binding.2)
        if binding.0 != 1 || close.0 != 41 { return mimi_buffer_empty() as *IfLetNode }
        binding_start = binding.1
        binding_end = binding.2
        cursor = close.2
    }
    colon := next_token(source, cursor)
    equal := next_token(source, colon.2)
    if colon.0 != 58 || equal.0 != 61 { return mimi_buffer_empty() as *IfLetNode }
    cursor = equal.2
    paren_depth : u64 = 0
    bracket_depth : u64 = 0
    block_start := source.len
    found_block := false
    while cursor < source.len && !found_block {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *IfLetNode }
        cursor = token.2
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 {
                if paren_depth == 0 { return mimi_buffer_empty() as *IfLetNode }
                paren_depth = paren_depth - 1
            } else {
                if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                    if token.0 == 93 {
                        if bracket_depth == 0 { return mimi_buffer_empty() as *IfLetNode }
                        bracket_depth = bracket_depth - 1
                    } else {
                        if token.0 == 123 && paren_depth == 0 && bracket_depth == 0 {
                            block_start = token.1
                            found_block = true
                        }
                    }
                }
            }
        }
    }
    if !found_block || block_start <= equal.2 { return mimi_buffer_empty() as *IfLetNode }
    value := parse_expression(source[equal.2:block_start], storage)
    if expression_is_null(value) { return mimi_buffer_empty() as *IfLetNode }
    value.start = value.start + equal.2
    value.end = value.end + equal.2
    then_branch := parse_block_span(source[block_start:source.len], block_start, storage)
    if block_node_is_null(then_branch) { return mimi_buffer_empty() as *IfLetNode }
    end := then_branch.end
    else_branch : *BlockNode = mimi_buffer_empty() as *BlockNode
    remainder := next_token(source, end)
    if remainder.0 != 0 {
        if remainder.0 != 165 { return mimi_buffer_empty() as *IfLetNode }
        opening := next_token(source, remainder.2)
        if opening.0 != 123 { return mimi_buffer_empty() as *IfLetNode }
        else_branch = parse_block_span(source[opening.1:source.len], opening.1, storage)
        if block_node_is_null(else_branch) || next_token(source, else_branch.end).0 != 0 { return mimi_buffer_empty() as *IfLetNode }
        end = else_branch.end
    }
    if mimi_arena_allocate(storage, 56, 8) == 0 { return mimi_buffer_empty() as *IfLetNode }
    node := storage.last as *IfLetNode
    node.start = keyword.1
    node.end = end
    node.variant_start = variant.1
    node.variant_end = variant.2
    node.binding_start = binding_start
    node.binding_end = binding_end
    node.value = value
    node.then_branch = then_branch
    node.else_branch = else_branch
    node
}

parse_if_expression_node :: fn (statement : *IfNode, storage : *ExpressionArena) *ExprNode {
    if if_node_is_null(statement) || (block_node_is_null(statement.else_branch) && if_node_is_null(statement.else_if)) { return mimi_buffer_empty() as *ExprNode }
    then_node := allocate_expr(storage, 289, statement.then_branch.start, statement.then_branch.end, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
    if expression_is_null(then_node) { return then_node }
    else_node : *ExprNode = mimi_buffer_empty() as *ExprNode
    if if_node_is_null(statement.else_if) {
        else_node = allocate_expr(storage, 289, statement.else_branch.start, statement.else_branch.end, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
    } else {
        else_node = parse_if_expression_node(statement.else_if, storage)
    }
    if expression_is_null(else_node) { return else_node }
    branches := allocate_expr(storage, 276, then_node.start, else_node.end, then_node, else_node)
    if expression_is_null(branches) { return branches }
    allocate_expr(storage, 288, statement.start, statement.end, statement.condition, branches)
}

pub loop_node_is_null :: fn (node : *LoopNode) bool {
    node == (mimi_buffer_empty() as *LoopNode)
}

pub parse_loop_statement :: fn (source : []u8, storage : *ExpressionArena) *LoopNode {
    keyword := next_token(source, 0)
    kind : u64 = 0
    condition : *ExprNode = mimi_buffer_empty() as *ExprNode
    block_start := source.len
    if keyword.0 == 171 {
        kind = 285
        opening := next_token(source, keyword.2)
        if opening.0 != 123 { return mimi_buffer_empty() as *LoopNode }
        block_start = opening.1
    } else {
        if keyword.0 == 169 { kind = 286 } else {
            if keyword.0 == 168 { kind = 287 } else { return mimi_buffer_empty() as *LoopNode }
        }
        cursor := keyword.2
        paren_depth : u64 = 0
        found_block := false
        condition_end := source.len
        while cursor < source.len && !found_block {
            token := next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *LoopNode }
            cursor = token.2
            if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                if token.0 == 41 {
                    if paren_depth == 0 { return mimi_buffer_empty() as *LoopNode }
                    paren_depth = paren_depth - 1
                } else {
                    if token.0 == 123 && paren_depth == 0 {
                        condition_end = token.1
                        block_start = token.1
                        found_block = true
                    }
                }
            }
        }
        if !found_block || condition_end <= keyword.2 { return mimi_buffer_empty() as *LoopNode }
        condition = parse_expression(source[keyword.2:condition_end], storage)
        if expression_is_null(condition) { return mimi_buffer_empty() as *LoopNode }
        condition.start = condition.start + keyword.2
        condition.end = condition.end + keyword.2
    }
    body := parse_block_span(source[block_start:source.len], block_start, storage)
    if block_node_is_null(body) { return mimi_buffer_empty() as *LoopNode }
    if kind == 287 {
        while_token := next_token(source, body.end)
        if while_token.0 != 169 { return mimi_buffer_empty() as *LoopNode }
        condition_start := while_token.2
        condition = parse_expression(source[condition_start:source.len], storage)
        if expression_is_null(condition) { return mimi_buffer_empty() as *LoopNode }
        condition.start = condition.start + condition_start
        condition.end = condition.end + condition_start
    } else {
        if next_token(source, body.end).0 != 0 { return mimi_buffer_empty() as *LoopNode }
    }
    if mimi_arena_allocate(storage, 40, 8) == 0 { return mimi_buffer_empty() as *LoopNode }
    node := storage.last as *LoopNode
    node.kind = kind
    node.start = keyword.1
    node.end = source.len
    node.condition = condition
    node.body = body
    node
}

pub for_node_is_null :: fn (node : *ForNode) bool {
    node == (mimi_buffer_empty() as *ForNode)
}

pub parse_for_statement :: fn (source : []u8, storage : *ExpressionArena) *ForNode {
    keyword := next_token(source, 0)
    if keyword.0 != 170 { return mimi_buffer_empty() as *ForNode }
    variable := next_token(source, keyword.2)
    in_token := next_token(source, variable.2)
    if variable.0 != 1 || in_token.0 != 173 { return mimi_buffer_empty() as *ForNode }
    cursor := in_token.2
    paren_depth : u64 = 0
    bracket_depth : u64 = 0
    header_end := source.len
    block_start := source.len
    found_block := false
    while cursor < source.len && !found_block {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *ForNode }
        cursor = token.2
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 {
                if paren_depth == 0 { return mimi_buffer_empty() as *ForNode }
                paren_depth = paren_depth - 1
            } else {
                if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                    if token.0 == 93 {
                        if bracket_depth == 0 { return mimi_buffer_empty() as *ForNode }
                        bracket_depth = bracket_depth - 1
                    } else {
                        if token.0 == 123 && paren_depth == 0 && bracket_depth == 0 {
                            header_end = token.1
                            block_start = token.1
                            found_block = true
                        }
                    }
                }
            }
        }
    }
    if !found_block || header_end <= in_token.2 { return mimi_buffer_empty() as *ForNode }
    iterable : *ExprNode = mimi_buffer_empty() as *ExprNode
    range_start : *ExprNode = mimi_buffer_empty() as *ExprNode
    range_end : *ExprNode = mimi_buffer_empty() as *ExprNode
    is_range := false
    range_cursor := in_token.2
    while range_cursor < header_end && !is_range {
        token := next_token(source, range_cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *ForNode }
        if token.0 == 135 { is_range = true } else { range_cursor = token.2 }
    }
    if is_range {
        range_start := parse_expression(source[in_token.2:range_cursor], storage)
        range_end := parse_expression(source[range_cursor + 2:header_end], storage)
        if expression_is_null(range_start) || expression_is_null(range_end) { return mimi_buffer_empty() as *ForNode }
        range_start.end = range_start.end + in_token.2
        range_start.start = range_start.start + in_token.2
        range_end.start = range_end.start + range_cursor + 2
        range_end.end = range_end.end + range_cursor + 2
    } else {
        iterable = parse_expression(source[in_token.2:header_end], storage)
        if expression_is_null(iterable) { return mimi_buffer_empty() as *ForNode }
        iterable.start = iterable.start + in_token.2
        iterable.end = iterable.end + in_token.2
    }
    body := parse_block_span(source[block_start:source.len], block_start, storage)
    if block_node_is_null(body) || next_token(source, body.end).0 != 0 { return mimi_buffer_empty() as *ForNode }
    if mimi_arena_allocate(storage, 72, 8) == 0 { return mimi_buffer_empty() as *ForNode }
    node := storage.last as *ForNode
    node.start = keyword.1
    node.end = body.end
    node.variable_start = variable.1
    node.variable_end = variable.2
    node.is_range = is_range
    node.iterable = iterable
    node.range_start = range_start
    node.range_end = range_end
    node.body = body
    node
}

pub match_node_is_null :: fn (node : *MatchNode) bool {
    node == (mimi_buffer_empty() as *MatchNode)
}

pub parse_match_expression :: fn (source : []u8, storage : *ExpressionArena) *MatchNode {
    keyword := next_token(source, 0)
    if keyword.0 != 162 { return mimi_buffer_empty() as *MatchNode }
    cursor := keyword.2
    paren_depth : u64 = 0
    bracket_depth : u64 = 0
    opening_start := source.len
    opening_end := source.len
    found_open := false
    while cursor < source.len && !found_open {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *MatchNode }
        cursor = token.2
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 {
                if paren_depth == 0 { return mimi_buffer_empty() as *MatchNode }
                paren_depth = paren_depth - 1
            } else {
                if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                    if token.0 == 93 {
                        if bracket_depth == 0 { return mimi_buffer_empty() as *MatchNode }
                        bracket_depth = bracket_depth - 1
                    } else {
                        if token.0 == 123 && paren_depth == 0 && bracket_depth == 0 {
                            opening_start = token.1
                            opening_end = token.2
                            found_open = true
                        }
                    }
                }
            }
        }
    }
    if !found_open || opening_start <= keyword.2 { return mimi_buffer_empty() as *MatchNode }
    match_value := parse_expression(source[keyword.2:opening_start], storage)
    if expression_is_null(match_value) { return mimi_buffer_empty() as *MatchNode }
    match_value.start = match_value.start + keyword.2
    match_value.end = match_value.end + keyword.2
    cursor = opening_end
    arm_count : u64 = 0
    first : *MatchArmNode = mimi_buffer_empty() as *MatchArmNode
    last : *MatchArmNode = mimi_buffer_empty() as *MatchArmNode
    close_end := source.len
    while cursor < source.len {
        if next_token(source, cursor).0 == 125 {
            close := next_token(source, cursor)
            if arm_count == 0 || next_token(source, close.2).0 != 0 { return mimi_buffer_empty() as *MatchNode }
            close_end = close.2
            break
        }
        arm_start := cursor
        segment_end := source.len
        local_paren : u64 = 0
        local_bracket : u64 = 0
        local_brace : u64 = 0
        found_separator := false
        while cursor < source.len && !found_separator {
            token := next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *MatchNode }
            cursor = token.2
            if token.0 == 40 { local_paren = local_paren + 1 } else {
                if token.0 == 41 {
                    if local_paren == 0 { return mimi_buffer_empty() as *MatchNode }
                    local_paren = local_paren - 1
                } else {
                    if token.0 == 91 { local_bracket = local_bracket + 1 } else {
                        if token.0 == 93 {
                            if local_bracket == 0 { return mimi_buffer_empty() as *MatchNode }
                            local_bracket = local_bracket - 1
                        } else {
                            if token.0 == 123 { local_brace = local_brace + 1 } else {
                                if token.0 == 125 {
                                    if local_brace > 0 { local_brace = local_brace - 1 } else {
                                        if local_paren == 0 && local_bracket == 0 {
                                            segment_end = token.1
                                            close_end = token.2
                                            found_separator = true
                                        }
                                    }
                                } else {
                                    if token.0 == 44 && local_paren == 0 && local_bracket == 0 && local_brace == 0 {
                                        segment_end = token.1
                                        found_separator = true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if !found_separator || local_paren != 0 || local_bracket != 0 || local_brace != 0 { return mimi_buffer_empty() as *MatchNode }
        arrow_start := segment_end
        scan := arm_start
        while scan < segment_end && arrow_start == segment_end {
            token := next_token(source, scan)
            if token.0 == 134 {
                arrow_start = token.1
                scan = token.2
            } else { scan = token.2 }
        }
        if arrow_start == segment_end { return mimi_buffer_empty() as *MatchNode }
        pattern := source[arm_start:arrow_start]
        variant := next_token(pattern, 0)
        if variant.0 != 1 { return mimi_buffer_empty() as *MatchNode }
        existing_arm := first
        while existing_arm != (mimi_buffer_empty() as *MatchArmNode) {
            if source_names_equal(source, existing_arm.variant_start, existing_arm.variant_end, variant.1 + arm_start, variant.2 + arm_start) { return mimi_buffer_empty() as *MatchNode }
            existing_arm = existing_arm.next
        }
        after_variant := next_token(pattern, variant.2)
        binding_start : u64 = 0
        binding_end : u64 = 0
        if after_variant.0 == 40 {
            binding := next_token(pattern, after_variant.2)
            binding_close := next_token(pattern, binding.2)
            if binding.0 != 1 || binding_close.0 != 41 || next_token(pattern, binding_close.2).0 != 0 { return mimi_buffer_empty() as *MatchNode }
            binding_start = binding.1 + arm_start
            binding_end = binding.2 + arm_start
        } else {
            if after_variant.0 != 0 { return mimi_buffer_empty() as *MatchNode }
        }
        value_start := scan
        arm_value := parse_expression(source[value_start:segment_end], storage)
        if expression_is_null(arm_value) { return mimi_buffer_empty() as *MatchNode }
        arm_value.start = arm_value.start + value_start
        arm_value.end = arm_value.end + value_start
        if mimi_arena_allocate(storage, 56, 8) == 0 { return mimi_buffer_empty() as *MatchNode }
        arm := storage.last as *MatchArmNode
        arm.start = arm_start
        arm.end = segment_end
        arm.variant_start = variant.1 + arm_start
        arm.variant_end = variant.2 + arm_start
        arm.binding_start = binding_start
        arm.binding_end = binding_end
        arm.value = arm_value
        arm.next = mimi_buffer_empty() as *MatchArmNode
        if last == (mimi_buffer_empty() as *MatchArmNode) { first = arm } else { last.next = arm }
        last = arm
        arm_count = arm_count + 1
        separator := next_token(source, segment_end)
        if separator.0 == 125 {
            close_end = separator.2
            break
        }
        if separator.0 != 44 { return mimi_buffer_empty() as *MatchNode }
        cursor = separator.2
    }
    if close_end == source.len || next_token(source, close_end).0 != 0 { return mimi_buffer_empty() as *MatchNode }
    if mimi_arena_allocate(storage, 40, 8) == 0 { return mimi_buffer_empty() as *MatchNode }
    node := storage.last as *MatchNode
    node.start = keyword.1
    node.end = close_end
    node.value = match_value
    node.arm_count = arm_count
    node.arms = first
    node
}

pub generic_parameter_list_is_null :: fn (parameters : *GenericParameterList) bool {
    parameters == (mimi_buffer_empty() as *GenericParameterList)
}

pub parse_generic_parameters :: fn (source : []u8, storage : *ExpressionArena) *GenericParameterList {
    opening := next_token(source, 0)
    if opening.0 != 60 { return mimi_buffer_empty() as *GenericParameterList }
    cursor := opening.2
    first : *GenericParameterNode = mimi_buffer_empty() as *GenericParameterNode
    last : *GenericParameterNode = mimi_buffer_empty() as *GenericParameterNode
    count : u64 = 0
    while true {
        name := next_token(source, cursor)
        if name.0 != 1 { return mimi_buffer_empty() as *GenericParameterList }
        current := first
        while current != (mimi_buffer_empty() as *GenericParameterNode) {
            if current.end - current.start == name.2 - name.1 {
                duplicate := true
                index : u64 = 0
                while index < name.2 - name.1 && duplicate {
                    if source[current.start + index] != source[name.1 + index] { duplicate = false }
                    index = index + 1
                }
                if duplicate { return mimi_buffer_empty() as *GenericParameterList }
            }
            current = current.next
        }
        if mimi_arena_allocate(storage, 24, 8) == 0 { return mimi_buffer_empty() as *GenericParameterList }
        item := storage.last as *GenericParameterNode
        item.start = name.1
        item.end = name.2
        item.next = mimi_buffer_empty() as *GenericParameterNode
        if last == (mimi_buffer_empty() as *GenericParameterNode) { first = item } else { last.next = item }
        last = item
        count = count + 1
        separator := next_token(source, name.2)
        if separator.0 == 62 {
            if next_token(source, separator.2).0 != 0 { return mimi_buffer_empty() as *GenericParameterList }
            if mimi_arena_allocate(storage, 32, 8) == 0 { return mimi_buffer_empty() as *GenericParameterList }
            result := storage.last as *GenericParameterList
            result.start = opening.1
            result.end = separator.2
            result.count = count
            result.first = first
            return result
        }
        if separator.0 != 44 { return mimi_buffer_empty() as *GenericParameterList }
        cursor = separator.2
    }
    mimi_buffer_empty() as *GenericParameterList
}

pub enum_node_is_null :: fn (node : *EnumNode) bool {
    node == (mimi_buffer_empty() as *EnumNode)
}

source_names_equal :: fn (source : []u8, left_start : u64, left_end : u64, right_start : u64, right_end : u64) bool {
    if left_end - left_start != right_end - right_start { return false }
    index : u64 = 0
    while index < left_end - left_start {
        if source[left_start + index] != source[right_start + index] { return false }
        index = index + 1
    }
    true
}

pub parse_enum_declaration :: fn (source : []u8, storage : *ExpressionArena) *EnumNode {
    keyword := next_token(source, 0)
    if keyword.0 != 162 { return mimi_buffer_empty() as *EnumNode }
    cursor := keyword.2
    parameters : *GenericParameterList = mimi_buffer_empty() as *GenericParameterList
    next := next_token(source, cursor)
    if next.0 == 60 {
        close_cursor := next.2
        found_close := false
        while close_cursor < source.len && !found_close {
            token := next_token(source, close_cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *EnumNode }
            close_cursor = token.2
            if token.0 == 62 { found_close = true }
        }
        if !found_close { return mimi_buffer_empty() as *EnumNode }
        parameters = parse_generic_parameters(source[next.1:close_cursor], storage)
        if generic_parameter_list_is_null(parameters) { return mimi_buffer_empty() as *EnumNode }
        parameters.start = parameters.start + next.1
        parameters.end = parameters.end + next.1
        cursor = close_cursor
    }
    opening := next_token(source, cursor)
    if opening.0 != 123 { return mimi_buffer_empty() as *EnumNode }
    cursor = opening.2
    first : *EnumVariantNode = mimi_buffer_empty() as *EnumVariantNode
    last : *EnumVariantNode = mimi_buffer_empty() as *EnumVariantNode
    count : u64 = 0
    close_end := source.len
    while cursor < source.len {
        if next_token(source, cursor).0 == 125 {
            close := next_token(source, cursor)
            close_end = close.2
            break
        }
        segment_start := cursor
        segment_end := source.len
        paren_depth : u64 = 0
        bracket_depth : u64 = 0
        found_separator := false
        while cursor < source.len && !found_separator {
            token := next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *EnumNode }
            cursor = token.2
            if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                if token.0 == 41 {
                    if paren_depth == 0 { return mimi_buffer_empty() as *EnumNode }
                    paren_depth = paren_depth - 1
                } else {
                    if token.0 == 123 { bracket_depth = bracket_depth + 1 } else {
                        if token.0 == 125 {
                            if bracket_depth > 0 { bracket_depth = bracket_depth - 1 } else {
                                if paren_depth == 0 {
                                    segment_end = token.1
                                    close_end = token.2
                                    found_separator = true
                                }
                            }
                        } else {
                            if token.0 == 44 && paren_depth == 0 && bracket_depth == 0 {
                                segment_end = token.1
                                found_separator = true
                            }
                        }
                    }
                }
            }
        }
        if !found_separator || paren_depth != 0 || bracket_depth != 0 { return mimi_buffer_empty() as *EnumNode }
        variant_source := source[segment_start:segment_end]
        name := next_token(variant_source, 0)
        if name.0 != 1 { return mimi_buffer_empty() as *EnumNode }
        existing := first
        while existing != (mimi_buffer_empty() as *EnumVariantNode) {
            if source_names_equal(source, existing.name_start, existing.name_end, name.1 + segment_start, name.2 + segment_start) { return mimi_buffer_empty() as *EnumNode }
            existing = existing.next
        }
        payload : *ExprNode = mimi_buffer_empty() as *ExprNode
        after_name := next_token(variant_source, name.2)
        if after_name.0 == 40 {
            payload_start := after_name.2
            payload_end := variant_source.len
            close := next_token(variant_source, payload_start)
            depth : u64 = 0
            scan := payload_start
            found_payload_close := false
            while scan < variant_source.len && !found_payload_close {
                close = next_token(variant_source, scan)
                if close.0 == 40 { depth = depth + 1 } else {
                    if close.0 == 41 {
                        if depth == 0 {
                            payload_end = close.1
                            found_payload_close = true
                        } else { depth = depth - 1 }
                    }
                }
                scan = close.2
            }
            if !found_payload_close || next_token(variant_source, close.2).0 != 0 { return mimi_buffer_empty() as *EnumNode }
            payload = parse_type(variant_source[payload_start:payload_end], storage)
            if expression_is_null(payload) { return mimi_buffer_empty() as *EnumNode }
            payload.start = payload.start + segment_start + payload_start
            payload.end = payload.end + segment_start + payload_start
        } else {
            if after_name.0 != 0 { return mimi_buffer_empty() as *EnumNode }
        }
        if mimi_arena_allocate(storage, 48, 8) == 0 { return mimi_buffer_empty() as *EnumNode }
        variant := storage.last as *EnumVariantNode
        variant.start = segment_start
        variant.end = segment_end
        variant.name_start = name.1 + segment_start
        variant.name_end = name.2 + segment_start
        variant.payload_type = payload
        variant.next = mimi_buffer_empty() as *EnumVariantNode
        if last == (mimi_buffer_empty() as *EnumVariantNode) { first = variant } else { last.next = variant }
        last = variant
        count = count + 1
        separator := next_token(source, segment_end)
        if separator.0 == 125 {
            close_end = separator.2
            break
        }
        if separator.0 != 44 { return mimi_buffer_empty() as *EnumNode }
        cursor = separator.2
    }
    if close_end == source.len || next_token(source, close_end).0 != 0 { return mimi_buffer_empty() as *EnumNode }
    if mimi_arena_allocate(storage, 40, 8) == 0 { return mimi_buffer_empty() as *EnumNode }
    node := storage.last as *EnumNode
    node.start = keyword.1
    node.end = close_end
    node.parameters = parameters
    node.variant_count = count
    node.variants = first
    node
}

pub struct_node_is_null :: fn (node : *StructNode) bool {
    node == (mimi_buffer_empty() as *StructNode)
}

pub parse_struct_declaration :: fn (source : []u8, storage : *ExpressionArena) *StructNode {
    keyword := next_token(source, 0)
    if keyword.0 != 163 { return mimi_buffer_empty() as *StructNode }
    cursor := keyword.2
    parameters : *GenericParameterList = mimi_buffer_empty() as *GenericParameterList
    next := next_token(source, cursor)
    if next.0 == 60 {
        close_cursor := next.2
        found_close := false
        while close_cursor < source.len && !found_close {
            token := next_token(source, close_cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *StructNode }
            close_cursor = token.2
            if token.0 == 62 { found_close = true }
        }
        if !found_close { return mimi_buffer_empty() as *StructNode }
        parameters = parse_generic_parameters(source[next.1:close_cursor], storage)
        if generic_parameter_list_is_null(parameters) { return mimi_buffer_empty() as *StructNode }
        parameters.start = parameters.start + next.1
        parameters.end = parameters.end + next.1
        cursor = close_cursor
    }
    opening := next_token(source, cursor)
    if opening.0 != 123 { return mimi_buffer_empty() as *StructNode }
    cursor = opening.2
    first : *StructFieldNode = mimi_buffer_empty() as *StructFieldNode
    last : *StructFieldNode = mimi_buffer_empty() as *StructFieldNode
    first_method : *StructMethodNode = mimi_buffer_empty() as *StructMethodNode
    last_method : *StructMethodNode = mimi_buffer_empty() as *StructMethodNode
    count : u64 = 0
    method_count : u64 = 0
    close_end := source.len
    while cursor < source.len {
        if next_token(source, cursor).0 == 125 {
            close := next_token(source, cursor)
            close_end = close.2
            break
        }
        if struct_method_starts(source, cursor) {
            method := parse_struct_method(source, cursor, storage)
            if method == (mimi_buffer_empty() as *StructMethodNode) { return mimi_buffer_empty() as *StructNode }
            previous_method := first_method
            while previous_method != (mimi_buffer_empty() as *StructMethodNode) {
                if source_names_equal(source, previous_method.name_start, previous_method.name_end, method.name_start, method.name_end) { return mimi_buffer_empty() as *StructNode }
                previous_method = previous_method.next
            }
            if last_method == (mimi_buffer_empty() as *StructMethodNode) { first_method = method } else { last_method.next = method }
            last_method = method
            method_count = method_count + 1
            cursor = method.end
            separator := next_token(source, cursor)
            if separator.0 == 44 { cursor = separator.2 } else {
                if separator.0 != 125 { return mimi_buffer_empty() as *StructNode }
            }
        } else {
        segment_start := cursor
        segment_end := source.len
        paren_depth : u64 = 0
        bracket_depth : u64 = 0
        angle_depth : u64 = 0
        found_separator := false
        while cursor < source.len && !found_separator {
            token := next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *StructNode }
            cursor = token.2
            if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                if token.0 == 41 {
                    if paren_depth == 0 { return mimi_buffer_empty() as *StructNode }
                    paren_depth = paren_depth - 1
                } else {
                    if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                        if token.0 == 93 {
                            if bracket_depth == 0 { return mimi_buffer_empty() as *StructNode }
                            bracket_depth = bracket_depth - 1
                        } else {
                            if token.0 == 60 { angle_depth = angle_depth + 1 } else {
                                if token.0 == 62 && angle_depth > 0 { angle_depth = angle_depth - 1 } else {
                                    if token.0 == 123 { return mimi_buffer_empty() as *StructNode } else {
                                        if token.0 == 125 && paren_depth == 0 && bracket_depth == 0 && angle_depth == 0 {
                                            segment_end = token.1
                                            close_end = token.2
                                            found_separator = true
                                        } else {
                                            if token.0 == 44 && paren_depth == 0 && bracket_depth == 0 && angle_depth == 0 {
                                                segment_end = token.1
                                                found_separator = true
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if !found_separator || paren_depth != 0 || bracket_depth != 0 || angle_depth != 0 { return mimi_buffer_empty() as *StructNode }
        field_source := source[segment_start:segment_end]
        name := next_token(field_source, 0)
        colon := next_token(field_source, name.2)
        if name.0 != 1 || colon.0 != 58 { return mimi_buffer_empty() as *StructNode }
        existing := first
        while existing != (mimi_buffer_empty() as *StructFieldNode) {
            if source_names_equal(source, existing.name_start, existing.name_end, name.1 + segment_start, name.2 + segment_start) { return mimi_buffer_empty() as *StructNode }
            existing = existing.next
        }
        scan := colon.2
        local_paren : u64 = 0
        local_bracket : u64 = 0
        local_angle : u64 = 0
        marker_kind : u8 = 0
        marker_start : u64 = 0
        marker_end : u64 = 0
        while scan < field_source.len && marker_kind == 0 {
            token := next_token(field_source, scan)
            if token.0 == 40 { local_paren = local_paren + 1 } else {
                if token.0 == 41 && local_paren > 0 { local_paren = local_paren - 1 } else {
                    if token.0 == 91 { local_bracket = local_bracket + 1 } else {
                        if token.0 == 93 && local_bracket > 0 { local_bracket = local_bracket - 1 } else {
                            if token.0 == 60 { local_angle = local_angle + 1 } else {
                                if token.0 == 62 && local_angle > 0 { local_angle = local_angle - 1 } else {
                                    if local_paren == 0 && local_bracket == 0 && local_angle == 0 && (token.0 == 58 || token.0 == 61) {
                                        marker_kind = token.0
                                        marker_start = token.1
                                        marker_end = token.2
                                    }
                                }
                            }
                        }
                    }
                }
            }
            scan = token.2
        }
        type_end := field_source.len
        mutable := true
        default_value : *ExprNode = mimi_buffer_empty() as *ExprNode
        if marker_kind != 0 {
            type_end = marker_start
            default_value = parse_expression(field_source[marker_end:field_source.len], storage)
            if expression_is_null(default_value) { return mimi_buffer_empty() as *StructNode }
            default_value.start = default_value.start + marker_end + segment_start
            default_value.end = default_value.end + marker_end + segment_start
            mutable = marker_kind == 61
        }
        data_type := parse_type(field_source[colon.2:type_end], storage)
        if expression_is_null(data_type) { return mimi_buffer_empty() as *StructNode }
        data_type.start = data_type.start + colon.2 + segment_start
        data_type.end = data_type.end + colon.2 + segment_start
        if mimi_arena_allocate(storage, 64, 8) == 0 { return mimi_buffer_empty() as *StructNode }
        field := storage.last as *StructFieldNode
        field.start = name.1 + segment_start
        field.end = segment_end
        field.name_start = name.1 + segment_start
        field.name_end = name.2 + segment_start
        field.mutable = mutable
        field.data_type = data_type
        field.default_value = default_value
        field.next = mimi_buffer_empty() as *StructFieldNode
        if last == (mimi_buffer_empty() as *StructFieldNode) { first = field } else { last.next = field }
        last = field
        count = count + 1
        separator := next_token(source, segment_end)
        if separator.0 == 125 {
            close_end = separator.2
            break
        }
        if separator.0 != 44 { return mimi_buffer_empty() as *StructNode }
        cursor = separator.2
        }
    }
    if close_end == source.len || next_token(source, close_end).0 != 0 { return mimi_buffer_empty() as *StructNode }
    if mimi_arena_allocate(storage, 40, 8) == 0 { return mimi_buffer_empty() as *StructNode }
    node := storage.last as *StructNode
    node.start = keyword.1
    node.end = close_end
    node.parameters = parameters
    node.field_count = count
    node.fields = first
    node.method_count = method_count
    node.methods = first_method
    node
}

struct_method_starts :: fn (source : []u8, start : u64) bool {
    name := next_token(source, start)
    open := next_token(source, name.2)
    close := next_token(source, open.2)
    colon1 := next_token(source, close.2)
    colon2 := next_token(source, colon1.2)
    function := next_token(source, colon2.2)
    name.0 == 1 && open.0 == 40 && close.0 == 41 && colon1.0 == 58 && colon2.0 == 58 && function.0 == 160
}

parse_struct_method :: fn (source : []u8, start : u64, storage : *ExpressionArena) *StructMethodNode {
    name := next_token(source, start)
    open_empty := next_token(source, name.2)
    close_empty := next_token(source, open_empty.2)
    colon1 := next_token(source, close_empty.2)
    colon2 := next_token(source, colon1.2)
    function_keyword := next_token(source, colon2.2)
    parameters_open := next_token(source, function_keyword.2)
    if !struct_method_starts(source, start) || parameters_open.0 != 40 { return mimi_buffer_empty() as *StructMethodNode }
    cursor := parameters_open.2
    depth : u64 = 1
    parameters_end := source.len
    parameters_close := source.len
    while cursor < source.len && depth > 0 {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *StructMethodNode }
        cursor = token.2
        if token.0 == 40 { depth = depth + 1 } else {
            if token.0 == 41 {
                depth = depth - 1
                if depth == 0 {
                    parameters_end = token.1
                    parameters_close = token.2
                }
            }
        }
    }
    if depth != 0 { return mimi_buffer_empty() as *StructMethodNode }
    body_open := next_token(source, parameters_close)
    return_end := source.len
    scan := parameters_close
    while scan < source.len && body_open.0 != 123 {
        token := next_token(source, scan)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *StructMethodNode }
        if token.0 == 123 {
            body_open = token
            return_end = token.1
        } else { scan = token.2 }
    }
    if body_open.0 != 123 { return mimi_buffer_empty() as *StructMethodNode }
    return_type := parse_type(source[parameters_close:return_end], storage)
    if expression_is_null(return_type) { return mimi_buffer_empty() as *StructMethodNode }
    return_type.start = return_type.start + parameters_close
    return_type.end = return_type.end + parameters_close
    body := parse_statement_block(source[body_open.1:source.len], body_open.1, storage)
    if block_node_is_null(body) { return mimi_buffer_empty() as *StructMethodNode }
    header := FunctionHeader { start = start, end = body_open.2, name_start = name.1, name_end = name.2, parameters_start = parameters_open.2, parameters_end = parameters_end, return_type_start = parameters_close, return_type_end = return_end, body_start = body_open.2 }
    parameters := parse_parameters(source, &header, storage)
    if parameters_end != parameters_open.2 && parameter_list_is_null(parameters) { return mimi_buffer_empty() as *StructMethodNode }
    if mimi_arena_allocate(storage, 56, 8) == 0 { return mimi_buffer_empty() as *StructMethodNode }
    function_node := storage.last as *FunctionNode
    function_node.start = start
    function_node.end = body.end
    function_node.name_start = name.1
    function_node.name_end = name.2
    function_node.parameters = parameters
    function_node.return_type = return_type
    function_node.body = body
    if mimi_arena_allocate(storage, 48, 8) == 0 { return mimi_buffer_empty() as *StructMethodNode }
    method := storage.last as *StructMethodNode
    method.start = start
    method.end = body.end
    method.name_start = name.1
    method.name_end = name.2
    method.function = function_node
    method.next = mimi_buffer_empty() as *StructMethodNode
    method
}

pub struct_literal_is_null :: fn (literal : *StructLiteralNode) bool {
    literal == (mimi_buffer_empty() as *StructLiteralNode)
}

pub parse_struct_literal :: fn (source : []u8, storage : *ExpressionArena) *StructLiteralNode {
    type_name := next_token(source, 0)
    if type_name.0 != 1 { return mimi_buffer_empty() as *StructLiteralNode }
    cursor := type_name.2
    type_end := type_name.2
    suffix := next_token(source, cursor)
    if suffix.0 == 60 {
        cursor = suffix.2
        angle_depth : u64 = 1
        found_generic_end := false
        while cursor < source.len && !found_generic_end {
            token := next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *StructLiteralNode }
            cursor = token.2
            if token.0 == 60 { angle_depth = angle_depth + 1 } else {
                if token.0 == 62 {
                    angle_depth = angle_depth - 1
                    if angle_depth == 0 {
                        type_end = token.2
                        found_generic_end = true
                    }
                }
            }
        }
        if !found_generic_end { return mimi_buffer_empty() as *StructLiteralNode }
    } else { type_end = type_name.2 }
    opening := next_token(source, cursor)
    if opening.0 != 123 { return mimi_buffer_empty() as *StructLiteralNode }
    cursor = opening.2
    first : *StructLiteralFieldNode = mimi_buffer_empty() as *StructLiteralFieldNode
    last : *StructLiteralFieldNode = mimi_buffer_empty() as *StructLiteralFieldNode
    count : u64 = 0
    close_end := source.len
    while cursor < source.len {
        if next_token(source, cursor).0 == 125 {
            close := next_token(source, cursor)
            close_end = close.2
            break
        }
        segment_start := cursor
        segment_end := source.len
        paren_depth : u64 = 0
        bracket_depth : u64 = 0
        brace_depth : u64 = 0
        found_separator := false
        while cursor < source.len && !found_separator {
            token := next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *StructLiteralNode }
            cursor = token.2
            if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                if token.0 == 41 {
                    if paren_depth == 0 { return mimi_buffer_empty() as *StructLiteralNode }
                    paren_depth = paren_depth - 1
                } else {
                    if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                        if token.0 == 93 {
                            if bracket_depth == 0 { return mimi_buffer_empty() as *StructLiteralNode }
                            bracket_depth = bracket_depth - 1
                        } else {
                            if token.0 == 123 { brace_depth = brace_depth + 1 } else {
                                if token.0 == 125 {
                                    if brace_depth > 0 { brace_depth = brace_depth - 1 } else {
                                        if paren_depth == 0 && bracket_depth == 0 {
                                            segment_end = token.1
                                            close_end = token.2
                                            found_separator = true
                                        }
                                    }
                                } else {
                                    if token.0 == 44 && paren_depth == 0 && bracket_depth == 0 && brace_depth == 0 {
                                        segment_end = token.1
                                        found_separator = true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if !found_separator || paren_depth != 0 || bracket_depth != 0 || brace_depth != 0 { return mimi_buffer_empty() as *StructLiteralNode }
        field_source := source[segment_start:segment_end]
        name := next_token(field_source, 0)
        equal := next_token(field_source, name.2)
        if name.0 != 1 || equal.0 != 61 { return mimi_buffer_empty() as *StructLiteralNode }
        existing := first
        while existing != (mimi_buffer_empty() as *StructLiteralFieldNode) {
            if source_names_equal(source, existing.name_start, existing.name_end, name.1 + segment_start, name.2 + segment_start) { return mimi_buffer_empty() as *StructLiteralNode }
            existing = existing.next
        }
        value := parse_expression(field_source[equal.2:field_source.len], storage)
        if expression_is_null(value) { return mimi_buffer_empty() as *StructLiteralNode }
        value.start = value.start + equal.2 + segment_start
        value.end = value.end + equal.2 + segment_start
        if mimi_arena_allocate(storage, 48, 8) == 0 { return mimi_buffer_empty() as *StructLiteralNode }
        field := storage.last as *StructLiteralFieldNode
        field.start = name.1 + segment_start
        field.end = segment_end
        field.name_start = name.1 + segment_start
        field.name_end = name.2 + segment_start
        field.value = value
        field.next = mimi_buffer_empty() as *StructLiteralFieldNode
        if last == (mimi_buffer_empty() as *StructLiteralFieldNode) { first = field } else { last.next = field }
        last = field
        count = count + 1
        separator := next_token(source, segment_end)
        if separator.0 == 125 {
            close_end = separator.2
            break
        }
        if separator.0 != 44 { return mimi_buffer_empty() as *StructLiteralNode }
        cursor = separator.2
    }
    if close_end == source.len || next_token(source, close_end).0 != 0 { return mimi_buffer_empty() as *StructLiteralNode }
    if mimi_arena_allocate(storage, 48, 8) == 0 { return mimi_buffer_empty() as *StructLiteralNode }
    literal := storage.last as *StructLiteralNode
    literal.start = type_name.1
    literal.end = close_end
    literal.type_start = type_name.1
    literal.type_end = type_end
    literal.field_count = count
    literal.fields = first
    literal
}

parse_cast_expression :: fn (source : []u8, storage : *ExpressionArena) *ExprNode {
    cursor : u64 = 0
    paren_depth : u64 = 0
    bracket_depth : u64 = 0
    cast_start := source.len
    cast_end := source.len
    while cursor < source.len {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { break }
        cursor = token.2
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 && paren_depth > 0 { paren_depth = paren_depth - 1 } else {
                if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                    if token.0 == 93 && bracket_depth > 0 { bracket_depth = bracket_depth - 1 } else {
                        if token.0 == 174 && paren_depth == 0 && bracket_depth == 0 {
                            if cast_start != source.len { return mimi_buffer_empty() as *ExprNode }
                            cast_start = token.1
                            cast_end = token.2
                        }
                    }
                }
            }
        }
    }
    if cast_start == source.len { return mimi_buffer_empty() as *ExprNode }
    left_source := source[0:cast_start]
    first := next_token(left_source, 0)
    left := parse_expression(left_source, storage)
    if expression_is_null(left) { return left }
    if expression_precedence(left.kind as u8) != 0 && first.0 != 40 { return mimi_buffer_empty() as *ExprNode }
    data_type := parse_type(source[cast_end:source.len], storage)
    if expression_is_null(data_type) { return data_type }
    data_type.start = data_type.start + cast_end
    data_type.end = data_type.end + cast_end
    allocate_expr(storage, 293, left.start, data_type.end, left, data_type)
}

pub function_node_is_null :: fn (function : *FunctionNode) bool {
    function == (mimi_buffer_empty() as *FunctionNode)
}

pub parse_function_definition :: fn (source : []u8, storage : *ExpressionArena) *FunctionNode {
    header := parse_function_header(source, storage)
    if function_header_is_null(header) { return mimi_buffer_empty() as *FunctionNode }
    if header.body_start >= source.len { return mimi_buffer_empty() as *FunctionNode }
    body := parse_statement_block(source[header.body_start:source.len], header.body_start, storage)
    if block_node_is_null(body) { return mimi_buffer_empty() as *FunctionNode }
    parameters := parse_parameters(source, header, storage)
    if header.parameters_start != header.parameters_end && parameter_list_is_null(parameters) {
        return mimi_buffer_empty() as *FunctionNode
    }
    return_type := parse_type(source[header.return_type_start:header.return_type_end], storage)
    if expression_is_null(return_type) { return mimi_buffer_empty() as *FunctionNode }
    return_type.start = return_type.start + header.return_type_start
    return_type.end = return_type.end + header.return_type_start
    if mimi_arena_allocate(storage, 56, 8) == 0 { return mimi_buffer_empty() as *FunctionNode }
    function := storage.last as *FunctionNode
    function.start = header.start
    function.end = body.end
    function.name_start = header.name_start
    function.name_end = header.name_end
    function.parameters = parameters
    function.return_type = return_type
    function.body = body
    function
}

pub parameter_list_is_null :: fn (parameter : *ParameterNode) bool {
    parameter == (mimi_buffer_empty() as *ParameterNode)
}

pub parse_parameters :: fn (source : []u8, header : *FunctionHeader, storage : *ExpressionArena) *ParameterNode {
    if function_header_is_null(header) { return mimi_buffer_empty() as *ParameterNode }
    if header.parameters_start == header.parameters_end { return mimi_buffer_empty() as *ParameterNode }
    first : *ParameterNode = mimi_buffer_empty() as *ParameterNode
    last : *ParameterNode = mimi_buffer_empty() as *ParameterNode
    segment_start := header.parameters_start
    cursor := segment_start
    bracket_depth : u64 = 0
    paren_depth : u64 = 0
    angle_depth : u64 = 0
    while cursor <= header.parameters_end {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *ParameterNode }
        cursor = token.2
        if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
            if token.0 == 93 && bracket_depth > 0 { bracket_depth = bracket_depth - 1 }
        }
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 && paren_depth > 0 { paren_depth = paren_depth - 1 }
        }
        if token.0 == 60 { angle_depth = angle_depth + 1 } else {
            if token.0 == 62 && angle_depth > 0 { angle_depth = angle_depth - 1 }
        }
        if (token.0 == 44 && bracket_depth == 0 && paren_depth == 0 && angle_depth == 0) || token.2 > header.parameters_end {
            segment_end := token.1
            if token.2 > header.parameters_end { segment_end = header.parameters_end }
            parameter := parse_parameter(source[segment_start:segment_end], segment_start, storage)
            if parameter == (mimi_buffer_empty() as *ParameterNode) { return parameter }
            previous := first
            duplicate := false
            while previous != (mimi_buffer_empty() as *ParameterNode) && !duplicate {
                if previous.name_end - previous.name_start == parameter.name_end - parameter.name_start {
                    equal := true
                    index : u64 = 0
                    while index < parameter.name_end - parameter.name_start && equal {
                        if source[previous.name_start + index] != source[parameter.name_start + index] { equal = false }
                        index = index + 1
                    }
                    if equal { duplicate = true }
                }
                previous = previous.next
            }
            if duplicate { return mimi_buffer_empty() as *ParameterNode }
            if parameter_list_is_null(first) { first = parameter } else { last.next = parameter }
            last = parameter
            segment_start = token.2
        }
    }
    if cursor <= header.parameters_end { return mimi_buffer_empty() as *ParameterNode }
    first
}

pub parse_tuple_literal :: fn (source : []u8, storage : *ExpressionArena) *ExprNode {
    opening := next_token(source, 0)
    if opening.0 != 40 { return mimi_buffer_empty() as *ExprNode }
    cursor := opening.2
    items : *ExprNode = mimi_buffer_empty() as *ExprNode
    count : u64 = 0
    while true {
        if next_token(source, cursor).0 == 41 { return mimi_buffer_empty() as *ExprNode }
        segment_start := cursor
        segment_end := source.len
        paren_depth : u64 = 0
        bracket_depth : u64 = 0
        found_separator := false
        while cursor < source.len && !found_separator {
            token := next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *ExprNode }
            cursor = token.2
            if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                if token.0 == 41 {
                    if paren_depth > 0 { paren_depth = paren_depth - 1 } else {
                        if bracket_depth == 0 {
                            segment_end = token.1
                            found_separator = true
                        }
                    }
                } else {
                    if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                        if token.0 == 93 {
                            if bracket_depth == 0 { return mimi_buffer_empty() as *ExprNode }
                            bracket_depth = bracket_depth - 1
                        } else {
                            if token.0 == 44 && paren_depth == 0 && bracket_depth == 0 {
                                segment_end = token.1
                                found_separator = true
                            }
                        }
                    }
                }
            }
        }
        if !found_separator || paren_depth != 0 || bracket_depth != 0 { return mimi_buffer_empty() as *ExprNode }
        item := parse_expression(source[segment_start:segment_end], storage)
        if expression_is_null(item) { return item }
        item.start = item.start + segment_start
        item.end = item.end + segment_start
        if count == 0 { items = item } else {
            items = allocate_expr(storage, 262, items.start, item.end, items, item)
            if expression_is_null(items) { return items }
        }
        count = count + 1
        separator := next_token(source, segment_end)
        if separator.0 == 41 {
            if count < 2 || next_token(source, separator.2).0 != 0 { return mimi_buffer_empty() as *ExprNode }
            return allocate_expr(storage, 268, opening.1, separator.2, items, mimi_buffer_empty() as *ExprNode)
        }
        if separator.0 != 44 { return mimi_buffer_empty() as *ExprNode }
        cursor = separator.2
        trailing_close := next_token(source, cursor)
        if trailing_close.0 == 41 {
            if next_token(source, trailing_close.2).0 != 0 { return mimi_buffer_empty() as *ExprNode }
            return allocate_expr(storage, 268, opening.1, trailing_close.2, items, mimi_buffer_empty() as *ExprNode)
        }
    }
    mimi_buffer_empty() as *ExprNode
}

parse_parameter :: fn (source : []u8, offset : u64, storage : *ExpressionArena) *ParameterNode {
    name := next_token(source, 0)
    colon := next_token(source, name.2)
    if name.0 != 1 || colon.0 != 58 { return mimi_buffer_empty() as *ParameterNode }
    type_start := colon.2
    data_type := parse_type(source[type_start:source.len], storage)
    if expression_is_null(data_type) { return mimi_buffer_empty() as *ParameterNode }
    data_type.start = data_type.start + offset + type_start
    data_type.end = data_type.end + offset + type_start
    if mimi_arena_allocate(storage, 32, 8) == 0 { return mimi_buffer_empty() as *ParameterNode }
    parameter := storage.last as *ParameterNode
    parameter.name_start = name.1 + offset
    parameter.name_end = name.2 + offset
    parameter.data_type = data_type
    parameter.next = mimi_buffer_empty() as *ParameterNode
    parameter
}

pub parse_type :: fn (source : []u8, storage : *ExpressionArena) *ExprNode {
    if source.len > 500000000000000000 { return mimi_buffer_empty() as *ExprNode }
    first := next_token(source, 0)
    if first.0 == 40 { return parse_tuple_type(source, storage) }
    if first.0 == 160 { return parse_function_type(source, storage) }
    if mimi_arena_allocate(storage, source.len * 32 + 32, 8) == 0 { return mimi_buffer_empty() as *ExprNode }
    prefixes := storage.last as *ExprOperator
    prefix_count : u64 = 0
    cursor : u64 = 0
    token := next_token(source, cursor)
    if token.0 == 42 {
        prefixes[prefix_count] = ExprOperator { kind = 271, start = token.1, base_count = 0, argument_count = 0 }
        prefix_count = prefix_count + 1
        cursor = token.2
    } else {
        if token.0 == 91 {
            next := next_token(source, token.2)
            if next.0 == 93 {
                prefixes[prefix_count] = ExprOperator { kind = 272, start = token.1, base_count = 0, argument_count = 0 }
                prefix_count = prefix_count + 1
                cursor = next.2
            } else {
                if next.0 != 2 { return mimi_buffer_empty() as *ExprNode }
                close := next_token(source, next.2)
                if close.0 != 93 { return mimi_buffer_empty() as *ExprNode }
                count_node := allocate_expr(storage, 2, next.1, next.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
                if expression_is_null(count_node) { return count_node }
                prefixes[prefix_count] = ExprOperator { kind = 273, start = token.1, base_count = count_node.start, argument_count = count_node.end }
                prefix_count = prefix_count + 1
                cursor = close.2
            }
        }
    }
    while true {
        token = next_token(source, cursor)
        if token.0 == 42 {
            prefixes[prefix_count] = ExprOperator { kind = 271, start = token.1, base_count = 0, argument_count = 0 }
            prefix_count = prefix_count + 1
            cursor = token.2
        } else {
            if token.0 == 91 {
                next := next_token(source, token.2)
                if next.0 == 93 {
                    prefixes[prefix_count] = ExprOperator { kind = 272, start = token.1, base_count = 0, argument_count = 0 }
                    prefix_count = prefix_count + 1
                    cursor = next.2
                } else {
                    if next.0 != 2 { return mimi_buffer_empty() as *ExprNode }
                    close := next_token(source, next.2)
                    if close.0 != 93 { return mimi_buffer_empty() as *ExprNode }
                    prefixes[prefix_count] = ExprOperator { kind = 273, start = token.1, base_count = next.1, argument_count = next.2 }
                    prefix_count = prefix_count + 1
                    cursor = close.2
                }
            } else { break }
        }
    }
    name := next_token(source, cursor)
    if name.0 != 1 && name.0 != 4 && name.0 != 5 { return mimi_buffer_empty() as *ExprNode }
    suffix := next_token(source, name.2)
    node : *ExprNode = mimi_buffer_empty() as *ExprNode
    if suffix.0 == 60 {
        node = parse_generic_type(source, name, suffix, storage)
    } else {
        if suffix.0 != 0 { return mimi_buffer_empty() as *ExprNode }
        node = allocate_expr(storage, 270, name.1, name.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
    }
    if expression_is_null(node) { return node }
    while prefix_count > 0 {
        prefix_count = prefix_count - 1
        prefix := prefixes[prefix_count]
        if prefix.kind == 273 {
            count := allocate_expr(storage, 2, prefix.base_count, prefix.argument_count, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
            if expression_is_null(count) { return count }
            node = allocate_expr(storage, prefix.kind, prefix.start, node.end, node, count)
        } else {
            node = allocate_expr(storage, prefix.kind, prefix.start, node.end, node, mimi_buffer_empty() as *ExprNode)
        }
        if expression_is_null(node) { return node }
    }
    node
}

parse_generic_type :: fn (source : []u8, name : (u8, u64, u64), opening : (u8, u64, u64), storage : *ExpressionArena) *ExprNode {
    cursor := opening.2
    arguments : *ExprNode = mimi_buffer_empty() as *ExprNode
    count : u64 = 0
    while true {
        if next_token(source, cursor).0 == 62 { return mimi_buffer_empty() as *ExprNode }
        segment_start := cursor
        segment_end := source.len
        angle_depth : u64 = 0
        paren_depth : u64 = 0
        bracket_depth : u64 = 0
        found_separator := false
        while cursor < source.len && !found_separator {
            token := next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *ExprNode }
            cursor = token.2
            if token.0 == 60 { angle_depth = angle_depth + 1 } else {
                if token.0 == 62 {
                    if angle_depth > 0 { angle_depth = angle_depth - 1 } else {
                        if paren_depth == 0 && bracket_depth == 0 {
                            segment_end = token.1
                            found_separator = true
                        }
                    }
                } else {
                    if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                        if token.0 == 41 {
                            if paren_depth == 0 { return mimi_buffer_empty() as *ExprNode }
                            paren_depth = paren_depth - 1
                        } else {
                            if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                                if token.0 == 93 {
                                    if bracket_depth == 0 { return mimi_buffer_empty() as *ExprNode }
                                    bracket_depth = bracket_depth - 1
                                } else {
                                    if token.0 == 44 && angle_depth == 0 && paren_depth == 0 && bracket_depth == 0 {
                                        segment_end = token.1
                                        found_separator = true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if !found_separator || angle_depth != 0 || paren_depth != 0 || bracket_depth != 0 { return mimi_buffer_empty() as *ExprNode }
        argument := parse_type(source[segment_start:segment_end], storage)
        if expression_is_null(argument) { argument = parse_expression(source[segment_start:segment_end], storage) }
        if expression_is_null(argument) { return argument }
        argument.start = argument.start + segment_start
        argument.end = argument.end + segment_start
        if count == 0 { arguments = argument } else {
            arguments = allocate_expr(storage, 276, arguments.start, argument.end, arguments, argument)
            if expression_is_null(arguments) { return arguments }
        }
        count = count + 1
        separator := next_token(source, segment_end)
        if separator.0 == 62 {
            if next_token(source, separator.2).0 != 0 { return mimi_buffer_empty() as *ExprNode }
            base := allocate_expr(storage, 270, name.1, name.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
            if expression_is_null(base) { return base }
            return allocate_expr(storage, 278, name.1, separator.2, base, arguments)
        }
        if separator.0 != 44 { return mimi_buffer_empty() as *ExprNode }
        cursor = separator.2
        if next_token(source, cursor).0 == 62 { return mimi_buffer_empty() as *ExprNode }
    }
    mimi_buffer_empty() as *ExprNode
}

pub parse_tuple_type :: fn (source : []u8, storage : *ExpressionArena) *ExprNode {
    opening := next_token(source, 0)
    if opening.0 != 40 { return mimi_buffer_empty() as *ExprNode }
    cursor := opening.2
    elements : *ExprNode = mimi_buffer_empty() as *ExprNode
    count : u64 = 0
    while true {
        token := next_token(source, cursor)
        if token.0 == 41 || token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *ExprNode }
        segment_start := cursor
        bracket_depth : u64 = 0
        paren_depth : u64 = 0
        segment_end := source.len
        found_separator := false
        while cursor < source.len && !found_separator {
            token = next_token(source, cursor)
            if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *ExprNode }
            cursor = token.2
            if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                if token.0 == 93 {
                    if bracket_depth == 0 { return mimi_buffer_empty() as *ExprNode }
                    bracket_depth = bracket_depth - 1
                } else {
                    if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                        if token.0 == 41 {
                            if paren_depth > 0 { paren_depth = paren_depth - 1 } else {
                                if bracket_depth == 0 {
                                    segment_end = token.1
                                    found_separator = true
                                }
                            }
                        } else {
                            if bracket_depth == 0 && paren_depth == 0 && token.0 == 44 {
                                segment_end = token.1
                                found_separator = true
                            }
                        }
                    }
                }
            }
        }
        if !found_separator || bracket_depth != 0 || paren_depth != 0 { return mimi_buffer_empty() as *ExprNode }
        element := parse_type(source[segment_start:segment_end], storage)
        if expression_is_null(element) { return element }
        element.start = element.start + segment_start
        element.end = element.end + segment_start
        if count == 0 { elements = element } else {
            elements = allocate_expr(storage, 276, elements.start, element.end, elements, element)
            if expression_is_null(elements) { return elements }
        }
        count = count + 1
        separator := next_token(source, segment_end)
        if separator.0 == 41 {
            if next_token(source, separator.2).0 != 0 || count < 2 { return mimi_buffer_empty() as *ExprNode }
            return allocate_expr(storage, 275, opening.1, separator.2, elements, mimi_buffer_empty() as *ExprNode)
        }
        if separator.0 != 44 { return mimi_buffer_empty() as *ExprNode }
        cursor = separator.2
        trailing_close := next_token(source, cursor)
        if trailing_close.0 == 41 {
            if count == 0 || next_token(source, trailing_close.2).0 != 0 { return mimi_buffer_empty() as *ExprNode }
            return allocate_expr(storage, 275, opening.1, trailing_close.2, elements, mimi_buffer_empty() as *ExprNode)
        }
    }
    mimi_buffer_empty() as *ExprNode
}

pub parse_function_type :: fn (source : []u8, storage : *ExpressionArena) *ExprNode {
    keyword := next_token(source, 0)
    opening := next_token(source, keyword.2)
    if keyword.0 != 160 || opening.0 != 40 { return mimi_buffer_empty() as *ExprNode }
    cursor := opening.2
    parameters : *ExprNode = mimi_buffer_empty() as *ExprNode
    count : u64 = 0
    close_start : u64 = 0
    close_end : u64 = 0
    if next_token(source, cursor).0 == 41 {
        close := next_token(source, cursor)
        close_start = close.1
        close_end = close.2
    } else {
        while true {
            segment_start := cursor
            segment_end := source.len
            paren_depth : u64 = 0
            bracket_depth : u64 = 0
            found_separator := false
            while cursor < source.len && !found_separator {
                token := next_token(source, cursor)
                if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *ExprNode }
                cursor = token.2
                if token.0 == 40 { paren_depth = paren_depth + 1 } else {
                    if token.0 == 41 {
                        if paren_depth > 0 { paren_depth = paren_depth - 1 } else {
                            if bracket_depth == 0 {
                                segment_end = token.1
                                close_start = token.1
                                close_end = token.2
                                found_separator = true
                            }
                        }
                    } else {
                        if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                            if token.0 == 93 {
                                if bracket_depth == 0 { return mimi_buffer_empty() as *ExprNode }
                                bracket_depth = bracket_depth - 1
                            } else {
                                if token.0 == 44 && paren_depth == 0 && bracket_depth == 0 {
                                    segment_end = token.1
                                    found_separator = true
                                }
                            }
                        }
                    }
                }
            }
            if !found_separator || paren_depth != 0 || bracket_depth != 0 { return mimi_buffer_empty() as *ExprNode }
            parameter := parse_type(source[segment_start:segment_end], storage)
            if expression_is_null(parameter) { return parameter }
            parameter.start = parameter.start + segment_start
            parameter.end = parameter.end + segment_start
            if count == 0 { parameters = parameter } else {
                parameters = allocate_expr(storage, 276, parameters.start, parameter.end, parameters, parameter)
                if expression_is_null(parameters) { return parameters }
            }
            count = count + 1
            separator := next_token(source, segment_end)
            if separator.0 == 41 { break }
            if separator.0 != 44 { return mimi_buffer_empty() as *ExprNode }
            cursor = separator.2
            trailing_close := next_token(source, cursor)
            if trailing_close.0 == 41 {
                close_start = trailing_close.1
                close_end = trailing_close.2
                break
            }
        }
    }
    if close_end == 0 { return mimi_buffer_empty() as *ExprNode }
    return_type := parse_type(source[close_end:source.len], storage)
    if expression_is_null(return_type) { return return_type }
    return_type.start = return_type.start + close_end
    return_type.end = return_type.end + close_end
    allocate_expr(storage, 277, keyword.1, return_type.end, parameters, return_type)
}

pub parse_expression :: fn (source : []u8, storage : *ExpressionArena) *ExprNode {
    // Bound the stack-size calculations below before multiplying source.len.
    if source.len > 500000000000000000 { return mimi_buffer_empty() as *ExprNode }
    first_cast := next_token(source, 0)
    if first_cast.0 == 1 || first_cast.0 == 2 || first_cast.0 == 3 || first_cast.0 == 40 || first_cast.0 == 42 || first_cast.0 == 91 || first_cast.0 == 38 || first_cast.0 == 45 || first_cast.0 == 33 {
        cast := parse_cast_expression(source, storage)
        if !expression_is_null(cast) { return cast }
    }
    first := next_token(source, 0)
    if first.0 == 1 && (next_token(source, first.2).0 == 123 || next_token(source, first.2).0 == 60) {
        literal := parse_struct_literal(source, storage)
        if struct_literal_is_null(literal) { } else {
        type_node := parse_type(source[literal.type_start:literal.type_end], storage)
        if expression_is_null(type_node) { return type_node }
        type_node.start = type_node.start + literal.type_start
        type_node.end = type_node.end + literal.type_start
        if expression_is_null(type_node) { return type_node }
        fields : *ExprNode = mimi_buffer_empty() as *ExprNode
        current := literal.fields
        while current != (mimi_buffer_empty() as *StructLiteralFieldNode) {
            name_node := allocate_expr(storage, 1, current.name_start, current.name_end, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
            if expression_is_null(name_node) { return name_node }
            entry := allocate_expr(storage, 292, current.start, current.end, name_node, current.value)
            if expression_is_null(entry) { return entry }
            if expression_is_null(fields) { fields = entry } else {
                fields = allocate_expr(storage, 262, fields.start, entry.end, fields, entry)
                if expression_is_null(fields) { return fields }
            }
            current = current.next
        }
        return allocate_expr(storage, 291, literal.start, literal.end, type_node, fields)
        }
    }
    if first.0 == 1 || first.0 == 2 || first.0 == 3 || first.0 == 4 || first.0 == 5 {
        if next_token(source, first.2).0 == 0 {
            return allocate_expr(storage, first.0 as u64, first.1, first.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
        }
    }
    if mimi_arena_allocate(storage, source.len * 8 + 8, 8) == 0 { return mimi_buffer_empty() as *ExprNode }
    node_stack := storage.last as **ExprNode
    if mimi_arena_allocate(storage, source.len * 32 + 32, 8) == 0 { return mimi_buffer_empty() as *ExprNode }
    operator_stack := storage.last as *ExprOperator
    stacks := ExpressionStacks { storage = storage, nodes = node_stack, operators = operator_stack, node_count = 0, operator_count = 0 }
    cursor : u64 = 0
    expecting_operand := true
    while true {
        token := next_token(source, cursor)
        if token.0 == 0 { break }
        if token.0 == 255 { return mimi_buffer_empty() as *ExprNode }
        cursor = token.2

        if token.0 == 1 || token.0 == 2 || token.0 == 3 || token.0 == 4 || token.0 == 5 {
            if !expecting_operand { return mimi_buffer_empty() as *ExprNode }
            node := allocate_expr(storage, token.0 as u64, token.1, token.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
            if expression_is_null(node) { return node }
            if token.0 == 1 || token.0 == 2 || token.0 == 3 {
                node.payload_start = token.1
                node.payload_end = token.2
            }
            stacks.nodes[stacks.node_count] = node
            stacks.node_count = stacks.node_count + 1
            expecting_operand = false
            while stacks.operator_count > 0 && is_prefix_operator(stacks.operators[stacks.operator_count - 1].kind) {
                if !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
            }
        } else {
            if token.0 == 46 && !expecting_operand {
                if stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
                member := next_token(source, cursor)
                if member.0 != 1 && member.0 != 2 { return mimi_buffer_empty() as *ExprNode }
                cursor = member.2
                member_node := allocate_expr(storage, member.0 as u64, member.1, member.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
                if expression_is_null(member_node) { return member_node }
                receiver := stacks.nodes[stacks.node_count - 1]
                access := allocate_expr(storage, 260, receiver.start, member.2, receiver, member_node)
                if expression_is_null(access) { return access }
                stacks.nodes[stacks.node_count - 1] = access
            } else {
                if token.0 == 40 && expecting_operand {
                    stacks.operators[stacks.operator_count] = ExprOperator { kind = 40, start = token.1, base_count = 0, argument_count = 0 }
                    stacks.operator_count = stacks.operator_count + 1
                } else {
                    if token.0 == 40 && !expecting_operand {
                        if stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
                        stacks.operators[stacks.operator_count] = ExprOperator { kind = 300, start = token.1, base_count = stacks.node_count, argument_count = 0 }
                        stacks.operator_count = stacks.operator_count + 1
                        expecting_operand = true
                    } else {
                    if token.0 == 91 && !expecting_operand {
                        if stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
                        stacks.operators[stacks.operator_count] = ExprOperator { kind = 91, start = token.1, base_count = stacks.node_count, argument_count = 0 }
                        stacks.operator_count = stacks.operator_count + 1
                        expecting_operand = true
                    } else {
                        if token.0 == 58 || token.0 == 135 {
                            found_index := false
                            while stacks.operator_count > 0 && !found_index {
                                top := stacks.operators[stacks.operator_count - 1]
                                if top.kind == 91 {
                                    found_index = true
                                } else {
                                    if top.kind == 40 || top.kind == 300 || !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                                }
                            }
                            if !found_index || stacks.operators[stacks.operator_count - 1].argument_count != 0 { return mimi_buffer_empty() as *ExprNode }
                            marker := stacks.operators[stacks.operator_count - 1]
                            if expecting_operand {
                                if stacks.node_count != marker.base_count { return mimi_buffer_empty() as *ExprNode }
                                marker.argument_count = 1
                            } else {
                                if stacks.node_count != marker.base_count + 1 { return mimi_buffer_empty() as *ExprNode }
                                marker.argument_count = 3
                            }
                            stacks.operators[stacks.operator_count - 1] = marker
                            expecting_operand = true
                        } else {
                        if token.0 == 44 {
                            if expecting_operand || stacks.operator_count == 0 { return mimi_buffer_empty() as *ExprNode }
                            while stacks.operator_count > 0 && stacks.operators[stacks.operator_count - 1].kind != 300 {
                                top := stacks.operators[stacks.operator_count - 1]
                                if top.kind == 40 || top.kind == 91 || !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                            }
                            if stacks.operator_count == 0 { return mimi_buffer_empty() as *ExprNode }
                            marker := stacks.operators[stacks.operator_count - 1]
                            expected_count := marker.base_count + 1
                            if marker.argument_count != 0 { expected_count = expected_count + 1 }
                            if stacks.node_count != expected_count { return mimi_buffer_empty() as *ExprNode }
                            argument := stacks.nodes[stacks.node_count - 1]
                            if marker.argument_count == 0 {
                                stacks.nodes[marker.base_count] = argument
                            } else {
                                previous := stacks.nodes[marker.base_count]
                                argument_list := allocate_expr(storage, 262, previous.start, argument.end, previous, argument)
                                if expression_is_null(argument_list) { return argument_list }
                                stacks.nodes[marker.base_count] = argument_list
                                stacks.node_count = stacks.node_count - 1
                            }
                            marker.argument_count = marker.argument_count + 1
                            stacks.operators[stacks.operator_count - 1] = marker
                            expecting_operand = true
                        } else {
                        if token.0 == 93 {
                            found_index := false
                            marker := ExprOperator { kind = 0, start = 0, base_count = 0, argument_count = 0 }
                            while stacks.operator_count > 0 && !found_index {
                                top := stacks.operators[stacks.operator_count - 1]
                                if top.kind == 91 {
                                    marker = top
                                    stacks.operator_count = stacks.operator_count - 1
                                    found_index = true
                                } else {
                                    if top.kind == 40 || top.kind == 300 || !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                                }
                            }
                            if !found_index || marker.base_count == 0 { return mimi_buffer_empty() as *ExprNode }
                            if marker.argument_count == 0 {
                                if expecting_operand || stacks.node_count != marker.base_count + 1 { return mimi_buffer_empty() as *ExprNode }
                                index_node := stacks.nodes[marker.base_count]
                                receiver := stacks.nodes[marker.base_count - 1]
                                access := allocate_expr(storage, 261, receiver.start, token.2, receiver, index_node)
                                if expression_is_null(access) { return access }
                                stacks.node_count = marker.base_count
                                stacks.nodes[stacks.node_count - 1] = access
                            } else {
                                has_start := marker.argument_count == 3
                                has_end := !expecting_operand
                                expected_count := marker.base_count
                                if has_start { expected_count = expected_count + 1 }
                                if has_end { expected_count = expected_count + 1 }
                                if stacks.node_count != expected_count { return mimi_buffer_empty() as *ExprNode }
                                start_node : *ExprNode = mimi_buffer_empty() as *ExprNode
                                end_node : *ExprNode = mimi_buffer_empty() as *ExprNode
                                if has_start { start_node = stacks.nodes[marker.base_count] }
                                if has_end {
                                    end_index := marker.base_count
                                    if has_start { end_index = end_index + 1 }
                                    end_node = stacks.nodes[end_index]
                                }
                                receiver := stacks.nodes[marker.base_count - 1]
                                bounds := allocate_expr(storage, 265, token.1, token.1, start_node, end_node)
                                if expression_is_null(bounds) { return bounds }
                                slice := allocate_expr(storage, 264, receiver.start, token.2, receiver, bounds)
                                if expression_is_null(slice) { return slice }
                                stacks.node_count = marker.base_count - 1
                                stacks.nodes[stacks.node_count] = slice
                                stacks.node_count = stacks.node_count + 1
                            }
                            expecting_operand = false
                        } else {
                            if token.0 == 41 && stacks.operator_count > 0 && stacks.operators[stacks.operator_count - 1].kind == 300 {
                                marker := stacks.operators[stacks.operator_count - 1]
                                if marker.argument_count == 0 {
                                    if stacks.node_count != marker.base_count && stacks.node_count != marker.base_count + 1 { return mimi_buffer_empty() as *ExprNode }
                                } else {
                                    if expecting_operand { return mimi_buffer_empty() as *ExprNode }
                                    while stacks.operator_count > 0 && stacks.operators[stacks.operator_count - 1].kind != 300 {
                                        if !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                                    }
                                    if stacks.node_count != marker.base_count + 2 { return mimi_buffer_empty() as *ExprNode }
                                    previous := stacks.nodes[marker.base_count]
                                    argument := stacks.nodes[marker.base_count + 1]
                                    argument_list := allocate_expr(storage, 262, previous.start, argument.end, previous, argument)
                                    if expression_is_null(argument_list) { return argument_list }
                                    stacks.nodes[marker.base_count] = argument_list
                                    stacks.node_count = stacks.node_count - 1
                                }
                                stacks.operator_count = stacks.operator_count - 1
                                callee := stacks.nodes[marker.base_count - 1]
                                arguments : *ExprNode = mimi_buffer_empty() as *ExprNode
                                if marker.argument_count != 0 || stacks.node_count == marker.base_count + 1 { arguments = stacks.nodes[marker.base_count] }
                                call := allocate_expr(storage, 263, callee.start, token.2, callee, arguments)
                                if expression_is_null(call) { return call }
                                stacks.node_count = marker.base_count - 1
                                stacks.nodes[stacks.node_count] = call
                                stacks.node_count = stacks.node_count + 1
                                expecting_operand = false
                            } else {
                            if token.0 == 41 {
                                if expecting_operand { return mimi_buffer_empty() as *ExprNode }
                                found_open := false
                                while stacks.operator_count > 0 && !found_open {
                                    top := stacks.operators[stacks.operator_count - 1]
                                    if top.kind == 40 {
                                        stacks.operator_count = stacks.operator_count - 1
                                        found_open = true
                                    } else {
                                        if top.kind == 91 || top.kind == 300 || !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                                    }
                                }
                                if !found_open { return mimi_buffer_empty() as *ExprNode }
                                if stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
                                stacks.nodes[stacks.node_count - 1].start = stacks.operators[stacks.operator_count].start
                                stacks.nodes[stacks.node_count - 1].end = token.2
                                expecting_operand = false
                            } else {
                                if token.0 == 174 && !expecting_operand {
                                    if stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
                                    type_end := cast_type_end(source, cursor)
                                    if type_end == cursor { return mimi_buffer_empty() as *ExprNode }
                                    data_type := parse_type(source[cursor:type_end], storage)
                                    if expression_is_null(data_type) { return data_type }
                                    data_type.start = data_type.start + cursor
                                    data_type.end = data_type.end + cursor
                                    value := stacks.nodes[stacks.node_count - 1]
                                    cast := allocate_expr(storage, 293, value.start, data_type.end, value, data_type)
                                    if expression_is_null(cast) { return cast }
                                    stacks.nodes[stacks.node_count - 1] = cast
                                    cursor = type_end
                                } else {
                                if expecting_operand {
                                    if token.0 != 45 && token.0 != 33 && token.0 != 38 && token.0 != 42 { return mimi_buffer_empty() as *ExprNode }
                                    stacks.operators[stacks.operator_count] = ExprOperator { kind = 250 + token.0 as u64, start = token.1, base_count = 0, argument_count = 0 }
                                    stacks.operator_count = stacks.operator_count + 1
                                } else {
                                    precedence := expression_precedence(token.0)
                                    if precedence == 0 { return mimi_buffer_empty() as *ExprNode }
                                    while stacks.operator_count > 0 {
                                        top := stacks.operators[stacks.operator_count - 1]
                                        if top.kind == 40 || top.kind == 91 || top.kind == 300 { break }
                                        top_precedence := expression_operator_precedence(top.kind)
                                        if top_precedence < precedence { break }
                                        if !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                                    }
                                    stacks.operators[stacks.operator_count] = ExprOperator { kind = token.0 as u64, start = token.1, base_count = 0, argument_count = 0 }
                                    stacks.operator_count = stacks.operator_count + 1
                                    expecting_operand = true
                                    }
                                }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
    }

    }
    if expecting_operand || stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
    while stacks.operator_count > 0 {
        if stacks.operators[stacks.operator_count - 1].kind == 40 || stacks.operators[stacks.operator_count - 1].kind == 91 || stacks.operators[stacks.operator_count - 1].kind == 300 { return mimi_buffer_empty() as *ExprNode }
        if !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
    }
    if stacks.node_count != 1 { return mimi_buffer_empty() as *ExprNode }
    stacks.nodes[0]
}

cast_type_end :: fn (source : []u8, start : u64) u64 {
    cursor := start
    paren_depth : u64 = 0
    bracket_depth : u64 = 0
    angle_depth : u64 = 0
    saw_name := false
    while cursor < source.len {
        token := next_token(source, cursor)
        if token.0 == 0 || token.0 == 255 { break }
        if paren_depth == 0 && bracket_depth == 0 && angle_depth == 0 {
            if token.0 == 174 || token.0 == 43 || token.0 == 45 || token.0 == 47 || token.0 == 37 || token.0 == 128 || token.0 == 129 || token.0 == 130 || token.0 == 131 || token.0 == 132 || token.0 == 133 || token.0 == 44 || token.0 == 41 || token.0 == 93 { break }
            if token.0 == 42 && saw_name { break }
        }
        cursor = token.2
        if token.0 == 1 || token.0 == 4 || token.0 == 5 { saw_name = true }
        if token.0 == 40 { paren_depth = paren_depth + 1 } else {
            if token.0 == 41 {
                if paren_depth == 0 { return start }
                paren_depth = paren_depth - 1
            } else {
                if token.0 == 91 { bracket_depth = bracket_depth + 1 } else {
                    if token.0 == 93 {
                        if bracket_depth == 0 { return start }
                        bracket_depth = bracket_depth - 1
                    } else {
                        if token.0 == 60 { angle_depth = angle_depth + 1 } else {
                            if token.0 == 62 && angle_depth > 0 { angle_depth = angle_depth - 1 }
                        }
                    }
                }
            }
        }
    }
    if paren_depth != 0 || bracket_depth != 0 || angle_depth != 0 { return start }
    cursor
}

allocate_expr :: fn (storage : *ExpressionArena, kind : u64, start : u64, end : u64, left : *ExprNode, right : *ExprNode) *ExprNode {
    if mimi_arena_allocate(storage, 56, 8) == 0 { return mimi_buffer_empty() as *ExprNode }
    node := storage.last as *ExprNode
    node.kind = kind
    node.start = start
    node.end = end
    node.left = left
    node.right = right
    node.payload_start = start
    node.payload_end = end
    node
}

reduce_expression :: fn (stacks : *ExpressionStacks) bool {
    if stacks.operator_count == 0 { return false }
    operator := stacks.operators[stacks.operator_count - 1]
    stacks.operator_count = stacks.operator_count - 1
    if is_prefix_operator(operator.kind) {
        if stacks.node_count < 1 { return false }
        operand := stacks.nodes[stacks.node_count - 1]
        node := allocate_expr(stacks.storage, operator.kind, operator.start, operand.end, operand, mimi_buffer_empty() as *ExprNode)
        if expression_is_null(node) { return false }
        stacks.nodes[stacks.node_count - 1] = node
        return true
    }
    if stacks.node_count < 2 { return false }
    right := stacks.nodes[stacks.node_count - 1]
    left := stacks.nodes[stacks.node_count - 2]
    stacks.node_count = stacks.node_count - 2
    node := allocate_expr(stacks.storage, operator.kind, left.start, right.end, left, right)
    if expression_is_null(node) { return false }
    stacks.nodes[stacks.node_count] = node
    stacks.node_count = stacks.node_count + 1
    true
}

is_prefix_operator :: fn (kind : u64) bool {
    kind == 295 || kind == 283 || kind == 288 || kind == 292
}

expression_operator_precedence :: fn (kind : u64) u8 {
    if is_prefix_operator(kind) { return 7 }
    expression_precedence(kind as u8)
}

expression_precedence :: fn (kind : u8) u8 {
    if kind == 133 { return 1 }
    if kind == 132 { return 2 }
    if kind == 128 || kind == 129 { return 3 }
    if kind == 60 || kind == 62 || kind == 130 || kind == 131 { return 4 }
    if kind == 43 || kind == 45 { return 5 }
    if kind == 42 || kind == 47 || kind == 37 { return 6 }
    0
}
