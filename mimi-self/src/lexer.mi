pub next_token :: fn (source : []u8, cursor : u64) (u8, u64, u64) {
    index := cursor
    while index < source.len {
        byte := source[index]
        if byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            index = index + 1
        } else {
            if byte == 47 && index + 1 < source.len && source[index + 1] == 47 {
                index = index + 2
                while index < source.len && source[index] != 10 {
                    index = index + 1
                }
            } else {
                if byte == 47 && index + 1 < source.len && source[index + 1] == 42 {
                    index = index + 2
                    closed := false
                    while index + 1 < source.len && !closed {
                        if source[index] == 42 && source[index + 1] == 47 {
                            index = index + 2
                            closed = true
                        } else {
                            index = index + 1
                        }
                    }
                    if !closed {
                        return (255, index, index)
                    }
                } else {
                    start := index
                    if byte == 34 {
                        index = index + 1
                        closed := false
                        while index < source.len && !closed {
                            if source[index] == 92 {
                                        if index + 1 >= source.len {
                                            return (255, index, index)
                                        }
                                        escaped := source[index + 1]
                                        if escaped == 34 || escaped == 92 || escaped == 110 || escaped == 114 || escaped == 116 {
                                            index = index + 2
                                        } else {
                                            return (255, index, index)
                                        }
                            } else {
                                if source[index] == 34 {
                                    index = index + 1
                                    closed = true
                                } else {
                                    index = index + 1
                                }
                            }
                        }
                        if !closed {
                            return (255, index, index)
                        }
                        return (3, start, index)
                    } else {
                        if (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || byte >= 128 {
                            index = index + 1
                            while index < source.len {
                                next := source[index]
                                if (next >= 65 && next <= 90) || (next >= 97 && next <= 122) || (next >= 48 && next <= 57) || next == 95 || next >= 128 {
                                    index = index + 1
                                } else {
                                    break
                                }
                            }
                            return (1, start, index)
                        } else {
                            if byte >= 48 && byte <= 57 {
                                index = index + 1
                                while index < source.len && source[index] >= 48 && source[index] <= 57 {
                                    index = index + 1
                                }
                                if index < source.len && source[index] == 46 && (index + 1 >= source.len || source[index + 1] != 46) {
                                    index = index + 1
                                    while index < source.len && source[index] >= 48 && source[index] <= 57 {
                                        index = index + 1
                                    }
                                }
                                return (2, start, index)
                            } else {
                                if byte == 124 && (index + 1 >= source.len || source[index + 1] != 124) {
                                    return (255, index, index)
                                }
                                if byte == 61 || byte == 33 || byte == 60 || byte == 62 || byte == 38 || byte == 124 {
                                    if index + 1 < source.len {
                                        next := source[index + 1]
                                        if (byte == 61 && (next == 61 || next == 62)) || (byte == 33 && next == 61) || (byte == 60 && next == 61) || (byte == 62 && next == 61) || (byte == 38 && next == 38) || (byte == 124 && next == 124) {
                                            index = index + 2
                                        } else {
                                            index = index + 1
                                        }
                                    } else {
                                        index = index + 1
                                    }
                                } else {
                                    if byte == 46 && index + 1 < source.len && source[index + 1] == 46 {
                                        index = index + 2
                                    } else {
                                        if byte == 58 || byte == 44 || byte == 46 || byte == 43 || byte == 45 || byte == 42 || byte == 47 || byte == 37 || byte == 40 || byte == 41 || byte == 123 || byte == 125 || byte == 91 || byte == 93 || byte == 64 {
                                            index = index + 1
                                        } else {
                                            return (255, index, index)
                                        }
                                    }
                                }
                                return (4, start, index)
                            }
                        }
                    }
                }
            }
        }
    }
    (0, source.len, source.len)
}

pub token_count :: fn (source : []u8) i32 {
    cursor : u64 = 0
    count := 0
    while true {
        token := next_token(source, cursor)
        if token.0 == 0 {
            return count
        }
        if token.0 == 255 {
            return -1
        }
        cursor = token.2
        count = count + 1
    }
    count
}
