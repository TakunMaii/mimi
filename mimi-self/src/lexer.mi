pub next_token_raw :: fn (source : *u8, source_length : u64, cursor : u64) (u8, u64, u64) {
    index := cursor
    while index < source_length {
        byte := source[index]
        if byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            index = index + 1
        } else {
            if byte == 47 && index + 1 < source_length && source[index + 1] == 47 {
                index = index + 2
                while index < source_length && source[index] != 10 {
                    index = index + 1
                }
            } else {
                if byte == 47 && index + 1 < source_length && source[index + 1] == 42 {
                    index = index + 2
                    closed := false
                    while index + 1 < source_length && !closed {
                        if source[index] == 42 && source[index + 1] == 47 {
                            index = index + 2
                            closed = true
                        } else {
                            index = index + 1
                        }
                    }
                    if !closed {
                        return (255, index, index)
                    }
                } else {
                    start := index
                    if byte == 34 {
                        index = index + 1
                        closed := false
                        while index < source_length && !closed {
                            if source[index] == 92 {
                                        if index + 1 >= source_length {
                                            return (255, index, index)
                                        }
                                        escaped := source[index + 1]
                                        if escaped == 34 || escaped == 92 || escaped == 110 || escaped == 114 || escaped == 116 {
                                            index = index + 2
                                        } else {
                                            return (255, index, index)
                                        }
                            } else {
                                if source[index] == 34 {
                                    index = index + 1
                                    closed = true
                                } else {
                                    index = index + 1
                                }
                            }
                        }
                        if !closed {
                            return (255, index, index)
                        }
                        return (3, start, index)
                    } else {
                        if (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || byte >= 128 {
                            if byte >= 128 {
                                width := utf8_width_raw(source, source_length, index)
                                if width == 0 || !utf8_identifier_start_raw(source, index, width) { return (255, index, index) }
                                index = index + width as u64
                            } else {
                                index = index + 1
                            }
                            while index < source_length {
                                next := source[index]
                                if (next >= 65 && next <= 90) || (next >= 97 && next <= 122) || (next >= 48 && next <= 57) || next == 95 || next >= 128 {
                                    if next >= 128 {
                                        width := utf8_width_raw(source, source_length, index)
                                        if width == 0 { return (255, index, index) }
                                        index = index + width as u64
                                    } else {
                                        index = index + 1
                                    }
                                } else {
                                    break
                                }
                            }
                            return (identifier_kind_raw(source, start, index), start, index)
                        } else {
                            if byte >= 48 && byte <= 57 {
                                previous := index
                                after_member_dot := false
                                while previous > 0 && (source[previous - 1] == 32 || source[previous - 1] == 9 || source[previous - 1] == 10 || source[previous - 1] == 13) {
                                    previous = previous - 1
                                }
                                if previous > 0 && source[previous - 1] == 46 {
                                    after_member_dot = true
                                }
                                index = index + 1
                                while index < source_length && source[index] >= 48 && source[index] <= 57 {
                                    index = index + 1
                                }
                                if !after_member_dot && index < source_length && source[index] == 46 && (index + 1 >= source_length || source[index + 1] != 46) {
                                    index = index + 1
                                    while index < source_length && source[index] >= 48 && source[index] <= 57 {
                                        index = index + 1
                                    }
                                    if index < source_length && source[index] == 46 && (index + 1 >= source_length || source[index + 1] != 46) {
                                        return (255, index, index)
                                    }
                                }
                                return (2, start, index)
                            } else {
                                next_byte : u8 = 0
                                if index + 1 < source_length {
                                    next_byte = source[index + 1]
                                }
                                kind := paired_kind(byte, next_byte)
                                if kind != 0 {
                                    index = index + 2
                                } else {
                                    kind = single_kind(byte)
                                    if kind == 0 {
                                        return (255, index, index)
                                    }
                                    index = index + 1
                                }
                                return (kind, start, index)
                            }
                        }
                    }
                }
            }
        }
    }
    (0, source_length, source_length)
}

pub next_token :: fn (source : []u8, cursor : u64) (u8, u64, u64) {
    next_token_raw(source.ptr, source.len, cursor)
}

pub LexResult :: struct {
    kind : u8,
    start : u64,
    end : u64,
    error_code : u8,
}

pub lex_next :: fn (source : []u8, cursor : u64) LexResult {
    token := next_token(source, cursor)
    if token.0 != 255 {
        return LexResult { kind = token.0, start = token.1, end = token.2, error_code = 0 }
    }
    code := error_code(source, token.1)
    span := error_span(source, token.1)
    LexResult { kind = 255, start = span.0, end = span.1, error_code = code }
}

pub error_code :: fn (source : []u8, cursor : u64) u8 {
    index : u64 = 0
    in_string := false
    escaped := false
    in_block_comment := false
    while index < cursor && index < source.len {
        byte := source[index]
        if in_block_comment {
            if byte == 42 && index + 1 < source.len && source[index + 1] == 47 {
                in_block_comment = false
                index = index + 2
            } else {
                index = index + 1
            }
        } else {
            if in_string {
                if escaped {
                    escaped = false
                    index = index + 1
                } else {
                    if byte == 92 {
                        escaped = true
                        index = index + 1
                    } else {
                        if byte == 34 {
                            in_string = false
                        }
                        index = index + 1
                    }
                }
            } else {
                if byte == 34 {
                    in_string = true
                    index = index + 1
                } else {
                    if byte == 47 && index + 1 < source.len && source[index + 1] == 47 {
                        index = index + 2
                        while index < cursor && index < source.len && source[index] != 10 {
                            index = index + 1
                        }
                    } else {
                        if byte == 47 && index + 1 < source.len && source[index + 1] == 42 {
                            in_block_comment = true
                            index = index + 2
                        } else {
                            index = index + 1
                        }
                    }
                }
            }
        }
    }
    if in_block_comment { return 2 }
    if in_string {
        if escaped { return 4 }
        if cursor >= source.len { return 3 }
        if source[cursor] == 92 {
            if cursor + 1 >= source.len { return 4 }
            value := source[cursor + 1]
            if value != 34 && value != 92 && value != 110 && value != 114 && value != 116 { return 4 }
        }
        return 3
    }
    if cursor < source.len && source[cursor] >= 128 && utf8_width(source, cursor) == 0 {
        return 5
    }
    1
}

pub error_message :: fn (source : []u8, cursor : u64) []u8 {
    code := error_code(source, cursor)
    if code == 2 { return "unterminated block comment" }
    if code == 3 { return "unterminated string literal" }
    if code == 4 { return "invalid string escape" }
    if code == 5 { return "invalid UTF-8 sequence in identifier" }
    "unexpected character"
}

pub error_span :: fn (source : []u8, cursor : u64) (u64, u64) {
    code := error_code(source, cursor)
    if code == 1 {
        if cursor < source.len { return (cursor, cursor + 1) }
        return (source.len, source.len)
    }
    if code == 5 { return (cursor, cursor + 1) }
    if code == 4 {
        end := cursor + 2
        if end > source.len { end = source.len }
        return (cursor, end)
    }
    if code == 2 || code == 3 {
        index : u64 = 0
        string_start : u64 = 0
        comment_start : u64 = 0
        in_string := false
        escaped := false
        in_block_comment := false
        while index < source.len {
            byte := source[index]
            if in_block_comment {
                if byte == 42 && index + 1 < source.len && source[index + 1] == 47 {
                    in_block_comment = false
                    index = index + 2
                } else {
                    index = index + 1
                }
            } else {
                if in_string {
                    if escaped {
                        escaped = false
                        index = index + 1
                    } else {
                        if byte == 92 {
                            escaped = true
                            index = index + 1
                        } else {
                            if byte == 34 { in_string = false }
                            index = index + 1
                        }
                    }
                } else {
                    if byte == 34 {
                        string_start = index
                        in_string = true
                        index = index + 1
                    } else {
                        if byte == 47 && index + 1 < source.len && source[index + 1] == 47 {
                            index = index + 2
                            while index < source.len && source[index] != 10 { index = index + 1 }
                        } else {
                            if byte == 47 && index + 1 < source.len && source[index + 1] == 42 {
                                comment_start = index
                                in_block_comment = true
                                index = index + 2
                            } else {
                                index = index + 1
                            }
                        }
                    }
                }
            }
        }
        if code == 2 { return (comment_start, source.len) }
        return (string_start, source.len)
    }
    (cursor, cursor)
}

utf8_width :: fn (source : []u8, index : u64) u8 {
    first := source[index]
    if first >= 194 && first <= 223 {
        if index + 1 >= source.len { return 0 }
        second := source[index + 1]
        if second < 128 || second > 191 { return 0 }
        return 2
    }
    if first >= 224 && first <= 239 {
        if index + 2 >= source.len { return 0 }
        second := source[index + 1]
        third := source[index + 2]
        if second < 128 || second > 191 || third < 128 || third > 191 { return 0 }
        if first == 224 && second < 160 { return 0 }
        if first == 237 && second >= 160 { return 0 }
        return 3
    }
    if first >= 240 && first <= 244 {
        if index + 3 >= source.len { return 0 }
        second := source[index + 1]
        third := source[index + 2]
        fourth := source[index + 3]
        if second < 128 || second > 191 || third < 128 || third > 191 || fourth < 128 || fourth > 191 { return 0 }
        if first == 240 && second < 144 { return 0 }
        if first == 244 && second > 143 { return 0 }
        return 4
    }
    0
}

utf8_identifier_start :: fn (source : []u8, index : u64, width : u8) bool {
    codepoint : u64 = 0
    if width == 2 {
        codepoint = (source[index] as u64 % 32) * 64 + source[index + 1] as u64 % 64
    } else {
        if width == 3 {
            codepoint = (source[index] as u64 % 16) * 4096 + (source[index + 1] as u64 % 64) * 64 + source[index + 2] as u64 % 64
        } else {
            if width == 4 {
                codepoint = (source[index] as u64 % 8) * 262144 + (source[index + 1] as u64 % 64) * 4096 + (source[index + 2] as u64 % 64) * 64 + source[index + 3] as u64 % 64
            } else {
                return false
            }
        }
    }
    if codepoint >= 192 && codepoint <= 767 { return codepoint != 215 && codepoint != 247 }
    if codepoint >= 880 && codepoint <= 1327 { return true }
    if codepoint >= 1329 && codepoint <= 1416 { return true }
    if codepoint >= 1488 && codepoint <= 1514 { return true }
    if codepoint >= 1568 && codepoint <= 1610 { return true }
    if codepoint >= 1646 && codepoint <= 1747 { return true }
    if codepoint >= 2308 && codepoint <= 8191 { return true }
    if codepoint >= 11264 && codepoint <= 11775 { return true }
    if codepoint >= 12353 && codepoint <= 12543 { return true }
    if codepoint >= 12549 && codepoint <= 12591 { return true }
    if codepoint >= 13312 && codepoint <= 40959 { return true }
    if codepoint >= 44032 && codepoint <= 55203 { return true }
    if codepoint >= 63744 && codepoint <= 64255 { return true }
    if codepoint >= 65536 && codepoint <= 126975 { return true }
    false
}

utf8_width_raw :: fn (source : *u8, source_length : u64, index : u64) u8 {
    first := source[index]
    if first >= 194 && first <= 223 {
        if index + 1 >= source_length { return 0 }
        second := source[index + 1]
        if second < 128 || second > 191 { return 0 }
        return 2
    }
    if first >= 224 && first <= 239 {
        if index + 2 >= source_length { return 0 }
        second := source[index + 1]
        third := source[index + 2]
        if second < 128 || second > 191 || third < 128 || third > 191 { return 0 }
        if first == 224 && second < 160 { return 0 }
        if first == 237 && second >= 160 { return 0 }
        return 3
    }
    if first >= 240 && first <= 244 {
        if index + 3 >= source_length { return 0 }
        second := source[index + 1]
        third := source[index + 2]
        fourth := source[index + 3]
        if second < 128 || second > 191 || third < 128 || third > 191 || fourth < 128 || fourth > 191 { return 0 }
        if first == 240 && second < 144 { return 0 }
        if first == 244 && second > 143 { return 0 }
        return 4
    }
    0
}

utf8_identifier_start_raw :: fn (source : *u8, index : u64, width : u8) bool {
    codepoint : u64 = 0
    if width == 2 {
        codepoint = (source[index] as u64 % 32) * 64 + source[index + 1] as u64 % 64
    } else {
        if width == 3 {
            codepoint = (source[index] as u64 % 16) * 4096 + (source[index + 1] as u64 % 64) * 64 + source[index + 2] as u64 % 64
        } else {
            if width == 4 {
                codepoint = (source[index] as u64 % 8) * 262144 + (source[index + 1] as u64 % 64) * 4096 + (source[index + 2] as u64 % 64) * 64 + source[index + 3] as u64 % 64
            } else { return false }
        }
    }
    if codepoint >= 192 && codepoint <= 767 { return codepoint != 215 && codepoint != 247 }
    if codepoint >= 880 && codepoint <= 1327 { return true }
    if codepoint >= 1329 && codepoint <= 1416 { return true }
    if codepoint >= 1488 && codepoint <= 1514 { return true }
    if codepoint >= 1568 && codepoint <= 1610 { return true }
    if codepoint >= 1646 && codepoint <= 1747 { return true }
    if codepoint >= 2308 && codepoint <= 8191 { return true }
    if codepoint >= 11264 && codepoint <= 11775 { return true }
    if codepoint >= 12353 && codepoint <= 12543 { return true }
    if codepoint >= 12549 && codepoint <= 12591 { return true }
    if codepoint >= 13312 && codepoint <= 40959 { return true }
    if codepoint >= 44032 && codepoint <= 55203 { return true }
    if codepoint >= 63744 && codepoint <= 64255 { return true }
    if codepoint >= 65536 && codepoint <= 126975 { return true }
    false
}

pub decoded_string_len :: fn (source : []u8, start : u64, end : u64) u64 {
    index := start + 1
    length : u64 = 0
    while index + 1 < end {
        if source[index] == 92 {
            index = index + 2
        } else {
            index = index + 1
        }
        length = length + 1
    }
    length
}

pub decoded_string_len_raw :: fn (source : *u8, start : u64, end : u64) u64 {
    index := start + 1
    length : u64 = 0
    while index + 1 < end {
        if source[index] == 92 { index = index + 2 } else { index = index + 1 }
        length = length + 1
    }
    length
}

pub decoded_string_byte :: fn (source : []u8, start : u64, end : u64, position : u64) u8 {
    index := start + 1
    decoded : u64 = 0
    while index + 1 < end {
        value := source[index]
        if value == 92 {
            escaped := source[index + 1]
            if escaped == 110 { value = 10 } else {
                if escaped == 114 { value = 13 } else {
                    if escaped == 116 { value = 9 } else { value = escaped }
                }
            }
            index = index + 2
        } else {
            index = index + 1
        }
        if decoded == position { return value }
        decoded = decoded + 1
    }
    0
}

pub decoded_string_byte_raw :: fn (source : *u8, start : u64, end : u64, position : u64) u8 {
    index := start + 1
    decoded : u64 = 0
    while index + 1 < end {
        value := source[index]
        if value == 92 {
            escaped := source[index + 1]
            if escaped == 110 { value = 10 } else {
                if escaped == 114 { value = 13 } else {
                    if escaped == 116 { value = 9 } else { value = escaped }
                }
            }
            index = index + 2
        } else { index = index + 1 }
        if decoded == position { return value }
        decoded = decoded + 1
    }
    0
}

identifier_kind_raw :: fn (source : *u8, start : u64, end : u64) u8 {
    hash : u64 = 0
    index := start
    while index < end {
        hash = hash * 131 + source[index]
        index = index + 1
    }
    if hash == 262750338 || hash == 302589253 { return 4 }
    if hash == 13418 { return 5 }
    if hash == 13472 { return 160 }
    if hash == 4471061603997 { return 161 }
    if hash == 228960337 { return 162 }
    if hash == 32320559965 { return 163 }
    if hash == 13857 { return 164 }
    if hash == 228925745 { return 165 }
    if hash == 1937457 { return 166 }
    if hash == 3932130972132 { return 167 }
    if hash == 13211 { return 168 }
    if hash == 35281108217 { return 169 }
    if hash == 1765077 { return 170 }
    if hash == 244713352 { return 171 }
    if hash == 29678813058 { return 172 }
    if hash == 13865 { return 173 }
    if hash == 12822 { return 174 }
    if hash == 4428069113672 { return 175 }
    if hash == 29119020707 { return 176 }
    if hash == 66109462071000619 { return 177 }
    1
}

paired_kind :: fn (first : u8, second : u8) u8 {
    if first == 61 && second == 61 { return 128 }
    if first == 33 && second == 61 { return 129 }
    if first == 60 && second == 61 { return 130 }
    if first == 62 && second == 61 { return 131 }
    if first == 38 && second == 38 { return 132 }
    if first == 124 && second == 124 { return 133 }
    if first == 61 && second == 62 { return 134 }
    if first == 46 && second == 46 { return 135 }
    0
}

single_kind :: fn (byte : u8) u8 {
    if byte == 44 || byte == 46 || byte == 58 || byte == 61 || byte == 60 || byte == 62 || byte == 38 || byte == 64 || byte == 33 || byte == 43 || byte == 45 || byte == 42 || byte == 47 || byte == 37 || byte == 40 || byte == 41 || byte == 123 || byte == 125 || byte == 91 || byte == 93 {
        return byte
    }
    0
}

pub token_count :: fn (source : []u8) i32 {
    cursor : u64 = 0
    count := 0
    while true {
        token := next_token(source, cursor)
        if token.0 == 0 {
            return count
        }
        if token.0 == 255 {
            return -1
        }
        cursor = token.2
        count = count + 1
    }
    count
}

extern mimi_arena_empty : fn() *void
extern mimi_arena_allocate : fn(arena : *ExpressionArena, size : u64, alignment : u64) i32
extern mimi_arena_release : fn(arena : *ExpressionArena) void
extern mimi_buffer_empty : fn() *void

pub ExpressionArena :: struct {
    head : *void,
    last : *void,
}

pub ExprNode :: struct {
    kind : u64,
    start : u64,
    end : u64,
    left : *ExprNode,
    right : *ExprNode,
}

pub BindingHeader :: struct {
    start : u64,
    end : u64,
    name_start : u64,
    name_end : u64,
    binding_kind : u64,
    type_start : u64,
    type_end : u64,
    value_start : u64,
    value_end : u64,
}

ExprOperator :: struct {
    kind : u64,
    start : u64,
    base_count : u64,
    argument_count : u64,
}

ExpressionStacks :: struct {
    storage : *ExpressionArena,
    nodes : **ExprNode,
    operators : *ExprOperator,
    node_count : u64,
    operator_count : u64,
}

pub expression_arena_init :: fn () ExpressionArena {
    empty := mimi_arena_empty()
    ExpressionArena { head = empty, last = empty }
}

pub expression_arena_release :: fn (storage : *ExpressionArena) void {
    mimi_arena_release(storage)
}

pub expression_is_null :: fn (node : *ExprNode) bool {
    node == (mimi_buffer_empty() as *ExprNode)
}

pub binding_header_is_null :: fn (header : *BindingHeader) bool {
    header == (mimi_buffer_empty() as *BindingHeader)
}

pub parse_binding_header :: fn (source : []u8, storage : *ExpressionArena) *BindingHeader {
    name := next_token(source, 0)
    if name.0 != 1 { return mimi_buffer_empty() as *BindingHeader }
    colon := next_token(source, name.2)
    if colon.0 != 58 { return mimi_buffer_empty() as *BindingHeader }
    marker := next_token(source, colon.2)
    binding_kind : u64 = 0
    type_start : u64 = 0
    type_end : u64 = 0
    value_start : u64 = marker.2
    if marker.0 == 58 {
        binding_kind = 2
    } else {
        if marker.0 == 61 {
            binding_kind = 0
        } else {
            binding_kind = 1
            type_start = marker.1
            cursor := marker.1
            nesting : u64 = 0
            found_equal := false
            while cursor < source.len && !found_equal {
                token := next_token(source, cursor)
                if token.0 == 0 || token.0 == 255 { return mimi_buffer_empty() as *BindingHeader }
                cursor = token.2
                if token.0 == 91 { nesting = nesting + 1 } else {
                    if token.0 == 93 && nesting > 0 { nesting = nesting - 1 } else {
                        if token.0 == 61 && nesting == 0 {
                            type_end = token.1
                            value_start = token.2
                            found_equal = true
                        }
                    }
                }
            }
            if !found_equal || nesting != 0 { return mimi_buffer_empty() as *BindingHeader }
            parsed_type := parse_type(source[type_start:type_end], storage)
            if expression_is_null(parsed_type) { return mimi_buffer_empty() as *BindingHeader }
        }
    }
    if next_token(source, value_start).0 == 0 || next_token(source, value_start).0 == 255 {
        return mimi_buffer_empty() as *BindingHeader
    }
    if mimi_arena_allocate(storage, 72, 8) == 0 { return mimi_buffer_empty() as *BindingHeader }
    header := storage.last as *BindingHeader
    header.start = name.1
    header.end = source.len
    header.name_start = name.1
    header.name_end = name.2
    header.binding_kind = binding_kind
    header.type_start = type_start
    header.type_end = type_end
    header.value_start = value_start
    header.value_end = source.len
    header
}

pub parse_type :: fn (source : []u8, storage : *ExpressionArena) *ExprNode {
    if source.len > 500000000000000000 { return mimi_buffer_empty() as *ExprNode }
    if mimi_arena_allocate(storage, source.len * 32 + 32, 8) == 0 { return mimi_buffer_empty() as *ExprNode }
    prefixes := storage.last as *ExprOperator
    prefix_count : u64 = 0
    cursor : u64 = 0
    token := next_token(source, cursor)
    if token.0 == 42 {
        prefixes[prefix_count] = ExprOperator { kind = 271, start = token.1, base_count = 0, argument_count = 0 }
        prefix_count = prefix_count + 1
        cursor = token.2
    } else {
        if token.0 == 91 {
            next := next_token(source, token.2)
            if next.0 == 93 {
                prefixes[prefix_count] = ExprOperator { kind = 272, start = token.1, base_count = 0, argument_count = 0 }
                prefix_count = prefix_count + 1
                cursor = next.2
            } else {
                if next.0 != 2 { return mimi_buffer_empty() as *ExprNode }
                close := next_token(source, next.2)
                if close.0 != 93 { return mimi_buffer_empty() as *ExprNode }
                count_node := allocate_expr(storage, 2, next.1, next.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
                if expression_is_null(count_node) { return count_node }
                prefixes[prefix_count] = ExprOperator { kind = 273, start = token.1, base_count = count_node.start, argument_count = count_node.end }
                prefix_count = prefix_count + 1
                cursor = close.2
            }
        }
    }
    while true {
        token = next_token(source, cursor)
        if token.0 == 42 {
            prefixes[prefix_count] = ExprOperator { kind = 271, start = token.1, base_count = 0, argument_count = 0 }
            prefix_count = prefix_count + 1
            cursor = token.2
        } else {
            if token.0 == 91 {
                next := next_token(source, token.2)
                if next.0 == 93 {
                    prefixes[prefix_count] = ExprOperator { kind = 272, start = token.1, base_count = 0, argument_count = 0 }
                    prefix_count = prefix_count + 1
                    cursor = next.2
                } else {
                    if next.0 != 2 { return mimi_buffer_empty() as *ExprNode }
                    close := next_token(source, next.2)
                    if close.0 != 93 { return mimi_buffer_empty() as *ExprNode }
                    prefixes[prefix_count] = ExprOperator { kind = 273, start = token.1, base_count = next.1, argument_count = next.2 }
                    prefix_count = prefix_count + 1
                    cursor = close.2
                }
            } else { break }
        }
    }
    name := next_token(source, cursor)
    if name.0 != 1 && name.0 != 4 && name.0 != 5 { return mimi_buffer_empty() as *ExprNode }
    next_token_result := next_token(source, name.2)
    if next_token_result.0 != 0 { return mimi_buffer_empty() as *ExprNode }
    node := allocate_expr(storage, 270, name.1, name.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
    if expression_is_null(node) { return node }
    while prefix_count > 0 {
        prefix_count = prefix_count - 1
        prefix := prefixes[prefix_count]
        if prefix.kind == 273 {
            count := allocate_expr(storage, 2, prefix.base_count, prefix.argument_count, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
            if expression_is_null(count) { return count }
            node = allocate_expr(storage, prefix.kind, prefix.start, node.end, node, count)
        } else {
            node = allocate_expr(storage, prefix.kind, prefix.start, node.end, node, mimi_buffer_empty() as *ExprNode)
        }
        if expression_is_null(node) { return node }
    }
    node
}

pub parse_expression :: fn (source : []u8, storage : *ExpressionArena) *ExprNode {
    // Bound the stack-size calculations below before multiplying source.len.
    if source.len > 500000000000000000 { return mimi_buffer_empty() as *ExprNode }
    first := next_token(source, 0)
    if first.0 == 1 || first.0 == 2 || first.0 == 3 || first.0 == 4 || first.0 == 5 {
        if next_token(source, first.2).0 == 0 {
            return allocate_expr(storage, first.0 as u64, first.1, first.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
        }
    }
    if mimi_arena_allocate(storage, source.len * 8 + 8, 8) == 0 { return mimi_buffer_empty() as *ExprNode }
    node_stack := storage.last as **ExprNode
    if mimi_arena_allocate(storage, source.len * 32 + 32, 8) == 0 { return mimi_buffer_empty() as *ExprNode }
    operator_stack := storage.last as *ExprOperator
    stacks := ExpressionStacks { storage = storage, nodes = node_stack, operators = operator_stack, node_count = 0, operator_count = 0 }
    cursor : u64 = 0
    expecting_operand := true
    while true {
        token := next_token(source, cursor)
        if token.0 == 0 { break }
        if token.0 == 255 { return mimi_buffer_empty() as *ExprNode }
        cursor = token.2

        if token.0 == 1 || token.0 == 2 || token.0 == 3 || token.0 == 4 || token.0 == 5 {
            if !expecting_operand { return mimi_buffer_empty() as *ExprNode }
            node := allocate_expr(storage, token.0 as u64, token.1, token.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
            if expression_is_null(node) { return node }
            stacks.nodes[stacks.node_count] = node
            stacks.node_count = stacks.node_count + 1
            expecting_operand = false
            while stacks.operator_count > 0 && is_prefix_operator(stacks.operators[stacks.operator_count - 1].kind) {
                if !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
            }
        } else {
            if token.0 == 46 && !expecting_operand {
                if stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
                member := next_token(source, cursor)
                if member.0 != 1 && member.0 != 2 { return mimi_buffer_empty() as *ExprNode }
                cursor = member.2
                member_node := allocate_expr(storage, member.0 as u64, member.1, member.2, mimi_buffer_empty() as *ExprNode, mimi_buffer_empty() as *ExprNode)
                if expression_is_null(member_node) { return member_node }
                receiver := stacks.nodes[stacks.node_count - 1]
                access := allocate_expr(storage, 260, receiver.start, member.2, receiver, member_node)
                if expression_is_null(access) { return access }
                stacks.nodes[stacks.node_count - 1] = access
            } else {
                if token.0 == 40 && expecting_operand {
                    stacks.operators[stacks.operator_count] = ExprOperator { kind = 40, start = token.1, base_count = 0, argument_count = 0 }
                    stacks.operator_count = stacks.operator_count + 1
                } else {
                    if token.0 == 40 && !expecting_operand {
                        if stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
                        stacks.operators[stacks.operator_count] = ExprOperator { kind = 300, start = token.1, base_count = stacks.node_count, argument_count = 0 }
                        stacks.operator_count = stacks.operator_count + 1
                        expecting_operand = true
                    } else {
                    if token.0 == 91 && !expecting_operand {
                        if stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
                        stacks.operators[stacks.operator_count] = ExprOperator { kind = 91, start = token.1, base_count = stacks.node_count, argument_count = 0 }
                        stacks.operator_count = stacks.operator_count + 1
                        expecting_operand = true
                    } else {
                        if token.0 == 58 || token.0 == 135 {
                            found_index := false
                            while stacks.operator_count > 0 && !found_index {
                                top := stacks.operators[stacks.operator_count - 1]
                                if top.kind == 91 {
                                    found_index = true
                                } else {
                                    if top.kind == 40 || top.kind == 300 || !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                                }
                            }
                            if !found_index || stacks.operators[stacks.operator_count - 1].argument_count != 0 { return mimi_buffer_empty() as *ExprNode }
                            marker := stacks.operators[stacks.operator_count - 1]
                            if expecting_operand {
                                if stacks.node_count != marker.base_count { return mimi_buffer_empty() as *ExprNode }
                                marker.argument_count = 1
                            } else {
                                if stacks.node_count != marker.base_count + 1 { return mimi_buffer_empty() as *ExprNode }
                                marker.argument_count = 3
                            }
                            stacks.operators[stacks.operator_count - 1] = marker
                            expecting_operand = true
                        } else {
                        if token.0 == 44 {
                            if expecting_operand || stacks.operator_count == 0 { return mimi_buffer_empty() as *ExprNode }
                            while stacks.operator_count > 0 && stacks.operators[stacks.operator_count - 1].kind != 300 {
                                top := stacks.operators[stacks.operator_count - 1]
                                if top.kind == 40 || top.kind == 91 || !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                            }
                            if stacks.operator_count == 0 { return mimi_buffer_empty() as *ExprNode }
                            marker := stacks.operators[stacks.operator_count - 1]
                            expected_count := marker.base_count + 1
                            if marker.argument_count != 0 { expected_count = expected_count + 1 }
                            if stacks.node_count != expected_count { return mimi_buffer_empty() as *ExprNode }
                            argument := stacks.nodes[stacks.node_count - 1]
                            if marker.argument_count == 0 {
                                stacks.nodes[marker.base_count] = argument
                            } else {
                                previous := stacks.nodes[marker.base_count]
                                argument_list := allocate_expr(storage, 262, previous.start, argument.end, previous, argument)
                                if expression_is_null(argument_list) { return argument_list }
                                stacks.nodes[marker.base_count] = argument_list
                                stacks.node_count = stacks.node_count - 1
                            }
                            marker.argument_count = marker.argument_count + 1
                            stacks.operators[stacks.operator_count - 1] = marker
                            expecting_operand = true
                        } else {
                        if token.0 == 93 {
                            found_index := false
                            marker := ExprOperator { kind = 0, start = 0, base_count = 0, argument_count = 0 }
                            while stacks.operator_count > 0 && !found_index {
                                top := stacks.operators[stacks.operator_count - 1]
                                if top.kind == 91 {
                                    marker = top
                                    stacks.operator_count = stacks.operator_count - 1
                                    found_index = true
                                } else {
                                    if top.kind == 40 || top.kind == 300 || !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                                }
                            }
                            if !found_index || marker.base_count == 0 { return mimi_buffer_empty() as *ExprNode }
                            if marker.argument_count == 0 {
                                if expecting_operand || stacks.node_count != marker.base_count + 1 { return mimi_buffer_empty() as *ExprNode }
                                index_node := stacks.nodes[marker.base_count]
                                receiver := stacks.nodes[marker.base_count - 1]
                                access := allocate_expr(storage, 261, receiver.start, token.2, receiver, index_node)
                                if expression_is_null(access) { return access }
                                stacks.node_count = marker.base_count
                                stacks.nodes[stacks.node_count - 1] = access
                            } else {
                                has_start := marker.argument_count == 3
                                has_end := !expecting_operand
                                expected_count := marker.base_count
                                if has_start { expected_count = expected_count + 1 }
                                if has_end { expected_count = expected_count + 1 }
                                if stacks.node_count != expected_count { return mimi_buffer_empty() as *ExprNode }
                                start_node : *ExprNode = mimi_buffer_empty() as *ExprNode
                                end_node : *ExprNode = mimi_buffer_empty() as *ExprNode
                                if has_start { start_node = stacks.nodes[marker.base_count] }
                                if has_end {
                                    end_index := marker.base_count
                                    if has_start { end_index = end_index + 1 }
                                    end_node = stacks.nodes[end_index]
                                }
                                receiver := stacks.nodes[marker.base_count - 1]
                                bounds := allocate_expr(storage, 265, token.1, token.1, start_node, end_node)
                                if expression_is_null(bounds) { return bounds }
                                slice := allocate_expr(storage, 264, receiver.start, token.2, receiver, bounds)
                                if expression_is_null(slice) { return slice }
                                stacks.node_count = marker.base_count - 1
                                stacks.nodes[stacks.node_count] = slice
                                stacks.node_count = stacks.node_count + 1
                            }
                            expecting_operand = false
                        } else {
                            if token.0 == 41 && stacks.operator_count > 0 && stacks.operators[stacks.operator_count - 1].kind == 300 {
                                marker := stacks.operators[stacks.operator_count - 1]
                                if marker.argument_count == 0 {
                                    if stacks.node_count != marker.base_count && stacks.node_count != marker.base_count + 1 { return mimi_buffer_empty() as *ExprNode }
                                } else {
                                    if expecting_operand { return mimi_buffer_empty() as *ExprNode }
                                    while stacks.operator_count > 0 && stacks.operators[stacks.operator_count - 1].kind != 300 {
                                        if !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                                    }
                                    if stacks.node_count != marker.base_count + 2 { return mimi_buffer_empty() as *ExprNode }
                                    previous := stacks.nodes[marker.base_count]
                                    argument := stacks.nodes[marker.base_count + 1]
                                    argument_list := allocate_expr(storage, 262, previous.start, argument.end, previous, argument)
                                    if expression_is_null(argument_list) { return argument_list }
                                    stacks.nodes[marker.base_count] = argument_list
                                    stacks.node_count = stacks.node_count - 1
                                }
                                stacks.operator_count = stacks.operator_count - 1
                                callee := stacks.nodes[marker.base_count - 1]
                                arguments : *ExprNode = mimi_buffer_empty() as *ExprNode
                                if marker.argument_count != 0 || stacks.node_count == marker.base_count + 1 { arguments = stacks.nodes[marker.base_count] }
                                call := allocate_expr(storage, 263, callee.start, token.2, callee, arguments)
                                if expression_is_null(call) { return call }
                                stacks.node_count = marker.base_count - 1
                                stacks.nodes[stacks.node_count] = call
                                stacks.node_count = stacks.node_count + 1
                                expecting_operand = false
                            } else {
                            if token.0 == 41 {
                                if expecting_operand { return mimi_buffer_empty() as *ExprNode }
                                found_open := false
                                while stacks.operator_count > 0 && !found_open {
                                    top := stacks.operators[stacks.operator_count - 1]
                                    if top.kind == 40 {
                                        stacks.operator_count = stacks.operator_count - 1
                                        found_open = true
                                    } else {
                                        if top.kind == 91 || top.kind == 300 || !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                                    }
                                }
                                if !found_open { return mimi_buffer_empty() as *ExprNode }
                                if stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
                                stacks.nodes[stacks.node_count - 1].start = stacks.operators[stacks.operator_count].start
                                stacks.nodes[stacks.node_count - 1].end = token.2
                                expecting_operand = false
                            } else {
                                if expecting_operand {
                                    if token.0 != 45 && token.0 != 33 && token.0 != 38 && token.0 != 42 { return mimi_buffer_empty() as *ExprNode }
                                    stacks.operators[stacks.operator_count] = ExprOperator { kind = 250 + token.0 as u64, start = token.1, base_count = 0, argument_count = 0 }
                                    stacks.operator_count = stacks.operator_count + 1
                                } else {
                                    precedence := expression_precedence(token.0)
                                    if precedence == 0 { return mimi_buffer_empty() as *ExprNode }
                                    while stacks.operator_count > 0 {
                                        top := stacks.operators[stacks.operator_count - 1]
                                        if top.kind == 40 || top.kind == 91 || top.kind == 300 { break }
                                        top_precedence := expression_operator_precedence(top.kind)
                                        if top_precedence < precedence { break }
                                        if !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
                                    }
                                    stacks.operators[stacks.operator_count] = ExprOperator { kind = token.0 as u64, start = token.1, base_count = 0, argument_count = 0 }
                                    stacks.operator_count = stacks.operator_count + 1
                                    expecting_operand = true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
    }

    }
    if expecting_operand || stacks.node_count == 0 { return mimi_buffer_empty() as *ExprNode }
    while stacks.operator_count > 0 {
        if stacks.operators[stacks.operator_count - 1].kind == 40 || stacks.operators[stacks.operator_count - 1].kind == 91 || stacks.operators[stacks.operator_count - 1].kind == 300 { return mimi_buffer_empty() as *ExprNode }
        if !reduce_expression(&stacks) { return mimi_buffer_empty() as *ExprNode }
    }
    if stacks.node_count != 1 { return mimi_buffer_empty() as *ExprNode }
    stacks.nodes[0]
}

allocate_expr :: fn (storage : *ExpressionArena, kind : u64, start : u64, end : u64, left : *ExprNode, right : *ExprNode) *ExprNode {
    if mimi_arena_allocate(storage, 40, 8) == 0 { return mimi_buffer_empty() as *ExprNode }
    node := storage.last as *ExprNode
    node.kind = kind
    node.start = start
    node.end = end
    node.left = left
    node.right = right
    node
}

reduce_expression :: fn (stacks : *ExpressionStacks) bool {
    if stacks.operator_count == 0 { return false }
    operator := stacks.operators[stacks.operator_count - 1]
    stacks.operator_count = stacks.operator_count - 1
    if is_prefix_operator(operator.kind) {
        if stacks.node_count < 1 { return false }
        operand := stacks.nodes[stacks.node_count - 1]
        node := allocate_expr(stacks.storage, operator.kind, operator.start, operand.end, operand, mimi_buffer_empty() as *ExprNode)
        if expression_is_null(node) { return false }
        stacks.nodes[stacks.node_count - 1] = node
        return true
    }
    if stacks.node_count < 2 { return false }
    right := stacks.nodes[stacks.node_count - 1]
    left := stacks.nodes[stacks.node_count - 2]
    stacks.node_count = stacks.node_count - 2
    node := allocate_expr(stacks.storage, operator.kind, left.start, right.end, left, right)
    if expression_is_null(node) { return false }
    stacks.nodes[stacks.node_count] = node
    stacks.node_count = stacks.node_count + 1
    true
}

is_prefix_operator :: fn (kind : u64) bool {
    kind == 295 || kind == 283 || kind == 288 || kind == 292
}

expression_operator_precedence :: fn (kind : u64) u8 {
    if is_prefix_operator(kind) { return 7 }
    expression_precedence(kind as u8)
}

expression_precedence :: fn (kind : u8) u8 {
    if kind == 133 { return 1 }
    if kind == 132 { return 2 }
    if kind == 128 || kind == 129 { return 3 }
    if kind == 60 || kind == 62 || kind == 130 || kind == 131 { return 4 }
    if kind == 43 || kind == 45 { return 5 }
    if kind == 42 || kind == 47 || kind == 37 { return 6 }
    0
}
